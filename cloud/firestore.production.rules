            || !("locationConsentAt" in resource.data) && request.resource.data.locationConsentAt == request.time
            || request.resource.data.get("locationConsentAt", null) == resource.data.get("locationConsentAt", null))
          // Shift change first: comparing the whole entries map is only needed when no shift changed.
          && (tsOneEntry() || request.resource.data.get("entries", {}) == resource.data.get("entries", {}));
      }
      function tsSentUpdate() {
        return tsHeartwoodAdmin()
          && resource.data.get("companyId", "heartwood") == "heartwood"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sent", "sentAt", "sentBy"])
          && request.resource.data.sent is bool
          && (request.resource.data.get("sentAt", null) == null || request.resource.data.sentAt is string)
          && (request.resource.data.get("sentBy", null) == null || request.resource.data.sentBy == request.auth.uid);
      }

      allow get: if tsHeartwoodAdmin() && docCompany(resource.data) == "heartwood";
      allow list: if tsHeartwoodAdmin() && resource.data.companyId == "heartwood";
      allow read: if signedIn() && (
        (resource == null && id.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        || (resource != null && resource.data.uid == request.auth.uid && companyOpen(resource.data.get("companyId", "heartwood")))
      );
      allow get: if resource.data.get("companyId", "heartwood") != "heartwood" && incAdminOf(resource.data.companyId);
      allow list: if resource.data.companyId != "heartwood" && incAdminOf(resource.data.companyId);
      allow create: if tsWorkerCreate(id);
      allow update: if tsWorkerUpdate(id) || tsSentUpdate() || tsCompanySent();
      allow delete: if false;
    }

    // Read-only mirror so clock-on can list machines and today's prestart.
    // Creates and edits stay with the compliance PR. allow write: if false does not veto those rules.
    match /tenants/{tenantId}/fleet/{assetId} {

      allow read: if tsFleetReader(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/prestarts/{id} {

      allow read: if tsFleetReader(tenantId);
      allow write: if false;
    }
// END TIMESHEET RULES

// BEGIN LEAVE RULES

    match /leaveRequests/{id} {
      function lvDecider() {
        return lvHeartwood() && (
          isAlex() || isPatrick() || (
            hasProfile() && (profile().role == "admin" || profile().role == "supervisor" || profile().role == "manager")
          )
        );
      }

      allow read: if lvHeartwood() && (
        lvDecider()
        || (resource != null && resource.data.uid == request.auth.uid)
        || (resource == null && id.matches('^lv[a-z0-9]{16}$'))
      );
      allow create: if (lvHeartwood() && lvCreateBody(id));
      allow update: if (lvDecider() && lvDecisionBody());
      allow delete: if false;
    }
    // Other companies (not Heartwood): leave lives under companies/{c}/leaveRequests, so Heartwood's own list
    // never sees it. Staff of that company create and read their own; its admins and supervisors read and decide.
    match /companies/{c}/leaveRequests/{id} {
      function cmRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "");
      }
      function lvCoDecider(c) { return incStaffOf(c) && cmRole() in ["admin", "supervisor", "manager"]; }

      allow read: if incStaffOf(c) && (
        lvCoDecider(c)
        || (resource != null && resource.data.uid == request.auth.uid)
        || (resource == null && id.matches('^lv[a-z0-9]{16}$'))
      );
      allow create: if incStaffOf(c) && lvCreateBody(id);
      allow update: if lvCoDecider(c) && lvDecisionBody();
      allow delete: if false;
    }
// END LEAVE RULES

// BEGIN REIMBURSEMENT CLAIM RULES


    match /reimbursementClaims/{id} {
      function rcAdmin() {
        return lvHeartwood() && (isAlex() || isPatrick() || (hasProfile() && (profile().role == "admin" || profile().role == "manager")));
      }

      allow read: if (isSync() && resource != null && resource.data.status == "paid") || lvHeartwood() && (
        rcAdmin()
        || (resource != null && resource.data.uid == request.auth.uid)
        || (resource == null && id.matches('^rc[a-z0-9]{16}$'))
      );
      allow create: if (lvHeartwood() && rcCreateBody(id));
      allow update: if (rcAdmin() && rcDecisionBody()) || rcHubdoc();
      allow delete: if false;
    }
    // Other companies: claims under companies/{c}/reimbursementClaims. Staff create and read their own; that
    // company's admins read and decide. The box filer reads paid ones and records Hubdoc state only.
    match /companies/{c}/reimbursementClaims/{id} {
      function rcCompanyDecider(c) {
        return incStaffOf(c) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") in ["admin", "manager"];
      }

      allow read: if (isSync() && resource != null && resource.data.status == "paid") || incStaffOf(c) && (
        rcCompanyDecider(c)
        || (resource != null && resource.data.uid == request.auth.uid)
        || (resource == null && id.matches('^rc[a-z0-9]{16}$'))
      );
      allow create: if incStaffOf(c) && rcCreateBody(id);
      allow update: if (rcCompanyDecider(c) && rcDecisionBody()) || rcHubdoc();
      allow delete: if false;
    }
// END REIMBURSEMENT CLAIM RULES
// BEGIN HOURS EXPORT RULES
    match /hoursExports/{id} {
      function hxAdmin() {
        return signedIn() && (
          request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2" || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin"
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("tenantId", "heartwood") == "heartwood")
        );
      }
      function hxCreate(id) {
        let d = request.resource.data;
        return hxAdmin()
          && id.matches('^hx[a-z0-9]{16}$')
          && d.keys().hasOnly(["weekStart", "weekEnd", "to", "fileName", "storagePath", "people", "totalHours", "status", "attempts", "createdBy", "createdByName", "createdAt", "companyId", "companyName"])
          && (!("companyId" in d) || d.companyId == "heartwood")
          && (!("companyName" in d) || d.companyName == "Heartwood")
          && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.weekEnd is string && d.weekEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.to == "accounts@heartwoodew.com"
          && d.fileName is string && d.fileName.matches('^[A-Za-z0-9_-]{1,80}[.]xlsx$')
          && d.storagePath == "hoursExports/" + id + "/" + d.fileName
          && d.people is int && d.people >= 0 && d.people <= 500
          && d.totalHours is number && d.totalHours >= 0 && d.totalHours <= 100000
          && d.status == "queued" && d.attempts == 0
          && d.createdBy == request.auth.uid
          && d.createdByName is string && d.createdByName.size() <= 80
          && d.createdAt == request.time;
      }
      function hxMark() {
        return isSync()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "attempts", "updatedAt", "sentAt", "messageId", "error", "via"])
          && request.resource.data.status in ["sending", "sent", "failed"]
          && request.resource.data.to == "accounts@heartwoodew.com"
          && request.resource.data.attempts is int
          && request.resource.data.get("error", "") is string && request.resource.data.get("error", "").size() <= 300
          && request.resource.data.get("messageId", "") is string && request.resource.data.get("messageId", "").size() <= 100;
      }
      function hxCreateCompany(id) {
        let d = request.resource.data;
        return companyOffice()
          && id.matches('^hx[a-z0-9]{16}$')
          && d.companyId == callerCompany()
          && d.to != "accounts@heartwoodew.com"
          && d.keys().hasOnly(["weekStart", "weekEnd", "to", "fileName", "storagePath", "people", "totalHours", "status", "attempts", "createdBy", "createdByName", "createdAt", "companyId", "companyName"])
          && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.weekEnd is string && d.weekEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.fileName is string && d.fileName.matches('^[A-Za-z0-9_-]{1,80}[.]xlsx$')
          && d.storagePath == "hoursExports/" + id + "/" + d.fileName
          && d.people is int && d.people >= 0 && d.people <= 500
          && d.totalHours is number && d.totalHours >= 0 && d.totalHours <= 100000
          && d.status == "queued" && d.attempts == 0
          && d.createdBy == request.auth.uid
          && d.createdByName is string && d.createdByName.size() <= 80
          && d.createdAt == request.time
          && d.companyName is string && d.companyName.size() > 0 && d.companyName.size() <= 80;
      }

      allow read: if hxAdmin() || isSync();
      allow read: if companyOffice() && resource.data.companyId == callerCompany();
      allow create: if hxCreate(id);
      allow create: if hxCreateCompany(id);
      allow update: if hxMark();
      allow delete: if false;
    }
// END HOURS EXPORT RULES

// BEGIN LIVE LOCATION RULES
    // One live doc per person (latest position only). Heartwood: liveLocations/{uid}.
    // Every other company: companies/{id}/liveLocations/{uid}. The same clock-off and
    // last-known rules apply to every company. Written while that person's timesheet
    // shift is clocked on (open or on a break). Clock off keeps the doc: the same person
    // sets clockedOn false and clockedOffAt, and does not have to delete it.
    // A position already shared cannot be replaced with location off, so a lapsed update stays.
    // Admin and manager of the same company read every doc, including a clocked-off last position.
    // A supervisor reads clocked-on docs only, for the Staff roster. Operator and labourer do not.
    // The crew map stays manager and admin. No other company does.
    // Heartwood: status "paused" blocks locations (llPaused). Other companies use companyNotPaused,
    // the same trial and billing pause as the rest of the app. No company document means not paused.
    match /liveLocations/{id} {
      function llMap() {
        return isAlex()
          || (isPatrick() && callerCompany() == "heartwood")
          || (hasProfile() && (profile().get("role", "") == "admin" || profile().get("role", "") == "manager"));
      }
      function llLiveRead() {
        return resource.data.clockedOn == true || llMap();
      }
      function llKeepsFix() {
        return resource.data.sharing != "gps" || request.resource.data.sharing == "gps";
      }
      function llClockOff(id) {
        let d = request.resource.data;
        return resource.data.clockedOn == true
          && d.clockedOn == false
          && d.clockedOffAt == request.time
          && d.uid == id
          && d.uid == request.auth.uid
          && same("uid") && same("name") && same("companyId") && same("sharing")
          && same("lat") && same("lng") && same("accuracy")
          && same("updatedAt") && same("weekStart") && same("entryId")
          && (
            (d.sharing == "gps" && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "lat", "lng", "accuracy", "updatedAt", "weekStart", "entryId", "clockedOffAt"]))
            || (d.sharing == "off" && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "updatedAt", "weekStart", "entryId", "clockedOffAt"]))
          );
      }
      function llRole() {
        return hasProfile() ? profile().get("role", "") : "";
      }
      function llPaused(id) {
        let path = /databases/$(database)/documents/companies/$(id);
        return exists(path) && get(path).data.get("status", "") == "paused";
      }
      function llOffice() {
        return signedIn() && callerCompany() != "" && (
          isAlex()
          || (isPatrick() && callerCompany() == "heartwood")
          || (hasProfile() && (llRole() == "admin" || llRole() == "manager" || llRole() == "supervisor"))
        );
      }
      function llGps(d) {
        return d.sharing == "gps"
          && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "lat", "lng", "accuracy", "updatedAt", "weekStart", "entryId"])
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100000;
      }
      function llOff(d) {
        return d.sharing == "off"
          && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "updatedAt", "weekStart", "entryId"]);
      }
      function llOpenEntry(sheet) {
        let entry = sheet.entries[request.resource.data.entryId];
        return sheet.uid == request.auth.uid
          && docCompany(sheet) == request.resource.data.companyId
          && entry.source == "clock"
          && (entry.status == "open" || entry.status == "break");
      }
      function llClocked() {
        let path = /databases/$(database)/documents/timesheets/$(request.auth.uid + "_" + request.resource.data.weekStart);
        return exists(path) && llOpenEntry(get(path).data);
      }
      function llBody(d, id) {
        return d.uid == id
          && d.uid == request.auth.uid
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.clockedOn == true
          && d.updatedAt == request.time
          && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.entryId is string && d.entryId.matches('^[a-z0-9]{8,24}$')
          && (llGps(d) || llOff(d))
          && llClocked();
      }

      allow get: if llOffice() && !llPaused("heartwood") && callerCompany() == "heartwood" && docCompany(resource.data) == "heartwood" && llLiveRead();
      allow list: if llOffice() && !llPaused("heartwood") && callerCompany() == "heartwood" && resource.data.companyId == "heartwood" && llLiveRead();
      allow create: if callerCompany() == "heartwood" && request.resource.data.companyId == "heartwood" && !llPaused("heartwood") && llBody(request.resource.data, id);
      allow update: if callerCompany() == "heartwood" && request.resource.data.companyId == "heartwood" && !llPaused("heartwood") && ((llBody(request.resource.data, id) && llKeepsFix()) || llClockOff(id));
      allow delete: if signedIn() && request.auth.uid == id && callerCompany() == "heartwood" && docCompany(resource.data) == "heartwood" && !llPaused("heartwood");
    }
    match /companies/{c}/liveLocations/{id} {
      function llMap() {
        return isAlex()
          || (isPatrick() && callerCompany() == "heartwood")
          || (hasProfile() && (profile().get("role", "") == "admin" || profile().get("role", "") == "manager"));
      }
      function llLiveRead() {
        return resource.data.clockedOn == true || llMap();
      }
      function llKeepsFix() {
        return resource.data.sharing != "gps" || request.resource.data.sharing == "gps";
      }
      function llClockOff(id) {
        let d = request.resource.data;
        return resource.data.clockedOn == true
          && d.clockedOn == false
          && d.clockedOffAt == request.time
          && d.uid == id
          && d.uid == request.auth.uid
          && same("uid") && same("name") && same("companyId") && same("sharing")
          && same("lat") && same("lng") && same("accuracy")
          && same("updatedAt") && same("weekStart") && same("entryId")
          && (
            (d.sharing == "gps" && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "lat", "lng", "accuracy", "updatedAt", "weekStart", "entryId", "clockedOffAt"]))
            || (d.sharing == "off" && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "updatedAt", "weekStart", "entryId", "clockedOffAt"]))
          );
      }
      function llRole() {
        return hasProfile() ? profile().get("role", "") : "";
      }
      function llOffice() {
        return signedIn() && callerCompany() != "" && (
          isAlex()
          || (isPatrick() && callerCompany() == "heartwood")
          || (hasProfile() && (llRole() == "admin" || llRole() == "manager" || llRole() == "supervisor"))
        );
      }
      function llGps(d) {
        return d.sharing == "gps"
          && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "lat", "lng", "accuracy", "updatedAt", "weekStart", "entryId"])
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100000;
      }
      function llOff(d) {
        return d.sharing == "off"
          && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "updatedAt", "weekStart", "entryId"]);
      }
      function llOpenEntry(sheet) {
        let entry = sheet.entries[request.resource.data.entryId];
        return sheet.uid == request.auth.uid
          && docCompany(sheet) == request.resource.data.companyId
          && entry.source == "clock"
          && (entry.status == "open" || entry.status == "break");
      }
      function llClocked() {
        let path = /databases/$(database)/documents/timesheets/$(request.auth.uid + "_" + request.resource.data.weekStart);
        return exists(path) && llOpenEntry(get(path).data);
      }
      function llBody(d, id) {
        return d.uid == id
          && d.uid == request.auth.uid
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.clockedOn == true
          && d.updatedAt == request.time
          && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.entryId is string && d.entryId.matches('^[a-z0-9]{8,24}$')
          && (llGps(d) || llOff(d))
          && llClocked();
      }

      allow get: if llOffice() && c != "heartwood" && callerCompany() == c && docCompany(resource.data) == c && companyNotPaused(c) && llLiveRead();
      allow list: if llOffice() && c != "heartwood" && callerCompany() == c && resource.data.companyId == c && companyNotPaused(c) && llLiveRead();
      allow create: if c != "heartwood" && callerCompany() == c && request.resource.data.companyId == c && companyNotPaused(c) && llBody(request.resource.data, id);
      allow update: if c != "heartwood" && callerCompany() == c && request.resource.data.companyId == c && companyNotPaused(c) && ((llBody(request.resource.data, id) && llKeepsFix()) || llClockOff(id));
      allow delete: if signedIn() && request.auth.uid == id && c != "heartwood" && callerCompany() == c && docCompany(resource.data) == c && companyNotPaused(c);
    }
// END LIVE LOCATION RULES

// BEGIN DAILY JOB RULES
    match /dailyJobDigest/{id} {
      allow read, write: if false;
    }
// END DAILY JOB RULES

// BEGIN PRESTART NOTICE RULES
    // Written by the prestart assignment function. The person reads their own
    // company only. Clients cannot write. The document has no prices.
    match /users/{uid}/prestartNotices/{noticeId} {
      allow read: if signedIn() && request.auth.uid == uid && resource.data.companyId == callerCompany();
      allow create, update, delete: if false;
    }
// END PRESTART NOTICE RULES

// BEGIN LOCATION REMIND RULES
    // Written by remindLocationSharing. The person reads their own company only.
    // sentAtMs is the 30-minute rate limit. Clients cannot write.
    match /users/{uid}/locationNotices/{noticeId} {
      allow read: if signedIn() && request.auth.uid == uid && resource.data.companyId == callerCompany();
      allow create, update, delete: if false;
    }
// END LOCATION REMIND RULES

// BEGIN STAFF PERFORMANCE RULES
    // One profile read per helper. Heartwood returns before the company lookup.
    // performanceSettings is managers and admins only (weights and the crew-only ranking switch).
    // take5Settings is the on/off flag every staff member of that company can read, so field crew
    // know to prompt, without being able to read weights or money.
    // take5s: any staff member creates their own; supervisors and above list the company.
    function perfListed() {
      return request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "38SU5waAy4f9UI9N6JTqDMaYpQg2", "R7t41e54Ykcdk9WPdVZnDd697iI2"];
    }
    function perfCompanyOf(p) {
      return p.get("companyId", "") is string && p.get("companyId", "") != ""
        ? p.get("companyId", "")
        : p.get("tenantId", "heartwood");
    }
    function perfRole(companyId) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      let missing = !exists(path);
      let p = missing ? {} : get(path).data;
      let c = perfCompanyOf(p);
      let same = (companyId == "heartwood" && (perfListed() || (!missing && c == "heartwood")))
        || (companyId != "heartwood" && !missing && c == companyId && companyNotPaused(companyId));
      return signedIn() && companyId is string && companyId.size() >= 2 && same ? (perfListed() ? "admin" : p.get("role", "")) : "";
    }
    match /performanceSettings/{companyId} {
      function perfWeightsOk(w) {
        return w is map
          && w.keys().hasOnly(["hours", "money", "jobs", "prestart", "take5", "incidents", "sick", "annual"])
          && w.hours is number && w.hours >= 0 && w.hours <= 10
          && w.money is number && w.money >= 0 && w.money <= 10
          && w.jobs is number && w.jobs >= 0 && w.jobs <= 10
          && w.prestart is number && w.prestart >= 0 && w.prestart <= 10
          && w.take5 is number && w.take5 >= 0 && w.take5 <= 10
          && w.incidents is number && w.incidents >= 0 && w.incidents <= 10
          && w.sick is number && w.sick >= 0 && w.sick <= 10
          && w.annual is number && w.annual >= 0 && w.annual <= 10;
      }
      function perfBody(companyId) {
        let d = request.resource.data;
        return d.keys().hasOnly(["companyId", "excludeLeaders", "weights", "updatedAt", "updatedBy"])
          && d.companyId == companyId
          && d.excludeLeaders is bool
          && perfWeightsOk(d.weights)
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
      }
      function perfDefaultWeights() {
        let w = request.resource.data.weights;
        return w.hours == 1 && w.money == 1 && w.jobs == 1 && w.prestart == 1 && w.take5 == 1
          && w.incidents == 1 && w.sick == 1 && w.annual == 0;
      }
      function perfCanRead(companyId) {
        let role = perfRole(companyId);
        return role == "admin" || role == "manager";
      }

      allow get: if perfCanRead(companyId);
      allow list: if false;
      allow create, update: if perfRole(companyId) == "admin" && perfBody(companyId);
      allow create: if perfRole(companyId) == "manager" && perfBody(companyId) && perfDefaultWeights();
      allow update: if perfRole(companyId) == "manager"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["excludeLeaders", "updatedAt", "updatedBy"])
        && request.resource.data.excludeLeaders is bool
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.weights == resource.data.weights
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /take5Settings/{companyId} {
      function take5Actor(companyId) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let missing = !exists(path);
        let p = missing ? {} : get(path).data;
        let c = perfCompanyOf(p);
        return signedIn() && companyId is string && companyId.size() >= 2 && (
          (companyId == "heartwood" && (perfListed() || (!missing && c == "heartwood")))
          || (companyId != "heartwood" && !missing && c == companyId && companyNotPaused(companyId))
        );
      }

      allow get: if take5Actor(companyId);
      allow list: if false;
      allow create, update: if perfRole(companyId) == "admin"
        && request.resource.data.keys().hasOnly(["companyId", "enabled", "updatedAt", "updatedBy"])
        && request.resource.data.companyId == companyId
        && request.resource.data.enabled is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /take5s/{id} {
      function take5Actor(companyId) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let missing = !exists(path);
        let p = missing ? {} : get(path).data;
        let c = perfCompanyOf(p);
        return signedIn() && companyId is string && companyId.size() >= 2 && (
          (companyId == "heartwood" && (perfListed() || (!missing && c == "heartwood")))
          || (companyId != "heartwood" && !missing && c == companyId && companyNotPaused(companyId))
        );
      }
      function take5Office(companyId) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let missing = !exists(path);
        let p = missing ? {} : get(path).data;
        let role = p.get("role", "");
        let c = perfCompanyOf(p);
        let leader = perfListed() || role in ["supervisor", "manager", "admin"];
        return signedIn() && companyId is string && leader && (
          (companyId == "heartwood" && (perfListed() || (!missing && c == "heartwood")))
          || (companyId != "heartwood" && !missing && c == companyId && companyNotPaused(companyId))
        );
      }
      function take5IdOk(id) { return id.matches('^t5[a-z0-9]{16}$'); }
      function take5MayGetMissing(id) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let missing = !exists(path);
        let p = missing ? {} : get(path).data;
        let c = perfCompanyOf(p);
        let open = c == "heartwood" || (!missing && companyNotPaused(c));
        return take5IdOk(id) && signedIn() && open && (perfListed() || !missing);
      }
      function take5Body(id) {
        let d = request.resource.data;
        return take5IdOk(id)
          && d.keys().hasOnly(["companyId", "uid", "name", "jobId", "jobNo", "day", "note", "steps", "photoPath", "createdAt"])
          && d.companyId is string
          && d.uid == request.auth.uid
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
          && d.jobId is string && d.jobId.size() > 0 && d.jobId.size() <= 80
          && d.jobNo is string && d.jobNo.size() <= 40
          && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.note is string && d.note.size() > 0 && d.note.size() <= 500
          && d.steps is map
          && d.steps.keys().hasOnly(["stop", "look", "assess", "control", "proceed"])
          && d.steps.stop == true && d.steps.look == true && d.steps.assess == true
          && d.steps.control == true && d.steps.proceed == true
          && d.photoPath is string && d.photoPath.size() <= 200
          && (d.photoPath == "" || d.photoPath == "take5Photos/" + d.companyId + "/" + d.uid + "_" + id + ".jpg")
          && d.createdAt == request.time;
      }

      allow get: if resource == null && take5MayGetMissing(id);
      allow get: if resource != null && resource.data.uid == request.auth.uid && take5Actor(resource.data.companyId);
      allow get: if resource != null && take5Office(resource.data.companyId);
      allow list: if resource.data.uid == request.auth.uid && take5Actor(resource.data.companyId);
      allow list: if take5Office(resource.data.companyId);
      allow create: if take5Actor(request.resource.data.companyId) && take5Body(id);
      allow update, delete: if false;
    }
    // Managers need company timesheets and incidents to build the ranking. Crew and supervisors stay on their own.
    match /timesheets/{id} {
      allow get: if perfRole(docCompany(resource.data)) == "manager";
      allow list: if resource.data.companyId is string && perfRole(resource.data.companyId) == "manager";
    }
    match /incidents/{iid} {
      allow get: if perfRole(docCompany(resource.data)) == "manager";
      allow list: if resource.data.companyId is string && perfRole(resource.data.companyId) == "manager";
    }
// END STAFF PERFORMANCE RULES

// BEGIN INBOUND FORWARD RULES
    // Per-company forwarded mail and job drafts. Written by inboundEmailWebhook
    // (Admin SDK). Office of that company (admin, manager, supervisor) can read.
    // Crew cannot. Another company cannot. The route index is not listable.
    // No price fields on a draft. Paste into the live rules. Do not deploy this file.
    function inboundCompanyOf(p) {
      return p.get("companyId", "") is string && p.get("companyId", "") != ""
        ? p.get("companyId", "")
        : (p.get("tenantId", "") is string && p.get("tenantId", "") != "" ? p.get("tenantId", "") : "heartwood");
    }
    function inboundBootstrap(companyId) {
      return companyId == "heartwood" && signedIn() && (
        request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"
        || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
      );
    }
    function inboundProfileOffice(companyId) {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return p.get("role", "") in ["admin", "manager", "supervisor"] && inboundCompanyOf(p) == companyId;
    }
    function inboundProfileMinter(companyId) {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return p.get("role", "") in ["admin", "manager"] && inboundCompanyOf(p) == companyId;
    }
    function inboundOffice(companyId) {
      return inboundBootstrap(companyId) || (signedIn() && inboundProfileOffice(companyId));
    }
    function inboundMinter(companyId) {
      return inboundBootstrap(companyId) || (signedIn() && inboundProfileMinter(companyId));
    }
    function inboundMoneyFree(data) {
      return !data.keys().hasAny(["poAmount", "poAmountBasis", "poAmountSource", "quoteAmount", "poLookupCandidates", "invoiceAmount", "xeroCheck", "amountInc", "totalEx", "gst", "totalInc", "priceOverrides", "lines"]);
    }
    function inboundLocalOk(companyId, localPart) {
      return companyId is string
        && companyId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && localPart is string
        && localPart.matches("^" + companyId + "-[a-z0-9]{8}$");
    }

    match /companies/{companyId}/inbound/{docId} {
      allow get: if docId == "config" && inboundOffice(companyId)
        && (resource == null || resource.data.companyId == companyId);
      allow list: if false;
      allow create: if docId == "config" && inboundMinter(companyId)
        && request.resource.data.keys().hasOnly(["companyId", "address", "localPart", "domain", "createdBy", "createdAt"])
        && request.resource.data.companyId == companyId
        && inboundLocalOk(companyId, request.resource.data.localPart)
        && request.resource.data.domain == "inbound.callupapp.com.au"
        && request.resource.data.address == request.resource.data.localPart + "@inbound.callupapp.com.au"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /companies/{companyId}/inboundMail/{messageId} {
      allow get: if inboundOffice(companyId) && resource.data.companyId == companyId;
      allow list: if inboundOffice(companyId) && resource.data.companyId == companyId;
      allow update: if resource != null
        && inboundOffice(companyId)
        && resource.data.companyId == companyId
        && resource.data.kind == "verification"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["dismissed", "dismissedAt"])
        && request.resource.data.dismissed == true
        && request.resource.data.dismissedAt == request.time;
      allow create, delete: if false;
    }
    match /companies/{companyId}/jobDrafts/{draftId} {
      function draftTextOk(d) {
        return d.client is string && d.client.size() <= 120
          && d.address is string && d.address.size() <= 200
          && d.notes is string && d.notes.size() <= 800
          && d.description is string && d.description.size() <= 800
          && d.po is string && d.po.size() <= 40
          && d.type is string && d.type.size() <= 40
          && (!("date" in d) || d.date == "" || d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && (!("supervisorName" in d) || (d.supervisorName is string && d.supervisorName.size() <= 80))
          && (!("supervisorEmail" in d) || (d.supervisorEmail is string && d.supervisorEmail.size() <= 120))
          && (!("supervisorPhone" in d) || (d.supervisorPhone is string && d.supervisorPhone.size() <= 40));
      }
      allow get: if inboundOffice(companyId) && resource.data.companyId == companyId;
      allow list: if inboundOffice(companyId) && resource.data.companyId == companyId;
      allow update: if resource != null
        && inboundOffice(companyId)
        && resource.data.companyId == companyId
        && request.resource.data.companyId == companyId
        && resource.data.status == "pending"
        && resource.data.source == "inbound-forward"
        && request.resource.data.messageId == resource.data.messageId
        && inboundMoneyFree(request.resource.data)
        && (
          (request.resource.data.status == "pending"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["client", "address", "lot", "street", "suburb", "type", "typeLabel", "costCode", "date", "po", "description", "notes", "supervisorName", "supervisorEmail", "supervisorPhone", "updatedAt"])
            && draftTextOk(request.resource.data))
          || (request.resource.data.status == "approved"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["client", "address", "lot", "street", "suburb", "type", "typeLabel", "costCode", "date", "po", "description", "notes", "supervisorName", "supervisorEmail", "supervisorPhone", "updatedAt", "status", "jobId", "approvedBy", "approvedAt"])
            && draftTextOk(request.resource.data)
            && request.resource.data.get("jobId", "") is string
            && request.resource.data.get("jobId", "").matches('^fwd[A-Za-z0-9]{8,40}$')
            && request.resource.data.approvedBy == request.auth.uid
            && request.resource.data.approvedAt == request.time)
          || (request.resource.data.status == "discarded"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "discardedBy", "discardedAt"])
            && request.resource.data.discardedBy == request.auth.uid
            && request.resource.data.discardedAt == request.time)
        );
      allow create, delete: if false;
    }
    match /inboundRoutes/{localPart} {
      allow read: if false;
      allow create: if signedIn()
        && inboundMinter(request.resource.data.companyId)
        && request.resource.data.keys().hasOnly(["companyId", "address", "createdBy", "createdAt"])
        && inboundLocalOk(request.resource.data.companyId, localPart)
        && request.resource.data.address == localPart + "@inbound.callupapp.com.au"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /inboundSeen/{id} {
      allow read, write: if false;
    }
// END INBOUND FORWARD RULES


    // More shared helpers. Same checks as the copies they replace.

    function lvDate(v) {
            return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
          }

    function lvHalves() {
            return (request.resource.data.startHalf == "" || request.resource.data.startHalf == "am" || request.resource.data.startHalf == "pm")
              && (request.resource.data.endHalf == "" || request.resource.data.endHalf == "am" || request.resource.data.endHalf == "pm")
              && (
                (request.resource.data.start == request.resource.data.end
                  && request.resource.data.startHalf == request.resource.data.endHalf)
                || (request.resource.data.start < request.resource.data.end
                  && (request.resource.data.startHalf == "" || request.resource.data.startHalf == "pm")
                  && (request.resource.data.endHalf == "" || request.resource.data.endHalf == "am"))
              );
          }

    function lvCreateBody(id) {
            return id.matches('^lv[a-z0-9]{16}$')
              && request.resource.data.keys().hasOnly(["uid", "name", "type", "start", "end", "startHalf", "endHalf", "reason", "certificatePath", "certificateName", "status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "createdAt", "updatedAt"])
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.name.size() <= 80
              && (request.resource.data.type == "annual" || request.resource.data.type == "sick" || request.resource.data.type == "other")
              && lvDate(request.resource.data.start)
              && lvDate(request.resource.data.end)
              && request.resource.data.end >= request.resource.data.start
              && lvHalves()
              && request.resource.data.reason is string
              && request.resource.data.reason.size() > 0
              && request.resource.data.reason.size() <= 500
              && lvCertPath(request.auth.uid, id)
              && request.resource.data.certificateName is string
              && request.resource.data.certificateName.size() <= 120
              && (request.resource.data.certificatePath == ""
                ? request.resource.data.certificateName == ""
                : request.resource.data.certificateName.size() > 0)
              && request.resource.data.status == "pending"
              && request.resource.data.decisionNote == ""
              && request.resource.data.decidedBy == ""
              && request.resource.data.decidedByName == ""
              && request.resource.data.decidedAt == null
              && request.resource.data.createdAt == request.time
              && request.resource.data.updatedAt == request.time;
          }

    function chatJobId(threadId) { return threadId[4:threadId.size()]; }

    function chatThreadOk(threadId) {
            return threadId == "staff"
              || (threadId is string && threadId.size() <= 210 && threadId.matches('^job_[A-Za-z0-9_-]{1,200}$'));
          }

    function chatCanAccess(tenantId, threadId) {
            return companyOpen(tenantId) && chatThreadOk(threadId) && (
              threadId == "staff"
                ? chatMember(tenantId)
                : chatCanSeeJob(tenantId, chatJobId(threadId))
            );
          }

    function inviteCallerTenant() {
            return isAlex() || isPatrick()
              ? "heartwood"
              : ((signedIn() && hasProfile()) && "tenantId" in profile() && profile().tenantId is string && profile().tenantId.size() > 0
                ? profile().tenantId
                : ((signedIn() && hasProfile()) ? "heartwood" : ""));
          }

    function inviteFullAdmin() {
            return inviteCallerTenant() == "heartwood"
              ? (isAlex() || isPatrick()
                || (exists(/databases/$(database)/documents/heartwoodAdmins/$(request.auth.uid))
                  && (signedIn() && hasProfile()) && profile().get("role", "") == "admin"))
              : ((signedIn() && hasProfile()) && "role" in profile() && profile().role == "admin");
          }

    function lvHeartwood() {
            return signedIn() && (
              isAlex() || isPatrick() || (
                hasProfile() && (!("tenantId" in profile()) || profile().tenantId == "heartwood")
              )
            );
          }

    // Shared helpers. Each used to be copied into several matches.
    // One copy, same checks. Callers and access are unchanged.
    function rcCreateBody(id) {
            return id.matches('^rc[a-z0-9]{16}$')
              && request.resource.data.keys().hasOnly(["uid", "name", "date", "amountCents", "supplier", "category", "notes", "paidWith", "jobId", "jobLabel", "receiptPath", "receiptName", "status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "paidAt", "createdAt", "updatedAt"])
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.name.size() <= 80
              && request.resource.data.date is string
              && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && request.resource.data.amountCents is int
              && request.resource.data.amountCents > 0
              && request.resource.data.amountCents <= 10000000
              && request.resource.data.supplier is string
              && request.resource.data.supplier.size() > 0
              && request.resource.data.supplier.size() <= 120
              && (request.resource.data.category == "fuel" || request.resource.data.category == "tip-fees" || request.resource.data.category == "parts" || request.resource.data.category == "tools" || request.resource.data.category == "consumables" || request.resource.data.category == "other")
              && request.resource.data.notes is string
              && request.resource.data.notes.size() <= 1000
              && (request.resource.data.paidWith == "personal-card" || request.resource.data.paidWith == "cash")
              && request.resource.data.jobId is string
              && request.resource.data.jobId.matches('^[A-Za-z0-9_-]{0,80}$')
              && request.resource.data.jobLabel is string
              && request.resource.data.jobLabel.size() <= 160
              && rcReceiptPath(request.auth.uid, id)
              && request.resource.data.receiptName is string
              && request.resource.data.receiptName.size() <= 120
              && (request.resource.data.receiptPath == ""
                ? request.resource.data.receiptName == ""
                : request.resource.data.receiptName.size() > 0)
              && request.resource.data.status == "submitted"
              && request.resource.data.decisionNote == ""
              && request.resource.data.decidedBy == ""
              && request.resource.data.decidedByName == ""
              && request.resource.data.decidedAt == null
              && request.resource.data.paidAt == null
              && request.resource.data.createdAt == request.time
              && request.resource.data.updatedAt == request.time;
          }

    function rcReceiptPath(uid, id) {
            return request.resource.data.receiptPath == ""
              || request.resource.data.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.pdf"
              || request.resource.data.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.jpg"
              || request.resource.data.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.png"
              || request.resource.data.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.webp";
          }

    function lvDecisionBody() {
            return resource.data.status == "pending"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "updatedAt"])
              && (request.resource.data.status == "approved" || request.resource.data.status == "declined")
              && request.resource.data.decisionNote is string
              && request.resource.data.decisionNote.size() > 0
              && request.resource.data.decisionNote.size() <= 500
              && request.resource.data.decidedBy == request.auth.uid
              && request.resource.data.decidedByName is string
              && request.resource.data.decidedByName.size() > 0
              && request.resource.data.decidedByName.size() <= 80
              && request.resource.data.decidedAt == request.time
              && request.resource.data.updatedAt == request.time
              && same("uid") && same("name") && same("type") && same("start") && same("end")
              && same("startHalf") && same("endHalf") && same("reason")
              && same("certificatePath") && same("certificateName") && same("createdAt");
          }

    function rcDecisionBody() {
            return rcStep()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "paidAt", "updatedAt", "hubdocStatus"])
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["hubdocStatus"])
                || (request.resource.data.status == "paid"
                  && request.resource.data.hubdocStatus == (resource.data.receiptPath == "" ? "no-receipt" : "queued")))
              && request.resource.data.decisionNote is string
              && request.resource.data.decisionNote.size() <= 500
              && request.resource.data.decidedBy == request.auth.uid
              && request.resource.data.decidedByName is string
              && request.resource.data.decidedByName.size() > 0
              && request.resource.data.decidedByName.size() <= 80
              && request.resource.data.decidedAt == request.time
              && request.resource.data.updatedAt == request.time
              && (request.resource.data.status == "paid"
                ? request.resource.data.paidAt == request.time
                : request.resource.data.paidAt == null);
          }

    function rcStep() {
            return (resource.data.status == "submitted" && (request.resource.data.status == "approved" || request.resource.data.status == "declined" || request.resource.data.status == "paid"))
              || (resource.data.status == "approved" && (request.resource.data.status == "paid" || request.resource.data.status == "declined"));
          }

    function rcHubdoc() {
            return isSync()
              && resource.data.status == "paid"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hubdocStatus", "hubdocAttempts", "hubdocUpdatedAt", "hubdocSentAt", "hubdocMessageId", "hubdocVia", "hubdocError"])
              && request.resource.data.hubdocStatus in ["sending", "sent", "failed", "no-receipt"]
              && request.resource.data.get("hubdocAttempts", 0) is int
              && request.resource.data.get("hubdocError", "") is string
              && request.resource.data.get("hubdocError", "").size() <= 300
              && request.resource.data.get("hubdocMessageId", "") is string
              && request.resource.data.get("hubdocMessageId", "").size() <= 100;
          }

    function lvCertPath(uid, id) {
            return request.resource.data.certificatePath == ""
              || request.resource.data.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.pdf"
              || request.resource.data.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.jpg"
              || request.resource.data.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.png"
              || request.resource.data.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.webp";
          }

    function tsFleetReader(tenantId) {
            return signedIn()
              && tenantId is string
              && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
              && (
                ((isAlex() || isPatrick()) && tenantId == "heartwood")
                || (hasProfile() && (
                  ("tenantId" in profile() && profile().tenantId == tenantId)
                  || (!("tenantId" in profile()) && tenantId == "heartwood")
                ))
              );
          }

    function chatMember(tenantId) {
            return signedIn()
              && tenantId is string
              && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
              && chatCallerTenant() == tenantId;
          }

    function chatCallerTenant() {
            return chatExplicitTenant()
              ? profile().tenantId
              : (((signedIn() && hasProfile()) || isAlex() || isPatrick()) ? "heartwood" : "");
          }

    function chatCanSeeJob(tenantId, jobId) {
            return signedIn()
              && jobId is string
              && jobId.size() > 0
              && jobId.size() <= 200
              && chatJobTenant(jobId) == tenantId
              && ((tenantId == "heartwood" && (isAlex() || isPatrick())) || chatAccountCanSee(tenantId, jobId));
          }

    function chatAccountCanSee(tenantId, jobId) {
            return (signedIn() && hasProfile())
              && chatAccountTenant() == tenantId
              && (("role" in profile() && profile().role == "admin") || chatAssigned(jobId))
              && chatCustomerOk(jobId);
          }

    function chatCustomerOk(jobId) {
            return !(signedIn() && hasProfile())
              || !("customerIds" in profile())
              || !(profile().customerIds is list)
              || profile().customerIds.size() == 0
              || ("client" in chatJob(jobId) && chatJob(jobId).client is string && chatJob(jobId).client in profile().customerIds);
          }

    function chatJob(jobId) { return get(chatJobPath(jobId)).data; }

    function chatJobPath(jobId) { return /databases/$(database)/documents/jobs/$(jobId); }

    function chatAssigned(jobId) {
            return "assigned" in chatJob(jobId) && chatJob(jobId).assigned is list && request.auth.uid in chatJob(jobId).assigned;
          }

    function chatAccountTenant() {
            return chatExplicitTenant() ? profile().tenantId : "heartwood";
          }

    function chatJobTenant(jobId) {
            return "tenantId" in chatJob(jobId) && chatJob(jobId).tenantId is string && chatJob(jobId).tenantId.size() > 0
              ? chatJob(jobId).tenantId
              : "heartwood";
          }

    // Support tickets. The person who raised it can create and read their own.
    // The platform owner (Master) can list, read and close every ticket.
    // Another company, and another person in the same company, cannot read it.
    // No prices are stored here. The screenshot path is empty or this ticket's file.
    match /supportTickets/{ticketId} {
      function ticketOwn() {
        return signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.companyId == callerCompany();
      }
      function ticketCreate() {
        let d = request.resource.data;
        let company = callerCompany();
        return signedIn()
          && ticketId.matches('^[A-Za-z0-9]{16,28}$')
          && company is string && company.size() > 1 && company.size() <= 40
          && d.keys().hasOnly(["subject", "description", "uid", "name", "email", "role", "companyId", "companyName", "appVersion", "swVersion", "userAgent", "page", "createdAt", "status", "screenshotPath"])
          && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 120
          && d.description is string && d.description.size() > 0 && d.description.size() <= 4000
          && d.uid == request.auth.uid
          && d.name is string && d.name.size() <= 80
          && d.email is string && d.email.size() <= 120
          && d.role is string && d.role.size() <= 40
          && d.companyId == company
          && d.companyName is string && d.companyName.size() <= 80
          && d.appVersion is string && d.appVersion.size() <= 80
          && d.swVersion is string && d.swVersion.size() <= 80
          && d.userAgent is string && d.userAgent.size() <= 300
          && d.page is string && d.page.size() <= 200
          && d.createdAt == request.time
          && d.status == "open"
          && d.screenshotPath is string && d.screenshotPath.size() <= 240
          && (d.screenshotPath == "" || d.screenshotPath == "supportTickets/" + company + "/" + request.auth.uid + "/" + ticketId + "/shot.jpg");
      }

      allow create: if ticketCreate();
      allow get, list: if platformOwner() || ticketOwn();
      allow update: if platformOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.status in ["open", "closed"]
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
