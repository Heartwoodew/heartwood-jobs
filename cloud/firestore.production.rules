// Production Firestore rules for heartwood-9f37f.
// Built from cloud/production/live-snapshot-20261108.rules (live ruleset f6f1fb5c).
// Every live match is kept. Company scoping is added beside those allows.
// A missing companyId means heartwood. This file is not deployed by CI.

rules_version = '2';
// Heartwood Jobs.
// ADMINS are a fixed list of Firebase Auth UIDs (Alex + the box sync user + Patrick, full admin since 11/10/2026). No role doc is needed to be admin,
// so there is no bootstrap step. OPERATORS (crew) are people with a users/{uid} doc whose role is "operator" or "labourer" (same access)
// (written by an admin). Operators see only jobs whose `assigned` array contains their uid, and may only change
// status (In progress / Done), site notes (log), loads, completion stamps and photos metadata.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // One trade catalogue. Company create and companyTrades both call these
    // instead of repeating the list. Keep new industries in this list only.
    function tradeIdOk(id) {
      return id is string && id in ["earthworks", "landscaping", "concreting", "fencing", "carpentry", "tiling", "plumbing", "electrical", "concrete-cutting", "cleaning", "property-maintenance", "pest-control", "skip-bins", "pools", "solar-aircon", "traffic-control", "civil-earthworks", "traffic-civil"];
    }
    function tradeSetOk(list, min, max) {
      return list is list && list.size() >= min && list.size() <= max && list.hasOnly(["earthworks", "landscaping", "concreting", "fencing", "carpentry", "tiling", "plumbing", "electrical", "concrete-cutting", "cleaning", "property-maintenance", "pest-control", "skip-bins", "pools", "solar-aircon", "traffic-control", "civil-earthworks", "traffic-civil"]);
    }
    // Heartwood admins: the fixed list (Alex, the box sync user, Patrick) OR an accepted Heartwood admin invite.
    // heartwoodAdmins/{uid} is written by acceptStaffInvite (Admin SDK) or a Heartwood admin, never by the person.
    function isAdmin() { return request.auth != null && (request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "38SU5waAy4f9UI9N6JTqDMaYpQg2", "R7t41e54Ykcdk9WPdVZnDd697iI2"] || heartwoodAdminGrant()); }
    function heartwoodAdminGrant() {
      let grant = /databases/$(database)/documents/heartwoodAdmins/$(request.auth.uid);
      let user = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(grant) && get(grant).data.get("role", "") == "admin"
        && exists(user) && docCompany(get(user).data) == "heartwood" && get(user).data.get("role", "") == "admin";
    }
    function isOwner() { return request.auth != null && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function isSync() { return request.auth != null && request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2"; }
    // Xero (profit figures, Send to Xero queue): explicit allowlist, NOT isAdmin(), so future admins get no Xero access.
    // Keep in step with XERO_UIDS in app.js. Alex + Patrick.
    function isOperator() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["operator", "labourer"];
    }

    function platformOwner() {
      return signedIn()
        && "email_verified" in request.auth.token
        && request.auth.token.email_verified == true
        && "email" in request.auth.token
        && request.auth.token.email == "alex@heartwoodew.com"
        && (("platformOwner" in request.auth.token && request.auth.token.platformOwner == true) || isAlex());
    }
    function docCompany(data) {
      return ("companyId" in data && data.companyId is string && data.companyId.size() > 0)
        ? data.companyId
        : (("tenantId" in data && data.tenantId is string && data.tenantId.size() > 0)
          ? data.tenantId
          : "heartwood");
    }
    // Paused: the trial has ended and the company is not paying, or the platform owner
    // set ownerPaused. One company lookup. Heartwood returns before the lookup.
    // A missing company document is not paused (legacy Heartwood data and tests).
    // ownerPaused is checked first so a test or paying company can still be held.
    // A missing ownerPaused field is not an owner pause. Billing writes use the Admin SDK.
    function companyRecordOpen(data) {
      return data.get("ownerPaused", false) != true
        && (data.get("isTest", false) == true || companyBillingOpen(data));
    }
    function companyBillingOpen(data) {
      let raw = data.get("billing", null);
      let status = raw is map ? raw.get("status", "") : "";
      let plan = data.get("plan", "");
      let trialEnd = data.get("trialEndsAt", null);
      let friendEnd = data.get("friendEndsAt", null);
      let trialOver = trialEnd is timestamp && !(trialEnd > request.time);
      let friendOver = friendEnd is timestamp && !(friendEnd > request.time);
      // Pause only when a trial or friend end is actually in the past. A missing end (older docs) stays open.
      return status == "active" || status == "trialing"
        || (plan == "paid" && status != "past_due" && status != "canceled")
        || (plan == "friend" && !friendOver)
        || (plan != "friend" && plan != "paid" && !trialOver && data.get("status", "active") == "active");
    }
    function companyNotPaused(companyId) {
      let path = /databases/$(database)/documents/companies/$(companyId);
      return !exists(path) || companyRecordOpen(get(path).data);
    }
    function companyOpen(companyId) {
      return companyId == "heartwood" || companyNotPaused(companyId);
    }
    function sessionPath() { return /databases/$(database)/documents/platformSessions/$(request.auth.uid); }
    function sessionCompany() {
      let id = platformOwner() && exists(sessionPath()) ? get(sessionPath()).data.get("companyId", "") : "";
      return id is string && id.size() > 1
        && exists(/databases/$(database)/documents/companies/$(id))
        && get(/databases/$(database)/documents/companies/$(id)).data.isTest == true
        && get(/databases/$(database)/documents/companies/$(id)).data.status == "active"
        ? id : "";
    }
    function callerCompany() {
      let session = sessionCompany();
      return session != "" ? session
        : (isAlex() || isPatrick())
        ? "heartwood"
        : (hasProfile() && "companyId" in profile() && profile().companyId is string && profile().companyId.size() > 0
          ? profile().companyId
          : (hasProfile() && "tenantId" in profile() && profile().tenantId is string && profile().tenantId.size() > 0
            ? profile().tenantId
            : (hasProfile() ? "heartwood" : "")));
    }
    // Referral code, referredBy and reward fields are written by Cloud Functions only.
    // A client cannot set them at create, and cannot add or change a referral after the company exists.
    // Only the platform owner can set or clear an owner pause. Heartwood and the
    // caller's own company are refused. The pause record (who, when) stays on reactivate.

// BEGIN COMPANY RULES
    match /companies/{companyId} {
      function companyIdOk(id) {
        return id is string && id.size() >= 2 && id.size() <= 40 && id.matches('^[a-z0-9][a-z0-9-]{0,39}$');
      }
      // Length only. A state list or postcode regex here pushes company edits over the 1000-expression cap.
      // The app checks the eight state codes and a 4-digit postcode before it writes.
      function addressPartsOk(data) {
        return !("addressParts" in data) || (
          data.addressParts.size() == 4
          && data.addressParts.street.size() > 0 && data.addressParts.street.size() <= 80
          && data.addressParts.suburb.size() > 0 && data.addressParts.suburb.size() <= 40
          && data.addressParts.state.size() == 3
          && data.addressParts.postcode.size() == 4);
      }
      function companyDetailText(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 80
          && data.legalName is string && data.legalName.size() > 0 && data.legalName.size() <= 120
          && data.abn is string && data.abn.size() > 0 && data.abn.size() <= 20
          && data.signoff is string && data.signoff.size() <= 80
          && data.logoUrl is string && data.logoUrl.size() <= 300
          && data.address is string && data.address.size() > 0 && data.address.size() <= 160
          && data.phone is string && data.phone.size() <= 40
          && data.email is string && data.email.size() >= 6 && data.email.size() <= 120
          && data.accountsEmail is string && data.accountsEmail.size() >= 6 && data.accountsEmail.size() <= 120
          && data.hubdocAddress is string && data.hubdocAddress.size() <= 120
          && (data.hubdocAddress == "" || data.hubdocAddress.matches('^[a-z0-9._+-]+@app[.]hubdoc[.]com$'))
          && addressPartsOk(data);
      }
      function companyBillingLocked(data) {
        return data.billing is map
          && data.billing.keys().hasOnly(["provider", "status", "stripeCustomerId", "stripeSubscriptionId"])
          && data.billing.provider == null
          && data.billing.status == "not-configured"
          && data.billing.stripeCustomerId == null
          && data.billing.stripeSubscriptionId == null;
      }
      function oneTradeId(id) {
        // Shared catalogue, one list lookup, so a multi-trade write stays under the expression limit.
        return tradeIdOk(id);
      }
      function tradeFieldOk(data) {
        return !("trade" in data) || oneTradeId(data.trade);
      }
      function tradesListOk(list) {
        return tradeSetOk(list, 1, 18);
      }
      function companyTradesEdit(companyId) {
        return signedIn()
          && companyId == callerCompany()
          && ((isAlex() || isPatrick()) || (hasProfile() && (profile().role == "admin" || profile().role == "manager")))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["trades"])
          && tradesListOk(request.resource.data.trades);
      }
      function referralClientFieldsAbsent(data) {
        return !("referredBy" in data) && !("referralCode" in data) && !("referralReward" in data);
      }
      function referralFieldsSame() {
        return request.resource.data.get("referredBy", null) == resource.data.get("referredBy", null)
          && request.resource.data.get("referralCode", null) == resource.data.get("referralCode", null)
          && request.resource.data.get("referralReward", null) == resource.data.get("referralReward", null);
      }
      function companyOwnerCreate(companyId) {
        let d = request.resource.data;
        return signedIn()
          && !isAlex() && !isPatrick()
          && !hasProfile()
          && companyIdOk(companyId)
          && companyId != "heartwood"
          && d.keys().hasOnly(["name", "legalName", "abn", "signoff", "logoUrl", "address", "addressParts", "phone", "email", "accountsEmail", "hubdocAddress", "ownerUid", "createdBy", "status", "plan", "origin", "isTest", "signedUpAt", "trialEndsAt", "staffCount", "jobCount", "lastActivityAt", "billing", "trade", "trades"])
          && companyDetailText(d) && tradeFieldOk(d) && (!("trades" in d) || tradesListOk(d.trades))
          && d.ownerUid == request.auth.uid
          && d.createdBy == request.auth.uid
          && d.status == "active"
          && d.plan == "trial"
          && d.isTest == false
          && d.origin == "signup"
          && d.signedUpAt == request.time
          && d.trialEndsAt > request.time + duration.value(13, 'd')
          && d.trialEndsAt < request.time + duration.value(15, 'd')
          && d.staffCount == 1
          && d.jobCount == 0
          && d.lastActivityAt == request.time
          && companyBillingLocked(d)
          && referralClientFieldsAbsent(d)
          && !d.keys().hasAny(["platformOwner", "finance"]);
      }
      function companyAdminEdit(companyId) {
        let next = request.resource.data;
        let diff = next.diff(resource.data).affectedKeys();
        return signedIn()
          && companyId == callerCompany()
          && (isAlex() || isPatrick() || (hasProfile() && profile().role == "admin"))
          && diff.hasOnly(["name", "legalName", "abn", "signoff", "logoUrl", "address", "addressParts", "phone", "email", "accountsEmail", "hubdocAddress", "jobPrefix", "accountsName"])
          && companyDetailText(next)
          && (!("jobPrefix" in next) || (next.jobPrefix is string && (next.jobPrefix == "" || next.jobPrefix.matches('^[A-Z0-9]{1,5}$'))))
          && (!("accountsName" in next) || (next.accountsName is string && next.accountsName.size() <= 80))
          && next.status == resource.data.status
          && next.plan == resource.data.plan
          && next.billing == resource.data.billing
          && next.ownerUid == resource.data.ownerUid
          && next.staffCount == resource.data.staffCount
          && next.jobCount == resource.data.jobCount
          && next.origin == resource.data.origin
          && next.get("isTest", false) == resource.data.get("isTest", false)
          && next.get("plan", "trial") == resource.data.get("plan", "trial")
          && next.get("friendEndsAt", null) == resource.data.get("friendEndsAt", null);
      }
      function testCompanyCreate(companyId) {
        let d = request.resource.data;
        return platformOwner()
          && companyIdOk(companyId)
          && companyId != "heartwood"
          && d.keys().hasOnly(["name", "legalName", "abn", "signoff", "logoUrl", "address", "addressParts", "phone", "email", "accountsEmail", "hubdocAddress", "ownerUid", "createdBy", "status", "plan", "origin", "isTest", "demoData", "signedUpAt", "trialEndsAt", "staffCount", "jobCount", "lastActivityAt", "billing", "trade", "trades"])
          && companyDetailText(d) && tradeFieldOk(d) && (!("trades" in d) || tradesListOk(d.trades))
          && d.isTest == true
          && d.plan == "trial"
          && d.origin == "test"
          && d.status == "active"
          && d.demoData is bool
          && d.ownerUid == request.auth.uid
          && d.createdBy == request.auth.uid
          && d.signedUpAt == request.time
          && d.trialEndsAt == null
          && d.lastActivityAt == request.time
          && companyBillingLocked(d)
          && referralClientFieldsAbsent(d)
          && (d.demoData == true ? (d.staffCount == 2 && d.jobCount == 2) : (d.staffCount == 0 && d.jobCount == 0));
      }
      function friendInvitePath(code) { return /databases/$(database)/documents/friendInvites/$(code); }
      function friendCompanyCreate(companyId) {
        let d = request.resource.data;
        return signedIn()
          && !isAlex() && !isPatrick()
          && !hasProfile()
          && companyIdOk(companyId)
          && companyId != "heartwood"
          && d.keys().hasOnly(["name", "legalName", "abn", "signoff", "logoUrl", "address", "addressParts", "phone", "email", "accountsEmail", "hubdocAddress", "ownerUid", "createdBy", "status", "plan", "origin", "isTest", "demoData", "friendInvite", "friendEndsAt", "signedUpAt", "trialEndsAt", "staffCount", "jobCount", "lastActivityAt", "billing", "trade", "trades"])
          && companyDetailText(d) && tradeFieldOk(d) && (!("trades" in d) || tradesListOk(d.trades))
          && d.plan == "friend"
          && d.isTest == false
          && d.demoData == false
          && d.origin == "friend"
          && d.status == "active"
          && d.friendInvite is string
          && d.friendInvite == d.friendInvite
          && exists(friendInvitePath(d.friendInvite))
          && get(friendInvitePath(d.friendInvite)).data.status == "pending"
          && existsAfter(friendInvitePath(d.friendInvite))
          && getAfter(friendInvitePath(d.friendInvite)).data.status == "used"
          && getAfter(friendInvitePath(d.friendInvite)).data.usedBy == request.auth.uid
          && getAfter(friendInvitePath(d.friendInvite)).data.companyId == companyId
          && d.ownerUid == request.auth.uid
          && d.friendEndsAt == null
          && d.trialEndsAt == null
          && d.signedUpAt == request.time
          && d.lastActivityAt == request.time
          && d.staffCount == 1
          && d.jobCount == 0
          && companyBillingLocked(d)
          && referralClientFieldsAbsent(d);
      }
      function ownerPlanEdit(companyId) {
        let next = request.resource.data;
        return platformOwner()
          && resource.data.get("isTest", false) != true
          && next.get("isTest", false) == resource.data.get("isTest", false)
          && next.diff(resource.data).affectedKeys().hasOnly(["plan", "friendEndsAt", "trialEndsAt"])
          && next.plan in ["friend", "trial", "paid"]
          && next.billing == resource.data.billing
          && next.status == resource.data.status
          && (next.friendEndsAt == null || next.friendEndsAt is timestamp)
          && (next.plan != "trial" || (
            next.trialEndsAt > request.time + duration.value(13, 'd')
            && next.trialEndsAt < request.time + duration.value(15, 'd')
          ));
      }
      function testArchive(companyId) {
        let next = request.resource.data;
        return platformOwner()
          && resource.data.isTest == true
          && resource.data.status == "active"
          && next.diff(resource.data).affectedKeys().hasOnly(["status", "archivedAt"])
          && next.status == "archived"
          && next.archivedAt == request.time
          && next.isTest == true
          && next.plan == resource.data.plan
          && next.billing == resource.data.billing;
      }
      function testDemoCounts(companyId) {
        let next = request.resource.data;
        return platformOwner()
          && resource.data.isTest == true
          && resource.data.status == "active"
          && next.diff(resource.data).affectedKeys().hasOnly(["demoData", "staffCount", "jobCount", "lastActivityAt"])
          && next.demoData == true
          && next.staffCount == 2
          && next.jobCount == 2
          && next.lastActivityAt == request.time;
      }
      function companyStatsBump(companyId) {
        let next = request.resource.data;
        return signedIn()
          && companyId == callerCompany()
          && hasProfile()
          && next.diff(resource.data).affectedKeys().hasOnly(["staffCount", "jobCount", "lastActivityAt"])
          && next.staffCount is int && next.jobCount is int
          && next.staffCount >= resource.data.staffCount && next.staffCount <= resource.data.staffCount + 1
          && next.jobCount >= resource.data.jobCount && next.jobCount <= resource.data.jobCount + 1
          && next.lastActivityAt == request.time;
      }
      function profileCompany() {
        return !hasProfile() ? ""
          : (profile().get("companyId", "") is string && profile().get("companyId", "").size() > 0
            ? profile().get("companyId", "")
            : (profile().get("tenantId", "") is string && profile().get("tenantId", "").size() > 0
              ? profile().get("tenantId", "")
              : ""));
      }
      function ownerPauseEdit(companyId) {
        let next = request.resource.data;
        let diff = next.diff(resource.data).affectedKeys();
        return platformOwner()
          && companyId != "heartwood"
          && companyId != profileCompany()
          && companyIdOk(companyId)
          && next.billing == resource.data.billing
          && next.plan == resource.data.plan
          && next.status == resource.data.status
          && next.get("isTest", false) == resource.data.get("isTest", false)
          && (
            (diff.hasOnly(["ownerPaused", "ownerPausedAt", "ownerPausedBy"])
              && next.ownerPaused == true
              && next.ownerPausedBy == request.auth.uid
              && next.ownerPausedAt == request.time)
            || (resource.data.get("ownerPaused", false) == true
              && diff.hasOnly(["ownerPaused", "ownerReactivatedAt", "ownerReactivatedBy"])
              && next.ownerPaused == false
              && next.ownerReactivatedBy == request.auth.uid
              && next.ownerReactivatedAt == request.time
              && next.get("ownerPausedBy", "") == resource.data.get("ownerPausedBy", "")
              && next.get("ownerPausedAt", null) == resource.data.get("ownerPausedAt", null))
          );
      }

      allow get: if platformOwner() || (signedIn() && callerCompany() == companyId);
      allow list: if platformOwner();
      // Box sync account (Hubdoc filer, receipts worker) reads each company's Hubdoc address and test flag.
      allow read: if isSync();
      allow create: if companyOwnerCreate(companyId) || testCompanyCreate(companyId) || friendCompanyCreate(companyId);
      allow update: if referralFieldsSame() && (companyTradesEdit(companyId) || ownerPlanEdit(companyId) || testArchive(companyId) || testDemoCounts(companyId) || companyAdminEdit(companyId) || companyStatsBump(companyId) || ownerPauseEdit(companyId));
      allow delete: if false;
    }
// END COMPANY RULES

// BEGIN AUTOFILL RULES
    // Emails this company has already sent a job to. Office only (admin, manager, supervisor,
    // plus Alex and Patrick at Heartwood). Crew cannot read it: it can name people on jobs
    // they are not assigned to. No price fields. No list, no delete.
    match /companies/{companyId}/autofill/{docId} {
      function autofillOffice(companyId) {
        return signedIn()
          && companyId == callerCompany()
          && companyOpen(companyId)
          && (
            (companyId == "heartwood" && (isAlex() || isPatrick()))
            || (hasProfile() && profile().get("role", "") in ["admin", "supervisor", "manager"])
          );
      }
      function autofillDocOk(companyId) {
        let d = request.resource.data;
        return d.keys().hasOnly(["companyId", "emails", "updatedAt", "updatedBy"])
          && d.companyId == companyId
          && d.emails is list
          && d.emails.size() <= 40
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
      }

      allow get: if docId == "recipients" && autofillOffice(companyId) && (resource == null || resource.data.companyId == companyId);
      allow list: if false;
      allow create, update: if docId == "recipients" && autofillOffice(companyId) && autofillDocOk(companyId);
      allow delete: if false;
    }
// END AUTOFILL RULES

    // Deletion audit. Written by deleteCompanyAccount (Admin SDK). Kept outside the company
    // that was deleted. Clients cannot write or delete it.
    match /companyDeletions/{companyId} {
      allow read: if platformOwner();
      allow create, update, delete: if false;
    }

    // Referral lookup, reward state and audit. Cloud Functions use the Admin SDK.
    // Clients cannot read or write these, so a reward cannot be granted from the browser.
    match /referralCodes/{code} {
      allow read, write: if false;
    }
    match /referrals/{referredCompanyId} {
      allow read, write: if false;
    }
    match /referralAudits/{id} {
      allow read, write: if false;
    }
    match /referralLocks/{companyId} {
      allow read, write: if false;
    }

    match /platformSessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if platformOwner() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["companyId"])
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() <= 40
        && (request.resource.data.companyId == ""
          || (exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
            && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.isTest == true
            && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.status == "active"));
      allow delete: if false;
    }

    match /friendInvites/{code} {
      function friendCodeOk(code) { return code.matches('^[a-z0-9]{8}$'); }

      allow get: if platformOwner()
        || (signedIn() && resource.data.status == "pending")
        || (signedIn() && resource.data.usedBy == request.auth.uid);
      allow list: if platformOwner();
      allow create: if platformOwner()
        && friendCodeOk(code)
        && request.resource.data.keys().hasOnly(["status", "createdBy", "createdAt", "note"])
        && request.resource.data.status == "pending"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 80;
      allow update: if (
          platformOwner()
          && resource.data.status == "pending"
          && request.resource.data.status == "revoked"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "revokedAt"])
          && request.resource.data.revokedAt == request.time
        ) || (
          signedIn()
          && resource.data.status == "pending"
          && request.resource.data.status == "used"
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.companyId is string
          && request.resource.data.usedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "usedBy", "companyId", "usedAt"])
          && existsAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
          && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.plan == "friend"
          && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.friendInvite == code
        );
      allow delete: if false;
    }

    match /testMailLog/{id} {
      allow read: if platformOwner();
      allow create: if platformOwner()
        && sessionCompany() != ""
        && request.resource.data.keys().hasOnly(["kind", "status", "companyId", "preview", "createdAt"])
        && request.resource.data.kind in ["hours", "hubdoc", "xero", "builder"]
        && request.resource.data.status == "preview"
        && request.resource.data.companyId == sessionCompany()
        && request.resource.data.preview is string
        && request.resource.data.preview.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }


    function companyOffice() {
      let id = callerCompany();
      return id != "" && id != "heartwood" && hasProfile()
        && (profile().role == "admin" || profile().role == "supervisor" || profile().role == "manager")
        && companyNotPaused(id);
    }
    function heartwoodManager() {
      return signedIn() && hasProfile() && profile().get("role", "") == "manager" && callerCompany() == "heartwood";
    }
    // Capacity: Heartwood supervisors and managers can read Heartwood jobs. They do not gain job writes.
    function companyStaff() {
      let id = callerCompany();
      return id != "" && id != "heartwood" && hasProfile() && companyNotPaused(id);
    }
    // Quote revisions. One user read, no callerCompany(), so it stays under the rules expression limit.


    // Quote extra items / guided price overrides / picked Google place (Nov 2026): optional, size-capped.
    // Shape only; the app cleans each item. Quotes stay office-only (staff never read them).
    // One profile read for a quote write. Calling isAdmin / callerCompany / companyOffice
    // on every branch re-ran the platform-owner email check and blew the 1000-expression limit,
    // including for a verified admin. Crew (operator / labourer) are not office.
    // Admin and manager may change guided prices. A supervisor must leave priceOverrides as they were.
    match /quotes/{id} {
      function quoteFieldsOk(d) {
        return d.get("extraItems", []) is list && d.get("extraItems", []).size() <= 40
          && d.get("priceOverrides", {}) is map && d.get("priceOverrides", {}).size() <= 20
          && (d.get("addressPlace", null) == null || (d.addressPlace is map
            && d.addressPlace.keys().hasOnly(["formattedAddress", "lat", "lng", "placeId", "source"])
            && d.addressPlace.lat is number && d.addressPlace.lng is number));
      }
      function quoteActor() {
        let user = /databases/$(database)/documents/users/$(request.auth.uid);
        let has = signedIn() && exists(user);
        let data = has ? get(user).data : null;
        let role = data != null ? data.get("role", "") : "";
        let companyId = data != null ? data.get("companyId", "") : "";
        let tenantId = data != null ? data.get("tenantId", "") : "";
        let bootstrap = signedIn() && request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "38SU5waAy4f9UI9N6JTqDMaYpQg2", "R7t41e54Ykcdk9WPdVZnDd697iI2"];
        let company = bootstrap ? "heartwood"
          : (companyId is string && companyId.size() > 0 ? companyId
            : (tenantId is string && tenantId.size() > 0 ? tenantId : (has ? "heartwood" : "")));
        let grant = /databases/$(database)/documents/heartwoodAdmins/$(request.auth.uid);
        let granted = !bootstrap && has && exists(grant) && get(grant).data.get("role", "") == "admin" && role == "admin" && company == "heartwood";
        return { "listed": bootstrap || granted, "role": role, "company": company, "ok": signedIn() };
      }
      function quoteCompanyOf(data) {
        let id = data.get("companyId", "");
        let tenant = data.get("tenantId", "");
        return (id is string && id.size() > 0) ? id : ((tenant is string && tenant.size() > 0) ? tenant : "heartwood");
      }
      function quoteOffice(actor, company) {
        return actor.ok && company is string && (
          (actor.listed && company == "heartwood")
          || (actor.company == company && company == "heartwood" && actor.role in ["manager", "supervisor"])
          || (actor.company == company && company != "heartwood" && company != "" && actor.role in ["admin", "manager", "supervisor"] && companyNotPaused(company))
        );
      }
      function quotePricesOk(actor, next, before) {
        return actor.listed || actor.role == "admin" || actor.role == "manager" || next.get("priceOverrides", {}) == before;
      }
      function quoteGetOk() {
        let actor = quoteActor();
        return quoteOffice(actor, quoteCompanyOf(resource.data));
      }
      function quoteListOk() {
        let actor = quoteActor();
        let company = resource.data.companyId;
        return company is string && quoteOffice(actor, company);
      }
      function quoteCreateOk() {
        let actor = quoteActor();
        let data = request.resource.data;
        let company = quoteCompanyOf(data);
        return quoteFieldsOk(data) && quoteOffice(actor, company) && quotePricesOk(actor, data, {});
      }
      function quoteUpdateOk() {
        let actor = quoteActor();
        let next = request.resource.data;
        let company = quoteCompanyOf(resource.data);
        return resource.data.get("quoteStatus", "") != "Accepted"
          && quoteFieldsOk(next)
          && quoteOffice(actor, company)
          && quoteCompanyOf(next) == company
          && quotePricesOk(actor, next, resource.data.get("priceOverrides", {}));
      }

      allow get: if quoteGetOk();
      allow list: if quoteListOk();
      allow create: if quoteCreateOk();
      // Accepted quotes stay as they were. Accepting is this update, while the quote is still a draft.
      allow update: if quoteUpdateOk();
      allow delete: if false;

      // Numbered quote revisions. Same company, supervisor and above. Create only.
      match /revisions/{revId} {
        function revisionStaff(companyId) {
          let path = /databases/$(database)/documents/users/$(request.auth.uid);
          return signedIn() && companyId is string && (companyId == "heartwood" || companyNotPaused(companyId)) && (
            (request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "38SU5waAy4f9UI9N6JTqDMaYpQg2", "R7t41e54Ykcdk9WPdVZnDd697iI2"] && companyId == "heartwood")
            || (exists(path)
              && (get(path).data.get("role", "") in ["supervisor", "manager", "admin"])
              && get(path).data.get("companyId", "heartwood") == companyId)
          );
        }

        allow get: if revisionStaff(resource.data.get("companyId", "heartwood"));
        allow list: if revisionStaff(resource.data.companyId);
        allow create: if revId.matches('^r[0-9]{3}$')
          && revisionStaff(request.resource.data.companyId)
          && request.resource.data.keys().hasOnly(["revision", "quoteId", "companyId", "createdBy", "createdByName", "createdAt", "createdAtIso", "lines", "extraItems", "priceOverrides", "totalEx", "gst", "totalInc", "changes"])
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1
          && request.resource.data.revision <= 999
          && request.resource.data.quoteId == id
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByName is string
          && request.resource.data.createdByName.size() > 0
          && request.resource.data.createdByName.size() <= 80
          && request.resource.data.createdAt == request.time
          && request.resource.data.lines is list
          && request.resource.data.lines.size() <= 80
          && request.resource.data.extraItems is list
          && request.resource.data.extraItems.size() <= 40
          && request.resource.data.priceOverrides is map
          && request.resource.data.priceOverrides.size() <= 20
          && request.resource.data.changes is list
          && request.resource.data.changes.size() <= 80
          && exists(/databases/$(database)/documents/quotes/$(id))
          && get(/databases/$(database)/documents/quotes/$(id)).data.get("quoteStatus", "Draft") != "Accepted"
          && get(/databases/$(database)/documents/quotes/$(id)).data.get("companyId", "heartwood") == request.resource.data.companyId;
        allow update, delete: if false;
      }
    }


    // Master page: a test company (isTest) that the verified platform owner may manage demo staff in.
    // Heartwood admin grants (12 Nov 2026). Created by acceptStaffInvite for an accepted Heartwood admin invite, or by a
    // Heartwood admin. Nobody grants themselves; supervisors and crew can't write here.
    match /heartwoodAdmins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(["uid", "role", "companyId", "inviteId", "grantedBy", "grantedAt"])
        && request.resource.data.uid == uid
        && request.resource.data.role == "admin"
        && request.resource.data.companyId == "heartwood"
        && request.resource.data.grantedBy == request.auth.uid
        && request.resource.data.grantedAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && request.auth.uid != uid;
    }
    match /users/{uid} {
      function companyIdOk(id) {
        return id is string && id.size() >= 2 && id.size() <= 40 && id.matches('^[a-z0-9][a-z0-9-]{0,39}$');
      }
      function ownerProfileCreate() {
        let d = request.resource.data;
        // jobTitle/jobTitleId: the signup screen labels the owner "Admin" under their first trade (PR 71).
        return d.keys().hasOnly(["name", "email", "role", "companyId", "tenantId", "jobTitle", "jobTitleId"])
          && d.role == "admin"
          && d.get("jobTitle", "Admin") == "Admin"
          && d.get("jobTitleId", "earthworks:admin").matches('^(earthworks|landscaping|concreting|fencing|carpentry|tiling|plumbing|electrical|concrete-cutting|cleaning|property-maintenance|pest-control|skip-bins|pools|solar-aircon|traffic-control|civil-earthworks):admin$')
          && companyIdOk(d.companyId)
          && d.companyId != "heartwood"
          && d.tenantId == d.companyId
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.email is string && d.email.size() <= 120
          && exists(/databases/$(database)/documents/companies/$(d.companyId))
          && get(/databases/$(database)/documents/companies/$(d.companyId)).data.ownerUid == request.auth.uid
          && !d.keys().hasAny(["platformOwner", "finance", "customerIds"]);
      }
      function testCompanyId(id) {
        return id != "heartwood" && exists(/databases/$(database)/documents/companies/$(id))
          && get(/databases/$(database)/documents/companies/$(id)).data.get("isTest", false) == true;
      }
      function skillItem(list, i) {
        return i >= list.size() || (list[i] is string && list[i].size() > 0 && list[i].size() <= 40 && !list[i].matches('.*[\\n\\r\\t<>].*'));
      }
      function skillsOk(list) {
        return list is list && list.size() <= 12
          && skillItem(list, 0) && skillItem(list, 1) && skillItem(list, 2) && skillItem(list, 3)
          && skillItem(list, 4) && skillItem(list, 5) && skillItem(list, 6) && skillItem(list, 7)
          && skillItem(list, 8) && skillItem(list, 9) && skillItem(list, 10) && skillItem(list, 11);
      }
      function staffEditOk(uid) {
        return signedIn() && request.auth.uid != uid && hasProfile()
          && (profile().get("role", "") == "admin" || (profile().get("role", "") == "manager" && resource.data.get("role", "") != "admin"))
          && callerCompany() != ""
          && docCompany(resource.data) == callerCompany()
          && docCompany(request.resource.data) == callerCompany()
          && request.resource.data.get("role", "") == resource.data.get("role", "")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["jobTitle", "jobTitleId", "skills"])
          && request.resource.data.get("jobTitle", "") is string
          && request.resource.data.get("jobTitle", "").size() <= 80
          && request.resource.data.get("jobTitleId", "") is string
          && request.resource.data.get("jobTitleId", "").size() <= 60
          && (!request.resource.data.keys().hasAny(["skills"]) || skillsOk(request.resource.data.skills));
      }

      // Everyone reads their own profile.
      allow get: if signedIn() && request.auth.uid == uid;
      // Skill and licence tags are informational. The person can change only that list.
      allow update: if signedIn() && request.auth.uid == uid
        && companyOpen(docCompany(resource.data))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["skills"])
        && skillsOk(request.resource.data.skills);
      // Admin or manager sets the job title and permission level, up to their own level. Not an admin, unless the editor is an admin.
      allow update: if staffEditOk(uid);
      // Box sync account (routines, staff sync) keeps full access.
      allow read, write: if isSync();
      // Heartwood admins (Alex, Patrick): Heartwood profiles only. A profile with no companyId/tenantId is Heartwood.
      allow get: if isAdmin() && docCompany(resource.data) == "heartwood";
      allow list: if isAdmin() && resource.data.companyId == "heartwood";
      allow get: if heartwoodManager() && docCompany(resource.data) == "heartwood";
      allow list: if heartwoodManager() && resource.data.companyId == "heartwood";
      allow create: if isAdmin() && docCompany(request.resource.data) == "heartwood";
      allow update: if isAdmin() && docCompany(resource.data) == "heartwood" && docCompany(request.resource.data) == "heartwood";
      allow delete: if isAdmin() && docCompany(resource.data) == "heartwood";
      // Platform owner (Alex, verified email): TEST companies only (open-as-test session, demo staff reset).
      allow get, delete: if platformOwner() && testCompanyId(docCompany(resource.data));
      allow list: if platformOwner() && sessionCompany() != "" && resource.data.companyId == sessionCompany();
      allow create: if platformOwner() && testCompanyId(docCompany(request.resource.data));
      allow update: if platformOwner() && testCompanyId(docCompany(resource.data)) && docCompany(request.resource.data) == docCompany(resource.data);
      // CallUp self-signup: the new owner writes their own admin profile for the company they just created.
      allow create: if signedIn() && request.auth.uid == uid && ownerProfileCreate();
      // Company admins and supervisors (not Heartwood, which uses isAdmin above) read their own company's staff.
      allow get: if companyOffice() && docCompany(resource.data) == callerCompany();
      allow list: if companyOffice() && resource.data.companyId == callerCompany();
    }

    // Job money (Nov 2026 round 3, Q6). Assigned crew read the whole job document and keep it in their phone's
    // offline cache, so app writers may not put the PO value, the accepted-quote total, Find PO suggestions
    // (poLookupCandidates, they carry PO amounts) or quote prices on a job.
    // Removing a legacy copy is allowed. The box (isSync) still writes poAmount for Find PO / ServiceM8 until its
    // workers move to jobMoney; cloud/scripts/migrate-job-money.mjs moves existing amounts.
    // invoiceAmount and xeroCheck (12 Nov 2026): the invoice price and the Xero match (totalEx, amountDue) are office only too.
    // Even the box (isSync) may not add or change them on a job (tools/export_completed.py and tools/xero_queue.py write them
    // to jobMoney); cloud/scripts/migrate-office-money.mjs moves old values.
    match /jobs/{jobId} {
      function xeroUser() { return request.auth != null && request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "R7t41e54Ykcdk9WPdVZnDd697iI2"]; }
      function isAssigned(d) { return request.auth.uid in d.assigned; }
      function heartwoodOfficeRead() {
        // Same people as supervisor, manager or admin of Heartwood. Role first, one company lookup, to stay under the expression limit.
        return signedIn() && hasProfile() && (profile().get("role", "") in ["supervisor", "manager", "admin"])
          && callerCompany() == "heartwood";
      }
      function syncDeniedJobKeys() { return ["invoiceAmount", "xeroCheck"]; }
      function jobMoneyKeys() { return ["poAmount", "poAmountBasis", "poAmountSource", "quoteAmount", "poLookupCandidates", "invoiceAmount", "xeroCheck"]; }
      function syncJobCreateOk() { return !request.resource.data.keys().hasAny(syncDeniedJobKeys()); }
      function syncJobUpdateOk() {
        let df = request.resource.data.diff(resource.data);
        return !df.addedKeys().hasAny(syncDeniedJobKeys()) && !df.changedKeys().hasAny(syncDeniedJobKeys());
      }
      function quotePriceKeys() { return ["totalEx", "gst", "totalInc", "lines", "priceOverrides", "ratesSnapshot"]; }
      function jobQuoteNoPrices(d) { return !(d.get("quote", null) is map) || !d.quote.keys().hasAny(quotePriceKeys()); }
      function jobMoneyFreeCreate() {
        return !request.resource.data.keys().hasAny(jobMoneyKeys()) && jobQuoteNoPrices(request.resource.data);
      }
      function jobMoneyFreeUpdate() {
        let df = request.resource.data.diff(resource.data);
        return !df.addedKeys().hasAny(jobMoneyKeys()) && !df.changedKeys().hasAny(jobMoneyKeys())
          && (!df.affectedKeys().hasAny(["quote"]) || jobQuoteNoPrices(request.resource.data));
      }

      allow read: if isSync() || (signedIn() && isAssigned(resource.data) && isOperator() && (resource.data.get("companyId", "heartwood") == "heartwood" || companyNotPaused(resource.data.get("companyId", ""))));
      allow get: if isAdmin() && docCompany(resource.data) == "heartwood";
      allow list: if isAdmin() && resource.data.companyId == "heartwood";
      // Managers (crew map) and supervisors (capacity) read Heartwood jobs through heartwoodOfficeRead() below.
      // One rule for both keeps the job get under the 1000-expression limit. Read only, no writes.
      allow get: if companyOffice() && docCompany(resource.data) == callerCompany();
      allow get: if companyStaff() && docCompany(resource.data) == callerCompany() && isAssigned(resource.data);
      allow list: if companyOffice() && resource.data.companyId == callerCompany();
      allow get: if heartwoodOfficeRead() && docCompany(resource.data) == "heartwood";
      allow list: if heartwoodOfficeRead() && resource.data.companyId == "heartwood";
      allow list: if companyStaff() && resource.data.companyId == callerCompany() && request.auth.uid in resource.data.assigned;
      allow create: if companyOffice() && request.resource.data.companyId == callerCompany() && jobMoneyFreeCreate();
      allow update: if companyOffice()
        && resource.data.get("companyId", "") == callerCompany()
        && request.resource.data.get("companyId", "") == callerCompany()
        && jobMoneyFreeUpdate();
      allow create: if (isSync() && syncJobCreateOk()) || (isAdmin() && docCompany(request.resource.data) == "heartwood" && jobMoneyFreeCreate());
      allow delete: if isSync() || (isAdmin() && docCompany(resource.data) == "heartwood");
      // Master page: Alex adds demo jobs to a test company only.
      allow create: if platformOwner() && request.resource.data.get("demo", false) == true
        && jobMoneyFreeCreate()
        && docCompany(request.resource.data) != "heartwood"
        && get(/databases/$(database)/documents/companies/$(docCompany(request.resource.data))).data.get("isTest", false) == true;
      allow update: if (isAdmin() && ((isSync() && syncJobUpdateOk()) || (docCompany(resource.data) == "heartwood" && docCompany(request.resource.data) == "heartwood"
          && jobMoneyFreeUpdate()))
        && (xeroUser() || isSync() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ["xeroStatus", "xeroInvoiceId", "xeroInvoiceNo", "xeroError", "xeroQueuedAt"]))) || (
        signedIn() && isAssigned(resource.data) && isOperator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ["status", "log", "loads", "startedAt", "completedAt", "completedBy", "completedByName",
              "photos", "photosEmailedAt", "photosEmailedCount", "updatedAt", "updatedBy"])
        && request.resource.data.status in ["Scheduled", "In progress", "Done"]
        && request.resource.data.updatedBy == request.auth.uid
        && (!("completedBy" in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.completedBy == request.auth.uid)
        && (!("log" in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.log is list && request.resource.data.log.size() <= 200
                && request.resource.data.log.size() >= resource.data.get("log", []).size()))
      );
    }

// BEGIN JOB DOCUMENT RULES
    // Job files (plans, quotes, invoices, drawings). Metadata only; the bytes live in Storage.
    // One profile read (none for Alex or Patrick) and one job read. companyNotPaused runs once,
    // and never for Heartwood, so a verified email stays under the 1000-expression limit.
    // Office is admin, manager and supervisor (same people who read quotes). Crew is operator
    // or labourer, and only when they are on the job's assigned list. Office-only files are
    // hidden from crew. A paused company cannot read or write. A missing company is not paused.
    match /jobs/{jobId}/documents/{docId} {
      function documentActor() {
        let bootstrap = signedIn() && request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "R7t41e54Ykcdk9WPdVZnDd697iI2"];
        let user = /databases/$(database)/documents/users/$(request.auth.uid);
        let has = signedIn() && !bootstrap && exists(user);
        let data = has ? get(user).data : null;
        let role = data != null ? data.get("role", "") : "";
        let companyId = data != null ? data.get("companyId", "") : "";
        let tenantId = data != null ? data.get("tenantId", "") : "";
        let company = bootstrap ? "heartwood"
          : (companyId is string && companyId.size() > 0 ? companyId
            : (tenantId is string && tenantId.size() > 0 ? tenantId : (has ? "heartwood" : "")));
        return { "role": role, "company": company, "ok": signedIn() && (bootstrap || has) };
      }
      function documentGate(jobId) {
        let actor = documentActor();
        let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
        let companyId = job.get("companyId", "");
        let tenantId = job.get("tenantId", "");
        let company = (companyId is string && companyId.size() > 0) ? companyId
          : ((tenantId is string && tenantId.size() > 0) ? tenantId : "heartwood");
        let assigned = job.get("assigned", []) is list && request.auth.uid in job.get("assigned", []);
        let open = company == "heartwood" || companyNotPaused(company);
        let same = actor.ok && actor.company == company && open;
        let office = same && (
          actor.role in ["admin", "manager", "supervisor"]
          || (company == "heartwood" && request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "R7t41e54Ykcdk9WPdVZnDd697iI2"])
        );
        let crew = same && assigned && actor.role in ["operator", "labourer"];
        return { "office": office, "crew": crew, "company": company };
      }
      function documentShape(d, jobId, docId) {
        return docId.matches('^d[A-Za-z0-9]{8,40}$')
          && d.keys().hasOnly(["companyId", "tenantId", "jobId", "name", "fileName", "contentType", "size", "visibility", "storagePath", "uploaderUid", "uploaderName", "createdAt", "updatedAt"])
          && d.companyId is string && d.tenantId == d.companyId && d.jobId == jobId
          && d.name is string && d.name.size() > 0 && d.name.size() <= 160
          && d.fileName is string && d.fileName.size() > 0 && d.fileName.size() <= 200
          && d.contentType is string && d.contentType.size() > 0 && d.contentType.size() <= 160
          && d.size is number && d.size > 0 && d.size <= 25 * 1024 * 1024
          && d.visibility in ["crew", "office"]
          && d.storagePath == "tenants/" + d.companyId + "/jobs/" + jobId + "/documents/" + docId
          && d.uploaderUid == request.auth.uid
          && d.uploaderName is string && d.uploaderName.size() > 0 && d.uploaderName.size() <= 80
          && d.createdAt == request.time
          && d.updatedAt == request.time;
      }
      function documentCreate(jobId, docId) {
        let gate = documentGate(jobId);
        let d = request.resource.data;
        return gate.office && d.companyId == gate.company && documentShape(d, jobId, docId);
      }
      function documentOffice(jobId) {
        return documentGate(jobId).office;
      }
      function documentCrew(jobId) {
        let gate = documentGate(jobId);
        return gate.crew && resource.data.visibility == "crew";
      }
      function documentRename(jobId) {
        let gate = documentGate(jobId);
        let next = request.resource.data;
        let prev = resource.data;
        return gate.office
          && prev.get("companyId", "") == gate.company
          && next.diff(prev).affectedKeys().hasOnly(["name", "updatedAt"])
          && next.name is string && next.name.size() > 0 && next.name.size() <= 160
          && next.updatedAt == request.time;
      }
      function documentRemove(jobId) {
        let gate = documentGate(jobId);
        return gate.office && resource.data.get("companyId", "") == gate.company;
      }

      allow get: if documentOffice(jobId);
      allow list: if documentOffice(jobId);
      allow get: if documentCrew(jobId);
      allow list: if documentCrew(jobId);
      allow create: if documentCreate(jobId, docId);
      allow update: if documentRename(jobId);
      allow delete: if documentRemove(jobId);
    }
// END JOB DOCUMENT RULES

    // Job money: office only. Heartwood admins (Alex, Patrick, the box) for Heartwood jobs; company admins and
    // supervisors (who already read quotes) for their own company. Crew (operators, staff) never read it.
    match /jobMoney/{jobId} {
      function jobMoneyOk(d, jobId) {
        return d.keys().hasOnly(["jobId", "companyId", "tenantId", "poAmount", "poAmountBasis", "poAmountSource", "quoteAmount",
            "splitUndoPoAmount", "poLookupCandidates", "invoiceAmount", "xeroCheck", "migratedAt", "updatedAt", "updatedBy"])
          && (d.get("poLookupCandidates", null) == null || (d.poLookupCandidates is list && d.poLookupCandidates.size() <= 50))
          && d.jobId == jobId
          && (d.get("poAmount", null) == null || d.poAmount is number)
          && (d.get("quoteAmount", null) == null || d.quoteAmount is number)
          && (d.get("invoiceAmount", null) == null || d.invoiceAmount is number)
          && (d.get("xeroCheck", null) == null || d.xeroCheck is map)
          && (d.get("splitUndoPoAmount", null) == null || d.splitUndoPoAmount is number);
      }

      // A missing doc (a job with no money yet) reads as "not found" for the office, so the Find PO listener stays alive. Crew still fail.
      allow read, write: if isSync();
      allow get: if isAdmin() && (resource == null || docCompany(resource.data) == "heartwood");
      allow get: if heartwoodManager() && (resource == null || docCompany(resource.data) == "heartwood");
      allow list: if isAdmin() && resource.data.companyId == "heartwood";
      allow list: if heartwoodManager() && resource.data.companyId == "heartwood";
      allow create: if isAdmin() && docCompany(request.resource.data) == "heartwood" && jobMoneyOk(request.resource.data, jobId);
      allow create: if heartwoodManager() && docCompany(request.resource.data) == "heartwood" && jobMoneyOk(request.resource.data, jobId);
      allow update: if isAdmin() && docCompany(resource.data) == "heartwood" && docCompany(request.resource.data) == "heartwood"
        && jobMoneyOk(request.resource.data, jobId);
      allow update: if heartwoodManager() && docCompany(resource.data) == "heartwood" && docCompany(request.resource.data) == "heartwood"
        && jobMoneyOk(request.resource.data, jobId);
      allow get: if companyOffice() && (resource == null || docCompany(resource.data) == callerCompany());
      allow list: if companyOffice() && resource.data.companyId == callerCompany();
      allow create: if companyOffice() && request.resource.data.companyId == callerCompany() && jobMoneyOk(request.resource.data, jobId);
      allow update: if companyOffice() && resource.data.get("companyId", "") == callerCompany()
        && request.resource.data.get("companyId", "") == callerCompany() && jobMoneyOk(request.resource.data, jobId);
      allow delete: if false;
    }

    // Invoicing counters (invoice numbers). Admins only; operators can neither read nor write.
    match /meta/{docId} {
      allow read, write: if isAdmin() && docId != "profitHistory";
      allow get: if heartwoodManager() && docId == "quoteRates";
      allow create, update: if heartwoodManager() && docId == "quoteRates";
    }
    // Per-company settings for companies other than Heartwood (Heartwood keeps meta/quoteRates and meta/supervisors).
    // {companyId}_quoteRates: office reads, company admins write. {companyId}_supervisors: office reads and writes.
    // Dispatch day start, day finish, travel gap and per-type hours. Each default is at least 1 hour.
    // Heartwood keeps this on meta/dispatchTimes (admins already write meta). Other companies use companyMeta.
    match /companyMeta/{docId} {
      function cmRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "");
      }
      function dispatchDurOk(m, k) {
        return !m.keys().hasAny([k]) || (m[k] is number && m[k] >= 1 && m[k] <= 24);
      }
      function dispatchDurationsOk(m) {
        return m is map && m.size() <= 8
          && m.keys().hasOnly(["spoil", "backslab", "roof-clean", "scaffold-clean", "final-clean", "site-clean", "waterproof", "other"])
          && dispatchDurOk(m, "spoil") && dispatchDurOk(m, "backslab") && dispatchDurOk(m, "roof-clean")
          && dispatchDurOk(m, "scaffold-clean") && dispatchDurOk(m, "final-clean") && dispatchDurOk(m, "site-clean")
          && dispatchDurOk(m, "waterproof") && dispatchDurOk(m, "other");
      }
      function dispatchMetaOk(d) {
        return d.keys().hasOnly(["companyId", "dayStart", "dayEnd", "travelGapMin", "durations", "updatedAt", "updatedBy"])
          && d.dayStart is string
          && d.dayStart.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && (!("dayEnd" in d) || (d.dayEnd is string && d.dayEnd.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
          && d.travelGapMin is number && d.travelGapMin >= 0 && d.travelGapMin <= 180
          && dispatchDurationsOk(d.durations)
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
      }
      function cmGetOk(docId) {
        let c = incProfileCompany();
        return signedIn() && c != "heartwood" && cmRole() in ["admin", "supervisor", "manager"]
          && docId in [c + "_quoteRates", c + "_supervisors", c + "_invoicing", c + "_dispatch"];
      }
      function cmWriteOk(docId) {
        let c = incProfileCompany();
        let role = cmRole();
        return signedIn() && c != "heartwood" && request.resource.data.get("companyId", "") == c
          && ((docId == c + "_supervisors" && role in ["admin", "supervisor", "manager"])
            || (docId == c + "_quoteRates" && role in ["admin", "manager"])
            || (docId == c + "_invoicing" && role == "admin")
            || (docId == c + "_dispatch" && role in ["admin", "manager"] && dispatchMetaOk(request.resource.data)));
      }

      allow get: if cmGetOk(docId);
      allow create, update: if cmWriteOk(docId);
      allow delete: if false;
    }
    match /companyTrades/{companyId} {
      function oneTradeId(id) {
        return tradeIdOk(id);
      }
      function tradeFieldOk(data) {
        return !("trade" in data) || oneTradeId(data.trade);
      }
      function tradesListOk(list) {
        return tradeSetOk(list, 1, 18);
      }
      function tradeDocOk(companyId) {
        let d = request.resource.data;
        return d.keys().hasOnly(["companyId", "trade", "trades", "extraTrades", "titles", "checklists", "photoSteps", "updatedBy", "updatedAt"])
          && d.companyId == companyId
          && ("trade" in d) && tradeFieldOk(d) && (!("trades" in d) || tradesListOk(d.trades))
          && tradeSetOk(d.extraTrades, 0, 17)
          && d.titles is list && d.titles.size() <= 80
          && (!("checklists" in d) || (d.checklists is list && d.checklists.size() <= 60))
          && (!("photoSteps" in d) || (d.photoSteps is list && d.photoSteps.size() <= 60))
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
      }
      function tradeWriter(companyId) {
        return companyId == callerCompany() && (
          (companyOffice() && profile().get("role", "") in ["admin", "manager"])
          || heartwoodManager()
          || (isAdmin() && companyId == "heartwood")
        );
      }

      allow get: if signedIn() && callerCompany() == companyId;
      allow list: if false;
      allow create, update: if tradeWriter(companyId) && tradeDocOk(companyId);
      allow delete: if false;
    }
    // Xero monthly P&L for the Home profit chart: Xero users read; only the box (tools/xero_profit_sync.py) writes.
    match /meta/profitHistory {
      function xeroUser() { return request.auth != null && request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "R7t41e54Ykcdk9WPdVZnDd697iI2"]; }

      allow read: if xeroUser() || isSync();
      allow write: if isSync();
    }
    // Send to Xero requests (app button -> box worker tools/xero_queue.py, which runs as the sync user).
    match /xeroQueue/{docId} {
      function xeroUser() { return request.auth != null && request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "R7t41e54Ykcdk9WPdVZnDd697iI2"]; }

      allow create: if xeroUser() && request.resource.data.status == "queued" && request.resource.data.by == request.auth.uid;
      allow read: if xeroUser() || isSync();
      allow update, delete: if isSync();
    }

    // Find PO requests (app 'Find PO' button -> box worker tools/po_lookup.py). Admins only (Alex, Patrick, sync).
    match /poLookups/{docId} {
      allow read, write: if isAdmin();
      // Find PO is Heartwood-only (Orbit portal and Alex's mailbox). Other companies can't queue or read lookups.
    }

    // Receipts (Upload receipt button). Any signed-in admin/operator creates their OWN receipt + image chunks and reads only
    // their own; the box sync user (tools/receipts_worker.py) and Alex read/update/delete all.
    // Accepted with a dollar amount > 0 and/or a tonnes weight > 0 (tip dockets often have only a weight).
    function isWorker() { return isAdmin() || isOperator(); }
    // Veolia (any site, any case) is on the company account. paidPersonally true is rejected.
    // An update that already had that pair still succeeds, so filing an old docket is unchanged.
    match /receipts/{rid} {
      function receiptMeasureOk(d) {
        let amtOk = !d.keys().hasAny(["amountInc"]) || d.amountInc == null || (d.amountInc is number && d.amountInc >= 0);
        let tOk = !d.keys().hasAny(["tonnes"]) || d.tonnes == null || (d.tonnes is number && d.tonnes >= 0);
        let hasAmt = d.keys().hasAny(["amountInc"]) && d.amountInc is number && d.amountInc > 0;
        let hasT = d.keys().hasAny(["tonnes"]) && d.tonnes is number && d.tonnes > 0;
        return amtOk && tOk && (hasAmt || hasT);
      }
      function supplierIsVeolia(d) {
        return d.get("supplier", "") is string
          && d.get("supplier", "").matches(".*[Vv][Ee][Oo][Ll][Ii][Aa].*");
      }
      function veoliaPaidPersonally(d) {
        return supplierIsVeolia(d) && d.get("paidPersonally", false) == true;
      }

      allow create: if isWorker() && notOtherCompany() && docCompany(request.resource.data) == "heartwood"
        && request.resource.data.uid == request.auth.uid && request.resource.data.status == "queued"
        && receiptMeasureOk(request.resource.data)
        && !veoliaPaidPersonally(request.resource.data);
      allow create: if companyStaff() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "queued" && request.resource.data.companyId == callerCompany()
        && receiptMeasureOk(request.resource.data)
        && !veoliaPaidPersonally(request.resource.data);
      allow read: if isOwner() || isSync() || (signedIn() && resource.data.uid == request.auth.uid);
      allow read: if companyStaff() && resource.data.uid == request.auth.uid && docCompany(resource.data) == callerCompany();
      allow update: if (isOwner() || isSync())
        && (!veoliaPaidPersonally(request.resource.data) || veoliaPaidPersonally(resource.data));
      allow delete: if isOwner() || isSync();
    }
    match /receiptChunks/{cid} {
      allow create: if isWorker() && notOtherCompany() && docCompany(request.resource.data) == "heartwood"
        && request.resource.data.uid == request.auth.uid && request.resource.data.data.size() < 800000;
      allow create: if companyStaff() && request.resource.data.get("companyId", "") == callerCompany()
        && request.resource.data.uid == request.auth.uid && request.resource.data.data.size() < 800000;
      allow read, update, delete: if isOwner() || isSync();
    }
    // Reimbursements ledger + owner settings (Hubdoc email-in address): ALEX ONLY (+ the box). Patrick (admin) cannot read.
    // New Veolia reimbursements are refused. A row that is already Veolia can still be updated
    // (Hubdoc status, mark paid) so existing ledger writes keep working.
    match /reimbursements/{id} {
      function supplierIsVeolia(d) {
        return d.get("supplier", "") is string
          && d.get("supplier", "").matches(".*[Vv][Ee][Oo][Ll][Ii][Aa].*");
      }
      function linkedReceiptVeolia(rid) {
        return rid is string && rid.size() > 0 && rid.size() <= 200
          && exists(/databases/$(database)/documents/receipts/$(rid))
          && get(/databases/$(database)/documents/receipts/$(rid)).data.get("supplier", "") is string
          && get(/databases/$(database)/documents/receipts/$(rid)).data.get("supplier", "").matches(".*[Vv][Ee][Oo][Ll][Ii][Aa].*");
      }
      function reimbIsVeolia(id, d) {
        return supplierIsVeolia(d) || linkedReceiptVeolia(d.get("receiptId", "")) || linkedReceiptVeolia(id);
      }

      allow read: if isOwner() || isSync();
      allow create: if (isOwner() || isSync()) && !reimbIsVeolia(id, request.resource.data);
      allow update: if (isOwner() || isSync())
        && (!reimbIsVeolia(id, request.resource.data) || reimbIsVeolia(id, resource.data));
      allow delete: if isOwner() || isSync();
    }
    match /ownerSettings/{id} { allow read, write: if isOwner() || isSync(); }
    // Timesheets: timesheets/{uid}_{weekStartYYYY-MM-DD}. A worker reads/writes only docs whose id starts with their own uid
    // (works for not-yet-created docs) and can't set the "sent" fields; Alex (owner) + the box read all, and Alex marks sent.
    match /timesheets/{tid} {
      function mine() { return signedIn() && tid.matches(request.auth.uid + "_[0-9]{4}-[0-9]{2}-[0-9]{2}"); }
      allow read: if isSync() || (mine() && (resource == null || companyOpen(resource.data.get("companyId", "heartwood"))));
      allow get: if isOwner() && docCompany(resource.data) == "heartwood";
      allow list: if isOwner() && resource.data.companyId == "heartwood";
      // Workers write their own sheet through the TIMESHEET RULES block below (tsWorkerCreate / tsWorkerUpdate), which
      // keeps clock stamps and entry authors fixed. The old blanket worker write here let a sheet be rewritten wholesale.
      allow create, update: if isOwner() && docCompany(request.resource.data) == "heartwood" && (resource == null || docCompany(resource.data) == "heartwood");
      allow delete: if isOwner();
    }

    // Safety / incident reports (ISO 45001 records). Any worker creates a report as themselves (status Open, number taken
    // from incidentCounter/main in the same transaction); reporters read only their own and may only add the photo flag.
    // Admins read all and update investigation/close fields; reporter, number and original account can't be changed. No deletes.
    // Other companies (not Heartwood): counter incidentCounter/{companyId}, reports incidents/{companyId}_INC-0001.
    // Any staff member of the company reports; that company's admins read and investigate. Heartwood's
    // rules below and its incidentCounter/main numbering are unchanged.
    // Kept cheap on purpose: Heartwood requests short-circuit on the first comparison, so these never add cost to them.
    function incProfileCompany() {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return p.get("companyId", "") is string && p.get("companyId", "") != "" ? p.get("companyId", "") : p.get("tenantId", "heartwood");
    }
    function incStaffOf(c) {
      return signedIn() && c != "heartwood"
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && incProfileCompany() == c
        && companyNotPaused(c);
    }
    // True for Heartwood staff and the box (no profile); false for staff of any other company.
    function notOtherCompany() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || incProfileCompany() == "heartwood";
    }
    match /incidentCounter/{id} {
      allow read: if id != "main" && incStaffOf(id);
      allow create: if id != "main" && incStaffOf(id) && request.resource.data.n == 1 && request.resource.data.keys().hasOnly(["n"]);
      allow update: if id != "main" && incStaffOf(id) && request.resource.data.n == resource.data.n + 1 && request.resource.data.keys().hasOnly(["n"]);
    }
    match /incidents/{iid} {
      function incAdminOf(c) {
        return incStaffOf(c) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin";
      }

      allow create: if request.resource.data.get("companyId", "heartwood") != "heartwood"
        && incStaffOf(request.resource.data.companyId)
        && request.resource.data.get("tenantId", request.resource.data.companyId) == request.resource.data.companyId
        && request.resource.data.reportedBy == request.auth.uid && request.resource.data.status == "Open"
        && request.resource.data.reportNo is string
        && iid == request.resource.data.companyId + "_" + request.resource.data.reportNo
        && request.resource.data.seq == getAfter(/databases/$(database)/documents/incidentCounter/$(request.resource.data.companyId)).data.n
        && request.resource.data.type in ["Incident", "Near miss", "Hazard", "Injury", "Property damage"]
        && !request.resource.data.keys().hasAny(["closedBy", "closedAt", "closedByName"]);
      allow get: if resource.data.get("companyId", "heartwood") != "heartwood" && incAdminOf(resource.data.companyId);
      allow list: if resource.data.companyId != "heartwood" && incAdminOf(resource.data.companyId);
      allow update: if resource.data.get("companyId", "heartwood") != "heartwood" && incAdminOf(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ["rootCause", "actions", "history", "status", "closedBy", "closedByName", "closedAt", "photosEmailedAt", "photosEmailedCount", "updatedAt", "updatedBy"])
        && resource.data.status == "Open" && request.resource.data.status in ["Open", "Closed"]
        && (request.resource.data.status == "Open" || request.resource.data.closedBy == request.auth.uid);
    }
    match /incidentCounter/{id} {
      allow read: if isWorker() && notOtherCompany();
      allow create: if isWorker() && id == "main" && notOtherCompany() && request.resource.data.n == 1 && request.resource.data.keys().hasOnly(["n"]);
      allow update: if isWorker() && id == "main" && notOtherCompany() && request.resource.data.n == resource.data.n + 1 && request.resource.data.keys().hasOnly(["n"]);
    }
    match /incidents/{iid} {
      function seqOk() { return request.resource.data.seq == getAfter(/databases/$(database)/documents/incidentCounter/main).data.n; }
      allow create: if isWorker() && request.resource.data.reportedBy == request.auth.uid && request.resource.data.status == "Open"
        && docCompany(request.resource.data) == "heartwood"
        && seqOk() && iid == request.resource.data.reportNo
        && request.resource.data.type in ["Incident", "Near miss", "Hazard", "Injury", "Property damage"]
        && !request.resource.data.keys().hasAny(["closedBy", "closedAt", "closedByName"]);
      // Heartwood admins read and investigate Heartwood incidents only; other companies' reports stay with that company.
      allow read: if isSync() || (signedIn() && resource.data.reportedBy == request.auth.uid);
      allow get: if isAdmin() && docCompany(resource.data) == "heartwood";
      allow list: if isAdmin() && resource.data.companyId == "heartwood";
      allow update: if (isAdmin() && docCompany(resource.data) == "heartwood" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ["rootCause", "actions", "history", "status", "closedBy", "closedByName", "closedAt", "photosEmailedAt", "photosEmailedCount", "updatedAt", "updatedBy"])
          && resource.data.status == "Open" && request.resource.data.status in ["Open", "Closed"]
          && (request.resource.data.status == "Open" || request.resource.data.closedBy == request.auth.uid))
        || (signedIn() && resource.data.reportedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["photosEmailedAt", "photosEmailedCount", "updatedAt", "updatedBy"]));
      allow delete: if false;
    }

    // SWMS PDFs (base64 chunks, uploaded by tools/upload_swms.py). Any logged-in worker reads; only Alex / the box write.
    // Heartwood's own SWMS PDFs: Heartwood staff only. Other companies see the labelled placeholder.
    match /swmsChunks/{cid} { allow read: if isWorker() && notOtherCompany(); allow write: if isOwner() || isSync(); }
    // Clients + contacts (supervisor / accounts names, mobiles, emails from builders' emails). Workers read (job Supervisor
    // card, tap-to-call); admins (Alex, Patrick, box) add/edit.
    match /clients/{cid} {
      allow read: if isWorker() && notOtherCompany();
      allow get: if companyStaff() && docCompany(resource.data) == callerCompany();
      allow list: if companyOffice() && resource.data.companyId == callerCompany();
      allow write: if isAdmin();
      allow create, update: if companyOffice() && request.resource.data.companyId == callerCompany();
    }
// BEGIN INBOX IMPORT RULES
    match /inbox/{id} {
      function inOffice() {
        return signedIn() && (
          request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"
          || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin"
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "supervisor"
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "manager"
            )
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("tenantId", "heartwood") == "heartwood"
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("companyId", "heartwood") == "heartwood"
          )
        );
      }
      function inMark() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(["read", "readAt", "imported", "importedJobId", "importedAt", "importedBy", "jobIds"])
          && (!changed.hasAny(["read"]) || request.resource.data.read is bool)
          && (!changed.hasAny(["readAt"]) || request.resource.data.readAt == request.time)
          && (!changed.hasAny(["imported"]) || request.resource.data.imported == true)
          && (!changed.hasAny(["importedJobId"]) || (
            request.resource.data.importedJobId is string
            && request.resource.data.importedJobId.size() > 0
            && request.resource.data.importedJobId.size() <= 128
            && request.resource.data.importedJobId.matches('^[A-Za-z0-9_-]+$')
          ))
          && (!changed.hasAny(["importedBy"]) || request.resource.data.importedBy == request.auth.uid)
          && (!changed.hasAny(["importedAt"]) || request.resource.data.importedAt == request.time)
          && (!changed.hasAny(["jobIds"]) || (
            request.resource.data.jobIds is list && request.resource.data.jobIds.size() <= 20
          ))
          && (!changed.hasAny(["imported", "importedJobId", "importedBy", "importedAt"])
            || (changed.hasAll(["imported", "importedJobId", "importedBy", "importedAt"])));
      }

      allow read: if inOffice() || isSync();
      allow create: if isSync();
      allow update: if isSync() || (inOffice() && inMark());
      allow delete: if false;
    }
// END INBOX IMPORT RULES
    // SWMS online signatures (finger signature as a small PNG data URL in the doc, NOT Firebase Storage). Any worker creates
    // their OWN (uid = theirs, server timestamp, current SWMS id, PNG < 100 KB, fixed fields); they read only their own; admins
    // (Alex, Patrick, box) read all. Signatures are a record: only Alex (owner) may update or delete.
    match /swmsSignatures/{sid} {
      allow create: if isWorker() && notOtherCompany() && request.resource.data.get("companyId", "heartwood") == "heartwood"
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid", "name", "swmsId", "swmsTitle", "version", "jobId", "jobLabel", "sig",
             "signedAt", "signedAtMs", "expiresAtMs", "device", "companyId"])
        && request.resource.data.keys().hasAll(["uid", "name", "swmsId", "version", "sig", "signedAt"])
        && request.resource.data.signedAt == request.time
        && request.resource.data.swmsId in ["working-near-roads", "mobile-plant", "working-with-silica", "hazardous-substances", "electrical"]
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.sig is string && request.resource.data.sig.size() < 100000
        && request.resource.data.sig.matches("data:image/png;base64,[A-Za-z0-9+/=]+");
      allow read: if isSync() || (signedIn() && resource.data.uid == request.auth.uid);
      allow get: if isAdmin() && docCompany(resource.data) == "heartwood";
      allow list: if isAdmin() && resource.data.companyId == "heartwood";
      allow update, delete: if isOwner();
    }
    // BEGIN CHAT RULES
    function chatExplicitTenant() {
      return (signedIn() && hasProfile()) && "tenantId" in profile() && profile().tenantId is string && profile().tenantId.size() > 0;
    }

    match /tenants/{tenantId}/chats/{threadId} {
      function chatHeadOk() {
        return request.resource.data.keys().hasOnly(["lastAt", "lastSenderUid", "lastSenderName", "preview"])
          && request.resource.data.lastSenderUid == request.auth.uid
          && request.resource.data.lastAt == request.time
          && request.resource.data.lastSenderName is string
          && request.resource.data.lastSenderName.size() > 0
          && request.resource.data.lastSenderName.size() <= 80
          && request.resource.data.preview is string
          && request.resource.data.preview.size() <= 140;
      }

      allow read: if chatCanAccess(tenantId, threadId);
      allow create, update: if chatCanAccess(tenantId, threadId) && chatHeadOk();
      allow delete: if false;
    }

    match /tenants/{tenantId}/chats/{threadId}/messages/{messageId} {
      function chatAdmin(tenantId) {
        return chatMember(tenantId) && (
          isAlex() || isPatrick() || ((signedIn() && hasProfile()) && "role" in profile() && profile().role == "admin")
        );
      }
      function chatHasPhoto() { return "photoPath" in request.resource.data; }
      function chatPhotoPathOk(tenantId, threadId) {
        return threadId == "staff"
          ? request.resource.data.photoPath.matches('^tenants/' + tenantId + '/chat/staff/photos/c[A-Za-z0-9]{8,40}$')
          : request.resource.data.photoPath.matches('^tenants/' + tenantId + '/chat/jobs/' + chatJobId(threadId) + '/photos/c[A-Za-z0-9]{8,40}$');
      }
      function chatMessageOk(tenantId, threadId) {
        return request.resource.data.keys().hasOnly(["senderUid", "senderName", "text", "createdAt", "photoPath", "photoType"])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time
          && (request.resource.data.text.size() > 0 || chatHasPhoto())
          && (!chatHasPhoto() || (
            request.resource.data.photoPath is string
            && request.resource.data.photoPath.size() > 0
            && request.resource.data.photoPath.size() <= 300
            && request.resource.data.photoType is string
            && request.resource.data.photoType.matches('^image/(jpeg|png|webp|gif)$')
            && chatPhotoPathOk(tenantId, threadId)
          ))
          && (chatHasPhoto() || !("photoType" in request.resource.data));
      }

      allow read: if chatCanAccess(tenantId, threadId);
      allow create: if chatCanAccess(tenantId, threadId) && chatMessageOk(tenantId, threadId);
      allow update: if false;
      allow delete: if chatCanAccess(tenantId, threadId)
        && (resource.data.senderUid == request.auth.uid || chatAdmin(tenantId));
    }

    match /tenants/{tenantId}/chatSeen/{uid}/threads/{threadId} {

      allow read: if signedIn() && request.auth.uid == uid && chatCanAccess(tenantId, threadId);
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && chatCanAccess(tenantId, threadId)
        && request.resource.data.keys().hasOnly(["seenAt"])
        && request.resource.data.seenAt == request.time;
      allow delete: if false;
    }

    // Web push tokens. The owner writes their own. Nobody else can read them.
    match /users/{uid}/fcmTokens/{tokenId} {
      function companyIdOk(id) {
        return id is string && id.size() >= 2 && id.size() <= 40 && id.matches('^[a-z0-9][a-z0-9-]{0,39}$');
      }
      function chatExplicitCompany() {
        return (signedIn() && hasProfile()) && "companyId" in profile() && profile().companyId is string && profile().companyId.size() > 0;
      }
      function chatTokenCompany() {
        return chatExplicitCompany()
          ? profile().companyId
          : (chatExplicitTenant()
            ? profile().tenantId
            : (((signedIn() && hasProfile()) || isAlex() || isPatrick()) ? "heartwood" : ""));
      }
      function chatPushOriginOk() {
        return request.resource.data.origin in [
          "https://jobs.heartwoodew.com",
          "https://app.callupapp.com.au",
          "https://callupapp.web.app"
        ];
      }
      function chatTokenOk() {
        return request.resource.data.keys().hasOnly(["token", "companyId", "origin", "platform", "updatedAt"])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 20
          && request.resource.data.token.size() <= 4096
          && companyIdOk(request.resource.data.companyId)
          && request.resource.data.companyId == chatTokenCompany()
          && chatPushOriginOk()
          && request.resource.data.platform == "web"
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && tokenId.matches('^[a-f0-9]{32}$')
        && chatTokenOk();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/chatSettings/{docId} {
      function chatPrefsOk() {
        return request.resource.data.keys().hasOnly(["muteChat", "muteDaily"])
          && request.resource.data.muteChat is bool
          && request.resource.data.muteDaily is bool;
      }

      allow read: if signedIn() && request.auth.uid == uid && docId == "prefs";
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && docId == "prefs"
        && chatPrefsOk();
      allow delete: if false;
    }
// END CHAT RULES

// BEGIN RUN SHEET RULES
    // Run sheets belong to one company (12 Nov 2026): companyId on the sheet (missing = Heartwood). An admin reads and
    // writes only their own company's sheets, for a worker of their own company. The depot is the company's own address
    // (Heartwood: Chuwar from its settings / default), so it is checked for shape only.

    match /runSheets/{sheetId} {
      function routeIsAdmin() {
        return isAlex() || isPatrick()
          || ((signedIn() && hasProfile()) && "role" in profile() && profile().role == "admin");
      }
      function routeSheetIdOk(id) {
        return id is string && id.matches('^[A-Za-z0-9]{1,128}_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      function routeSheetWorker(id) { return id[0:id.size()-11]; }
      function routeSheetDate(id) { return id[id.size()-10:id.size()]; }
      function routeWorkerCompany(sheetId) {
        let p = /databases/$(database)/documents/users/$(routeSheetWorker(sheetId));
        return exists(p) ? docCompany(get(p).data) : "heartwood";
      }
      function routeCanRead(sheetId) {
        return signedIn() && routeSheetIdOk(sheetId)
          && (request.auth.uid == routeSheetWorker(sheetId)
            || (routeIsAdmin() && (resource == null || docCompany(resource.data) == callerCompany())));
      }
      function routeCanWrite(sheetId) {
        return routeIsAdmin() && routeSheetIdOk(sheetId)
          && request.resource.data.keys().hasOnly([
            "workerUid", "workerName", "date", "jobIds", "returnToDepot", "status", "depot",
            "method", "provider", "tweaked", "totalMinutes", "totalKm", "currentMinutes", "currentKm",
            "approvedBy", "approvedByName", "approvedAt", "companyId"
          ])
          && request.resource.data.companyId is string
          && request.resource.data.companyId == callerCompany()
          && (resource == null || docCompany(resource.data) == callerCompany())
          && routeWorkerCompany(sheetId) == callerCompany()
          && request.resource.data.approvedBy == request.auth.uid
          && request.resource.data.date == routeSheetDate(sheetId)
          && request.resource.data.date is string
          && request.resource.data.status == "approved"
          && request.resource.data.depot is string
          && request.resource.data.depot.size() > 0
          && request.resource.data.depot.size() <= 200
          && request.resource.data.returnToDepot is bool
          && request.resource.data.tweaked is bool
          && request.resource.data.jobIds is list
          && request.resource.data.jobIds.size() > 0
          && request.resource.data.jobIds.size() <= 40
          && request.resource.data.workerName is string
          && request.resource.data.workerName.size() <= 80
          && request.resource.data.approvedByName is string
          && request.resource.data.approvedByName.size() > 0
          && request.resource.data.approvedByName.size() <= 80
          && request.resource.data.approvedAt == request.time
          && request.resource.data.method in ["exact", "nearest-neighbour-2opt"]
          && request.resource.data.provider in ["osrm", "ors", "osrm-fallback"]
          && request.resource.data.totalMinutes is number
          && request.resource.data.totalMinutes >= 0
          && request.resource.data.totalKm is number
          && request.resource.data.totalKm >= 0
          && request.resource.data.currentMinutes is number
          && request.resource.data.currentMinutes >= 0
          && request.resource.data.currentKm is number
          && request.resource.data.currentKm >= 0;
      }

      allow read: if routeCanRead(sheetId);
      allow create, update: if routeCanWrite(sheetId);
      allow delete: if false;
    }
// END RUN SHEET RULES

// BEGIN SWMS SIGNATURE RULES

    match /swmsSignatures/{id} {
      function swmsCanSign() {
        return isAlex() || isPatrick() || (signedIn() && hasProfile());
      }
      function swmsIdOk() {
        return request.resource.data.swmsId is string
          && request.resource.data.swmsId.matches('^(working-near-roads|mobile-plant|working-with-silica|hazardous-substances|electrical)$');
      }
      function swmsSigOk() {
        return request.resource.data.sig is string
          && request.resource.data.sig.size() >= 32
          && request.resource.data.sig.size() <= 90000
          && request.resource.data.sig.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$');
      }
      function swmsCreateOk() {
        return swmsCanSign()
          && request.resource.data.keys().hasOnly(["uid", "name", "swmsId", "swmsTitle", "version", "jobId", "jobLabel", "sig", "signedAt", "signedAtMs", "expiresAtMs", "device", "companyId"])
          && (request.resource.data.get("companyId", "heartwood") == "heartwood"
            ? notOtherCompany()
            : incStaffOf(request.resource.data.companyId))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && swmsIdOk()
          && request.resource.data.swmsTitle is string
          && request.resource.data.swmsTitle.size() > 0
          && request.resource.data.swmsTitle.size() <= 80
          && request.resource.data.version is string
          && request.resource.data.version.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
          && request.resource.data.jobId is string
          && request.resource.data.jobId.size() <= 200
          && request.resource.data.jobLabel is string
          && request.resource.data.jobLabel.size() <= 160
          && swmsSigOk()
          && request.resource.data.signedAt == request.time
          && request.resource.data.signedAtMs is int
          && request.resource.data.signedAtMs >= request.time.toMillis() - 300000
          && request.resource.data.signedAtMs <= request.time.toMillis() + 300000
          && request.resource.data.expiresAtMs is int
          && request.resource.data.expiresAtMs >= request.resource.data.signedAtMs + 364 * 24 * 60 * 60 * 1000
          && request.resource.data.expiresAtMs <= request.resource.data.signedAtMs + 367 * 24 * 60 * 60 * 1000
          && request.resource.data.device is string
          && request.resource.data.device.size() <= 200;
      }

      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow read: if (isAlex() || isPatrick() || ((signedIn() && hasProfile()) && profile().role == "admin"
          && profile().get("tenantId", "heartwood") == "heartwood"
          && profile().get("companyId", "heartwood") == "heartwood"))
        && docCompany(resource.data) == "heartwood";
      allow read: if companyOffice() && docCompany(resource.data) == callerCompany();
      allow create: if swmsCreateOk();
      allow update, delete: if false;
    }
// END SWMS SIGNATURE RULES

// BEGIN FLEET RULES

    // Prestart readings: any member of the tenant may move a machine's reading UP (same unit), signed as themselves.
    // Nothing else on the machine can change this way. A lower reading stays on the prestart only.

    match /tenants/{tenantId}/fleet/{assetId} {
      function fleetCallerTenant() {
        return chatExplicitTenant()
          ? profile().tenantId
          : (((signedIn() && hasProfile()) || isAlex() || isPatrick()) ? "heartwood" : "");
      }
      function fleetMember(tenantId) {
        return signedIn()
          && tenantId is string
          && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
          && fleetCallerTenant() == tenantId;
      }
      function fleetAdmin(tenantId) {
        return fleetMember(tenantId) && (
          isAlex() || isPatrick() || ((signedIn() && hasProfile()) && "role" in profile() && profile().role == "admin")
        );
      }
      function fleetDateOk(v) {
        return v is string && (v == "" || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }
      function fleetAssetOk() {
        return request.resource.data.keys().hasOnly(["type", "name", "rego", "regoExpiry", "coiRequired", "coiExpiry", "notes", "prestartKind", "reading", "readingUnit", "readingAt", "readingBy", "readingByName", "updatedAt", "updatedBy"])
          && (request.resource.data.type == "vehicle" || request.resource.data.type == "trailer" || request.resource.data.type == "plant")
          && (!("prestartKind" in request.resource.data) || request.resource.data.prestartKind == "skid-steer" || request.resource.data.prestartKind == "excavator" || request.resource.data.prestartKind == "tip-truck" || request.resource.data.prestartKind == "ute" || request.resource.data.prestartKind == "trailer" || request.resource.data.prestartKind == "other-plant")
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.rego is string
          && request.resource.data.rego.size() <= 20
          && fleetDateOk(request.resource.data.regoExpiry)
          && request.resource.data.coiRequired is bool
          && fleetDateOk(request.resource.data.coiExpiry)
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 2000
          && (!("reading" in request.resource.data) || (request.resource.data.reading is int && request.resource.data.reading >= 0 && request.resource.data.reading <= 10000000))
          && (!("readingUnit" in request.resource.data) || request.resource.data.readingUnit == "" || request.resource.data.readingUnit == "hours" || request.resource.data.readingUnit == "km")
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }
      function fleetEditor(tenantId) {
        return fleetAdmin(tenantId)
          || (fleetMember(tenantId) && (signedIn() && hasProfile()) && "role" in profile() && profile().role in ["supervisor", "manager"]);
      }
      function fleetReadingOk(tenantId) {
        return fleetMember(tenantId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reading", "readingUnit", "readingAt", "readingBy", "readingByName"])
          && request.resource.data.reading is int
          && request.resource.data.reading > 0
          && request.resource.data.reading <= 10000000
          && (request.resource.data.readingUnit == "hours" || request.resource.data.readingUnit == "km")
          && (resource.data.get("reading", 0) == 0
            || resource.data.get("readingUnit", "") == ""
            || resource.data.get("readingUnit", "") != request.resource.data.readingUnit
            || request.resource.data.reading > resource.data.get("reading", 0))
          && request.resource.data.readingBy == request.auth.uid
          && request.resource.data.readingByName is string
          && request.resource.data.readingByName.size() <= 80
          && request.resource.data.readingAt == request.time;
      }

      allow read: if fleetMember(tenantId);
      allow create: if fleetEditor(tenantId) && fleetAssetOk();
      allow update: if (fleetEditor(tenantId) && fleetAssetOk()) || fleetReadingOk(tenantId);
      allow delete: if fleetAdmin(tenantId);
    }

    match /tenants/{tenantId}/policies/{policyId} {
      function fleetCallerTenant() {
        return chatExplicitTenant()
          ? profile().tenantId
          : (((signedIn() && hasProfile()) || isAlex() || isPatrick()) ? "heartwood" : "");
      }
      function fleetMember(tenantId) {
        return signedIn()
          && tenantId is string
          && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
          && fleetCallerTenant() == tenantId;
      }
      function fleetAdmin(tenantId) {
        return fleetMember(tenantId) && (
          isAlex() || isPatrick() || ((signedIn() && hasProfile()) && "role" in profile() && profile().role == "admin")
        );
      }
      function fleetDateOk(v) {
        return v is string && (v == "" || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }
      function fleetPolicyOk() {
        return request.resource.data.keys().hasOnly(["type", "insurer", "policyNumber", "startDate", "expiry", "amount", "notes", "assetId", "updatedAt", "updatedBy"])
          && (request.resource.data.type == "workcover" || request.resource.data.type == "public-liability" || request.resource.data.type == "vehicle" || request.resource.data.type == "plant" || request.resource.data.type == "contract-works")
          && request.resource.data.insurer is string
          && request.resource.data.insurer.size() > 0
          && request.resource.data.insurer.size() <= 120
          && request.resource.data.policyNumber is string
          && request.resource.data.policyNumber.size() <= 60
          && fleetDateOk(request.resource.data.startDate)
          && fleetDateOk(request.resource.data.expiry)
          && request.resource.data.amount is string
          && request.resource.data.amount.size() <= 40
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 2000
          && request.resource.data.assetId is string
          && request.resource.data.assetId.size() <= 80
          && request.resource.data.assetId.matches('^[A-Za-z0-9_-]*$')
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if fleetAdmin(tenantId);
      allow create, update: if fleetAdmin(tenantId) && fleetPolicyOk();
      allow delete: if fleetAdmin(tenantId);
    }
// END FLEET RULES

// BEGIN INVITE RULES
    // Labourer, operator or supervisor: any invite admin (admin or supervisor). Admin: a profile-role admin of a CallUp
    // company, or a Heartwood admin (Alex, Patrick, or an accepted Heartwood admin grant in heartwoodAdmins/{uid}).

    match /invites/{inviteId} {
      function inviteAdmin() {
        return isAlex() || isPatrick()
          || ((signedIn() && hasProfile()) && "role" in profile()
            && (profile().role == "admin" || profile().role == "supervisor" || profile().role == "manager"));
      }
      function inviteEmailOk(email) {
        return email is string
          && email.size() >= 6
          && email.size() <= 120
          && email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
      }
      function inviteRoleOk() {
        return request.resource.data.role in ["labourer", "operator", "supervisor"]
          || (request.resource.data.role == "manager" && (inviteFullAdmin() || ((signedIn() && hasProfile()) && profile().get("role", "") == "manager")))
          || (request.resource.data.role == "admin" && inviteFullAdmin());
      }
      function inviteBaseOk() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && !request.resource.data.name.matches('.*[\\n\\r\\t<>].*')
          && inviteEmailOk(request.resource.data.email)
          && inviteRoleOk()
          && request.resource.data.tenantId is string
          && request.resource.data.tenantId == inviteCallerTenant()
          && request.resource.data.tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
          && request.resource.data.token is string
          && request.resource.data.token.matches('^[A-Za-z0-9_-]{43,128}$')
          && request.resource.data.createdBy is string
          && request.resource.data.createdBy.size() > 0
          && request.resource.data.createdBy.size() <= 128
          && request.resource.data.createdAt is timestamp
          && request.resource.data.expiresAt is timestamp;
      }
      function inviteExpiryWindow() {
        return request.resource.data.expiresAt > request.time + duration.value(6, 'd')
          && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
      }
      function inviteLockPath(email) { return /databases/$(database)/documents/inviteEmails/$(email); }
      function inviteLockFree(email) {
        return !exists(inviteLockPath(email))
          || get(inviteLockPath(email)).data.status != "pending";
      }
      function inviteLockAgrees(email, inviteId) {
        return existsAfter(inviteLockPath(email))
          && getAfter(inviteLockPath(email)).data.keys().hasOnly(["email", "status", "inviteId", "expiresAt", "role", "tenantId"])
          && getAfter(inviteLockPath(email)).data.email == email
          && getAfter(inviteLockPath(email)).data.inviteId == inviteId
          && getAfter(inviteLockPath(email)).data.role == request.resource.data.role
          && getAfter(inviteLockPath(email)).data.tenantId == request.resource.data.tenantId
          && getAfter(inviteLockPath(email)).data.status == request.resource.data.status
          && getAfter(inviteLockPath(email)).data.expiresAt == request.resource.data.expiresAt;
      }
      function inviteCreateOk(inviteId) {
        return inviteAdmin()
          && inviteBaseOk()
          && request.resource.data.keys().hasOnly(["name", "email", "role", "jobTitle", "jobTitleId", "status", "createdBy", "createdAt", "expiresAt", "token", "tenantId", "companyId"])
          && request.resource.data.get("companyId", request.resource.data.tenantId) == request.resource.data.tenantId
          && request.resource.data.status == "pending"
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && inviteExpiryWindow()
          && inviteLockFree(request.resource.data.email)
          && inviteLockAgrees(request.resource.data.email, inviteId);
      }
      function inviteCancelOk(inviteId) {
        return resource.data.status == "pending"
          && request.resource.data.status == "cancelled"
          && request.resource.data.cancelledBy == request.auth.uid
          && request.resource.data.cancelledAt == request.time
          && same("name") && same("email") && same("role") && same("createdBy")
          && same("createdAt") && same("expiresAt") && same("token") && same("tenantId")
          && same("companyId") && same("jobTitle") && same("jobTitleId")
          && same("resentAt") && same("resentBy")
          && inviteLockAgrees(request.resource.data.email, inviteId);
      }
      function inviteResendOk(inviteId) {
        return resource.data.status == "pending"
          && request.resource.data.status == "pending"
          && request.resource.data.token != resource.data.token
          && request.resource.data.resentBy == request.auth.uid
          && request.resource.data.resentAt == request.time
          && inviteExpiryWindow()
          && same("name") && same("email") && same("role") && same("createdBy")
          && same("createdAt") && same("tenantId") && same("companyId") && same("jobTitle") && same("jobTitleId")
          && same("cancelledAt") && same("cancelledBy")
          && inviteLockAgrees(request.resource.data.email, inviteId);
      }
      function inviteUpdateOk(inviteId) {
        return inviteAdmin()
          && inviteBaseOk()
          && request.resource.data.keys().hasOnly(["name", "email", "role", "jobTitle", "jobTitleId", "status", "createdBy", "createdAt", "expiresAt", "token", "tenantId", "companyId", "cancelledAt", "cancelledBy", "resentAt", "resentBy"])
          && (inviteCancelOk(inviteId) || inviteResendOk(inviteId));
      }

      // Supervisors never read an admin invite (it carries the sign-up token): their list asks for the three crew/supervisor roles.
      allow get, list: if inviteAdmin() && resource.data.tenantId == inviteCallerTenant()
        && (resource.data.role in ["labourer", "operator", "supervisor"]
          || (resource.data.role == "manager" && (inviteFullAdmin() || ((signedIn() && hasProfile()) && profile().get("role", "") == "manager")))
          || inviteFullAdmin());
      allow create: if inviteCreateOk(inviteId);
      allow update: if inviteUpdateOk(inviteId);
      allow delete: if false;
    }


    match /inviteEmails/{email} {
      function inviteAdmin() {
        return isAlex() || isPatrick()
          || ((signedIn() && hasProfile()) && "role" in profile()
            && (profile().role == "admin" || profile().role == "supervisor" || profile().role == "manager"));
      }
      function inviteEmailOk(email) {
        return email is string
          && email.size() >= 6
          && email.size() <= 120
          && email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
      }
      function inviteRoleOk() {
        return request.resource.data.role in ["labourer", "operator", "supervisor"]
          || (request.resource.data.role == "manager" && (inviteFullAdmin() || ((signedIn() && hasProfile()) && profile().get("role", "") == "manager")))
          || (request.resource.data.role == "admin" && inviteFullAdmin());
      }
      function inviteLockPath(email) { return /databases/$(database)/documents/inviteEmails/$(email); }
      function invitePath(inviteId) { return /databases/$(database)/documents/invites/$(inviteId); }
      function inviteLockEmailOk(email) {
        return inviteEmailOk(email)
          && request.resource.data.email == email
          && inviteRoleOk()
          && request.resource.data.tenantId == inviteCallerTenant()
          && request.resource.data.inviteId is string
          && request.resource.data.inviteId.size() > 0
          && request.resource.data.inviteId.size() <= 128
          && request.resource.data.expiresAt is timestamp
          && (request.resource.data.status == "pending" || request.resource.data.status == "cancelled")
          && request.resource.data.keys().hasOnly(["email", "status", "inviteId", "expiresAt", "role", "tenantId"]);
      }
      function inviteLockPointsAtInvite(email) {
        return existsAfter(invitePath(request.resource.data.inviteId))
          && getAfter(invitePath(request.resource.data.inviteId)).data.email == email
          && getAfter(invitePath(request.resource.data.inviteId)).data.role == request.resource.data.role
          && getAfter(invitePath(request.resource.data.inviteId)).data.tenantId == request.resource.data.tenantId
          && getAfter(invitePath(request.resource.data.inviteId)).data.status == request.resource.data.status
