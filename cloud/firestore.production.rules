    match /tenants/{tenantId}/serviceCosts/{recordId} {
      function svcCallerTenant() {
        return chatExplicitTenant()
          ? profile().tenantId
          : (((signedIn() && hasProfile()) || isAlex() || isPatrick()) ? "heartwood" : "");
      }
      function svcMember(tenantId) {
        return signedIn()
          && tenantId is string
          && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
          && svcCallerTenant() == tenantId;
      }
      function svcAdmin(tenantId) {
        return svcMember(tenantId) && (
          isAlex() || isPatrick() || ((signedIn() && hasProfile()) && "role" in profile() && profile().role == "admin")
        );
      }
      function svcWriter(tenantId) {
        return svcAdmin(tenantId)
          || (svcMember(tenantId) && (signedIn() && hasProfile()) && "role" in profile() && profile().role in ["supervisor", "manager"]);
      }
      function svcCostOk() {
        return docData().keys().hasOnly(["amount", "updatedAt", "updatedBy"])
          && textLen(docData().amount, 1, 40)
          && docData().updatedBy == request.auth.uid
          && docData().updatedAt == request.time;
      }

      allow read: if svcWriter(tenantId);
      allow create, update: if svcWriter(tenantId) && svcCostOk();
      allow delete: if svcWriter(tenantId);
    }
// END SERVICING RULES

// BEGIN PRESTART RULES

    match /tenants/{tenantId}/prestarts/{id} {
      function psCallerTenant() {
        return chatExplicitTenant()
          ? profile().tenantId
          : (((signedIn() && hasProfile()) || isAlex() || isPatrick()) ? "heartwood" : "");
      }
      function psMember(tenantId) {
        return signedIn()
          && tenantId is string
          && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
          && psCallerTenant() == tenantId;
      }
      function psAdmin(tenantId) {
        return psMember(tenantId) && (
          isAlex() || isPatrick() || ((signedIn() && hasProfile()) && "role" in profile() && profile().role == "admin")
        );
      }
      function psKindOk(kind) {
        return kind == "skid-steer" || kind == "excavator" || kind == "tip-truck"
          || kind == "ute" || kind == "trailer" || kind == "other-plant";
      }
      function psItem(item) {
        return item.keys().hasOnly(["id", "result", "comment", "critical"])
          && textLen(item.id, 1, 40)
          && (item.result == "pass" || item.result == "fail" || item.result == "na")
          && textMax(item.comment, 500)
          && (item.result != "fail" || item.comment.size() > 0)
          && item.critical is bool;
      }
      function psItems(items) {
        return items is list
          && items.size() >= 1
          && items.size() <= 16
          && psItem(items[0])
          && psItem(items[items.size() - 1]);
      }
      function psCreateOk() {
        return docData().keys().hasOnly(["assetId", "assetType", "assetName", "kind", "day", "reading", "readingUnit", "odometer", "items", "signerUid", "signerName", "signedAt", "defect", "doNotOperate", "resolved"])
          && docData().assetId is string
          && docData().assetId.matches('^[A-Za-z0-9_-]{1,80}$')
          && (docData().assetType == "vehicle" || docData().assetType == "trailer" || docData().assetType == "plant")
          && psKindOk(docData().kind)
          && textLen(docData().assetName, 1, 80)
          && docData().day is string
          && docData().day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && docData().reading is int
          && docData().reading >= 0
          && docData().reading <= 10000000
          && (docData().readingUnit == "" || docData().readingUnit == "hours" || docData().readingUnit == "km")
          && docData().odometer is int
          && docData().odometer >= 0
          && docData().odometer <= 10000000
          && psItems(docData().items)
          && docData().signerUid == request.auth.uid
          && textLen(docData().signerName, 2, 80)
          && docData().signedAt == request.time
          && docData().defect is bool
          && docData().doNotOperate is bool
          && docData().resolved == false;
      }
      function psSame(key) {
        return docData()[key] == prevData()[key];
      }
      function psResolveOk() {
        return prevData().defect == true
          && prevData().resolved == false
          && docData().resolved == true
          && docData().resolvedBy == request.auth.uid
          && textMax(docData().resolvedNote, 500)
          && docData().resolvedAt == request.time
          && psSame("assetId") && psSame("assetType") && psSame("assetName") && psSame("kind")
          && psSame("day") && psSame("reading") && psSame("readingUnit") && psSame("odometer")
          && psSame("items") && psSame("signerUid") && psSame("signerName")
          && psSame("signedAt") && psSame("defect") && psSame("doNotOperate");
      }

      allow read: if psMember(tenantId);
      allow create: if psMember(tenantId) && psCreateOk();
      allow update: if psAdmin(tenantId) && psResolveOk();
      allow delete: if false;
    }

    match /tenants/{tenantId}/prestartTemplates/{assetType} {
      function psCallerTenant() {
        return chatExplicitTenant()
          ? profile().tenantId
          : (((signedIn() && hasProfile()) || isAlex() || isPatrick()) ? "heartwood" : "");
      }
      function psMember(tenantId) {
        return signedIn()
          && tenantId is string
          && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
          && psCallerTenant() == tenantId;
      }
      function psAdmin(tenantId) {
        return psMember(tenantId) && (
          isAlex() || isPatrick() || ((signedIn() && hasProfile()) && "role" in profile() && profile().role == "admin")
        );
      }
      function psKindOk(kind) {
        return kind == "skid-steer" || kind == "excavator" || kind == "tip-truck"
          || kind == "ute" || kind == "trailer" || kind == "other-plant";
      }
      function psTpl(item) {
        return item.keys().hasOnly(["id", "label", "critical"])
          &&textLen(item.id, 1, 40)
          &&textLen(item.label, 1, 60)
          && item.critical is bool;
      }
      function psTemplateOk() {
        return docData().keys().hasOnly(["items", "updatedAt", "updatedBy"])
          && docData().items is list
          && docData().items.size() >= 1
          && docData().items.size() <= 16
          && psTpl(docData().items[0])
          && psTpl(docData().items[docData().items.size() - 1])
          && docData().updatedBy == request.auth.uid
          && docData().updatedAt == request.time;
      }

      allow read: if psMember(tenantId);
      allow create, update: if psAdmin(tenantId)
        && psKindOk(assetType)
        && psTemplateOk();
      allow delete: if false;
    }
// END PRESTART RULES

// BEGIN TIMESHEET HELPERS (definitions the TIMESHEET block needs; copied from cloud/emulator/firestore.rules)
    function isAlex() { return request.auth != null && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function isPatrick() { return request.auth != null && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return exists(userPath()); }
    function profile() { return get(userPath()).data; }
    function same(key) {
      let next = docData();
      let prev = prevData();
      return (!(key in next) && !(key in prev))
        || ((key in next) && (key in prev) && next[key] == prev[key]);
    }
    function fieldSame(next, prev, key) {
      return (!(key in next) && !(key in prev))
        || ((key in next) && (key in prev) && next[key] == prev[key]);
    }
// END TIMESHEET HELPERS

// BEGIN TIMESHEET RULES
    // Heartwood timesheets carry no companyId (unchanged). Everyone else's must name their own company,
    // so Heartwood never sees them and their own admins can.
    // One diff, reused: each extra diff of the entries/edits maps counts against the 1000-expression limit.
    // A machine pick is written once, all three fields together.
    match /timesheets/{id} {
      function incAdminOf(c) {
        return incStaffOf(c) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin";
      }
      function tsHeartwoodAdmin() {
        return isAlex() || isPatrick() || (
          hasProfile() && profile().role == "admin"
          && (!("tenantId" in profile()) || profile().tenantId == "heartwood")
        );
      }
      function tsMine(id) {
        return signedIn()
          && docData().uid == request.auth.uid
          && docData().weekStart is string
          && docData().weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && id == request.auth.uid + "_" + docData().weekStart;
      }
      function tsDocOk() {
        return docData().keys().hasOnly(["uid", "name", "weekStart", "weekEnd", "days", "entries", "totalHrs", "updatedAt", "updatedAtIso", "lastEntryId", "locationConsentAt", "sent", "sentAt", "sentBy", "approved", "companyId"])
          && tsCompanyOk()
          && textLen(docData().name, 1, 80)
          && docData().weekEnd is string
          && docData().weekEnd >= docData().weekStart
          && docData().days is map
          && docData().days.size() <= 7
          && docData().totalHrs is number
          && docData().totalHrs >= 0
          && docData().totalHrs <= 400
          && docData().updatedAt == request.time
          && textMax(docData().updatedAtIso, 40);
      }
      function tsCompanyOk() {
        return docData().get("companyId", "heartwood") == "heartwood"
          ? notOtherCompany()
          : incStaffOf(docData().companyId);
      }
      function tsCompanySent() {
        return prevData().get("companyId", "heartwood") != "heartwood"
          && incAdminOf(prevData().companyId)
          && docData().companyId == prevData().companyId
          && docData().diff(prevData()).affectedKeys().hasOnly(["sent", "sentAt", "sentBy"])
          && docData().sent is bool
          && (docData().get("sentAt", null) == null || docData().sentAt is string)
          && (docData().get("sentBy", null) == null || docData().sentBy == request.auth.uid);
      }
      function tsFix(m) {
        return m.keys().hasOnly(["at", "fix", "lat", "lng", "accuracy"])
          && m.at == request.time
          && ((m.fix == "no location" && m.keys().hasOnly(["at", "fix"]))
            || (m.fix == "gps" && m.lat is number && m.lat >= -90 && m.lat <= 90
              && m.lng is number && m.lng >= -180 && m.lng <= 180
              && m.accuracy is number && m.accuracy >= 0 && m.accuracy <= 100000));
      }
      function tsFixSame(b, a, k) {
        return a.source == "manual" ? !(k in a)
          : ((!(k in a) && !(k in b)) || ((k in a) && (k in b) && a[k] == b[k]) || ((k in a) && !(k in b) && tsFix(a[k])));
      }
      function tsEntryCore(e) {
        return e.keys().hasOnly(["id", "source", "status", "date", "start", "finish", "breakStart", "breakEnd", "note", "job", "clockOn", "clockOff", "breakOn", "breakOff", "enteredBy", "enteredByName", "enteredAt", "edits", "lastEditId", "machineChoice", "machineId", "machineName"])
          && e.id == docData().lastEntryId
          && e.id.matches('^[a-z0-9]{8,24}$')
          && (e.source == "clock" || e.source == "manual")
          && e.enteredBy == request.auth.uid
          &&textLen(e.enteredByName, 1, 80)
          && e.enteredAt is timestamp
          && e.edits is map
          &&textMax(e.note, 200)
          &&textMax(e.job, 200)
          && e.date is string && e.date.size() == 10
          &&textMax(e.start, 5)
          &&textMax(e.finish, 5)
          && ((e.source == "clock" && "clockOn" in e) || (e.source == "manual" && !e.keys().hasAny(["clockOn", "clockOff", "breakOn", "breakOff"])));
      }
      function tsEntryNew(e) {
        return tsEntryCore(e) && e.enteredAt == request.time && e.edits.size() == 0 && e.lastEditId == ""
          && tsFixSame({}, e, "clockOn") && tsFixSame({}, e, "clockOff") && tsFixSame({}, e, "breakOn") && tsFixSame({}, e, "breakOff");
      }
      function tsEditOk(b, a) {
        let d = a.edits.diff(b.edits);
        return d.removedKeys().size() == 0
          && d.changedKeys().size() == 0
          && (d.addedKeys().size() == 0
            || (d.addedKeys().hasOnly([a.lastEditId])
              && a.edits[a.lastEditId].at == request.time
              && a.edits[a.lastEditId].by == request.auth.uid
              && a.edits[a.lastEditId].byName is string
              && a.edits[a.lastEditId].summary is string
              && a.edits[a.lastEditId].summary.size() > 0
              && a.edits[a.lastEditId].summary.size() <= 200));
      }
      function tsMachinePick(b, a) {
        return !("machineChoice" in b)
          && (((a.machineChoice == "none" || a.machineChoice == "skip") && a.machineId == "" &&textMax(a.machineName, 80))
            || (a.machineChoice == "asset" && a.machineId.matches('^[A-Za-z0-9_-]{1,80}$') &&textLen(a.machineName, 1, 80)));
      }
      // An existing shift: check only what changed. id, source, author, enteredAt and the clock-on stamp never change;
      // a recorded stamp or machine pick is never rewritten or removed; a new stamp is a valid fix taken now (clock shifts only).
      // A clock-time correction is separate: start and finish only, plus the edit audit and the original times.
      // Job, note, date and the GPS fix stay. The first original is kept.
      // Re-validating the whole shift on every tap pushed clock-off after a break past Firestore's 1000-expression limit
      // (permission-denied, user test 11 Nov 2026).
      // Clock-off after a break and a machine pick used to hit Firestore's 1000-expression limit (permission-denied):
      // the entries map was diffed three times and compared whole. Diff once and look the shift up once.
      function tsHm(v) {
        return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
      }
      function tsPad2(n) {
        return n < 10 ? "0" + string(n) : string(n);
      }
      function tsToday() {
        let t = request.time + duration.value(10, 'h');
        return string(t.year()) + "-" + tsPad2(t.month()) + "-" + tsPad2(t.day());
      }
      function tsNowHm() {
        let t = request.time + duration.value(10, 'h');
        return tsPad2(t.hours()) + ":" + tsPad2(t.minutes());
      }
      function tsTimeOk(b, a) {
        let today = tsToday();
        let nowHm = tsNowHm();
        let openWeek = today >= prevData().weekStart && today <= prevData().weekEnd;
        let locked = prevData().get("sent", false) == true || prevData().get("approved", false) == true;
        return (a.finish == "" || a.finish > a.start)
          && (a.date < today || (a.date == today && a.start <= nowHm && (a.finish == "" || a.finish <= nowHm)))
          && (openWeek || !locked || isAlex() || isPatrick() || (hasProfile() && profile().role == "admin"))
          && (!("originalClockOn" in b) ? a.originalClockOn == b.start : a.originalClockOn == b.originalClockOn)
          && (b.finish == ""
            ? (!("originalClockOff" in a) && !("originalClockOff" in b))
            : (!("originalClockOff" in b) ? a.originalClockOff == b.finish : a.originalClockOff == b.originalClockOff));
      }
      function tsEntryNext(b, a) {
        let d = a.diff(b);
        let ch = d.affectedKeys();
        let added = d.addedKeys();
        return d.removedKeys().size() == 0 && (
          (ch.hasOnly(["status", "finish", "breakStart", "breakEnd", "clockOff", "breakOn", "breakOff", "enteredByName", "edits", "lastEditId", "machineChoice", "machineId", "machineName"])
            && !("start" in ch)
            && (!("finish" in ch) || ch.hasAny(["status", "clockOff", "breakOn", "breakOff"]))
            && !d.changedKeys().hasAny(["clockOff", "breakOn", "breakOff", "machineChoice", "machineId", "machineName"])
            && (!ch.hasAny(["clockOff", "breakOn", "breakOff"]) || (a.source == "clock"
              && (!("clockOff" in added) || tsFix(a.clockOff))
              && (!("breakOn" in added) || tsFix(a.breakOn))
              && (!("breakOff" in added) || tsFix(a.breakOff))))
            && (!ch.hasAny(["machineChoice", "machineId", "machineName"]) || tsMachinePick(b, a))
            && (!("finish" in ch) || (textMax(a.finish, 5)))
            && (!("enteredByName" in ch) || (textLen(a.enteredByName, 1, 80)))
            && (!ch.hasAny(["edits", "lastEditId"]) || (a.edits is map && tsEditOk(b, a))))
          || (ch.hasOnly(["start", "finish", "edits", "lastEditId", "originalClockOn", "originalClockOff"])
            && (a.start != b.start || a.finish != b.finish)
            && tsHm(a.start)
            && (a.finish == "" || tsHm(a.finish))
            && (b.finish != "" || a.finish == "")
            && a.edits is map
            && a.edits.size() == b.edits.size() + 1
            && tsEditOk(b, a)
            && tsTimeOk(b, a)));
      }
      function tsOneEntry() {
        let after = docData().entries;
        let before = prevData().get("entries", {});
        let key = docData().lastEntryId;
        let d = after.diff(before);
        return after is map
          && after.size() <= 40
          && key is string
          && d.removedKeys().size() == 0
          && d.affectedKeys().size() == 1
          && d.affectedKeys().hasOnly([key])
          && (key in before ? tsEntryNext(before[key], after[key]) : tsEntryNew(after[key]));
      }
      function tsWorkerCreate(id) {
        return tsMine(id) && tsDocOk()
          && !("sent" in docData()) && !("sentAt" in docData()) && !("sentBy" in docData())
          && !("approved" in docData())
          && (!("locationConsentAt" in docData()) || docData().locationConsentAt == request.time)
          && (!("entries" in docData())
            || (docData().entries.size() == 1
              && docData().lastEntryId in docData().entries
              && tsEntryNew(docData().entries[docData().lastEntryId])));
      }
      function tsWorkerUpdate(id) {
        return tsMine(id) && tsDocOk()
          && docData().uid == prevData().uid
          && docData().weekStart == prevData().weekStart
          && same("sent") && same("sentAt") && same("sentBy") && same("approved")
          && (!("locationConsentAt" in prevData()) && !("locationConsentAt" in docData())
            || !("locationConsentAt" in prevData()) && docData().locationConsentAt == request.time
            || docData().get("locationConsentAt", null) == prevData().get("locationConsentAt", null))
          // Shift change first: comparing the whole entries map is only needed when no shift changed.
          && (tsOneEntry() || docData().get("entries", {}) == prevData().get("entries", {}));
      }
      function tsSentUpdate() {
        return tsHeartwoodAdmin()
          && prevData().get("companyId", "heartwood") == "heartwood"
          && docData().diff(prevData()).affectedKeys().hasOnly(["sent", "sentAt", "sentBy"])
          && docData().sent is bool
          && (docData().get("sentAt", null) == null || docData().sentAt is string)
          && (docData().get("sentBy", null) == null || docData().sentBy == request.auth.uid);
      }

      allow get: if tsHeartwoodAdmin() && docCompany(prevData()) == "heartwood";
      allow list: if tsHeartwoodAdmin() && prevData().companyId == "heartwood";
      allow read: if signedIn() && (
        (resource == null && id.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        || (resource != null && prevData().uid == request.auth.uid && companyOpen(prevData().get("companyId", "heartwood")))
      );
      allow get: if prevData().get("companyId", "heartwood") != "heartwood" && incAdminOf(prevData().companyId);
      allow list: if prevData().companyId != "heartwood" && incAdminOf(prevData().companyId);
      allow create: if tsWorkerCreate(id);
      allow update: if tsWorkerUpdate(id) || tsSentUpdate() || tsCompanySent();
      allow delete: if false;
    }

    // Read-only mirror so clock-on can list machines and today's prestart.
    // Creates and edits stay with the compliance PR. allow write: if false does not veto those rules.
    match /tenants/{tenantId}/fleet/{assetId} {

      allow read: if tsFleetReader(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/prestarts/{id} {

      allow read: if tsFleetReader(tenantId);
      allow write: if false;
    }
// END TIMESHEET RULES

// BEGIN LEAVE RULES

    match /leaveRequests/{id} {
      function lvDecider() {
        return lvHeartwood() && (
          isAlex() || isPatrick() || (
            hasProfile() && (profile().role == "admin" || profile().role == "supervisor" || profile().role == "manager")
          )
        );
      }

      allow read: if lvHeartwood() && (
        lvDecider()
        || (resource != null && prevData().uid == request.auth.uid)
        || (resource == null && id.matches('^lv[a-z0-9]{16}$'))
      );
      allow create: if (lvHeartwood() && lvCreateBody(id));
      allow update: if (lvDecider() && lvDecisionBody());
      allow delete: if false;
    }
    // Other companies (not Heartwood): leave lives under companies/{c}/leaveRequests, so Heartwood's own list
    // never sees it. Staff of that company create and read their own; its admins and supervisors read and decide.
    match /companies/{c}/leaveRequests/{id} {
      function cmRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "");
      }
      function lvCoDecider(c) { return incStaffOf(c) && cmRole() in ["admin", "supervisor", "manager"]; }

      allow read: if incStaffOf(c) && (
        lvCoDecider(c)
        || (resource != null && prevData().uid == request.auth.uid)
        || (resource == null && id.matches('^lv[a-z0-9]{16}$'))
      );
      allow create: if incStaffOf(c) && lvCreateBody(id);
      allow update: if lvCoDecider(c) && lvDecisionBody();
      allow delete: if false;
    }
// END LEAVE RULES

// BEGIN REIMBURSEMENT CLAIM RULES


    match /reimbursementClaims/{id} {
      function rcAdmin() {
        return lvHeartwood() && (isAlex() || isPatrick() || (hasProfile() && (profile().role == "admin" || profile().role == "manager")));
      }

      allow read: if (isSync() && resource != null && prevData().status == "paid") || lvHeartwood() && (
        rcAdmin()
        || (resource != null && prevData().uid == request.auth.uid)
        || (resource == null && id.matches('^rc[a-z0-9]{16}$'))
      );
      allow create: if (lvHeartwood() && rcCreateBody(id));
      allow update: if (rcAdmin() && rcDecisionBody()) || rcHubdoc();
      allow delete: if false;
    }
    // Other companies: claims under companies/{c}/reimbursementClaims. Staff create and read their own; that
    // company's admins read and decide. The box filer reads paid ones and records Hubdoc state only.
    match /companies/{c}/reimbursementClaims/{id} {
      function rcCompanyDecider(c) {
        return incStaffOf(c) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") in ["admin", "manager"];
      }

      allow read: if (isSync() && resource != null && prevData().status == "paid") || incStaffOf(c) && (
        rcCompanyDecider(c)
        || (resource != null && prevData().uid == request.auth.uid)
        || (resource == null && id.matches('^rc[a-z0-9]{16}$'))
      );
      allow create: if incStaffOf(c) && rcCreateBody(id);
      allow update: if (rcCompanyDecider(c) && rcDecisionBody()) || rcHubdoc();
      allow delete: if false;
    }
// END REIMBURSEMENT CLAIM RULES
// BEGIN HOURS EXPORT RULES
    match /hoursExports/{id} {
      function hxAdmin() {
        return signedIn() && (
          request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2" || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin"
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("tenantId", "heartwood") == "heartwood")
        );
      }
      function hxCreate(id) {
        let d = docData();
        return hxAdmin()
          && id.matches('^hx[a-z0-9]{16}$')
          && d.keys().hasOnly(["weekStart", "weekEnd", "to", "fileName", "storagePath", "people", "totalHours", "status", "attempts", "createdBy", "createdByName", "createdAt", "companyId", "companyName"])
          && (!("companyId" in d) || d.companyId == "heartwood")
          && (!("companyName" in d) || d.companyName == "Heartwood")
          && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.weekEnd is string && d.weekEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.to == "accounts@heartwoodew.com"
          && d.fileName is string && d.fileName.matches('^[A-Za-z0-9_-]{1,80}[.]xlsx$')
          && d.storagePath == "hoursExports/" + id + "/" + d.fileName
          && d.people is int && d.people >= 0 && d.people <= 500
          && d.totalHours is number && d.totalHours >= 0 && d.totalHours <= 100000
          && d.status == "queued" && d.attempts == 0
          && d.createdBy == request.auth.uid
          &&textMax(d.createdByName, 80)
          && d.createdAt == request.time;
      }
      function hxMark() {
        return isSync()
          && docData().diff(prevData()).affectedKeys().hasOnly(["status", "attempts", "updatedAt", "sentAt", "messageId", "error", "via"])
          && docData().status in ["sending", "sent", "failed"]
          && docData().to == "accounts@heartwoodew.com"
          && docData().attempts is int
          &&textMax(docData().get("error", ""), 300)
          &&textMax(docData().get("messageId", ""), 100);
      }
      function hxCreateCompany(id) {
        let d = docData();
        return companyOffice()
          && id.matches('^hx[a-z0-9]{16}$')
          && d.companyId == callerCompany()
          && d.to != "accounts@heartwoodew.com"
          && d.keys().hasOnly(["weekStart", "weekEnd", "to", "fileName", "storagePath", "people", "totalHours", "status", "attempts", "createdBy", "createdByName", "createdAt", "companyId", "companyName"])
          && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.weekEnd is string && d.weekEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.fileName is string && d.fileName.matches('^[A-Za-z0-9_-]{1,80}[.]xlsx$')
          && d.storagePath == "hoursExports/" + id + "/" + d.fileName
          && d.people is int && d.people >= 0 && d.people <= 500
          && d.totalHours is number && d.totalHours >= 0 && d.totalHours <= 100000
          && d.status == "queued" && d.attempts == 0
          && d.createdBy == request.auth.uid
          &&textMax(d.createdByName, 80)
          && d.createdAt == request.time
          &&textLen(d.companyName, 1, 80);
      }

      allow read: if hxAdmin() || isSync();
      allow read: if companyOffice() && prevData().companyId == callerCompany();
      allow create: if hxCreate(id);
      allow create: if hxCreateCompany(id);
      allow update: if hxMark();
      allow delete: if false;
    }
// END HOURS EXPORT RULES

// BEGIN LIVE LOCATION RULES
    // One live doc per person (latest position only). Heartwood: liveLocations/{uid}.
    // Every other company: companies/{id}/liveLocations/{uid}. The same clock-off and
    // last-known rules apply to every company. Written while that person's timesheet
    // shift is clocked on (open or on a break). Clock off keeps the doc: the same person
    // sets clockedOn false and clockedOffAt, and does not have to delete it.
    // A position already shared cannot be replaced with location off, so a lapsed update stays.
    // Admin and manager of the same company read every doc, including a clocked-off last position.
    // A supervisor reads clocked-on docs only, for the Staff roster. Operator and labourer do not.
    // The crew map stays manager and admin. No other company does.
    // Heartwood: status "paused" blocks locations (llPaused). Other companies use companyNotPaused,
    // the same trial and billing pause as the rest of the app. No company document means not paused.
    match /liveLocations/{id} {
      function llMap() {
        return isAlex()
          || (isPatrick() && callerCompany() == "heartwood")
          || (hasProfile() && (profile().get("role", "") == "admin" || profile().get("role", "") == "manager"));
      }
      function llLiveRead() {
        return prevData().clockedOn == true || llMap();
      }
      function llKeepsFix() {
        return prevData().sharing != "gps" || docData().sharing == "gps";
      }
      function llClockOff(id) {
        let d = docData();
        return prevData().clockedOn == true
          && d.clockedOn == false
          && d.clockedOffAt == request.time
          && d.uid == id
          && d.uid == request.auth.uid
          && same("uid") && same("name") && same("companyId") && same("sharing")
          && same("lat") && same("lng") && same("accuracy")
          && same("updatedAt") && same("weekStart") && same("entryId")
          && (
            (d.sharing == "gps" && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "lat", "lng", "accuracy", "updatedAt", "weekStart", "entryId", "clockedOffAt"]))
            || (d.sharing == "off" && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "updatedAt", "weekStart", "entryId", "clockedOffAt"]))
          );
      }
      function llRole() {
        return hasProfile() ? profile().get("role", "") : "";
      }
      function llPaused(id) {
        let path = /databases/$(database)/documents/companies/$(id);
        return exists(path) && get(path).data.get("status", "") == "paused";
      }
      function llOffice() {
        return signedIn() && callerCompany() != "" && (
          isAlex()
          || (isPatrick() && callerCompany() == "heartwood")
          || (hasProfile() && (llRole() == "admin" || llRole() == "manager" || llRole() == "supervisor"))
        );
      }
      function llGps(d) {
        return d.sharing == "gps"
          && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "lat", "lng", "accuracy", "updatedAt", "weekStart", "entryId"])
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100000;
      }
      function llOff(d) {
        return d.sharing == "off"
          && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "updatedAt", "weekStart", "entryId"]);
      }
      function llOpenEntry(sheet) {
        let entry = sheet.entries[docData().entryId];
        return sheet.uid == request.auth.uid
          && docCompany(sheet) == docData().companyId
          && entry.source == "clock"
          && (entry.status == "open" || entry.status == "break");
      }
      function llClocked() {
        let path = /databases/$(database)/documents/timesheets/$(request.auth.uid + "_" + docData().weekStart);
        return exists(path) && llOpenEntry(get(path).data);
      }
      function llBody(d, id) {
        return d.uid == id
          && d.uid == request.auth.uid
          &&textLen(d.name, 1, 80)
          && d.clockedOn == true
          && d.updatedAt == request.time
          && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.entryId is string && d.entryId.matches('^[a-z0-9]{8,24}$')
          && (llGps(d) || llOff(d))
          && llClocked();
      }

      allow get: if llOffice() && !llPaused("heartwood") && callerCompany() == "heartwood" && docCompany(prevData()) == "heartwood" && llLiveRead();
      allow list: if llOffice() && !llPaused("heartwood") && callerCompany() == "heartwood" && prevData().companyId == "heartwood" && llLiveRead();
      allow create: if callerCompany() == "heartwood" && docData().companyId == "heartwood" && !llPaused("heartwood") && llBody(docData(), id);
      allow update: if callerCompany() == "heartwood" && docData().companyId == "heartwood" && !llPaused("heartwood") && ((llBody(docData(), id) && llKeepsFix()) || llClockOff(id));
      allow delete: if signedIn() && request.auth.uid == id && callerCompany() == "heartwood" && docCompany(prevData()) == "heartwood" && !llPaused("heartwood");
    }
    match /companies/{c}/liveLocations/{id} {
      function llMap() {
        return isAlex()
          || (isPatrick() && callerCompany() == "heartwood")
          || (hasProfile() && (profile().get("role", "") == "admin" || profile().get("role", "") == "manager"));
      }
      function llLiveRead() {
        return prevData().clockedOn == true || llMap();
      }
      function llKeepsFix() {
        return prevData().sharing != "gps" || docData().sharing == "gps";
      }
      function llClockOff(id) {
        let d = docData();
        return prevData().clockedOn == true
          && d.clockedOn == false
          && d.clockedOffAt == request.time
          && d.uid == id
          && d.uid == request.auth.uid
          && same("uid") && same("name") && same("companyId") && same("sharing")
          && same("lat") && same("lng") && same("accuracy")
          && same("updatedAt") && same("weekStart") && same("entryId")
          && (
            (d.sharing == "gps" && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "lat", "lng", "accuracy", "updatedAt", "weekStart", "entryId", "clockedOffAt"]))
            || (d.sharing == "off" && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "updatedAt", "weekStart", "entryId", "clockedOffAt"]))
          );
      }
      function llRole() {
        return hasProfile() ? profile().get("role", "") : "";
      }
      function llOffice() {
        return signedIn() && callerCompany() != "" && (
          isAlex()
          || (isPatrick() && callerCompany() == "heartwood")
          || (hasProfile() && (llRole() == "admin" || llRole() == "manager" || llRole() == "supervisor"))
        );
      }
      function llGps(d) {
        return d.sharing == "gps"
          && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "lat", "lng", "accuracy", "updatedAt", "weekStart", "entryId"])
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100000;
      }
      function llOff(d) {
        return d.sharing == "off"
          && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "updatedAt", "weekStart", "entryId"]);
      }
      function llOpenEntry(sheet) {
        let entry = sheet.entries[docData().entryId];
        return sheet.uid == request.auth.uid
          && docCompany(sheet) == docData().companyId
          && entry.source == "clock"
          && (entry.status == "open" || entry.status == "break");
      }
      function llClocked() {
        let path = /databases/$(database)/documents/timesheets/$(request.auth.uid + "_" + docData().weekStart);
        return exists(path) && llOpenEntry(get(path).data);
      }
      function llBody(d, id) {
        return d.uid == id
          && d.uid == request.auth.uid
          &&textLen(d.name, 1, 80)
          && d.clockedOn == true
          && d.updatedAt == request.time
          && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.entryId is string && d.entryId.matches('^[a-z0-9]{8,24}$')
          && (llGps(d) || llOff(d))
          && llClocked();
      }

      allow get: if llOffice() && c != "heartwood" && callerCompany() == c && docCompany(prevData()) == c && companyNotPaused(c) && llLiveRead();
      allow list: if llOffice() && c != "heartwood" && callerCompany() == c && prevData().companyId == c && companyNotPaused(c) && llLiveRead();
      allow create: if c != "heartwood" && callerCompany() == c && docData().companyId == c && companyNotPaused(c) && llBody(docData(), id);
      allow update: if c != "heartwood" && callerCompany() == c && docData().companyId == c && companyNotPaused(c) && ((llBody(docData(), id) && llKeepsFix()) || llClockOff(id));
      allow delete: if signedIn() && request.auth.uid == id && c != "heartwood" && callerCompany() == c && docCompany(prevData()) == c && companyNotPaused(c);
    }
// END LIVE LOCATION RULES

// BEGIN DAILY JOB RULES
    match /dailyJobDigest/{id} {
      allow read, write: if false;
    }
// END DAILY JOB RULES

// BEGIN PRESTART NOTICE RULES
    // Written by the prestart assignment function. The person reads their own
    // company only. Clients cannot write. The document has no prices.
    match /users/{uid}/prestartNotices/{noticeId} {
      allow read: if signedIn() && request.auth.uid == uid && prevData().companyId == callerCompany();
      allow create, update, delete: if false;
    }
// END PRESTART NOTICE RULES

// BEGIN LOCATION REMIND RULES
    // Written by remindLocationSharing. The person reads their own company only.
    // sentAtMs is the 30-minute rate limit. Clients cannot write.
    match /users/{uid}/locationNotices/{noticeId} {
      allow read: if signedIn() && request.auth.uid == uid && prevData().companyId == callerCompany();
      allow create, update, delete: if false;
    }
// END LOCATION REMIND RULES

// BEGIN STAFF PERFORMANCE RULES
    // One profile read per helper. Heartwood returns before the company lookup.
    // performanceSettings is managers and admins only (weights and the crew-only ranking switch).
    // take5Settings is the on/off flag every staff member of that company can read, so field crew
    // know to prompt, without being able to read weights or money.
    // take5s: any staff member creates their own; supervisors and above list the company.
    function perfListed() {
      return request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "38SU5waAy4f9UI9N6JTqDMaYpQg2", "R7t41e54Ykcdk9WPdVZnDd697iI2"];
    }
    function perfCompanyOf(p) {
      return p.get("companyId", "") is string && p.get("companyId", "") != ""
        ? p.get("companyId", "")
        : p.get("tenantId", "heartwood");
    }
    function perfRole(companyId) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      let missing = !exists(path);
      let p = missing ? {} : get(path).data;
      let c = perfCompanyOf(p);
      let same = (companyId == "heartwood" && (perfListed() || (!missing && c == "heartwood")))
        || (companyId != "heartwood" && !missing && c == companyId && companyNotPaused(companyId));
      return signedIn() && companyId is string && companyId.size() >= 2 && same ? (perfListed() ? "admin" : p.get("role", "")) : "";
    }
    match /performanceSettings/{companyId} {
      function perfWeightsOk(w) {
        return w is map
          && w.keys().hasOnly(["hours", "money", "jobs", "prestart", "take5", "incidents", "sick", "annual"])
          && w.hours is number && w.hours >= 0 && w.hours <= 10
          && w.money is number && w.money >= 0 && w.money <= 10
          && w.jobs is number && w.jobs >= 0 && w.jobs <= 10
          && w.prestart is number && w.prestart >= 0 && w.prestart <= 10
          && w.take5 is number && w.take5 >= 0 && w.take5 <= 10
          && w.incidents is number && w.incidents >= 0 && w.incidents <= 10
          && w.sick is number && w.sick >= 0 && w.sick <= 10
          && w.annual is number && w.annual >= 0 && w.annual <= 10;
      }
      function perfBody(companyId) {
        let d = docData();
        return d.keys().hasOnly(["companyId", "excludeLeaders", "weights", "updatedAt", "updatedBy"])
          && d.companyId == companyId
          && d.excludeLeaders is bool
          && perfWeightsOk(d.weights)
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
      }
      function perfDefaultWeights() {
        let w = docData().weights;
        return w.hours == 1 && w.money == 1 && w.jobs == 1 && w.prestart == 1 && w.take5 == 1
          && w.incidents == 1 && w.sick == 1 && w.annual == 0;
      }
      function perfCanRead(companyId) {
        let role = perfRole(companyId);
        return role == "admin" || role == "manager";
      }

      allow get: if perfCanRead(companyId);
      allow list: if false;
      allow create, update: if perfRole(companyId) == "admin" && perfBody(companyId);
      allow create: if perfRole(companyId) == "manager" && perfBody(companyId) && perfDefaultWeights();
      allow update: if perfRole(companyId) == "manager"
        && docData().diff(prevData()).affectedKeys().hasOnly(["excludeLeaders", "updatedAt", "updatedBy"])
        && docData().excludeLeaders is bool
        && docData().companyId == prevData().companyId
        && docData().weights == prevData().weights
        && docData().updatedBy == request.auth.uid
        && docData().updatedAt == request.time;
      allow delete: if false;
    }
    match /take5Settings/{companyId} {
      function take5Actor(companyId) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let missing = !exists(path);
        let p = missing ? {} : get(path).data;
        let c = perfCompanyOf(p);
        return signedIn() && companyId is string && companyId.size() >= 2 && (
          (companyId == "heartwood" && (perfListed() || (!missing && c == "heartwood")))
          || (companyId != "heartwood" && !missing && c == companyId && companyNotPaused(companyId))
        );
      }

      allow get: if take5Actor(companyId);
      allow list: if false;
      allow create, update: if perfRole(companyId) == "admin"
        && docData().keys().hasOnly(["companyId", "enabled", "updatedAt", "updatedBy"])
        && docData().companyId == companyId
        && docData().enabled is bool
        && docData().updatedBy == request.auth.uid
        && docData().updatedAt == request.time;
      allow delete: if false;
    }
    match /take5s/{id} {
      function take5Actor(companyId) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let missing = !exists(path);
        let p = missing ? {} : get(path).data;
        let c = perfCompanyOf(p);
        return signedIn() && companyId is string && companyId.size() >= 2 && (
          (companyId == "heartwood" && (perfListed() || (!missing && c == "heartwood")))
          || (companyId != "heartwood" && !missing && c == companyId && companyNotPaused(companyId))
        );
      }
      function take5Office(companyId) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let missing = !exists(path);
        let p = missing ? {} : get(path).data;
        let role = p.get("role", "");
        let c = perfCompanyOf(p);
        let leader = perfListed() || role in ["supervisor", "manager", "admin"];
        return signedIn() && companyId is string && leader && (
          (companyId == "heartwood" && (perfListed() || (!missing && c == "heartwood")))
          || (companyId != "heartwood" && !missing && c == companyId && companyNotPaused(companyId))
        );
      }
      function take5IdOk(id) { return id.matches('^t5[a-z0-9]{16}$'); }
      function take5MayGetMissing(id) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let missing = !exists(path);
        let p = missing ? {} : get(path).data;
        let c = perfCompanyOf(p);
        let open = c == "heartwood" || (!missing && companyNotPaused(c));
        return take5IdOk(id) && signedIn() && open && (perfListed() || !missing);
      }
      function take5Body(id) {
        let d = docData();
        return take5IdOk(id)
          && d.keys().hasOnly(["companyId", "uid", "name", "jobId", "jobNo", "day", "note", "steps", "photoPath", "createdAt"])
          && d.companyId is string
          && d.uid == request.auth.uid
          &&textLen(d.name, 2, 80)
          &&textLen(d.jobId, 1, 80)
          &&textMax(d.jobNo, 40)
          && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          &&textLen(d.note, 1, 500)
          && d.steps is map
          && d.steps.keys().hasOnly(["stop", "look", "assess", "control", "proceed"])
          && d.steps.stop == true && d.steps.look == true && d.steps.assess == true
          && d.steps.control == true && d.steps.proceed == true
          &&textMax(d.photoPath, 200)
          && (d.photoPath == "" || d.photoPath == "take5Photos/" + d.companyId + "/" + d.uid + "_" + id + ".jpg")
          && d.createdAt == request.time;
      }

      allow get: if resource == null && take5MayGetMissing(id);
      allow get: if resource != null && prevData().uid == request.auth.uid && take5Actor(prevData().companyId);
      allow get: if resource != null && take5Office(prevData().companyId);
      allow list: if prevData().uid == request.auth.uid && take5Actor(prevData().companyId);
      allow list: if take5Office(prevData().companyId);
      allow create: if take5Actor(docData().companyId) && take5Body(id);
      allow update, delete: if false;
    }
    // Managers need company timesheets and incidents to build the ranking. Crew and supervisors stay on their own.
    match /timesheets/{id} {
      allow get: if perfRole(docCompany(prevData())) == "manager";
      allow list: if prevData().companyId is string && perfRole(prevData().companyId) == "manager";
    }
    match /incidents/{iid} {
      allow get: if perfRole(docCompany(prevData())) == "manager";
      allow list: if prevData().companyId is string && perfRole(prevData().companyId) == "manager";
    }
// END STAFF PERFORMANCE RULES

// BEGIN INBOUND FORWARD RULES
    // Per-company forwarded mail and job drafts. Written by inboundEmailWebhook
    // (Admin SDK). Office of that company (admin, manager, supervisor) can read.
    // Crew cannot. Another company cannot. The route index is not listable.
    // No price fields on a draft. Paste into the live rules. Do not deploy this file.
    function inboundCompanyOf(p) {
      return p.get("companyId", "") is string && p.get("companyId", "") != ""
        ? p.get("companyId", "")
        : (p.get("tenantId", "") is string && p.get("tenantId", "") != "" ? p.get("tenantId", "") : "heartwood");
    }
    function inboundBootstrap(companyId) {
      return companyId == "heartwood" && signedIn() && (
        request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"
        || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
      );
    }
    function inboundProfileOffice(companyId) {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return p.get("role", "") in ["admin", "manager", "supervisor"] && inboundCompanyOf(p) == companyId;
    }
    function inboundProfileMinter(companyId) {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return p.get("role", "") in ["admin", "manager"] && inboundCompanyOf(p) == companyId;
    }
    function inboundOffice(companyId) {
      return inboundBootstrap(companyId) || (signedIn() && inboundProfileOffice(companyId));
    }
    function inboundMinter(companyId) {
      return inboundBootstrap(companyId) || (signedIn() && inboundProfileMinter(companyId));
    }
    function inboundMoneyFree(data) {
      return !data.keys().hasAny(["poAmount", "poAmountBasis", "poAmountSource", "quoteAmount", "poLookupCandidates", "invoiceAmount", "xeroCheck", "amountInc", "totalEx", "gst", "totalInc", "priceOverrides", "lines"]);
    }
    function inboundLocalOk(companyId, localPart) {
      return companyId is string
        && companyId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && localPart is string
        && localPart.matches("^" + companyId + "-[a-z0-9]{8}$");
    }

    match /companies/{companyId}/inbound/{docId} {
      allow get: if docId == "config" && inboundOffice(companyId)
        && (resource == null || prevData().companyId == companyId);
      allow list: if false;
      allow create: if docId == "config" && inboundMinter(companyId)
        && docData().keys().hasOnly(["companyId", "address", "localPart", "domain", "createdBy", "createdAt"])
        && docData().companyId == companyId
        && inboundLocalOk(companyId, docData().localPart)
        && docData().domain == "inbound.callupapp.com.au"
        && docData().address == docData().localPart + "@inbound.callupapp.com.au"
        && docData().createdBy == request.auth.uid
        && docData().createdAt == request.time;
      allow update, delete: if false;
    }
    match /companies/{companyId}/inboundMail/{messageId} {
      allow get: if inboundOffice(companyId) && prevData().companyId == companyId;
      allow list: if inboundOffice(companyId) && prevData().companyId == companyId;
      allow update: if resource != null
        && inboundOffice(companyId)
        && prevData().companyId == companyId
        && prevData().kind == "verification"
        && docData().diff(prevData()).affectedKeys().hasOnly(["dismissed", "dismissedAt"])
        && docData().dismissed == true
        && docData().dismissedAt == request.time;
      allow create, delete: if false;
    }
    match /companies/{companyId}/jobDrafts/{draftId} {
      function draftTextOk(d) {
        return textMax(d.client, 120)
          &&textMax(d.address, 200)
          &&textMax(d.notes, 800)
          &&textMax(d.description, 800)
          &&textMax(d.po, 40)
          &&textMax(d.type, 40)
          && (!("date" in d) || d.date == "" || d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && (!("supervisorName" in d) || (textMax(d.supervisorName, 80)))
          && (!("supervisorEmail" in d) || (textMax(d.supervisorEmail, 120)))
          && (!("supervisorPhone" in d) || (textMax(d.supervisorPhone, 40)));
      }
      allow get: if inboundOffice(companyId) && prevData().companyId == companyId;
      allow list: if inboundOffice(companyId) && prevData().companyId == companyId;
      allow update: if resource != null
        && inboundOffice(companyId)
        && prevData().companyId == companyId
        && docData().companyId == companyId
        && prevData().status == "pending"
        && prevData().source == "inbound-forward"
        && docData().messageId == prevData().messageId
        && inboundMoneyFree(docData())
        && (
          (docData().status == "pending"
            && docData().diff(prevData()).affectedKeys().hasOnly(["client", "address", "lot", "street", "suburb", "type", "typeLabel", "costCode", "date", "po", "description", "notes", "supervisorName", "supervisorEmail", "supervisorPhone", "updatedAt"])
            && draftTextOk(docData()))
          || (docData().status == "approved"
            && docData().diff(prevData()).affectedKeys().hasOnly(["client", "address", "lot", "street", "suburb", "type", "typeLabel", "costCode", "date", "po", "description", "notes", "supervisorName", "supervisorEmail", "supervisorPhone", "updatedAt", "status", "jobId", "approvedBy", "approvedAt"])
            && draftTextOk(docData())
            && docData().get("jobId", "") is string
            && docData().get("jobId", "").matches('^fwd[A-Za-z0-9]{8,40}$')
            && docData().approvedBy == request.auth.uid
            && docData().approvedAt == request.time)
          || (docData().status == "discarded"
            && docData().diff(prevData()).affectedKeys().hasOnly(["status", "discardedBy", "discardedAt"])
            && docData().discardedBy == request.auth.uid
            && docData().discardedAt == request.time)
        );
      allow create, delete: if false;
    }
    match /inboundRoutes/{localPart} {
      allow read: if false;
      allow create: if signedIn()
        && inboundMinter(docData().companyId)
        && docData().keys().hasOnly(["companyId", "address", "createdBy", "createdAt"])
        && inboundLocalOk(docData().companyId, localPart)
        && docData().address == localPart + "@inbound.callupapp.com.au"
        && docData().createdBy == request.auth.uid
        && docData().createdAt == request.time;
      allow update, delete: if false;
    }
    match /inboundSeen/{id} {
      allow read, write: if false;
    }
// END INBOUND FORWARD RULES


    // More shared helpers. Same checks as the copies they replace.

    function lvDate(v) {
            return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
          }

    function lvHalves() {
            let next = docData();
            return (next.startHalf == "" || next.startHalf == "am" || next.startHalf == "pm")
              && (next.endHalf == "" || next.endHalf == "am" || next.endHalf == "pm")
              && (
                (next.start == next.end
                  && next.startHalf == next.endHalf)
                || (next.start < next.end
                  && (next.startHalf == "" || next.startHalf == "pm")
                  && (next.endHalf == "" || next.endHalf == "am"))
              );
          }

    function lvCreateBody(id) {
            let next = docData();
            return id.matches('^lv[a-z0-9]{16}$')
              && next.keys().hasOnly(["uid", "name", "type", "start", "end", "startHalf", "endHalf", "reason", "certificatePath", "certificateName", "status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "createdAt", "updatedAt"])
              && next.uid == request.auth.uid
              && textLen(next.name, 1, 80)
              && (next.type == "annual" || next.type == "sick" || next.type == "other")
              && lvDate(next.start)
              && lvDate(next.end)
              && next.end >= next.start
              && lvHalves()
              && textLen(next.reason, 1, 500)
              && lvCertPath(request.auth.uid, id)
              && textMax(next.certificateName, 120)
              && (next.certificatePath == ""
                ? next.certificateName == ""
                : next.certificateName.size() > 0)
              && next.status == "pending"
              && next.decisionNote == ""
              && next.decidedBy == ""
              && next.decidedByName == ""
              && next.decidedAt == null
              && next.createdAt == request.time
              && next.updatedAt == request.time;
          }

    function chatJobId(threadId) { return threadId[4:threadId.size()]; }

    function chatThreadOk(threadId) {
            return threadId == "staff"
              || (textMax(threadId, 210) && threadId.matches('^job_[A-Za-z0-9_-]{1,200}$'));
          }

    function chatCanAccess(tenantId, threadId) {
            return companyOpen(tenantId) && chatThreadOk(threadId) && (
              threadId == "staff"
                ? chatMember(tenantId)
                : chatCanSeeJob(tenantId, chatJobId(threadId))
            );
          }

    function inviteCallerTenant() {
            return isAlex() || isPatrick()
              ? "heartwood"
              : ((signedIn() && hasProfile()) && "tenantId" in profile() && profile().tenantId is string && profile().tenantId.size() > 0
                ? profile().tenantId
                : ((signedIn() && hasProfile()) ? "heartwood" : ""));
          }

    function inviteFullAdmin() {
            return inviteCallerTenant() == "heartwood"
              ? (isAlex() || isPatrick()
                || (exists(/databases/$(database)/documents/heartwoodAdmins/$(request.auth.uid))
                  && (signedIn() && hasProfile()) && profile().get("role", "") == "admin"))
              : ((signedIn() && hasProfile()) && "role" in profile() && profile().role == "admin");
          }

    function lvHeartwood() {
            return signedIn() && (
              isAlex() || isPatrick() || (
                hasProfile() && (!("tenantId" in profile()) || profile().tenantId == "heartwood")
              )
            );
          }

    // Shared helpers. Each used to be copied into several matches.
    // One copy, same checks. Callers and access are unchanged.
    function rcCreateBody(id) {
            let next = docData();
            return id.matches('^rc[a-z0-9]{16}$')
              && next.keys().hasOnly(["uid", "name", "date", "amountCents", "supplier", "category", "notes", "paidWith", "jobId", "jobLabel", "receiptPath", "receiptName", "status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "paidAt", "createdAt", "updatedAt"])
              && next.uid == request.auth.uid
              && textLen(next.name, 1, 80)
              && next.date is string
              && next.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && next.amountCents is int
              && next.amountCents > 0
              && next.amountCents <= 10000000
              && textLen(next.supplier, 1, 120)
              && (next.category == "fuel" || next.category == "tip-fees" || next.category == "parts" || next.category == "tools" || next.category == "consumables" || next.category == "other")
              && textMax(next.notes, 1000)
              && (next.paidWith == "personal-card" || next.paidWith == "cash")
              && next.jobId is string
              && next.jobId.matches('^[A-Za-z0-9_-]{0,80}$')
              && textMax(next.jobLabel, 160)
              && rcReceiptPath(request.auth.uid, id)
              && textMax(next.receiptName, 120)
              && (next.receiptPath == ""
                ? next.receiptName == ""
                : next.receiptName.size() > 0)
              && next.status == "submitted"
              && next.decisionNote == ""
              && next.decidedBy == ""
              && next.decidedByName == ""
              && next.decidedAt == null
              && next.paidAt == null
              && next.createdAt == request.time
              && next.updatedAt == request.time;
          }

    function rcReceiptPath(uid, id) {
            let next = docData();
            return next.receiptPath == ""
              || next.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.pdf"
              || next.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.jpg"
              || next.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.png"
              || next.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.webp";
          }

    function lvDecisionBody() {
            let next = docData();
            let prev = prevData();
            return prev.status == "pending"
              && next.diff(prev).affectedKeys().hasOnly(["status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "updatedAt"])
              && (next.status == "approved" || next.status == "declined")
              && textLen(next.decisionNote, 1, 500)
              && next.decidedBy == request.auth.uid
              && textLen(next.decidedByName, 1, 80)
              && next.decidedAt == request.time
              && next.updatedAt == request.time
              && fieldSame(next, prev, "uid") && fieldSame(next, prev, "name") && fieldSame(next, prev, "type") && fieldSame(next, prev, "start") && fieldSame(next, prev, "end")
              && fieldSame(next, prev, "startHalf") && fieldSame(next, prev, "endHalf") && fieldSame(next, prev, "reason")
              && fieldSame(next, prev, "certificatePath") && fieldSame(next, prev, "certificateName") && same("createdAt");
          }

    function rcDecisionBody() {
            let next = docData();
            let prev = prevData();
            return rcStep()
              && next.diff(prev).affectedKeys().hasOnly(["status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "paidAt", "updatedAt", "hubdocStatus"])
              && (!next.diff(prev).affectedKeys().hasAny(["hubdocStatus"])
                || (next.status == "paid"
                  && next.hubdocStatus == (prev.receiptPath == "" ? "no-receipt" : "queued")))
              && textMax(next.decisionNote, 500)
              && next.decidedBy == request.auth.uid
              && textLen(next.decidedByName, 1, 80)
              && next.decidedAt == request.time
              && next.updatedAt == request.time
              && (next.status == "paid"
                ? next.paidAt == request.time
                : next.paidAt == null);
          }

    function rcStep() {
            let next = docData();
            let prev = prevData();
            return (prev.status == "submitted" && (next.status == "approved" || next.status == "declined" || next.status == "paid"))
              || (prev.status == "approved" && (next.status == "paid" || next.status == "declined"));
          }

    function rcHubdoc() {
            let next = docData();
            let prev = prevData();
            return isSync()
              && prev.status == "paid"
              && next.diff(prev).affectedKeys().hasOnly(["hubdocStatus", "hubdocAttempts", "hubdocUpdatedAt", "hubdocSentAt", "hubdocMessageId", "hubdocVia", "hubdocError"])
              && next.hubdocStatus in ["sending", "sent", "failed", "no-receipt"]
              && next.get("hubdocAttempts", 0) is int
              && next.get("hubdocError", "") is string
              && next.get("hubdocError", "").size() <= 300
              && next.get("hubdocMessageId", "") is string
              && next.get("hubdocMessageId", "").size() <= 100;
          }

    function lvCertPath(uid, id) {
            let next = docData();
            return next.certificatePath == ""
              || next.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.pdf"
              || next.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.jpg"
              || next.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.png"
              || next.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.webp";
          }

    function tsFleetReader(tenantId) {
            return signedIn()
              && tenantId is string
              && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
              && (
                ((isAlex() || isPatrick()) && tenantId == "heartwood")
                || (hasProfile() && (
                  ("tenantId" in profile() && profile().tenantId == tenantId)
                  || (!("tenantId" in profile()) && tenantId == "heartwood")
                ))
              );
          }

    function chatMember(tenantId) {
            return signedIn()
              && tenantId is string
              && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
              && chatCallerTenant() == tenantId;
          }

    function chatCallerTenant() {
            return chatExplicitTenant()
              ? profile().tenantId
              : (((signedIn() && hasProfile()) || isAlex() || isPatrick()) ? "heartwood" : "");
          }

    function chatCanSeeJob(tenantId, jobId) {
            return signedIn()
              && textLen(jobId, 1, 200)
              && chatJobTenant(jobId) == tenantId
              && ((tenantId == "heartwood" && (isAlex() || isPatrick())) || chatAccountCanSee(tenantId, jobId));
          }

    function chatAccountCanSee(tenantId, jobId) {
            return (signedIn() && hasProfile())
              && chatAccountTenant() == tenantId
              && (("role" in profile() && profile().role == "admin") || chatAssigned(jobId))
              && chatCustomerOk(jobId);
          }

    function chatCustomerOk(jobId) {
            return !(signedIn() && hasProfile())
              || !("customerIds" in profile())
              || !(profile().customerIds is list)
              || profile().customerIds.size() == 0
              || ("client" in chatJob(jobId) && chatJob(jobId).client is string && chatJob(jobId).client in profile().customerIds);
          }

    function chatJob(jobId) { return get(chatJobPath(jobId)).data; }

    function chatJobPath(jobId) { return /databases/$(database)/documents/jobs/$(jobId); }

    function chatAssigned(jobId) {
            return "assigned" in chatJob(jobId) && chatJob(jobId).assigned is list && request.auth.uid in chatJob(jobId).assigned;
          }

    function chatAccountTenant() {
            return chatExplicitTenant() ? profile().tenantId : "heartwood";
          }

    function chatJobTenant(jobId) {
            return "tenantId" in chatJob(jobId) && chatJob(jobId).tenantId is string && chatJob(jobId).tenantId.size() > 0
              ? chatJob(jobId).tenantId
              : "heartwood";
          }

    // Phone errors. A signed-in member of this company may create one record.
    // Only an admin of this company may read. The client cannot update or delete.
    // No prices, tokens, or GPS. The phone truncates the text; these limits are the backstop.
    match /companies/{companyId}/clientErrors/{errorId} {
      function clientErrorMember(companyId) {
        return signedIn()
          && companyId == callerCompany()
          && companyId.size() > 1
          && companyId.size() <= 40;
      }
      function clientErrorAdmin(companyId) {
        return clientErrorMember(companyId) && (
          (companyId == "heartwood" && isAdmin())
          || (hasProfile() && profile().get("role", "") == "admin")
          || platformOwner()
        );
      }
      function clientErrorCreate(companyId) {
        let d = request.resource.data;
        return clientErrorMember(companyId)
          && errorId.matches('^[A-Za-z0-9]{1,40}$')
          && d.keys().hasOnly(["createdAt", "uid", "role", "appVersion", "swVersion", "screen", "message", "stack", "userAgent", "online"])
          && d.createdAt == request.time
          && d.uid == request.auth.uid
          && d.role is string && d.role.size() <= 40
          && d.appVersion is string && d.appVersion.size() <= 80
          && d.swVersion is string && d.swVersion.size() <= 80
          && d.screen is string && d.screen.size() <= 120
          && d.message is string && d.message.size() > 0 && d.message.size() <= 500
          && d.stack is string && d.stack.size() <= 2048
          && d.userAgent is string && d.userAgent.size() <= 300
          && d.online is bool;
      }

      allow get, list: if clientErrorAdmin(companyId);
      allow create: if clientErrorCreate(companyId);
      allow update, delete: if false;
    }

    // Support tickets. The person who raised it can create and read their own.
    // The platform owner (Master) can list, read and close every ticket.
    // Another company, and another person in the same company, cannot read it.
    // No prices are stored here. The screenshot path is empty or this ticket's file.
    match /supportTickets/{ticketId} {
      function ticketOwn() {
        return signedIn()
          && prevData().uid == request.auth.uid
          && prevData().companyId == callerCompany();
      }
      function ticketCreate() {
        let d = docData();
        let company = callerCompany();
        return signedIn()
          && ticketId.matches('^[A-Za-z0-9]{16,28}$')
          && company is string && company.size() > 1 && company.size() <= 40
          && d.keys().hasOnly(["subject", "description", "uid", "name", "email", "role", "companyId", "companyName", "appVersion", "swVersion", "userAgent", "page", "createdAt", "status", "screenshotPath"])
          &&textLen(d.subject, 1, 120)
          &&textLen(d.description, 1, 4000)
          && d.uid == request.auth.uid
          &&textMax(d.name, 80)
          &&textMax(d.email, 120)
          &&textMax(d.role, 40)
          && d.companyId == company
          &&textMax(d.companyName, 80)
          &&textMax(d.appVersion, 80)
          &&textMax(d.swVersion, 80)
          &&textMax(d.userAgent, 300)
          &&textMax(d.page, 200)
          && d.createdAt == request.time
          && d.status == "open"
          &&textMax(d.screenshotPath, 240)
          && (d.screenshotPath == "" || d.screenshotPath == "supportTickets/" + company + "/" + request.auth.uid + "/" + ticketId + "/shot.jpg");
      }

      allow create: if ticketCreate();
      allow get, list: if platformOwner() || ticketOwn();
      allow update: if platformOwner()
        && docData().diff(prevData()).affectedKeys().hasOnly(["status", "updatedAt"])
        && docData().status in ["open", "closed"]
        && docData().updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
