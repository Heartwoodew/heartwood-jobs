// BEGIN TIMESHEET HELPERS (definitions the TIMESHEET block needs; copied from cloud/emulator/firestore.rules)
    function isAlex() { return request.auth != null && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function isPatrick() { return request.auth != null && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
