          && (!("finish" in ch) || (a.finish is string && a.finish.size() <= 5))
          && (!("note" in ch) || (a.note is string && a.note.size() <= 200))
          && (!("job" in ch) || (a.job is string && a.job.size() <= 200))
          && (!("enteredByName" in ch) || (a.enteredByName is string && a.enteredByName.size() > 0 && a.enteredByName.size() <= 80))
