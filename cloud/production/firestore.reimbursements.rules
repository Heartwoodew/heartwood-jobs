// BEGIN REIMBURSEMENT CLAIM RULES
    function rcSignedIn() { return request.auth != null; }
    function rcStaff() {
      return rcSignedIn() && (
        isAlex() || isPatrick() || (
          hasProfile() && callerCompany() == "heartwood"
        ) || (
          callerCompany() != "heartwood" && callerCompany() != "" && hasProfile()
        )
      );
    }
    function rcAdmin() {
      return rcStaff() && (isAlex() || isPatrick() || (hasProfile() && (profile().role == "admin" || profile().role == "manager")));
    }
    function rcReceiptPath(uid, id) {
      let next = docData();
      return next.receiptPath == ""
        || next.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.pdf"
        || next.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.jpg"
        || next.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.png"
        || next.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.webp";
    }
    function rcCreate(id) {
      return rcStaff()
        && id.matches('^rc[a-z0-9]{16}$')
        && docData().keys().hasOnly(["uid", "name", "date", "amountCents", "supplier", "category", "notes", "paidWith", "jobId", "jobLabel", "receiptPath", "receiptName", "status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "paidAt", "createdAt", "updatedAt", "companyId"])
        && (!("companyId" in docData()) || docData().companyId == callerCompany())
        && docData().uid == request.auth.uid
        && textLen(docData().name, 1, 80)
        && docData().date is string
        && docData().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && docData().amountCents is int
        && docData().amountCents > 0
        && docData().amountCents <= 10000000
        && textLen(docData().supplier, 1, 120)
        && (docData().category == "fuel" || docData().category == "tip-fees" || docData().category == "parts" || docData().category == "tools" || docData().category == "consumables" || docData().category == "other")
        && textMax(docData().notes, 1000)
        && (docData().paidWith == "personal-card" || docData().paidWith == "cash")
        && docData().jobId is string
        && docData().jobId.matches('^[A-Za-z0-9_-]{0,80}$')
        && textMax(docData().jobLabel, 160)
        && rcReceiptPath(request.auth.uid, id)
        && textMax(docData().receiptName, 120)
        && (docData().receiptPath == ""
          ? docData().receiptName == ""
          : docData().receiptName.size() > 0)
        && docData().status == "submitted"
        && docData().decisionNote == ""
        && docData().decidedBy == ""
        && docData().decidedByName == ""
        && docData().decidedAt == null
        && docData().paidAt == null
        && docData().createdAt == request.time
        && docData().updatedAt == request.time;
    }
    function rcStep() {
      let next = docData();
      let prev = prevData();
      return (prev.status == "submitted" && (next.status == "approved" || next.status == "declined" || next.status == "paid"))
        || (prev.status == "approved" && (next.status == "paid" || next.status == "declined"));
    }
    function rcDecision() {
      return rcAdmin()
        && rcStep()
        && docData().diff(prevData()).affectedKeys().hasOnly(["status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "paidAt", "updatedAt", "hubdocStatus"])
        && (!docData().diff(prevData()).affectedKeys().hasAny(["hubdocStatus"])
          || (docData().status == "paid"
            && docData().hubdocStatus == (prevData().receiptPath == "" ? "no-receipt" : "queued")))
        && textMax(docData().decisionNote, 500)
        && docData().decidedBy == request.auth.uid
        && textLen(docData().decidedByName, 1, 80)
        && docData().decidedAt == request.time
        && docData().updatedAt == request.time
        && (docData().status == "paid"
          ? docData().paidAt == request.time
          : docData().paidAt == null);
    }

    // Hubdoc filer: the box sync account (tools/hubdoc_filer.py) reads paid claims and records only the Hubdoc
    // send state. It cannot change the claim itself, and only on claims that are already paid.
    function rcSync() { return rcSignedIn() && request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2"; }
    function rcHubdoc() {
      let next = docData();
      let prev = prevData();
      return rcSync()
        && prev.status == "paid"
        && next.diff(prev).affectedKeys().hasOnly(["hubdocStatus", "hubdocAttempts", "hubdocUpdatedAt", "hubdocSentAt", "hubdocMessageId", "hubdocVia", "hubdocError"])
        && next.hubdocStatus in ["sending", "sent", "failed", "no-receipt"]
        && next.get("hubdocAttempts", 0) is int
        && next.get("hubdocError", "") is string
        && next.get("hubdocError", "").size() <= 300
        && next.get("hubdocMessageId", "") is string
        && next.get("hubdocMessageId", "").size() <= 100;
    }

    match /reimbursementClaims/{id} {
      allow get: if (rcSync() && resource != null && prevData().status == "paid")
        || (rcStaff() && callerCompany() == "heartwood" && (
          (resource == null && id.matches('^rc[a-z0-9]{16}$'))
          || (resource != null && docCompany(prevData()) == "heartwood" && (rcAdmin() || prevData().uid == request.auth.uid))
        ))
        || (callerCompany() != "heartwood" && resource != null && prevData().companyId == callerCompany()
          && (prevData().uid == request.auth.uid || (hasProfile() && (profile().role == "admin" || profile().role == "manager"))));
      allow list: if rcStaff() && callerCompany() == "heartwood" && prevData().uid == request.auth.uid;
      allow list: if rcAdmin() && callerCompany() == "heartwood" && prevData().companyId == "heartwood";
      allow list: if rcSync() && prevData().status == "paid";
      allow list: if callerCompany() != "heartwood" && prevData().companyId == callerCompany()
        && (prevData().uid == request.auth.uid || (hasProfile() && (profile().role == "admin" || profile().role == "manager")));
      allow create: if rcCreate(id) && (
        callerCompany() == "heartwood" || docData().companyId == callerCompany()
      );
      allow update: if (rcDecision() && docCompany(prevData()) == callerCompany()) || rcHubdoc();
      allow delete: if false;
    }
// END REIMBURSEMENT CLAIM RULES
