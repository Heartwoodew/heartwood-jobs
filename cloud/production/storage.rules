rules_version = '2';
// EMULATOR AND PROPOSED STORAGE RULES.
// Do not deploy until the owner completes cloud/MIGRATION.md.
// Job-photo list stays on canSeeJob. Object read does not: repeated jobData()
// calls are counted on get and production denies them, while list still caches.
// Receipts, finance and exports are unchanged. Delete stays off for those,
// and for job photos. Chat photos are a separate path: the uploader or an
// admin of that tenant may delete one. No public download tokens.
// Do not deploy this file from the app. The reviewed command is storage-only.
// A matching path, file name, or client metadata tenantId is not enough.
// The caller must be a member of that tenant via their profile (missing tenantId
// means Heartwood, including existing staff). Job photos also require the job
// record. Receipts require the receipt record. Finance files are not a Base
// feature: on Heartwood they follow the existing Xero UID list (Alex, Patrick).
// Any other tenant would need a server-written tenants/{id}.financeUids list,
// which this branch does not create.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAlex() { return signedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function isPatrick() { return signedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function userPath() { return /databases/(default)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && firestore.exists(userPath()); }
    function profile() { return firestore.get(userPath()).data; }
    function explicitTenant() {
      return hasProfile() && "tenantId" in profile() && profile().tenantId is string && profile().tenantId.size() > 0;
    }
    function callerTenant() {
      return explicitTenant() ? profile().tenantId : ((hasProfile() || isAlex() || isPatrick()) ? "heartwood" : "");
    }
    function member(tenantId) {
      return signedIn() && tenantId is string && tenantId.size() > 0 && callerTenant() == tenantId;
    }
    function rulesAdmin() {
      return isAlex() || isPatrick() || (hasProfile() && "role" in profile() && profile().role == "admin");
    }
    function canSeeMoney() {
      return rulesAdmin() || (hasProfile() && "role" in profile() && profile().role == "supervisor");
    }
    // Production allows two Firestore accesses per evaluation. exists() and get()
    // on the same path each count, and the emulator's cap is higher, so it did
    // not catch this. Job photos therefore use one get of the job and, only for
    // a non-bootstrap account, one get of that user. A missing profile is not read.
    function jobPath(jobId) { return /databases/(default)/documents/jobs/$(jobId); }
    function jobData(jobId) { return firestore.get(jobPath(jobId)).data; }
    function userData() { return firestore.get(userPath()).data; }
    function jobTenant(jobId) {
      return "tenantId" in jobData(jobId) && jobData(jobId).tenantId is string && jobData(jobId).tenantId.size() > 0
        ? jobData(jobId).tenantId : "heartwood";
    }
    function accountTenant() {
      return "tenantId" in userData() && userData().tenantId is string && userData().tenantId.size() > 0
        ? userData().tenantId : "heartwood";
    }
    function accountAssigned(jobId) {
      return "assigned" in jobData(jobId) && jobData(jobId).assigned is list && request.auth.uid in jobData(jobId).assigned;
    }
    function accountCustomerOk(jobId) {
      return !("customerIds" in userData())
        || !(userData().customerIds is list)
        || userData().customerIds.size() == 0
        || ("client" in jobData(jobId) && jobData(jobId).client is string && jobData(jobId).client in userData().customerIds);
    }
    function accountCanSee(tenantId, jobId) {
      return accountTenant() == tenantId
        && (("role" in userData() && userData().role == "admin") || accountAssigned(jobId))
        && accountCustomerOk(jobId);
    }
    function canSeeJob(tenantId, jobId) {
      return signedIn() && tenantId is string && tenantId.size() > 0
        && jobTenant(jobId) == tenantId
        && ((tenantId == "heartwood" && (isAlex() || isPatrick())) || accountCanSee(tenantId, jobId));
    }
    // Object read must not call canSeeJob. That helper calls jobData() once per field.
    // Production counts each call on getMetadata/getBlob and denies the read once the
    // two-document cap is passed. list still caches those calls, so the folder lists
    // and the gallery hides the storage/unauthorized as an empty set. Bootstrap admins
    // read with no Firestore access. Assigned staff use one get of the job. A missing
    // user profile is not read: that get throws and would deny the admin allow too.
    function jobPhotoStaff(tenantId, jobId) {
      let job = firestore.get(jobPath(jobId)).data;
      let jobTenant = "tenantId" in job && job.tenantId is string && job.tenantId.size() > 0 ? job.tenantId : "heartwood";
      let assigned = "assigned" in job && job.assigned is list && request.auth.uid in job.assigned;
      return signedIn() && tenantId is string && tenantId.size() > 0 && jobTenant == tenantId && assigned;
    }
    function jobPhotoFile(tenantId, jobId) {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.jobId == jobId
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.purpose == "job-photo"
        && request.resource.metadata.batchCount is string
        && int(request.resource.metadata.batchCount) >= 1
        && int(request.resource.metadata.batchCount) <= 10;
    }

    match /tenants/{tenantId}/jobs/{jobId}/photos {
      allow list: if canSeeJob(tenantId, jobId);
    }

    match /tenants/{tenantId}/jobs/{jobId}/photos/{file} {
      allow read: if signedIn() && tenantId == "heartwood" && (isAlex() || isPatrick());
      allow read: if jobPhotoStaff(tenantId, jobId);
      allow create, update: if canSeeJob(tenantId, jobId) && jobPhotoFile(tenantId, jobId);
      allow delete: if false;
    }

    function receiptPath(id) { return /databases/(default)/documents/receipts/$(id); }
    function receiptExists(id) { return firestore.exists(receiptPath(id)); }
    function receiptData(id) { return firestore.get(receiptPath(id)).data; }
    function receiptTenant(id) {
      return receiptExists(id) && "tenantId" in receiptData(id) && receiptData(id).tenantId is string && receiptData(id).tenantId.size() > 0
        ? receiptData(id).tenantId : "heartwood";
    }
    function ownsReceipt(id) {
      return receiptExists(id) && receiptData(id).uid == request.auth.uid;
    }
    function receiptFile(tenantId, receiptId) {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.receiptId == receiptId
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.purpose == "receipt";
    }
    function canReadReceipt(tenantId, receiptId) {
      return member(tenantId) && receiptExists(receiptId) && receiptTenant(receiptId) == tenantId && (
        (isAlex() && callerTenant() == tenantId)
        || (ownsReceipt(receiptId) && canSeeMoney())
      );
    }

    match /tenants/{tenantId}/receipts/{receiptId}/original {
      allow read: if canReadReceipt(tenantId, receiptId);
      allow create, update: if member(tenantId) && ownsReceipt(receiptId) && receiptTenant(receiptId) == tenantId && receiptFile(tenantId, receiptId);
      allow delete: if false;
    }

    function heartwoodFinance() { return isAlex() || isPatrick(); }
    function listedFinance(tenantId) {
      return firestore.exists(/databases/(default)/documents/tenants/$(tenantId))
        && "financeUids" in firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data
        && firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.financeUids is list
        && request.auth.uid in firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.financeUids;
    }
    function canReadFinance(tenantId) {
      return member(tenantId) && (tenantId == "heartwood" ? heartwoodFinance() : listedFinance(tenantId));
    }

    match /tenants/{tenantId}/finance/{allPaths=**} {
      allow read: if canReadFinance(tenantId);
      allow write: if false;
    }

    match /tenants/{tenantId}/_exports/{allPaths=**} {
      allow read: if member(tenantId) && rulesAdmin();
      allow write: if false;
    }

    // Chat photos. Private blobs only: the app reads them with getBlob.
    // Staff thread: any member of the tenant. Job thread: canSeeJob (admin or
    // assigned, same customer scope as job photos). Two Firestore reads max.
    function chatPhotoBytes() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024;
    }
    function chatStaffFile(tenantId) {
      return chatPhotoBytes()
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.threadId == "staff"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.purpose == "chat-photo";
    }
    function chatJobFile(tenantId, jobId) {
      return chatPhotoBytes()
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.jobId == jobId
        && request.resource.metadata.threadId == "job_" + jobId
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.purpose == "chat-photo";
    }
    function chatNameOk(file) {
      return file.matches('^c[A-Za-z0-9]{8,40}$');
    }

    match /tenants/{tenantId}/chat/staff/photos {
      allow list: if member(tenantId);
    }
    match /tenants/{tenantId}/chat/staff/photos/{file} {
      allow read: if member(tenantId);
      allow create: if member(tenantId) && chatNameOk(file) && chatStaffFile(tenantId);
      allow update: if false;
      allow delete: if member(tenantId) && chatNameOk(file) && resource.metadata.purpose == "chat-photo"
        && (
          resource.metadata.uploaderUid == request.auth.uid
          || isAlex() || isPatrick()
          || (hasProfile() && "role" in profile() && profile().role == "admin")
        );
    }

    match /tenants/{tenantId}/chat/jobs/{jobId}/photos {
      allow list: if canSeeJob(tenantId, jobId);
    }
    match /tenants/{tenantId}/chat/jobs/{jobId}/photos/{file} {
      allow read: if canSeeJob(tenantId, jobId);
      allow create: if canSeeJob(tenantId, jobId) && chatNameOk(file) && chatJobFile(tenantId, jobId);
      allow update: if false;
      allow delete: if canSeeJob(tenantId, jobId) && chatNameOk(file) && resource.metadata.purpose == "chat-photo"
        && (
          resource.metadata.uploaderUid == request.auth.uid
          || isAlex() || isPatrick()
          || ("role" in userData() && userData().role == "admin")
        );
    }

// BEGIN LEAVE CERTIFICATE RULES
    function lvCertSignedIn() { return request.auth != null; }
    function lvCertIsAlex() { return lvCertSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function lvCertIsPatrick() { return lvCertSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function lvCertUserPath() { return /databases/(default)/documents/users/$(request.auth.uid); }
    function lvCertAdmin() {
      return lvCertIsAlex() || lvCertIsPatrick() || (
        lvCertSignedIn() && firestore.get(lvCertUserPath()).data.get("role", "") == "admin"
      );
    }
    function lvCertFile(uid, requestId, file) {
      return request.auth.uid == uid
        && requestId.matches('^lv[a-z0-9]{16}$')
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.metadata.purpose == "leave-certificate"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.requestId == requestId
        && (
          (file == "cert.pdf" && request.resource.contentType == "application/pdf")
          || (file == "cert.jpg" && request.resource.contentType == "image/jpeg")
          || (file == "cert.png" && request.resource.contentType == "image/png")
          || (file == "cert.webp" && request.resource.contentType == "image/webp")
        );
    }
    function lvCertReader(uid) {
      return lvCertSignedIn() && (request.auth.uid == uid || lvCertAdmin());
    }

    match /leaveCertificates/{uid}/{requestId} {
      allow list: if lvCertReader(uid);
    }
    match /leaveCertificates/{uid}/{requestId}/{file} {
      allow read: if lvCertReader(uid);
      allow create: if lvCertSignedIn() && lvCertFile(uid, requestId, file);
      allow update, delete: if false;
    }
// END LEAVE CERTIFICATE RULES

// BEGIN REIMBURSEMENT RECEIPT RULES
    function rcFileSignedIn() { return request.auth != null; }
    function rcFileIsAlex() { return rcFileSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function rcFileIsPatrick() { return rcFileSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function rcFileAdmin() {
      return rcFileIsAlex() || rcFileIsPatrick() || (
        rcFileSignedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin"
      );
    }
    function rcFileOk(uid, claimId, file) {
      return request.auth.uid == uid
        && claimId.matches('^rc[a-z0-9]{16}$')
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.metadata.purpose == "reimbursement-receipt"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.claimId == claimId
        && (
          (file == "receipt.pdf" && request.resource.contentType == "application/pdf")
          || (file == "receipt.jpg" && request.resource.contentType == "image/jpeg")
          || (file == "receipt.png" && request.resource.contentType == "image/png")
          || (file == "receipt.webp" && request.resource.contentType == "image/webp")
        );
    }
    function rcFileReader(uid) {
      // 38SU... is the box sync account; it reads receipts only to email paid claims to Hubdoc.
      return rcFileSignedIn() && (request.auth.uid == uid || rcFileAdmin() || request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2");
    }

    match /reimbursements/{uid}/{claimId}/{file} {
      allow read: if rcFileReader(uid);
      allow create: if rcFileSignedIn() && rcFileOk(uid, claimId, file);
      allow update, delete: if false;
    }
// END REIMBURSEMENT RECEIPT RULES

// BEGIN HOURS EXPORT FILE RULES
    function hxFileSignedIn() { return request.auth != null; }
    function hxFileAdmin() {
      return hxFileSignedIn() && (
        request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2" || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin"
      );
    }
    match /hoursExports/{exportId}/{file} {
      // 38SU... is the box sync account; it reads the file only to email it to accounts@heartwoodew.com.
      allow read: if hxFileAdmin() || (hxFileSignedIn() && request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2");
      allow create: if hxFileAdmin()
        && exportId.matches('^hx[a-z0-9]{16}$')
        && file.matches('^[A-Za-z0-9_-]{1,80}[.]xlsx$')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        && request.resource.metadata.purpose == "hours-export"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.exportId == exportId;
      allow update, delete: if false;
    }
// END HOURS EXPORT FILE RULES
  }
}
