rules_version = '2';
// EMULATOR AND PROPOSED STORAGE RULES.
// Do not deploy until the owner completes cloud/MIGRATION.md.
// Job-photo list uses canListJobPhotos (company match, not canSeeJob). Object
// read does not call canSeeJob: repeated jobData() calls are counted on get and
// production denies them, while list still caches.
// Receipts, finance and exports are unchanged. Delete stays off for those,
// and for job photos. Chat photos are a separate path: the uploader or an
// admin of that tenant may delete one. No public download tokens.
// Do not deploy this file from the app. The reviewed command is storage-only.
// A matching path, file name, or client metadata tenantId is not enough.
// The caller must be a member of that tenant via their profile (missing tenantId
// means Heartwood, including existing staff). Job photos also require the job
// record. Receipts require the receipt record. Finance files are not a Base
// feature: on Heartwood they follow the existing Xero UID list (Alex, Patrick).
// Any other tenant would need a server-written tenants/{id}.financeUids list,
// which this branch does not create.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAlex() { return signedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function isPatrick() { return signedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function userPath() { return /databases/(default)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && firestore.exists(userPath()); }
    function profile() { return firestore.get(userPath()).data; }
    function explicitTenant() {
      return hasProfile() && "tenantId" in profile() && profile().tenantId is string && profile().tenantId.size() > 0;
    }
    function explicitCompany() {
      return hasProfile() && "companyId" in profile() && profile().companyId is string && profile().companyId.size() > 0;
    }
    function callerTenant() {
      return explicitCompany() ? profile().companyId
        : (explicitTenant() ? profile().tenantId : ((hasProfile() || isAlex() || isPatrick()) ? "heartwood" : ""));
    }
    function storagePlatformOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == "alex@heartwoodew.com"
        && (request.auth.token.platformOwner == true || request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2");
    }
    function userCompanyOf(uid) {
      let path = /databases/(default)/documents/users/$(uid);
      return !firestore.exists(path)
        ? "heartwood"
        : ("companyId" in firestore.get(path).data && firestore.get(path).data.companyId is string && firestore.get(path).data.companyId.size() > 0
          ? firestore.get(path).data.companyId
          : ("tenantId" in firestore.get(path).data && firestore.get(path).data.tenantId is string && firestore.get(path).data.tenantId.size() > 0
            ? firestore.get(path).data.tenantId
            : "heartwood"));
    }
    function member(tenantId) {
      return signedIn() && tenantId is string && tenantId.size() > 0 && callerTenant() == tenantId;
    }
    function rulesAdmin() {
      return isAlex() || isPatrick() || (hasProfile() && "role" in profile() && profile().role == "admin");
    }
    function canSeeMoney() {
      return rulesAdmin() || (hasProfile() && "role" in profile() && profile().role in ["supervisor", "manager"]);
    }
    // Production allows two Firestore accesses per evaluation. exists() and get()
    // on the same path each count, and the emulator's cap is higher, so it did
    // not catch this. Job photos therefore use one get of the job and, only for
    // a non-bootstrap account, one get of that user. A missing profile is not read.
    function jobPath(jobId) { return /databases/(default)/documents/jobs/$(jobId); }
    function jobData(jobId) { return firestore.get(jobPath(jobId)).data; }
    function userData() { return firestore.get(userPath()).data; }
    function jobTenant(jobId) {
      return "tenantId" in jobData(jobId) && jobData(jobId).tenantId is string && jobData(jobId).tenantId.size() > 0
        ? jobData(jobId).tenantId : "heartwood";
    }
    function accountTenant() {
      return "tenantId" in userData() && userData().tenantId is string && userData().tenantId.size() > 0
        ? userData().tenantId : "heartwood";
    }
    function accountAssigned(jobId) {
      return "assigned" in jobData(jobId) && jobData(jobId).assigned is list && request.auth.uid in jobData(jobId).assigned;
    }
    function accountCustomerOk(jobId) {
      return !("customerIds" in userData())
        || !(userData().customerIds is list)
        || userData().customerIds.size() == 0
        || ("client" in jobData(jobId) && jobData(jobId).client is string && jobData(jobId).client in userData().customerIds);
    }
    function accountCanSee(tenantId, jobId) {
      return accountTenant() == tenantId
        && (("role" in userData() && userData().role == "admin") || accountAssigned(jobId))
        && accountCustomerOk(jobId);
    }
    function canSeeJob(tenantId, jobId) {
      return signedIn() && tenantId is string && tenantId.size() > 0
        && jobTenant(jobId) == tenantId
        && ((tenantId == "heartwood" && (isAlex() || isPatrick())) || accountCanSee(tenantId, jobId));
    }
    // Object read must not call canSeeJob. That helper calls jobData() once per field.
    // Production counts each call on getMetadata/getBlob and denies the read once the
    // two-document cap is passed. list still caches those calls. Bootstrap admins
    // (Alex, Patrick on heartwood) read with no Firestore access. Everyone else uses
    // one get of the job and one get of the user. A missing profile is not read on
    // the bootstrap allow: that get throws and would deny it too.
    // Company is companyId, then tenantId, then heartwood, so legacy Heartwood jobs
    // and staff with neither field still match. A set companyId wins over tenantId.
    // Path tenant, job company and the caller's company must be the same. Access is
    // assigned staff, or supervisor/manager/admin. Customer scope still applies.
    function jobCompanyOf(jobId) {
      let job = jobData(jobId);
      return "companyId" in job && job.companyId is string && job.companyId.size() > 0
        ? job.companyId
        : ("tenantId" in job && job.tenantId is string && job.tenantId.size() > 0 ? job.tenantId : "heartwood");
    }
    function memberCompany() {
      let user = userData();
      return "companyId" in user && user.companyId is string && user.companyId.size() > 0
        ? user.companyId
        : ("tenantId" in user && user.tenantId is string && user.tenantId.size() > 0 ? user.tenantId : "heartwood");
    }
    function photoCustomerOk(jobId) {
      return !("customerIds" in userData())
        || !(userData().customerIds is list)
        || userData().customerIds.size() == 0
        || ("client" in jobData(jobId) && jobData(jobId).client is string && jobData(jobId).client in userData().customerIds);
    }
    function photoPermitted(jobId) {
      let office = "role" in userData() && userData().role in ["supervisor", "manager", "admin"];
      return office || accountAssigned(jobId);
    }
    function canListJobPhotos(tenantId, jobId) {
      return signedIn() && tenantId is string && tenantId.size() > 0
        && jobCompanyOf(jobId) == tenantId
        && (
          (tenantId == "heartwood" && (isAlex() || isPatrick()))
          || (memberCompany() == tenantId && photoPermitted(jobId) && photoCustomerOk(jobId))
        );
    }
    function jobPhotoReader(tenantId, jobId) {
      let job = firestore.get(jobPath(jobId)).data;
      let user = firestore.get(userPath()).data;
      let jobCompany = "companyId" in job && job.companyId is string && job.companyId.size() > 0
        ? job.companyId
        : ("tenantId" in job && job.tenantId is string && job.tenantId.size() > 0 ? job.tenantId : "heartwood");
      let userCompany = "companyId" in user && user.companyId is string && user.companyId.size() > 0
        ? user.companyId
        : ("tenantId" in user && user.tenantId is string && user.tenantId.size() > 0 ? user.tenantId : "heartwood");
      let assigned = "assigned" in job && job.assigned is list && request.auth.uid in job.assigned;
      let office = "role" in user && user.role in ["supervisor", "manager", "admin"];
      let customerOk = !("customerIds" in user)
        || !(user.customerIds is list)
        || user.customerIds.size() == 0
        || ("client" in job && job.client is string && job.client in user.customerIds);
      return tenantId is string && tenantId.size() > 0
        && jobCompany == tenantId && userCompany == tenantId
        && (assigned || office) && customerOk;
    }
    function jobPhotoFile(tenantId, jobId) {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.jobId == jobId
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.purpose == "job-photo"
        && request.resource.metadata.batchCount is string
        && int(request.resource.metadata.batchCount) >= 1
        && int(request.resource.metadata.batchCount) <= 10;
    }

    match /tenants/{tenantId}/jobs/{jobId}/photos {
      allow list: if canListJobPhotos(tenantId, jobId);
    }

    match /tenants/{tenantId}/jobs/{jobId}/photos/{file} {
      allow read: if signedIn() && tenantId == "heartwood" && (isAlex() || isPatrick());
      allow read: if signedIn() && !(tenantId == "heartwood" && (isAlex() || isPatrick())) && jobPhotoReader(tenantId, jobId);
      allow create, update: if canSeeJob(tenantId, jobId) && jobPhotoFile(tenantId, jobId);
      allow delete: if false;
    }

    function receiptPath(id) { return /databases/(default)/documents/receipts/$(id); }
    function receiptExists(id) { return firestore.exists(receiptPath(id)); }
    function receiptData(id) { return firestore.get(receiptPath(id)).data; }
    function receiptTenant(id) {
      return receiptExists(id) && "tenantId" in receiptData(id) && receiptData(id).tenantId is string && receiptData(id).tenantId.size() > 0
        ? receiptData(id).tenantId : "heartwood";
    }
    function ownsReceipt(id) {
      return receiptExists(id) && receiptData(id).uid == request.auth.uid;
    }
    function receiptFile(tenantId, receiptId) {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.receiptId == receiptId
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.purpose == "receipt";
    }
    function canReadReceipt(tenantId, receiptId) {
      return member(tenantId) && receiptExists(receiptId) && receiptTenant(receiptId) == tenantId && (
        (isAlex() && callerTenant() == tenantId)
        || (ownsReceipt(receiptId) && canSeeMoney())
      );
    }

    match /tenants/{tenantId}/receipts/{receiptId}/original {
      allow read: if canReadReceipt(tenantId, receiptId);
      allow create, update: if member(tenantId) && ownsReceipt(receiptId) && receiptTenant(receiptId) == tenantId && receiptFile(tenantId, receiptId);
      allow delete: if false;
    }

    function heartwoodFinance() { return isAlex() || isPatrick(); }
    function listedFinance(tenantId) {
      return firestore.exists(/databases/(default)/documents/tenants/$(tenantId))
        && "financeUids" in firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data
        && firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.financeUids is list
        && request.auth.uid in firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.financeUids;
    }
    function canReadFinance(tenantId) {
      return member(tenantId) && (tenantId == "heartwood" ? heartwoodFinance() : listedFinance(tenantId));
    }

    match /tenants/{tenantId}/finance/{allPaths=**} {
      allow read: if canReadFinance(tenantId);
      allow write: if false;
    }

    match /tenants/{tenantId}/_exports/{allPaths=**} {
      allow read: if member(tenantId) && rulesAdmin();
      allow write: if false;
    }

    // Chat photos. Private blobs only: the app reads them with getBlob.
    // Staff thread: any member of the tenant. Job thread: canSeeJob (admin or
    // assigned, same customer scope as job photos). Two Firestore reads max.
    function chatPhotoBytes() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024;
    }
    function chatStaffFile(tenantId) {
      return chatPhotoBytes()
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.threadId == "staff"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.purpose == "chat-photo";
    }
    function chatJobFile(tenantId, jobId) {
      return chatPhotoBytes()
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.jobId == jobId
        && request.resource.metadata.threadId == "job_" + jobId
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.purpose == "chat-photo";
    }
    function chatNameOk(file) {
      return file.matches('^c[A-Za-z0-9]{8,40}$');
    }

    match /tenants/{tenantId}/chat/staff/photos {
      allow list: if member(tenantId);
    }
    match /tenants/{tenantId}/chat/staff/photos/{file} {
      allow read: if member(tenantId);
      allow create: if member(tenantId) && chatNameOk(file) && chatStaffFile(tenantId);
      allow update: if false;
      allow delete: if member(tenantId) && chatNameOk(file) && resource.metadata.purpose == "chat-photo"
        && (
          resource.metadata.uploaderUid == request.auth.uid
          || isAlex() || isPatrick()
          || (hasProfile() && "role" in profile() && profile().role == "admin")
        );
    }

    // Job-thread chat photo object read: one get of the job and one get of the
    // caller. That is the production cap, so do not call canSeeJob. Admins of
    // the same company are allowed; staff still need to be assigned and, when
    // set, inside their customer scope.
    function jobChatPhotoReader(tenantId, jobId) {
      let job = firestore.get(jobPath(jobId)).data;
      let user = firestore.get(userPath()).data;
      let jobTenant = "tenantId" in job && job.tenantId is string && job.tenantId.size() > 0 ? job.tenantId : "heartwood";
      let accountCompany = "companyId" in user && user.companyId is string && user.companyId.size() > 0
        ? user.companyId
        : ("tenantId" in user && user.tenantId is string && user.tenantId.size() > 0 ? user.tenantId : "heartwood");
      let assigned = "assigned" in job && job.assigned is list && request.auth.uid in job.assigned;
      let isAdmin = "role" in user && user.role == "admin";
      let customerOk = !("customerIds" in user) || !(user.customerIds is list) || user.customerIds.size() == 0
        || ("client" in job && job.client is string && job.client in user.customerIds);
      return signedIn() && tenantId is string && tenantId.size() > 0
        && jobTenant == tenantId && accountCompany == tenantId
        && (isAdmin || assigned) && customerOk;
    }
    match /tenants/{tenantId}/chat/jobs/{jobId}/photos {
      allow list: if canSeeJob(tenantId, jobId);
    }
    match /tenants/{tenantId}/chat/jobs/{jobId}/photos/{file} {
      allow read: if signedIn() && tenantId == "heartwood" && (isAlex() || isPatrick());
      allow read: if jobChatPhotoReader(tenantId, jobId);
      allow create: if canSeeJob(tenantId, jobId) && chatNameOk(file) && chatJobFile(tenantId, jobId);
      allow update: if false;
      allow delete: if canSeeJob(tenantId, jobId) && chatNameOk(file) && resource.metadata.purpose == "chat-photo"
        && (
          resource.metadata.uploaderUid == request.auth.uid
          || isAlex() || isPatrick()
          || ("role" in userData() && userData().role == "admin")
        );
    }

// BEGIN LEAVE CERTIFICATE RULES
    function lvCertSignedIn() { return request.auth != null; }
    function lvCertIsAlex() { return lvCertSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function lvCertIsPatrick() { return lvCertSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function lvCertUserPath() { return /databases/(default)/documents/users/$(request.auth.uid); }
    function lvCertAdmin(uid) {
      return ((lvCertIsAlex() || lvCertIsPatrick()) && userCompanyOf(uid) == "heartwood") || (
        lvCertSignedIn()
        && firestore.exists(lvCertUserPath())
        && firestore.get(lvCertUserPath()).data.get("role", "") == "admin"
        && userCompanyOf(request.auth.uid) == userCompanyOf(uid)
      );
    }
    function lvCertFile(uid, requestId, file) {
      return request.auth.uid == uid
        && requestId.matches('^lv[a-z0-9]{16}$')
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.metadata.purpose == "leave-certificate"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.requestId == requestId
        && (
          (file == "cert.pdf" && request.resource.contentType == "application/pdf")
          || (file == "cert.jpg" && request.resource.contentType == "image/jpeg")
          || (file == "cert.png" && request.resource.contentType == "image/png")
          || (file == "cert.webp" && request.resource.contentType == "image/webp")
        );
    }
    function lvCertReader(uid) {
      return lvCertSignedIn() && (request.auth.uid == uid || lvCertAdmin(uid));
    }

    match /leaveCertificates/{uid}/{requestId} {
      allow list: if lvCertReader(uid);
    }
    match /leaveCertificates/{uid}/{requestId}/{file} {
      allow read: if lvCertReader(uid);
      allow create: if lvCertSignedIn() && lvCertFile(uid, requestId, file);
      allow update, delete: if false;
    }
// END LEAVE CERTIFICATE RULES

// BEGIN REIMBURSEMENT RECEIPT RULES
    function rcFileSignedIn() { return request.auth != null; }
    function rcFileIsAlex() { return rcFileSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function rcFileIsPatrick() { return rcFileSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function rcFileAdmin(uid) {
      return ((rcFileIsAlex() || rcFileIsPatrick()) && userCompanyOf(uid) == "heartwood") || (
        rcFileSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get("role", "") in ["admin", "manager"]
        && userCompanyOf(request.auth.uid) == userCompanyOf(uid)
      );
    }
    function rcFileOk(uid, claimId, file) {
      return request.auth.uid == uid
        && claimId.matches('^rc[a-z0-9]{16}$')
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.metadata.purpose == "reimbursement-receipt"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.claimId == claimId
        && (
          (file == "receipt.pdf" && request.resource.contentType == "application/pdf")
          || (file == "receipt.jpg" && request.resource.contentType == "image/jpeg")
          || (file == "receipt.png" && request.resource.contentType == "image/png")
          || (file == "receipt.webp" && request.resource.contentType == "image/webp")
        );
    }
    function rcFileReader(uid) {
      // 38SU... is the box sync account; it reads receipts only to email paid claims to Hubdoc.
      return rcFileSignedIn() && (request.auth.uid == uid || rcFileAdmin(uid) || request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2");
    }

    match /reimbursements/{uid}/{claimId}/{file} {
      allow read: if rcFileReader(uid);
      allow create: if rcFileSignedIn() && rcFileOk(uid, claimId, file);
      allow update, delete: if false;
    }
// END REIMBURSEMENT RECEIPT RULES

// BEGIN HOURS EXPORT FILE RULES
    function hxFileAdmin() {
      return signedIn() && (
        ((isAlex() || isPatrick()) && callerTenant() == "heartwood")
        || (hasProfile() && profile().get("role", "") == "admin" && callerTenant() != "")
      );
    }
    function hxExportCompany(exportId) {
      let path = /databases/(default)/documents/hoursExports/$(exportId);
      return firestore.exists(path) && "companyId" in firestore.get(path).data
        && firestore.get(path).data.companyId is string
        ? firestore.get(path).data.companyId
        : "heartwood";
    }
    match /hoursExports/{exportId}/{file} {
      allow read: if (hxFileAdmin() && hxExportCompany(exportId) == callerTenant())
        || (signedIn() && request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2");
      allow create: if hxFileAdmin()
        && exportId.matches('^hx[a-z0-9]{16}$')
        && file.matches('^[A-Za-z0-9_-]{1,80}[.]xlsx$')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        && request.resource.metadata.purpose == "hours-export"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.exportId == exportId
        && request.resource.metadata.companyId == callerTenant();
      allow update, delete: if false;
    }
// END HOURS EXPORT FILE RULES

    // Company logo only. Not job photos. Members of that company can read.
    // Owners and admins (profile role admin, including the company creator) can write.
    // Platform owner may read any company logo. JPEG or PNG, 2 MB. That company's
    // admin may delete so they can remove a logo. No public download tokens.
    match /companies/{companyId}/logo/{file} {
      allow read: if signedIn() && (callerTenant() == companyId || storagePlatformOwner());
      allow create, update: if signedIn() && callerTenant() == companyId
        && hasProfile() && profile().get("role", "") == "admin"
        && file.matches('^logo[.](jpg|png)$')
        && request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024
        && (request.resource.contentType == "image/jpeg" || request.resource.contentType == "image/png")
        && request.resource.metadata.purpose == "company-logo"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.companyId == companyId;
      allow delete: if signedIn() && callerTenant() == companyId
        && hasProfile() && profile().get("role", "") == "admin";
    }
    // Job documents. Private blobs next to job photos. Office (admin, manager, supervisor)
    // of that company can read, upload and delete. Crew can read a file only when its
    // metadata says crew, and only if they are on the job. Each allow uses at most two
    // Firestore reads. Heartwood skips the company read (it is never paused). Another
    // company's read checks the company document, so a paused trial cannot get the bytes.
    // A missing companies/{id} document fails closed here (get cannot also exists()).
    function docUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function docAccountCompany(user) {
      return "companyId" in user && user.companyId is string && user.companyId.size() > 0
        ? user.companyId
        : ("tenantId" in user && user.tenantId is string && user.tenantId.size() > 0 ? user.tenantId : "heartwood");
    }
    function docOfficeRole(user) {
      return "role" in user && user.role in ["admin", "manager", "supervisor"];
    }
    function docOfficeProfile(tenantId) {
      let user = docUser();
      return docAccountCompany(user) == tenantId && docOfficeRole(user);
    }
    function storageBillingOpen(data) {
      let raw = data.get("billing", null);
      let status = raw is map ? raw.get("status", "") : "";
      let plan = data.get("plan", "");
      let trialEnd = data.get("trialEndsAt", null);
      let friendEnd = data.get("friendEndsAt", null);
      let trialOver = trialEnd is timestamp && !(trialEnd > request.time);
      let friendOver = friendEnd is timestamp && !(friendEnd > request.time);
      return status == "active" || status == "trialing"
        || (plan == "paid" && status != "past_due" && status != "canceled")
        || (plan == "friend" && !friendOver)
        || (plan != "friend" && plan != "paid" && !trialOver && data.get("status", "active") == "active");
    }
    function storageCompanyOpen(companyId) {
      let data = firestore.get(/databases/(default)/documents/companies/$(companyId)).data;
      return data.get("ownerPaused", false) != true
        && (data.get("isTest", false) == true || storageBillingOpen(data));
    }
    function docHeartwoodOwner(tenantId) {
      return signedIn() && tenantId == "heartwood" && (isAlex() || isPatrick());
    }
    function docHeartwoodOffice(tenantId) {
      return signedIn() && tenantId == "heartwood" && !isAlex() && !isPatrick() && docOfficeProfile(tenantId);
    }
    function docCompanyOffice(tenantId) {
      return signedIn() && tenantId != "heartwood" && tenantId.size() > 0
        && docOfficeProfile(tenantId) && storageCompanyOpen(tenantId);
    }
    // Non-Heartwood upload. The path tenant, the job's companyId and the
    // uploader's company must match. User and job are the two production reads,
    // so this allow does not also read companies/{id}. Read, list and delete
    // still use docCompanyOffice, which refuses a paused company. A job with no
    // companyId does not match a CallUp path (Heartwood create uses jobCompanyMatches).
    function docCompanyOfficeCreate(tenantId, jobId) {
      let user = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let job = firestore.get(jobPath(jobId)).data;
      let jobCompany = "companyId" in job && job.companyId is string && job.companyId.size() > 0
        ? job.companyId : "";
      return signedIn() && tenantId != "heartwood" && tenantId.size() > 0
        && docAccountCompany(user) == tenantId
        && jobCompany == tenantId
        && docOfficeRole(user);
    }
    function docCrewAssigned(tenantId, jobId) {
      let job = firestore.get(jobPath(jobId)).data;
      let company = "companyId" in job && job.companyId is string && job.companyId.size() > 0
        ? job.companyId
        : ("tenantId" in job && job.tenantId is string && job.tenantId.size() > 0 ? job.tenantId : "heartwood");
      let assigned = "assigned" in job && job.assigned is list && request.auth.uid in job.assigned;
      return signedIn() && company == tenantId && assigned
        && (tenantId == "heartwood" || storageCompanyOpen(tenantId));
    }
    function jobCompanyMatches(tenantId, jobId) {
      let job = firestore.get(jobPath(jobId)).data;
      let company = "companyId" in job && job.companyId is string && job.companyId.size() > 0
        ? job.companyId
        : ("tenantId" in job && job.tenantId is string && job.tenantId.size() > 0 ? job.tenantId : "heartwood");
      return company == tenantId;
    }
    function docNameOk(file) {
      return file.matches('^d[A-Za-z0-9]{8,40}$');
    }
    function docExtOk() {
      return request.resource.metadata.fileName.matches('(?i).+\\.(pdf|jpe?g|png|webp|gif|heic|heif|docx?|xlsx?|dwg|dxf)$');
    }
    function docTypeOk() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|heic|heif)')
        || request.resource.contentType == "application/pdf"
        || request.resource.contentType == "application/msword"
        || request.resource.contentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        || request.resource.contentType == "application/vnd.ms-excel"
        || request.resource.contentType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        || request.resource.contentType in ["application/acad", "application/x-acad", "application/dwg", "application/dxf", "image/vnd.dwg", "image/vnd.dxf"]
        || (request.resource.contentType == "application/octet-stream" && docExtOk());
    }
    function docFileOk(tenantId, jobId) {
      return request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && docTypeOk()
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.jobId == jobId
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.purpose == "job-document"
        && request.resource.metadata.visibility in ["crew", "office"]
        && request.resource.metadata.fileName is string
        && request.resource.metadata.fileName.size() > 0
        && request.resource.metadata.fileName.size() <= 200;
    }
    function docCrewRead(tenantId, jobId) {
      return resource != null
        && resource.metadata.purpose == "job-document"
        && resource.metadata.visibility == "crew"
        && docCrewAssigned(tenantId, jobId);
    }

    match /tenants/{tenantId}/jobs/{jobId}/documents {
      allow list: if docHeartwoodOwner(tenantId);
      allow list: if docHeartwoodOffice(tenantId);
      allow list: if docCompanyOffice(tenantId);
    }
    match /tenants/{tenantId}/jobs/{jobId}/documents/{file} {
      allow read: if docHeartwoodOwner(tenantId);
      allow read: if docHeartwoodOffice(tenantId);
      allow read: if docCompanyOffice(tenantId);
      allow read: if docCrewRead(tenantId, jobId);
      allow create: if docNameOk(file) && docFileOk(tenantId, jobId) && docHeartwoodOwner(tenantId) && jobCompanyMatches(tenantId, jobId);
      allow create: if docNameOk(file) && docFileOk(tenantId, jobId) && docHeartwoodOffice(tenantId) && jobCompanyMatches(tenantId, jobId);
      allow create: if docNameOk(file) && docFileOk(tenantId, jobId) && docCompanyOfficeCreate(tenantId, jobId);
      allow delete: if docHeartwoodOwner(tenantId);
      allow delete: if docHeartwoodOffice(tenantId);
      allow delete: if docCompanyOffice(tenantId);
      allow update: if false;
    }

    // Pause-retention backups. The Admin SDK writes these before a paused company is deleted.
    // Clients cannot read or write them.
    match /pauseBackups/{companyId}/{file} {
      allow read, write: if false;
    }
// BEGIN TAKE 5 PHOTO RULES
    // One profile read (exists + get). A second lookup would pass the emulator and fail in production.
    function take5PhotoAccess(companyId, file, writing) {
      let path = /databases/(default)/documents/users/$(request.auth.uid);
      let listed = request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"
        || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
        || request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2";
      let missing = !firestore.exists(path);
      let p = missing ? {} : firestore.get(path).data;
      let c = p.get("companyId", "") is string && p.get("companyId", "") != ""
        ? p.get("companyId", "")
        : (p.get("tenantId", "") is string && p.get("tenantId", "") != "" ? p.get("tenantId", "") : "heartwood");
      let role = p.get("role", "");
      let own = file.matches('^' + request.auth.uid + '_t5[a-z0-9]{16}[.]jpg$');
      let leader = listed || role in ["supervisor", "manager", "admin"];
      return signedIn() && c == companyId && (writing ? own : (own || leader));
    }
    match /take5Photos/{companyId}/{file} {
      allow read: if take5PhotoAccess(companyId, file, false);
      allow create: if take5PhotoAccess(companyId, file, true)
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == "image/jpeg"
        && request.resource.metadata.purpose == "take5"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.companyId == companyId;
      allow update, delete: if false;
    }
// END TAKE 5 PHOTO RULES

// BEGIN INBOUND MAIL FILE RULES
    // Plain-text copy of a forwarded email. Admin SDK writes it. Office of that
    // company can read the bytes. Crew cannot. Another company cannot.
    // One profile read, and only when the caller is not Alex or Patrick.
    function inboundFileOffice(companyId) {
      return signedIn() && (
        (companyId == "heartwood" && (isAlex() || isPatrick()))
        || inboundFileProfile(companyId)
      );
    }
    function inboundFileProfile(companyId) {
      let p = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let company = "companyId" in p && p.companyId is string && p.companyId.size() > 0
        ? p.companyId
        : ("tenantId" in p && p.tenantId is string && p.tenantId.size() > 0 ? p.tenantId : "heartwood");
      return company == companyId && "role" in p && p.role in ["admin", "manager", "supervisor"];
    }
    match /companies/{companyId}/inbound/{messageId}/{file} {
      allow read: if file == "body.txt" && inboundFileOffice(companyId);
      allow list: if false;
      allow write: if false;
    }
// END INBOUND MAIL FILE RULES

    // Support screenshot. Private. One profile read (exists + get), which is the
    // production cap. The submitter reads and writes only their own file in their
    // company. The platform owner reads every file and may upload their own
    // screenshot while viewing another company. storagePlatformOwner reads
    // email_verified directly, so a token without that claim must not call it.
    function supportFileOwner() {
      return signedIn()
        && "email_verified" in request.auth.token
        && "email" in request.auth.token
        && storagePlatformOwner();
    }
    function supportCallerCompany() {
      let path = /databases/(default)/documents/users/$(request.auth.uid);
      let listed = request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"
        || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2";
      let missing = !firestore.exists(path);
      let p = missing ? {} : firestore.get(path).data;
      let company = p.get("companyId", "");
      let tenant = p.get("tenantId", "");
      return company is string && company != "" ? company
        : (tenant is string && tenant != "" ? tenant : ((listed || !missing) ? "heartwood" : ""));
    }
    function supportShotFile(companyId, uid, ticketId, file) {
      return signedIn()
        && request.auth.uid == uid
        && file == "shot.jpg"
        && ticketId.matches('^[A-Za-z0-9]{16,28}$')
        && companyId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == "image/jpeg"
        && request.resource.metadata.purpose == "support-ticket"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.companyId == companyId
        && request.resource.metadata.ticketId == ticketId;
    }
    match /supportTickets/{companyId}/{uid}/{ticketId}/{file} {
      allow read: if signedIn() && request.auth.uid == uid && supportCallerCompany() == companyId;
      allow read: if supportFileOwner();
      allow create: if supportShotFile(companyId, uid, ticketId, file) && supportCallerCompany() == companyId;
      allow create: if supportShotFile(companyId, uid, ticketId, file) && supportFileOwner();
      allow update, delete: if false;
    }
  }
}
