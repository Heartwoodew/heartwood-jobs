// Firestore staff-invite rules to merge into the LIVE ruleset for heartwood-9f37f.
// Paste this block once, inside the existing:
//   service cloud.firestore { match /databases/{database}/documents { ... } }
// Do not deploy cloud/emulator/firestore.rules. That file is an emulator model
// and would replace jobs, quotes, receipts and the rest of the live rules.
//
// Invites are CallUp Base. A supervisor or admin creates invites/{id} together with
// inviteEmails/{email} in one transaction. Role is labourer, operator, supervisor, or admin (CallUp company admins only).
// The accept function (Admin SDK) is the only writer of users/{uid}.role.
// This block does not add a users match: a second users match would be OR'd
// with the live one. Keep the live users rules denying client writes of role.
// Clients cannot write mail or inviteMail. The email worker uses the Admin SDK.
//
// These rules are a prototype. Review them before publishing.

// BEGIN INVITE RULES
    function inviteSignedIn() { return request.auth != null; }
    function inviteIsAlex() { return inviteSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function inviteIsPatrick() { return inviteSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function inviteUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function inviteHasProfile() { return inviteSignedIn() && exists(inviteUserPath()); }
    function inviteProfile() { return get(inviteUserPath()).data; }
    function inviteAdmin() {
      return inviteIsAlex() || inviteIsPatrick()
        || (inviteHasProfile() && "role" in inviteProfile()
          && (inviteProfile().role == "admin" || inviteProfile().role == "supervisor" || inviteProfile().role == "manager"));
    }
    function inviteCallerTenant() {
      return inviteIsAlex() || inviteIsPatrick()
        ? "heartwood"
        : (inviteHasProfile() && "companyId" in inviteProfile() && inviteProfile().companyId is string && inviteProfile().companyId.size() > 0
          ? inviteProfile().companyId
          : (inviteHasProfile() && "tenantId" in inviteProfile() && inviteProfile().tenantId is string && inviteProfile().tenantId.size() > 0
          ? inviteProfile().tenantId
          : (inviteHasProfile() ? "heartwood" : "")));
    }
    function inviteEmailOk(email) {
      return textLen(email, 6, 120)
        && email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
    }
    // Labourer, operator or supervisor: any invite admin (admin or supervisor). Admin: a profile-role admin of a CallUp
    // company, or a Heartwood admin (Alex, Patrick, or an accepted Heartwood admin grant in heartwoodAdmins/{uid}).
    function inviteFullAdmin() {
      return inviteCallerTenant() == "heartwood"
        ? (inviteIsAlex() || inviteIsPatrick()
          || (exists(/databases/$(database)/documents/heartwoodAdmins/$(request.auth.uid))
            && inviteHasProfile() && inviteProfile().get("role", "") == "admin"))
        : (inviteHasProfile() && "role" in inviteProfile() && inviteProfile().role == "admin");
    }
    function inviteRoleOk() {
      let next = docData();
      return next.role in ["labourer", "operator", "supervisor", "manager"]
        || (next.role == "admin" && inviteFullAdmin());
    }
    function inviteSame(key) {
      let next = docData();
      let prev = prevData();
      return (!(key in next) && !(key in prev))
        || ((key in next) && (key in prev) && next[key] == prev[key]);
    }
    function inviteBaseOk() {
      let next = docData();
      return textLen(next.name, 1, 80)
        && !next.name.matches('.*[\\n\\r\\t<>].*')
        && inviteEmailOk(next.email)
        && inviteRoleOk()
        && next.tenantId is string
        && next.tenantId == inviteCallerTenant()
        && next.tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && (!("companyId" in next) || next.companyId == next.tenantId)
        && next.token is string
        && next.token.matches('^[A-Za-z0-9_-]{43,128}$')
        && textLen(next.createdBy, 1, 128)
        && next.createdAt is timestamp
        && next.expiresAt is timestamp;
    }
    function inviteExpiryWindow() {
      let next = docData();
      return next.expiresAt > request.time + duration.value(6, 'd')
        && next.expiresAt < request.time + duration.value(8, 'd');
    }
    function inviteLockPath(email) { return /databases/$(database)/documents/inviteEmails/$(email); }
    function invitePath(inviteId) { return /databases/$(database)/documents/invites/$(inviteId); }
    function inviteLockFree(email) {
      return !exists(inviteLockPath(email))
        || get(inviteLockPath(email)).data.status != "pending";
    }
    function inviteLockAgrees(email, inviteId) {
      let next = docData();
      return existsAfter(inviteLockPath(email))
        && getAfter(inviteLockPath(email)).data.keys().hasOnly(["email", "status", "inviteId", "expiresAt", "role", "tenantId"])
        && getAfter(inviteLockPath(email)).data.email == email
        && getAfter(inviteLockPath(email)).data.inviteId == inviteId
        && getAfter(inviteLockPath(email)).data.role == next.role
        && getAfter(inviteLockPath(email)).data.tenantId == next.tenantId
        && getAfter(inviteLockPath(email)).data.status == next.status
        && getAfter(inviteLockPath(email)).data.expiresAt == next.expiresAt;
    }
    function inviteCreateOk(inviteId) {
      let next = docData();
      return inviteAdmin()
        && inviteBaseOk()
        && next.keys().hasOnly(["name", "email", "role", "jobTitle", "jobTitleId", "status", "createdBy", "createdAt", "expiresAt", "token", "tenantId", "companyId"])
        && next.status == "pending"
        && next.createdBy == request.auth.uid
        && next.createdAt == request.time
        && inviteExpiryWindow()
        && inviteLockFree(next.email)
        && inviteLockAgrees(next.email, inviteId);
    }
    function inviteCancelOk(inviteId) {
      let next = docData();
      let prev = prevData();
      return prev.status == "pending"
        && next.status == "cancelled"
        && next.cancelledBy == request.auth.uid
        && next.cancelledAt == request.time
        && inviteSame("name") && inviteSame("email") && inviteSame("role") && inviteSame("createdBy")
        && inviteSame("createdAt") && inviteSame("expiresAt") && inviteSame("token") && inviteSame("tenantId")
        && inviteSame("resentAt") && inviteSame("resentBy") && inviteSame("companyId")
        && inviteLockAgrees(next.email, inviteId);
    }
    function inviteResendOk(inviteId) {
      let next = docData();
      let prev = prevData();
      return prev.status == "pending"
        && next.status == "pending"
        && next.token != prev.token
        && next.resentBy == request.auth.uid
        && next.resentAt == request.time
        && inviteExpiryWindow()
        && inviteSame("name") && inviteSame("email") && inviteSame("role") && inviteSame("createdBy")
        && inviteSame("createdAt") && inviteSame("tenantId") && inviteSame("companyId")
        && inviteSame("cancelledAt") && inviteSame("cancelledBy")
        && inviteLockAgrees(next.email, inviteId);
    }
    function inviteUpdateOk(inviteId) {
      let next = docData();
      return inviteAdmin()
        && inviteBaseOk()
        && next.keys().hasOnly(["name", "email", "role", "jobTitle", "jobTitleId", "status", "createdBy", "createdAt", "expiresAt", "token", "tenantId", "companyId", "cancelledAt", "cancelledBy", "resentAt", "resentBy"])
        && (inviteCancelOk(inviteId) || inviteResendOk(inviteId));
    }

    match /invites/{inviteId} {
      // Supervisors never read an admin invite (it carries the sign-up token): their list asks for the three crew/supervisor roles.
      allow get, list: if inviteAdmin() && prevData().tenantId == inviteCallerTenant()
        && (prevData().role in ["labourer", "operator", "supervisor", "manager"] || inviteFullAdmin());
      allow create: if inviteCreateOk(inviteId);
      allow update: if inviteUpdateOk(inviteId);
      allow delete: if false;
    }

    function inviteLockEmailOk(email) {
      let next = docData();
      return inviteEmailOk(email)
        && next.email == email
        && inviteRoleOk()
        && next.tenantId == inviteCallerTenant()
        && textLen(next.inviteId, 1, 128)
        && next.expiresAt is timestamp
        && (next.status == "pending" || next.status == "cancelled")
        && next.keys().hasOnly(["email", "status", "inviteId", "expiresAt", "role", "tenantId"]);
    }
    function inviteLockPointsAtInvite(email) {
      let next = docData();
      return existsAfter(invitePath(next.inviteId))
        && getAfter(invitePath(next.inviteId)).data.email == email
        && getAfter(invitePath(next.inviteId)).data.role == next.role
        && getAfter(invitePath(next.inviteId)).data.tenantId == next.tenantId
        && getAfter(invitePath(next.inviteId)).data.status == next.status
        && getAfter(invitePath(next.inviteId)).data.expiresAt == next.expiresAt;
    }
    function inviteLockWriteOk(email) {
      return (
        !exists(inviteLockPath(email))
        && docData().status == "pending"
      ) || (
        exists(inviteLockPath(email))
        && get(inviteLockPath(email)).data.status == "pending"
        && get(inviteLockPath(email)).data.inviteId == docData().inviteId
        && (docData().status == "pending" || docData().status == "cancelled")
      ) || (
        exists(inviteLockPath(email))
        && get(inviteLockPath(email)).data.status != "pending"
        && docData().status == "pending"
      );
    }

    match /inviteEmails/{email} {
      allow get: if inviteAdmin();
      allow list: if false;
      allow create, update: if inviteAdmin()
        && inviteLockEmailOk(email)
        && inviteLockPointsAtInvite(email)
        && inviteLockWriteOk(email);
      allow delete: if false;
    }

    match /inviteMail/{id} {
      allow read, write: if false;
    }
    match /mail/{id} {
      allow read, write: if false;
    }
// END INVITE RULES
