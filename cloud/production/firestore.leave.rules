// Firestore leave rules to merge into the LIVE ruleset for heartwood-9f37f.
// Paste this block once, inside the existing:
//   service cloud.firestore { match /databases/{database}/documents { ... } }
// Do not deploy cloud/emulator/firestore.rules. That file is an emulator model.
//
// Uses only helpers already in the live rules after the timesheet paste:
//   isAlex, isPatrick, hasProfile, profile, same, userPath
// Every other function is defined in this block. It does not call signedIn,
// isAppAdmin, or the servicing / prestart / invite helpers.
//
// leaveRequests/{id}  id is lv + 16 hex characters.
// Staff create their own pending request. Supervisors and admins approve or
// decline it with a note. Staff read their own status. A certificate path is
// a pointer only. The file itself is in Storage.

// BEGIN LEAVE RULES
    function lvSignedIn() { return request.auth != null; }
    function lvHeartwood() {
      return lvSignedIn() && (
        isAlex() || isPatrick() || (hasProfile() && callerCompany() == "heartwood")
      );
    }
    function lvDecider() {
      let known = lvSignedIn() && hasProfile();
      let user = known ? profile() : null;
      let company = lvSignedIn() ? callerCompany() : "";
      return lvSignedIn() && (
        (!known && (isAlex() || isPatrick()))
        || (company == "heartwood" && (isAlex() || isPatrick() || (known && (user.role == "admin" || user.role == "supervisor" || user.role == "manager"))))
        || (company != "heartwood" && known && (user.role == "admin" || user.role == "supervisor" || user.role == "manager"))
      );
    }
    function lvDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function lvHalf(v) {
      return v == "" || v == "am" || v == "pm";
    }
    function lvHalves() {
      let next = docData();
      return lvHalf(next.startHalf)
        && lvHalf(next.endHalf)
        && (
          (next.start == next.end
            && next.startHalf == next.endHalf)
          || (next.start < next.end
            && (next.startHalf == "" || next.startHalf == "pm")
            && (next.endHalf == "" || next.endHalf == "am"))
        );
    }
    function lvCertPath(uid, id) {
      let next = docData();
      return next.certificatePath == ""
        || next.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.pdf"
        || next.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.jpg"
        || next.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.png"
        || next.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.webp";
    }
    function lvCreate(id) {
      let next = docData();
      return (lvHeartwood() || (callerCompany() != "heartwood" && callerCompany() != "" && hasProfile()))
        && id.matches('^lv[a-z0-9]{16}$')
        && next.keys().hasOnly(["uid", "name", "type", "start", "end", "startHalf", "endHalf", "reason", "certificatePath", "certificateName", "status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "createdAt", "updatedAt", "companyId"])
        && (!("companyId" in next) || next.companyId == callerCompany())
        && next.uid == request.auth.uid
        && textLen(next.name, 1, 80)
        && (next.type == "annual" || next.type == "sick" || next.type == "other")
        && lvDate(next.start)
        && lvDate(next.end)
        && next.end >= next.start
        && lvHalves()
        && textLen(next.reason, 1, 500)
        && lvCertPath(request.auth.uid, id)
        && textMax(next.certificateName, 120)
        && (next.certificatePath == ""
          ? next.certificateName == ""
          : next.certificateName.size() > 0)
        && next.status == "pending"
        && next.decisionNote == ""
        && next.decidedBy == ""
        && next.decidedByName == ""
        && next.decidedAt == null
        && next.createdAt == request.time
        && next.updatedAt == request.time;
    }
    function lvDecision() {
      let next = docData();
      let prev = prevData();
      return lvDecider()
        && prev.status == "pending"
        && next.diff(prev).affectedKeys().hasOnly(["status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "updatedAt"])
        && (next.status == "approved" || next.status == "declined")
        && textLen(next.decisionNote, 1, 500)
        && next.decidedBy == request.auth.uid
        && textLen(next.decidedByName, 1, 80)
        && next.decidedAt == request.time
        && next.updatedAt == request.time
        && fieldSame(next, prev, "uid") && fieldSame(next, prev, "name") && fieldSame(next, prev, "type") && fieldSame(next, prev, "start") && fieldSame(next, prev, "end")
        && fieldSame(next, prev, "startHalf") && fieldSame(next, prev, "endHalf") && fieldSame(next, prev, "reason")
        && fieldSame(next, prev, "certificatePath") && fieldSame(next, prev, "certificateName") && same("createdAt");
    }

    match /leaveRequests/{id} {
      allow get: if (lvHeartwood() && (resource == null && id.matches('^lv[a-z0-9]{16}$')
          || resource != null && docCompany(prevData()) == "heartwood" && (lvDecider() || prevData().uid == request.auth.uid)))
        || (callerCompany() != "heartwood" && resource != null && prevData().companyId == callerCompany()
          && (prevData().uid == request.auth.uid || (hasProfile() && (profile().role == "admin" || profile().role == "supervisor" || profile().role == "manager"))));
      allow list: if lvHeartwood() && prevData().uid == request.auth.uid;
      allow list: if lvHeartwood() && lvDecider() && prevData().companyId == "heartwood";
      allow list: if callerCompany() != "heartwood" && prevData().companyId == callerCompany()
        && (prevData().uid == request.auth.uid || (hasProfile() && (profile().role == "admin" || profile().role == "supervisor" || profile().role == "manager")));
      allow create: if lvCreate(id) && (lvHeartwood() && callerCompany() == "heartwood" || docData().companyId == callerCompany());
      allow update: if lvDecision() && docCompany(prevData()) == callerCompany();
      allow delete: if false;
    }
// END LEAVE RULES
