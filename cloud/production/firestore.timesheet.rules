// Firestore timesheet rules to merge into the LIVE ruleset for heartwood-9f37f.
// Paste this block once, inside the existing:
//   service cloud.firestore { match /databases/{database}/documents { ... } }
// Do not deploy cloud/emulator/firestore.rules. That file is an emulator model
// and would replace jobs, quotes, receipts and the rest of the live rules.
// Do not deploy this block until Alex has approved it.
//
// timesheets/{uid}_{weekStart} is the existing week document.
// Workers read and write only their own id. Heartwood admins (Alex, Patrick,
// or a heartwood profile role admin) read every sheet, and may only flip the
// sent / sentAt / sentBy flags. Clock stamps (clockOn, clockOff, breakOn,
// breakOff) cannot be rewritten. A worker may correct start and finish on their
// own sheet. The first correction stores originalClockOn and originalClockOff;
// a later correction cannot replace them. That write cannot change job, note,
// date, status, or the GPS fix. A sent or approved week outside the current
// pay period cannot be corrected, except by an admin on their own sheet.
// A later edit must append one audit map entry.
// Location is one fix map per tap: gps (lat, lng, accuracy) or "no location".

// BEGIN TIMESHEET RULES
    function tsHeartwoodAdmin() {
      return isAlex() || isPatrick() || (
        hasProfile() && profile().role == "admin"
        && (!("tenantId" in profile()) || profile().tenantId == "heartwood")
      );
    }
    function tsMine(id) {
      return signedIn()
        && docData().uid == request.auth.uid
        && docData().weekStart is string
        && docData().weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == request.auth.uid + "_" + docData().weekStart;
    }
    function tsDocOk() {
      return docData().keys().hasOnly(["uid", "name", "weekStart", "weekEnd", "days", "entries", "totalHrs", "updatedAt", "updatedAtIso", "lastEntryId", "locationConsentAt", "sent", "sentAt", "sentBy", "approved"])
        && textLen(docData().name, 1, 80)
        && docData().weekEnd is string
        && docData().weekEnd >= docData().weekStart
        && docData().days is map
        && docData().days.size() <= 7
        && docData().totalHrs is number
        && docData().totalHrs >= 0
        && docData().totalHrs <= 400
        && docData().updatedAt == request.time
        && textMax(docData().updatedAtIso, 40);
    }
    function tsFix(m) {
      return m.keys().hasOnly(["at", "fix", "lat", "lng", "accuracy"])
        && m.at == request.time
        && ((m.fix == "no location" && m.keys().hasOnly(["at", "fix"]))
          || (m.fix == "gps" && m.lat is number && m.lat >= -90 && m.lat <= 90
            && m.lng is number && m.lng >= -180 && m.lng <= 180
            && m.accuracy is number && m.accuracy >= 0 && m.accuracy <= 100000));
    }
    function tsFixSame(b, a, k) {
      return a.source == "manual" ? !(k in a)
        : ((!(k in a) && !(k in b)) || ((k in a) && (k in b) && a[k] == b[k]) || ((k in a) && !(k in b) && tsFix(a[k])));
    }
    function tsEntryCore(e) {
      return e.keys().hasOnly(["id", "source", "status", "date", "start", "finish", "breakStart", "breakEnd", "note", "job", "clockOn", "clockOff", "breakOn", "breakOff", "enteredBy", "enteredByName", "enteredAt", "edits", "lastEditId", "machineChoice", "machineId", "machineName"])
        && e.id == docData().lastEntryId
        && e.id.matches('^[a-z0-9]{8,24}$')
        && (e.source == "clock" || e.source == "manual")
        && e.enteredBy == request.auth.uid
        &&textLen(e.enteredByName, 1, 80)
        && e.enteredAt is timestamp
        && e.edits is map
        &&textMax(e.note, 200)
        &&textMax(e.job, 200)
        && e.date is string && e.date.size() == 10
        &&textMax(e.start, 5)
        &&textMax(e.finish, 5)
        && ((e.source == "clock" && "clockOn" in e) || (e.source == "manual" && !e.keys().hasAny(["clockOn", "clockOff", "breakOn", "breakOff"])));
    }
    function tsEntryNew(e) {
      return tsEntryCore(e) && e.enteredAt == request.time && e.edits.size() == 0 && e.lastEditId == ""
        && tsFixSame({}, e, "clockOn") && tsFixSame({}, e, "clockOff") && tsFixSame({}, e, "breakOn") && tsFixSame({}, e, "breakOff");
    }
    // One diff, reused: each extra diff of the entries/edits maps counts against the 1000-expression limit.
    function tsEditOk(b, a) {
      let d = a.edits.diff(b.edits);
      return d.removedKeys().size() == 0
        && d.changedKeys().size() == 0
        && (d.addedKeys().size() == 0
          || (d.addedKeys().hasOnly([a.lastEditId])
            && a.edits[a.lastEditId].at == request.time
            && a.edits[a.lastEditId].by == request.auth.uid
            && a.edits[a.lastEditId].byName is string
            && a.edits[a.lastEditId].summary is string
            && a.edits[a.lastEditId].summary.size() > 0
            && a.edits[a.lastEditId].summary.size() <= 200));
    }
    // A machine pick is written once, all three fields together.
    function tsMachinePick(b, a) {
      return !("machineChoice" in b)
        && (((a.machineChoice == "none" || a.machineChoice == "skip") && a.machineId == "" &&textMax(a.machineName, 80))
          || (a.machineChoice == "asset" && a.machineId.matches('^[A-Za-z0-9_-]{1,80}$') &&textLen(a.machineName, 1, 80)));
    }
    // An existing shift: check only what changed. id, source, author, enteredAt and the clock-on stamp never change;
    // a recorded stamp or machine pick is never rewritten or removed; a new stamp is a valid fix taken now (clock shifts only).
    // A clock-time correction is separate: start and finish only, plus the edit audit and the original times.
    // Job, note, date and the GPS fix stay. The first original is kept. Re-validating the whole shift on every tap
    // pushed clock-off after a break past Firestore's 1000-expression limit (permission-denied, user test 11 Nov 2026).
    function tsHm(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function tsPad2(n) {
      return n < 10 ? "0" + string(n) : string(n);
    }
    function tsToday() {
      let t = request.time + duration.value(10, 'h');
      return string(t.year()) + "-" + tsPad2(t.month()) + "-" + tsPad2(t.day());
    }
    function tsNowHm() {
      let t = request.time + duration.value(10, 'h');
      return tsPad2(t.hours()) + ":" + tsPad2(t.minutes());
    }
    // Called only after the punch branch has already failed its key check, so a clock-off does not pay for it.
    function tsTimeOk(b, a) {
      let today = tsToday();
      let nowHm = tsNowHm();
      let openWeek = today >= prevData().weekStart && today <= prevData().weekEnd;
      let locked = prevData().get("sent", false) == true || prevData().get("approved", false) == true;
      return (a.finish == "" || a.finish > a.start)
        && (a.date < today || (a.date == today && a.start <= nowHm && (a.finish == "" || a.finish <= nowHm)))
        && (openWeek || !locked || isAlex() || isPatrick() || (hasProfile() && profile().role == "admin"))
        && (!("originalClockOn" in b) ? a.originalClockOn == b.start : a.originalClockOn == b.originalClockOn)
        && (b.finish == ""
          ? (!("originalClockOff" in a) && !("originalClockOff" in b))
          : (!("originalClockOff" in b) ? a.originalClockOff == b.finish : a.originalClockOff == b.originalClockOff));
    }
    function tsEntryNext(b, a) {
      let d = a.diff(b);
      let ch = d.affectedKeys();
      let added = d.addedKeys();
      return d.removedKeys().size() == 0 && (
        (ch.hasOnly(["status", "finish", "breakStart", "breakEnd", "clockOff", "breakOn", "breakOff", "enteredByName", "edits", "lastEditId", "machineChoice", "machineId", "machineName"])
          && !("start" in ch)
          && (!("finish" in ch) || ch.hasAny(["status", "clockOff", "breakOn", "breakOff"]))
          && !d.changedKeys().hasAny(["clockOff", "breakOn", "breakOff", "machineChoice", "machineId", "machineName"])
          && (!ch.hasAny(["clockOff", "breakOn", "breakOff"]) || (a.source == "clock"
            && (!("clockOff" in added) || tsFix(a.clockOff))
            && (!("breakOn" in added) || tsFix(a.breakOn))
            && (!("breakOff" in added) || tsFix(a.breakOff))))
          && (!ch.hasAny(["machineChoice", "machineId", "machineName"]) || tsMachinePick(b, a))
          && (!("finish" in ch) || (textMax(a.finish, 5)))
          && (!("enteredByName" in ch) || (textLen(a.enteredByName, 1, 80)))
          && (!ch.hasAny(["edits", "lastEditId"]) || (a.edits is map && tsEditOk(b, a))))
        || (ch.hasOnly(["start", "finish", "edits", "lastEditId", "originalClockOn", "originalClockOff"])
          && (a.start != b.start || a.finish != b.finish)
          && tsHm(a.start)
          && (a.finish == "" || tsHm(a.finish))
          && (b.finish != "" || a.finish == "")
          && a.edits is map
          && a.edits.size() == b.edits.size() + 1
          && tsEditOk(b, a)
          && tsTimeOk(b, a)));
    }
    function tsFleetReader(tenantId) {
      return signedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && (
          ((isAlex() || isPatrick()) && tenantId == "heartwood")
          || (hasProfile() && (
            ("tenantId" in profile() && profile().tenantId == tenantId)
            || (!("tenantId" in profile()) && tenantId == "heartwood")
          ))
        );
    }
    // Clock-off after a break and a machine pick used to hit Firestore's 1000-expression limit (permission-denied):
    // the entries map was diffed three times and compared whole. Diff once and look the shift up once.
    // One diff of the entries map. affectedKeys() on that diff, then only the changed shift.
    function tsOneEntry() {
      let after = docData().entries;
      let before = prevData().get("entries", {});
      let key = docData().lastEntryId;
      let d = after.diff(before);
      let n = d.affectedKeys().size();
      return after is map
        && after.size() <= 40
        && d.removedKeys().size() == 0
        && (n == 0
          || (key is string && n == 1 && d.affectedKeys().hasOnly([key])
            && (key in before ? tsEntryNext(before[key], after[key]) : tsEntryNew(after[key]))));
    }
    function tsWorkerCreate(id) {
      return tsMine(id) && tsDocOk()
        && !("sent" in docData()) && !("sentAt" in docData()) && !("sentBy" in docData())
        && !("approved" in docData())
        && (!("locationConsentAt" in docData()) || docData().locationConsentAt == request.time)
        && (!("entries" in docData())
          || (docData().entries.size() == 1
            && docData().lastEntryId in docData().entries
            && tsEntryNew(docData().entries[docData().lastEntryId])));
    }
    function tsWorkerUpdate(id) {
      return tsMine(id) && tsDocOk()
        && docData().uid == prevData().uid
        && docData().weekStart == prevData().weekStart
        && same("sent") && same("sentAt") && same("sentBy") && same("approved")
        && (!("locationConsentAt" in prevData()) && !("locationConsentAt" in docData())
          || !("locationConsentAt" in prevData()) && docData().locationConsentAt == request.time
          || docData().get("locationConsentAt", null) == prevData().get("locationConsentAt", null))
        && tsOneEntry();
    }
    function tsSentUpdate() {
      return tsHeartwoodAdmin()
        && docData().diff(prevData()).affectedKeys().hasOnly(["sent", "sentAt", "sentBy"])
        && docData().sent is bool
        && (docData().get("sentAt", null) == null || docData().sentAt is string)
        && (docData().get("sentBy", null) == null || docData().sentBy == request.auth.uid);
    }

    match /timesheets/{id} {
      allow get: if signedIn() && (
        (resource == null && id.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        || (tsHeartwoodAdmin() && resource != null && docCompany(prevData()) == "heartwood")
        || (resource != null && prevData().uid == request.auth.uid && docCompany(prevData()) == callerCompany())
        || (callerCompany() != "heartwood" && hasProfile() && profile().role == "admin" && resource != null && prevData().companyId == callerCompany())
      );
      allow list: if signedIn() && callerCompany() == "heartwood" && prevData().uid == request.auth.uid;
      allow list: if callerCompany() != "heartwood" && prevData().uid == request.auth.uid && prevData().companyId == callerCompany();
      allow list: if tsHeartwoodAdmin() && prevData().companyId == "heartwood";
      allow list: if callerCompany() != "heartwood" && hasProfile() && profile().role == "admin" && prevData().companyId == callerCompany();
      allow create: if tsWorkerCreate(id);
      allow update: if tsWorkerUpdate(id) || tsSentUpdate();
      allow delete: if false;
    }

    // Read-only mirror so clock-on can list machines and today's prestart.
    // Creates and edits stay with the compliance PR. allow write: if false does not veto those rules.
    match /tenants/{tenantId}/fleet/{assetId} {
      allow read: if tsFleetReader(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/prestarts/{id} {
      allow read: if tsFleetReader(tenantId);
      allow write: if false;
    }
// END TIMESHEET RULES
