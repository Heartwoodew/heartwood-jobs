// Firestore run-sheet rules to merge into the LIVE ruleset for heartwood-9f37f.
// Paste the block once, inside the existing:
//   service cloud.firestore { match /databases/{database}/documents { ... } }
// Do not deploy this file. Do not deploy cloud/emulator/firestore.rules.
// Do not replace jobs, receipts, quotes, xeroQueue, or finance matches.
// Geocode cache is a `geo` map on the existing job document and uses the live
// job update rule. This block does not widen job writes and does not delete anything.
//
// Document id: {workerUid}_{YYYY-MM-DD}
//   runSheets/patrickUid_2026-11-06
// Read: an admin (Alex, Patrick, or users.role == admin), or the worker named in the id.
// Write: those admins only, and only an approved order. Staff cannot approve.
// Delete: false. Rejecting a suggestion writes nothing.

// BEGIN RUN SHEET RULES
    function routeSignedIn() { return request.auth != null; }
    function routeIsAlex() { return routeSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function routeIsPatrick() { return routeSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function routeUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function routeHasProfile() { return routeSignedIn() && exists(routeUserPath()); }
    function routeProfile() { return get(routeUserPath()).data; }
    function routeIsAdmin() {
      return routeIsAlex() || routeIsPatrick()
        || (routeHasProfile() && "role" in routeProfile() && routeProfile().role == "admin");
    }
    function routeSheetIdOk(id) {
      return id is string && id.matches('^[A-Za-z0-9]{1,128}_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function routeSheetWorker(id) { return id[0:id.size()-11]; }
    function routeSheetDate(id) { return id[id.size()-10:id.size()]; }
    function routeCanRead(sheetId) {
      return routeSignedIn() && routeSheetIdOk(sheetId)
        && (routeIsAdmin() || request.auth.uid == routeSheetWorker(sheetId));
    }
    function routeCanWrite(sheetId) {
      return routeIsAdmin() && routeSheetIdOk(sheetId)
        && request.resource.data.keys().hasOnly([
          "workerUid", "workerName", "date", "jobIds", "returnToDepot", "status", "depot",
          "method", "provider", "tweaked", "totalMinutes", "totalKm", "currentMinutes", "currentKm",
          "approvedBy", "approvedByName", "approvedAt"
        ])
        && request.resource.data.workerUid == routeSheetWorker(sheetId)
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.date == routeSheetDate(sheetId)
        && request.resource.data.date is string
        && request.resource.data.status == "approved"
        && request.resource.data.depot == "208-220 Holdsworth Rd, Chuwar QLD 4306"
        && request.resource.data.returnToDepot is bool
        && request.resource.data.tweaked is bool
        && request.resource.data.jobIds is list
        && request.resource.data.jobIds.size() > 0
        && request.resource.data.jobIds.size() <= 40
        && request.resource.data.workerName is string
        && request.resource.data.workerName.size() <= 80
        && request.resource.data.approvedByName is string
        && request.resource.data.approvedByName.size() > 0
        && request.resource.data.approvedByName.size() <= 80
        && request.resource.data.approvedAt == request.time
        && request.resource.data.method in ["exact", "nearest-neighbour-2opt"]
        && request.resource.data.provider in ["osrm", "ors", "osrm-fallback"]
        && request.resource.data.totalMinutes is number
        && request.resource.data.totalMinutes >= 0
        && request.resource.data.totalKm is number
        && request.resource.data.totalKm >= 0
        && request.resource.data.currentMinutes is number
        && request.resource.data.currentMinutes >= 0
        && request.resource.data.currentKm is number
        && request.resource.data.currentKm >= 0;
    }

    match /runSheets/{sheetId} {
      allow read: if routeCanRead(sheetId);
      allow create, update: if routeCanWrite(sheetId);
      allow delete: if false;
    }
// END RUN SHEET RULES
