// BEGIN INBOX IMPORT RULES
    match /inbox/{id} {
      function inOffice() {
        return signedIn() && (
          request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"
          || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin"
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "supervisor"
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "manager"
            )
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("tenantId", "heartwood") == "heartwood"
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("companyId", "heartwood") == "heartwood"
          )
        );
      }
      function inMark() {
        let changed = docData().diff(prevData()).affectedKeys();
        return changed.hasOnly(["read", "readAt", "imported", "importedJobId", "importedAt", "importedBy", "jobIds"])
          && (!changed.hasAny(["read"]) || docData().read is bool)
          && (!changed.hasAny(["readAt"]) || docData().readAt == request.time)
          && (!changed.hasAny(["imported"]) || docData().imported == true)
          && (!changed.hasAny(["importedJobId"]) || (
            textLen(docData().importedJobId, 1, 128)
            && docData().importedJobId.matches('^[A-Za-z0-9_-]+$')
          ))
          && (!changed.hasAny(["importedBy"]) || docData().importedBy == request.auth.uid)
          && (!changed.hasAny(["importedAt"]) || docData().importedAt == request.time)
          && (!changed.hasAny(["jobIds"]) || (
            docData().jobIds is list && docData().jobIds.size() <= 20
          ))
          && (!changed.hasAny(["imported", "importedJobId", "importedBy", "importedAt"])
            || (changed.hasAll(["imported", "importedJobId", "importedBy", "importedAt"])));
      }

      allow read: if inOffice() || isSync();
      allow create: if isSync();
      allow update: if isSync() || (inOffice() && inMark());
      allow delete: if false;
    }
// END INBOX IMPORT RULES
