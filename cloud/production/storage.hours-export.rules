// BEGIN HOURS EXPORT FILE RULES
    function hxFileSignedIn() { return request.auth != null; }
    function hxFileAdmin() {
      return hxFileSignedIn() && (
        request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2" || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin"
      );
    }
    match /hoursExports/{exportId}/{file} {
      // 38SU... is the box sync account; it reads the file only to email it to accounts@heartwoodew.com.
      allow read: if hxFileAdmin() || (hxFileSignedIn() && request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2");
      allow create: if hxFileAdmin()
        && exportId.matches('^hx[a-z0-9]{16}$')
        && file.matches('^[A-Za-z0-9_-]{1,80}[.]xlsx$')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        && request.resource.metadata.purpose == "hours-export"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.exportId == exportId;
      allow update, delete: if false;
    }
// END HOURS EXPORT FILE RULES
