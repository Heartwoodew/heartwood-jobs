// BEGIN HOURS EXPORT FILE RULES
    function hxFileAdmin() {
      return signedIn() && (
        ((isAlex() || isPatrick()) && callerTenant() == "heartwood")
        || (hasProfile() && profile().get("role", "") == "admin" && callerTenant() != "")
      );
    }
    function hxExportCompany(exportId) {
      let path = /databases/(default)/documents/hoursExports/$(exportId);
      return firestore.exists(path) && "companyId" in firestore.get(path).data
        && firestore.get(path).data.companyId is string
        ? firestore.get(path).data.companyId
        : "heartwood";
    }
    match /hoursExports/{exportId}/{file} {
      allow read: if (hxFileAdmin() && hxExportCompany(exportId) == callerTenant())
        || (signedIn() && request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2");
      allow create: if hxFileAdmin()
        && exportId.matches('^hx[a-z0-9]{16}$')
        && file.matches('^[A-Za-z0-9_-]{1,80}[.]xlsx$')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        && request.resource.metadata.purpose == "hours-export"
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.exportId == exportId
        && request.resource.metadata.companyId == callerTenant();
      allow update, delete: if false;
    }
// END HOURS EXPORT FILE RULES
