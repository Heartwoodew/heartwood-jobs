// BEGIN JOB CHECK RULES
    // jobChecks/{id} is written by requestJobCheck with the Admin SDK.
    // Heartwood admins (Alex, Patrick) and Heartwood admin or supervisor
    // profiles can read. A missing companyId on the profile means heartwood.
    // Nobody can write from the client. Test and friend companies are not
    // heartwood, so their staff cannot read these rows.
    function jcSignedIn() { return request.auth != null; }
    function jcUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function jcCompanyId() {
      return jcUser().keys().hasAny(["companyId"]) && jcUser().companyId is string && jcUser().companyId.size() > 0
        ? jcUser().companyId
        : (jcUser().keys().hasAny(["tenantId"]) && jcUser().tenantId is string && jcUser().tenantId.size() > 0
          ? jcUser().tenantId
          : "heartwood");
    }
    function jcOffice() {
      return jcSignedIn() && (
        request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"
        || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (jcUser().get("role", "") == "admin" || jcUser().get("role", "") == "supervisor")
          && jcCompanyId() == "heartwood"
        )
      );
    }
    match /jobChecks/{id} {
      allow get: if jcOffice() && resource.data.companyId == "heartwood";
      allow list: if jcOffice() && resource.data.companyId == "heartwood";
      allow create, update, delete: if false;
    }
// END JOB CHECK RULES
