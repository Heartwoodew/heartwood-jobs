// Firestore Compliance rules to merge into the LIVE ruleset for heartwood-9f37f.
// Paste this block once, inside the existing:
//   service cloud.firestore { match /databases/{database}/documents { ... } }
// Do not deploy this file, and do not deploy cloud/emulator/firestore.rules.
// This block does not change jobs, quotes, receipts, finance, xeroQueue or chat.
// It covers only:
//   tenants/{tenantId}/fleet/{assetId}      registration and Queensland COI
//   tenants/{tenantId}/policies/{policyId}  WorkCover and insurance
// COI is a certificate of inspection, not an insurance policy.
// Fleet: a signed-in member of that tenant can read. An admin of that tenant writes.
// Policies: admin of that tenant only. Staff cannot read policy details.
// Missing profile tenantId means heartwood, same as chat and storage.
// Alex and Patrick are Heartwood admins. No seed data belongs in these collections.

// BEGIN FLEET RULES
    function fleetSignedIn() { return request.auth != null; }
    function fleetIsAlex() { return fleetSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function fleetIsPatrick() { return fleetSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function fleetUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function fleetHasProfile() { return fleetSignedIn() && exists(fleetUserPath()); }
    function fleetProfile() { return get(fleetUserPath()).data; }
    function fleetExplicitTenant() {
      return fleetHasProfile() && "tenantId" in fleetProfile() && fleetProfile().tenantId is string && fleetProfile().tenantId.size() > 0;
    }
    function fleetCallerTenant() {
      return fleetExplicitTenant()
        ? fleetProfile().tenantId
        : ((fleetHasProfile() || fleetIsAlex() || fleetIsPatrick()) ? "heartwood" : "");
    }
    function fleetMember(tenantId) {
      return fleetSignedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && fleetCallerTenant() == tenantId;
    }
    function fleetAdmin(tenantId) {
      return fleetMember(tenantId) && (
        fleetIsAlex() || fleetIsPatrick() || (fleetHasProfile() && "role" in fleetProfile() && fleetProfile().role == "admin")
      );
    }
    function fleetDateOk(v) {
      return v is string && (v == "" || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function fleetAssetOk() {
      return docData().keys().hasOnly(["type", "name", "rego", "regoExpiry", "coiRequired", "coiExpiry", "notes", "prestartKind", "reading", "readingUnit", "readingAt", "readingBy", "readingByName", "updatedAt", "updatedBy"])
        && (docData().type == "vehicle" || docData().type == "trailer" || docData().type == "plant")
        && (!("prestartKind" in docData()) || docData().prestartKind == "skid-steer" || docData().prestartKind == "excavator" || docData().prestartKind == "tip-truck" || docData().prestartKind == "ute" || docData().prestartKind == "trailer" || docData().prestartKind == "other-plant")
        && textLen(docData().name, 1, 80)
        && textMax(docData().rego, 20)
        && fleetDateOk(docData().regoExpiry)
        && docData().coiRequired is bool
        && fleetDateOk(docData().coiExpiry)
        && textMax(docData().notes, 2000)
        && (!("reading" in docData()) || (docData().reading is int && docData().reading >= 0 && docData().reading <= 10000000))
        && (!("readingUnit" in docData()) || docData().readingUnit == "" || docData().readingUnit == "hours" || docData().readingUnit == "km")
        && docData().updatedBy == request.auth.uid
        && docData().updatedAt == request.time;
    }
    function fleetEditor(tenantId) {
      return fleetAdmin(tenantId)
        || (fleetMember(tenantId) && fleetHasProfile() && "role" in fleetProfile() && fleetProfile().role in ["supervisor", "manager"]);
    }
    function fleetPolicyOk() {
      return docData().keys().hasOnly(["type", "insurer", "policyNumber", "startDate", "expiry", "amount", "notes", "assetId", "updatedAt", "updatedBy"])
        && (docData().type == "workcover" || docData().type == "public-liability" || docData().type == "vehicle" || docData().type == "plant" || docData().type == "contract-works")
        && textLen(docData().insurer, 1, 120)
        && textMax(docData().policyNumber, 60)
        && fleetDateOk(docData().startDate)
        && fleetDateOk(docData().expiry)
        && textMax(docData().amount, 40)
        && textMax(docData().notes, 2000)
        && textMax(docData().assetId, 80)
        && docData().assetId.matches('^[A-Za-z0-9_-]*$')
        && docData().updatedBy == request.auth.uid
        && docData().updatedAt == request.time;
    }

    // Prestart readings: any member of the tenant may move a machine's reading UP (same unit), signed as themselves.
    // Nothing else on the machine can change this way. A lower reading stays on the prestart only.
    function fleetReadingOk(tenantId) {
      return fleetMember(tenantId)
        && docData().diff(prevData()).affectedKeys().hasOnly(["reading", "readingUnit", "readingAt", "readingBy", "readingByName"])
        && docData().reading is int
        && docData().reading > 0
        && docData().reading <= 10000000
        && (docData().readingUnit == "hours" || docData().readingUnit == "km")
        && (prevData().get("reading", 0) == 0
          || prevData().get("readingUnit", "") == ""
          || prevData().get("readingUnit", "") != docData().readingUnit
          || docData().reading > prevData().get("reading", 0))
        && docData().readingBy == request.auth.uid
        && textMax(docData().readingByName, 80)
        && docData().readingAt == request.time;
    }

    match /tenants/{tenantId}/fleet/{assetId} {
      allow read: if fleetMember(tenantId);
      allow create: if fleetEditor(tenantId) && fleetAssetOk();
      allow update: if (fleetEditor(tenantId) && fleetAssetOk()) || fleetReadingOk(tenantId);
      allow delete: if fleetAdmin(tenantId);
    }

    match /tenants/{tenantId}/policies/{policyId} {
      allow read: if fleetAdmin(tenantId);
      allow create, update: if fleetAdmin(tenantId) && fleetPolicyOk();
      allow delete: if fleetAdmin(tenantId);
    }
// END FLEET RULES
