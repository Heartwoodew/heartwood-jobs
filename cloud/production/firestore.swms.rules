// Firestore SWMS signature rules to merge into the LIVE ruleset for heartwood-9f37f.
// Paste this block once, inside the existing:
//   service cloud.firestore { match /databases/{database}/documents { ... } }
// Do not deploy this file. Do not deploy cloud/emulator/firestore.rules.
// This block does not change jobs, receipts, finance, xeroQueue, chat, or scheduling.
//
// Collection: swmsSignatures/{id}
//   One document per signing. The newest per worker per SWMS is the current one.
//   The app writes it. Staff read only their own (where uid == auth.uid).
//   Alex, Patrick, and users.role == admin read the whole collection.
//   Update and delete are denied. Re-signing creates a new document.
//
// The signature image is a PNG data URL on the document. There is no Storage
// path, so no Storage rules are added. Staff listing uses a single-field
// equality on uid, which Firestore indexes automatically. No composite index.
//
// BEGIN SWMS SIGNATURE RULES
    function swmsSignedIn() { return request.auth != null; }
    function swmsIsAlex() { return swmsSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function swmsIsPatrick() { return swmsSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function swmsUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function swmsHasProfile() { return swmsSignedIn() && exists(swmsUserPath()); }
    function swmsProfile() { return get(swmsUserPath()).data; }
    function swmsIsAdmin() {
      return swmsIsAlex() || swmsIsPatrick()
        || (swmsHasProfile() && "role" in swmsProfile() && swmsProfile().role == "admin");
    }
    function swmsCanSign() {
      return swmsIsAlex() || swmsIsPatrick() || swmsHasProfile();
    }
    function swmsIdOk() {
      return request.resource.data.swmsId is string
        && request.resource.data.swmsId.matches('^(working-near-roads|mobile-plant|working-with-silica|hazardous-substances|electrical)$');
    }
    function swmsSigOk() {
      return request.resource.data.sig is string
        && request.resource.data.sig.size() >= 32
        && request.resource.data.sig.size() <= 90000
        && request.resource.data.sig.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$');
    }
    function swmsCreateOk() {
      return swmsCanSign()
        && request.resource.data.keys().hasOnly(["uid", "name", "swmsId", "swmsTitle", "version", "jobId", "jobLabel", "sig", "signedAt", "signedAtMs", "expiresAtMs", "device", "companyId"])
        && (!("companyId" in request.resource.data) || request.resource.data.companyId == callerCompany())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && swmsIdOk()
        && request.resource.data.swmsTitle is string
        && request.resource.data.swmsTitle.size() > 0
        && request.resource.data.swmsTitle.size() <= 80
        && request.resource.data.version is string
        && request.resource.data.version.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && request.resource.data.jobId is string
        && request.resource.data.jobId.size() <= 200
        && request.resource.data.jobLabel is string
        && request.resource.data.jobLabel.size() <= 160
        && swmsSigOk()
        && request.resource.data.signedAt == request.time
        && request.resource.data.signedAtMs is int
        && request.resource.data.signedAtMs >= request.time.toMillis() - 300000
        && request.resource.data.signedAtMs <= request.time.toMillis() + 300000
        && request.resource.data.expiresAtMs is int
        && request.resource.data.expiresAtMs >= request.resource.data.signedAtMs + 364 * 24 * 60 * 60 * 1000
        && request.resource.data.expiresAtMs <= request.resource.data.signedAtMs + 367 * 24 * 60 * 60 * 1000
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 200;
    }

    match /swmsSignatures/{id} {
      allow get: if swmsSignedIn() && resource != null && docCompany(resource.data) == callerCompany()
        && (resource.data.uid == request.auth.uid || swmsIsAdmin() && callerCompany() == docCompany(resource.data));
      allow list: if swmsSignedIn() && callerCompany() == "heartwood" && resource.data.uid == request.auth.uid;
      allow list: if swmsSignedIn() && callerCompany() != "heartwood" && resource.data.uid == request.auth.uid
        && resource.data.companyId == callerCompany();
      allow list: if (swmsIsAlex() || swmsIsPatrick() || (swmsHasProfile() && swmsProfile().role == "admin" && callerCompany() == "heartwood"))
        && resource.data.companyId == "heartwood";
      allow list: if callerCompany() != "heartwood" && swmsHasProfile() && swmsProfile().role == "admin"
        && resource.data.companyId == callerCompany();
      allow create: if swmsCreateOk();
      allow update, delete: if false;
    }
// END SWMS SIGNATURE RULES
