// BEGIN SWMS SIGNATURE RULES
    function swmsSignedIn() { return request.auth != null; }
    function swmsIsAlex() { return swmsSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function swmsIsPatrick() { return swmsSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function swmsUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function swmsHasProfile() { return swmsSignedIn() && exists(swmsUserPath()); }
    function swmsProfile() { return get(swmsUserPath()).data; }
    function swmsIsAdmin() {
      return swmsIsAlex() || swmsIsPatrick()
        || (swmsHasProfile() && "role" in swmsProfile() && swmsProfile().role == "admin");
    }
    function swmsCanSign() {
      return swmsIsAlex() || swmsIsPatrick() || swmsHasProfile();
    }
    function swmsIdOk() {
      return request.resource.data.swmsId is string
        && request.resource.data.swmsId.matches('^(working-near-roads|mobile-plant|working-with-silica|hazardous-substances|electrical)$');
    }
    function swmsSigOk() {
      return request.resource.data.sig is string
        && request.resource.data.sig.size() >= 32
        && request.resource.data.sig.size() <= 90000
        && request.resource.data.sig.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$');
    }
    function swmsCreateOk() {
      return swmsCanSign()
        && request.resource.data.keys().hasOnly(["uid", "name", "swmsId", "swmsTitle", "version", "jobId", "jobLabel", "sig", "signedAt", "signedAtMs", "expiresAtMs", "device", "companyId"])
        && (!("companyId" in request.resource.data) || request.resource.data.companyId == callerCompany())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && swmsIdOk()
        && request.resource.data.swmsTitle is string
        && request.resource.data.swmsTitle.size() > 0
        && request.resource.data.swmsTitle.size() <= 80
        && request.resource.data.version is string
        && request.resource.data.version.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && request.resource.data.jobId is string
        && request.resource.data.jobId.size() <= 200
        && request.resource.data.jobLabel is string
        && request.resource.data.jobLabel.size() <= 160
        && swmsSigOk()
        && request.resource.data.signedAt == request.time
        && request.resource.data.signedAtMs is int
        && request.resource.data.signedAtMs >= request.time.toMillis() - 300000
        && request.resource.data.signedAtMs <= request.time.toMillis() + 300000
        && request.resource.data.expiresAtMs is int
        && request.resource.data.expiresAtMs >= request.resource.data.signedAtMs + 364 * 24 * 60 * 60 * 1000
        && request.resource.data.expiresAtMs <= request.resource.data.signedAtMs + 367 * 24 * 60 * 60 * 1000
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 200;
    }

    match /swmsSignatures/{id} {
      allow get: if swmsSignedIn() && resource != null && docCompany(resource.data) == callerCompany()
        && (resource.data.uid == request.auth.uid || swmsIsAdmin() && callerCompany() == docCompany(resource.data));
      allow list: if swmsSignedIn() && callerCompany() == "heartwood" && resource.data.uid == request.auth.uid;
      allow list: if swmsSignedIn() && callerCompany() != "heartwood" && resource.data.uid == request.auth.uid
        && resource.data.companyId == callerCompany();
      allow list: if (swmsIsAlex() || swmsIsPatrick() || (swmsHasProfile() && swmsProfile().role == "admin" && callerCompany() == "heartwood"))
        && resource.data.companyId == "heartwood";
      allow list: if callerCompany() != "heartwood" && swmsHasProfile() && swmsProfile().role == "admin"
        && resource.data.companyId == callerCompany();
      allow create: if swmsCreateOk();
      allow update, delete: if false;
    }
// END SWMS SIGNATURE RULES

// BEGIN RUN SHEET RULES
    function routeSignedIn() { return request.auth != null; }
    function routeIsAlex() { return routeSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function routeIsPatrick() { return routeSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function routeUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function routeHasProfile() { return routeSignedIn() && exists(routeUserPath()); }
    function routeProfile() { return get(routeUserPath()).data; }
    function routeIsAdmin() {
      return routeIsAlex() || routeIsPatrick()
        || (routeHasProfile() && "role" in routeProfile() && routeProfile().role == "admin");
    }
    function routeSheetIdOk(id) {
      return id is string && id.matches('^[A-Za-z0-9]{1,128}_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function routeSheetWorker(id) { return id[0:id.size()-11]; }
    function routeSheetDate(id) { return id[id.size()-10:id.size()]; }
    function routeCanRead(sheetId) {
      return routeSignedIn() && routeSheetIdOk(sheetId)
        && (routeIsAdmin() || request.auth.uid == routeSheetWorker(sheetId));
    }
    function routeCanWrite(sheetId) {
      return routeIsAdmin() && routeSheetIdOk(sheetId)
        && request.resource.data.keys().hasOnly([
          "workerUid", "workerName", "date", "jobIds", "returnToDepot", "status", "depot",
          "method", "provider", "tweaked", "totalMinutes", "totalKm", "currentMinutes", "currentKm",
          "approvedBy", "approvedByName", "approvedAt"
        ])
        && request.resource.data.workerUid == routeSheetWorker(sheetId)
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.date == routeSheetDate(sheetId)
        && request.resource.data.date is string
        && request.resource.data.status == "approved"
        && request.resource.data.depot == "208-220 Holdsworth Rd, Chuwar QLD 4306"
        && request.resource.data.returnToDepot is bool
        && request.resource.data.tweaked is bool
        && request.resource.data.jobIds is list
        && request.resource.data.jobIds.size() > 0
        && request.resource.data.jobIds.size() <= 40
        && request.resource.data.workerName is string
        && request.resource.data.workerName.size() <= 80
        && request.resource.data.approvedByName is string
        && request.resource.data.approvedByName.size() > 0
        && request.resource.data.approvedByName.size() <= 80
        && request.resource.data.approvedAt == request.time
        && request.resource.data.method in ["exact", "nearest-neighbour-2opt"]
        && request.resource.data.provider in ["osrm", "ors", "osrm-fallback"]
        && request.resource.data.totalMinutes is number
        && request.resource.data.totalMinutes >= 0
        && request.resource.data.totalKm is number
        && request.resource.data.totalKm >= 0
        && request.resource.data.currentMinutes is number
        && request.resource.data.currentMinutes >= 0
        && request.resource.data.currentKm is number
        && request.resource.data.currentKm >= 0;
    }

    match /runSheets/{sheetId} {
      allow read: if routeCanRead(sheetId);
      allow create, update: if routeCanWrite(sheetId);
      allow delete: if false;
    }
// END RUN SHEET RULES
// BEGIN TIMESHEET RULES
    function tsHeartwoodAdmin() {
      return isAlex() || isPatrick() || (
        hasProfile() && profile().role == "admin"
        && (!("tenantId" in profile()) || profile().tenantId == "heartwood")
      );
    }
    function tsMine(id) {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.weekStart is string
        && request.resource.data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == request.auth.uid + "_" + request.resource.data.weekStart;
    }
    function tsDocOk() {
      return request.resource.data.keys().hasOnly(["uid", "name", "weekStart", "weekEnd", "days", "entries", "totalHrs", "updatedAt", "updatedAtIso", "lastEntryId", "locationConsentAt", "sent", "sentAt", "sentBy"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.weekEnd is string
        && request.resource.data.weekEnd >= request.resource.data.weekStart
        && request.resource.data.days is map
        && request.resource.data.days.size() <= 7
        && request.resource.data.totalHrs is number
        && request.resource.data.totalHrs >= 0
        && request.resource.data.totalHrs <= 400
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedAtIso is string
        && request.resource.data.updatedAtIso.size() <= 40;
    }
    function tsFix(m) {
      return m.keys().hasOnly(["at", "fix", "lat", "lng", "accuracy"])
        && m.at == request.time
        && ((m.fix == "no location" && m.keys().hasOnly(["at", "fix"]))
          || (m.fix == "gps" && m.lat is number && m.lat >= -90 && m.lat <= 90
            && m.lng is number && m.lng >= -180 && m.lng <= 180
            && m.accuracy is number && m.accuracy >= 0 && m.accuracy <= 100000));
    }
    function tsFixSame(b, a, k) {
      return a.source == "manual" ? !(k in a)
        : ((!(k in a) && !(k in b)) || ((k in a) && (k in b) && a[k] == b[k]) || ((k in a) && !(k in b) && tsFix(a[k])));
    }
    function tsEntryCore(e) {
      return e.keys().hasOnly(["id", "source", "status", "date", "start", "finish", "breakStart", "breakEnd", "note", "job", "clockOn", "clockOff", "breakOn", "breakOff", "enteredBy", "enteredByName", "enteredAt", "edits", "lastEditId", "machineChoice", "machineId", "machineName"])
        && e.id == request.resource.data.lastEntryId
        && e.id.matches('^[a-z0-9]{8,24}$')
        && (e.source == "clock" || e.source == "manual")
        && e.enteredBy == request.auth.uid
        && e.enteredByName is string && e.enteredByName.size() > 0 && e.enteredByName.size() <= 80
        && e.enteredAt is timestamp
        && e.edits is map
        && e.note is string && e.note.size() <= 200
        && e.job is string && e.job.size() <= 200
        && e.date is string && e.date.size() == 10
        && e.start is string && e.start.size() <= 5
        && e.finish is string && e.finish.size() <= 5
        && ((e.source == "clock" && "clockOn" in e) || (e.source == "manual" && !e.keys().hasAny(["clockOn", "clockOff", "breakOn", "breakOff"])));
    }
    function tsEntryNew(e) {
      return tsEntryCore(e) && e.enteredAt == request.time && e.edits.size() == 0 && e.lastEditId == ""
        && tsFixSame({}, e, "clockOn") && tsFixSame({}, e, "clockOff") && tsFixSame({}, e, "breakOn") && tsFixSame({}, e, "breakOff");
    }
    function tsEditOk(b, a) {
      return a.edits.diff(b.edits).removedKeys().size() == 0
        && a.edits.diff(b.edits).changedKeys().size() == 0
        && (a.edits.diff(b.edits).addedKeys().size() == 0
          || (a.edits.diff(b.edits).addedKeys().hasOnly([a.lastEditId])
            && a.edits[a.lastEditId].at == request.time
            && a.edits[a.lastEditId].by == request.auth.uid
            && a.edits[a.lastEditId].byName is string
            && a.edits[a.lastEditId].summary is string
            && a.edits[a.lastEditId].summary.size() > 0
            && a.edits[a.lastEditId].summary.size() <= 200));
    }
    function tsMachineLock(b, a) {
      return (!("machineChoice" in a) && !("machineChoice" in b))
        || ("machineChoice" in b && a.machineChoice == b.machineChoice && a.get("machineId", "") == b.get("machineId", "") && a.get("machineName", "") == b.get("machineName", ""))
        || (!("machineChoice" in b) && (
          ((a.machineChoice == "none" || a.machineChoice == "skip") && a.machineId == "" && a.machineName is string && a.machineName.size() <= 80)
          || (a.machineChoice == "asset" && a.machineId.matches('^[A-Za-z0-9_-]{1,80}$') && a.machineName is string && a.machineName.size() > 0 && a.machineName.size() <= 80)
        ));
    }
    function tsEntryNext(b, a) {
      return tsEntryCore(a) && a.source == b.source && a.enteredBy == b.enteredBy && a.enteredAt == b.enteredAt && a.id == b.id
        && tsFixSame(b, a, "clockOn") && tsFixSame(b, a, "clockOff") && tsFixSame(b, a, "breakOn") && tsFixSame(b, a, "breakOff")
        && tsMachineLock(b, a)
        && tsEditOk(b, a);
    }
    function tsFleetReader(tenantId) {
      return signedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && (
          ((isAlex() || isPatrick()) && tenantId == "heartwood")
          || (hasProfile() && (
            ("tenantId" in profile() && profile().tenantId == tenantId)
            || (!("tenantId" in profile()) && tenantId == "heartwood")
          ))
        );
    }
    function tsOneEntry() {
      return request.resource.data.entries is map
        && request.resource.data.entries.size() <= 40
        && request.resource.data.lastEntryId is string
        && request.resource.data.entries.diff(resource.data.get("entries", {})).removedKeys().size() == 0
        && request.resource.data.entries.diff(resource.data.get("entries", {})).affectedKeys().size() == 1
        && request.resource.data.entries.diff(resource.data.get("entries", {})).affectedKeys().hasOnly([request.resource.data.lastEntryId])
        && (
          (request.resource.data.lastEntryId in resource.data.get("entries", {})
            && tsEntryNext(resource.data.entries[request.resource.data.lastEntryId], request.resource.data.entries[request.resource.data.lastEntryId]))
          || (!(request.resource.data.lastEntryId in resource.data.get("entries", {}))
            && tsEntryNew(request.resource.data.entries[request.resource.data.lastEntryId]))
        );
    }
    function tsWorkerCreate(id) {
      return tsMine(id) && tsDocOk()
        && !("sent" in request.resource.data) && !("sentAt" in request.resource.data) && !("sentBy" in request.resource.data)
        && (!("locationConsentAt" in request.resource.data) || request.resource.data.locationConsentAt == request.time)
        && (!("entries" in request.resource.data)
          || (request.resource.data.entries.size() == 1
            && request.resource.data.lastEntryId in request.resource.data.entries
            && tsEntryNew(request.resource.data.entries[request.resource.data.lastEntryId])));
    }
    function tsWorkerUpdate(id) {
      return tsMine(id) && tsDocOk()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.weekStart == resource.data.weekStart
        && same("sent") && same("sentAt") && same("sentBy")
        && (!("locationConsentAt" in resource.data) && !("locationConsentAt" in request.resource.data)
          || !("locationConsentAt" in resource.data) && request.resource.data.locationConsentAt == request.time
          || request.resource.data.get("locationConsentAt", null) == resource.data.get("locationConsentAt", null))
        && (request.resource.data.get("entries", {}) == resource.data.get("entries", {}) || tsOneEntry());
    }
    function tsSentUpdate() {
      return tsHeartwoodAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sent", "sentAt", "sentBy"])
        && request.resource.data.sent is bool
        && (request.resource.data.get("sentAt", null) == null || request.resource.data.sentAt is string)
        && (request.resource.data.get("sentBy", null) == null || request.resource.data.sentBy == request.auth.uid);
    }

    match /timesheets/{id} {
      allow get: if signedIn() && (
        (resource == null && id.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        || (tsHeartwoodAdmin() && resource != null && docCompany(resource.data) == "heartwood")
        || (resource != null && resource.data.uid == request.auth.uid && docCompany(resource.data) == callerCompany())
        || (callerCompany() != "heartwood" && hasProfile() && profile().role == "admin" && resource != null && resource.data.companyId == callerCompany())
      );
      allow list: if signedIn() && callerCompany() == "heartwood" && resource.data.uid == request.auth.uid;
      allow list: if callerCompany() != "heartwood" && resource.data.uid == request.auth.uid && resource.data.companyId == callerCompany();
      allow list: if tsHeartwoodAdmin() && resource.data.companyId == "heartwood";
      allow list: if callerCompany() != "heartwood" && hasProfile() && profile().role == "admin" && resource.data.companyId == callerCompany();
      allow create: if tsWorkerCreate(id);
      allow update: if tsWorkerUpdate(id) || tsSentUpdate();
      allow delete: if false;
    }

    // Read-only mirror so clock-on can list machines and today's prestart.
    // Creates and edits stay with the compliance PR. allow write: if false does not veto those rules.
    match /tenants/{tenantId}/fleet/{assetId} {
      allow read: if tsFleetReader(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/prestarts/{id} {
      allow read: if tsFleetReader(tenantId);
      allow write: if false;
    }
// END TIMESHEET RULES

// BEGIN LEAVE RULES
    function lvSignedIn() { return request.auth != null; }
    function lvHeartwood() {
      return lvSignedIn() && (
        isAlex() || isPatrick() || (hasProfile() && callerCompany() == "heartwood")
      );
    }
    function lvDecider() {
      return lvSignedIn() && hasProfile() == false && (isAlex() || isPatrick())
        || lvSignedIn() && (
          (callerCompany() == "heartwood" && (isAlex() || isPatrick() || (hasProfile() && (profile().role == "admin" || profile().role == "supervisor"))))
          || (callerCompany() != "heartwood" && hasProfile() && (profile().role == "admin" || profile().role == "supervisor"))
        );
    }
    function lvDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function lvHalf(v) {
      return v == "" || v == "am" || v == "pm";
    }
    function lvHalves() {
      return lvHalf(request.resource.data.startHalf)
        && lvHalf(request.resource.data.endHalf)
        && (
          (request.resource.data.start == request.resource.data.end
            && request.resource.data.startHalf == request.resource.data.endHalf)
          || (request.resource.data.start < request.resource.data.end
            && (request.resource.data.startHalf == "" || request.resource.data.startHalf == "pm")
            && (request.resource.data.endHalf == "" || request.resource.data.endHalf == "am"))
        );
    }
    function lvCertPath(uid, id) {
      return request.resource.data.certificatePath == ""
        || request.resource.data.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.pdf"
        || request.resource.data.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.jpg"
        || request.resource.data.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.png"
        || request.resource.data.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.webp";
    }
    function lvCreate(id) {
      return (lvHeartwood() || (callerCompany() != "heartwood" && callerCompany() != "" && hasProfile()))
        && id.matches('^lv[a-z0-9]{16}$')
        && request.resource.data.keys().hasOnly(["uid", "name", "type", "start", "end", "startHalf", "endHalf", "reason", "certificatePath", "certificateName", "status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "createdAt", "updatedAt", "companyId"])
        && (!("companyId" in request.resource.data) || request.resource.data.companyId == callerCompany())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && (request.resource.data.type == "annual" || request.resource.data.type == "sick" || request.resource.data.type == "other")
        && lvDate(request.resource.data.start)
        && lvDate(request.resource.data.end)
        && request.resource.data.end >= request.resource.data.start
        && lvHalves()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && lvCertPath(request.auth.uid, id)
        && request.resource.data.certificateName is string
        && request.resource.data.certificateName.size() <= 120
        && (request.resource.data.certificatePath == ""
          ? request.resource.data.certificateName == ""
          : request.resource.data.certificateName.size() > 0)
        && request.resource.data.status == "pending"
        && request.resource.data.decisionNote == ""
        && request.resource.data.decidedBy == ""
        && request.resource.data.decidedByName == ""
        && request.resource.data.decidedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    function lvDecision() {
      return lvDecider()
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "updatedAt"])
        && (request.resource.data.status == "approved" || request.resource.data.status == "declined")
        && request.resource.data.decisionNote is string
        && request.resource.data.decisionNote.size() > 0
        && request.resource.data.decisionNote.size() <= 500
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedByName is string
        && request.resource.data.decidedByName.size() > 0
        && request.resource.data.decidedByName.size() <= 80
        && request.resource.data.decidedAt == request.time
        && request.resource.data.updatedAt == request.time
        && same("uid") && same("name") && same("type") && same("start") && same("end")
        && same("startHalf") && same("endHalf") && same("reason")
        && same("certificatePath") && same("certificateName") && same("createdAt");
    }

    match /leaveRequests/{id} {
      allow get: if (lvHeartwood() && (resource == null && id.matches('^lv[a-z0-9]{16}$')
          || resource != null && docCompany(resource.data) == "heartwood" && (lvDecider() || resource.data.uid == request.auth.uid)))
        || (callerCompany() != "heartwood" && resource != null && resource.data.companyId == callerCompany()
          && (resource.data.uid == request.auth.uid || (hasProfile() && (profile().role == "admin" || profile().role == "supervisor"))));
      allow list: if lvHeartwood() && resource.data.uid == request.auth.uid;
      allow list: if lvHeartwood() && lvDecider() && resource.data.companyId == "heartwood";
      allow list: if callerCompany() != "heartwood" && resource.data.companyId == callerCompany()
        && (resource.data.uid == request.auth.uid || (hasProfile() && (profile().role == "admin" || profile().role == "supervisor")));
      allow create: if lvCreate(id) && (lvHeartwood() && callerCompany() == "heartwood" || request.resource.data.companyId == callerCompany());
      allow update: if lvDecision() && docCompany(resource.data) == callerCompany();
      allow delete: if false;
    }
// END LEAVE RULES

// BEGIN REIMBURSEMENT CLAIM RULES
    function rcSignedIn() { return request.auth != null; }
    function rcStaff() {
      return rcSignedIn() && (
        isAlex() || isPatrick() || (
          hasProfile() && callerCompany() == "heartwood"
        ) || (
          callerCompany() != "heartwood" && callerCompany() != "" && hasProfile()
        )
      );
    }
    function rcAdmin() {
      return rcStaff() && (isAlex() || isPatrick() || (hasProfile() && profile().role == "admin"));
    }
    function rcReceiptPath(uid, id) {
      return request.resource.data.receiptPath == ""
        || request.resource.data.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.pdf"
        || request.resource.data.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.jpg"
        || request.resource.data.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.png"
        || request.resource.data.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.webp";
    }
    function rcCreate(id) {
      return rcStaff()
        && id.matches('^rc[a-z0-9]{16}$')
        && request.resource.data.keys().hasOnly(["uid", "name", "date", "amountCents", "supplier", "category", "notes", "paidWith", "jobId", "jobLabel", "receiptPath", "receiptName", "status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "paidAt", "createdAt", "updatedAt", "companyId"])
        && (!("companyId" in request.resource.data) || request.resource.data.companyId == callerCompany())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && request.resource.data.amountCents <= 10000000
        && request.resource.data.supplier is string
        && request.resource.data.supplier.size() > 0
        && request.resource.data.supplier.size() <= 120
        && (request.resource.data.category == "fuel" || request.resource.data.category == "tip-fees" || request.resource.data.category == "parts" || request.resource.data.category == "tools" || request.resource.data.category == "consumables" || request.resource.data.category == "other")
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && (request.resource.data.paidWith == "personal-card" || request.resource.data.paidWith == "cash")
        && request.resource.data.jobId is string
        && request.resource.data.jobId.matches('^[A-Za-z0-9_-]{0,80}$')
        && request.resource.data.jobLabel is string
        && request.resource.data.jobLabel.size() <= 160
        && rcReceiptPath(request.auth.uid, id)
        && request.resource.data.receiptName is string
        && request.resource.data.receiptName.size() <= 120
        && (request.resource.data.receiptPath == ""
          ? request.resource.data.receiptName == ""
          : request.resource.data.receiptName.size() > 0)
        && request.resource.data.status == "submitted"
        && request.resource.data.decisionNote == ""
        && request.resource.data.decidedBy == ""
        && request.resource.data.decidedByName == ""
        && request.resource.data.decidedAt == null
        && request.resource.data.paidAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    function rcStep() {
      return (resource.data.status == "submitted" && (request.resource.data.status == "approved" || request.resource.data.status == "declined" || request.resource.data.status == "paid"))
        || (resource.data.status == "approved" && (request.resource.data.status == "paid" || request.resource.data.status == "declined"));
    }
    function rcDecision() {
      return rcAdmin()
        && rcStep()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "paidAt", "updatedAt", "hubdocStatus"])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["hubdocStatus"])
          || (request.resource.data.status == "paid"
            && request.resource.data.hubdocStatus == (resource.data.receiptPath == "" ? "no-receipt" : "queued")))
        && request.resource.data.decisionNote is string
        && request.resource.data.decisionNote.size() <= 500
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedByName is string
        && request.resource.data.decidedByName.size() > 0
        && request.resource.data.decidedByName.size() <= 80
        && request.resource.data.decidedAt == request.time
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.status == "paid"
          ? request.resource.data.paidAt == request.time
          : request.resource.data.paidAt == null);
    }

    // Hubdoc filer: the box sync account (tools/hubdoc_filer.py) reads paid claims and records only the Hubdoc
    // send state. It cannot change the claim itself, and only on claims that are already paid.
    function rcSync() { return rcSignedIn() && request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2"; }
    function rcHubdoc() {
      return rcSync()
        && resource.data.status == "paid"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hubdocStatus", "hubdocAttempts", "hubdocUpdatedAt", "hubdocSentAt", "hubdocMessageId", "hubdocVia", "hubdocError"])
        && request.resource.data.hubdocStatus in ["sending", "sent", "failed", "no-receipt"]
        && request.resource.data.get("hubdocAttempts", 0) is int
        && request.resource.data.get("hubdocError", "") is string
        && request.resource.data.get("hubdocError", "").size() <= 300
        && request.resource.data.get("hubdocMessageId", "") is string
        && request.resource.data.get("hubdocMessageId", "").size() <= 100;
    }

    match /reimbursementClaims/{id} {
      allow get: if (rcSync() && resource != null && resource.data.status == "paid")
        || (rcStaff() && callerCompany() == "heartwood" && (
          (resource == null && id.matches('^rc[a-z0-9]{16}$'))
          || (resource != null && docCompany(resource.data) == "heartwood" && (rcAdmin() || resource.data.uid == request.auth.uid))
        ))
        || (callerCompany() != "heartwood" && resource != null && resource.data.companyId == callerCompany()
          && (resource.data.uid == request.auth.uid || (hasProfile() && profile().role == "admin")));
      allow list: if rcStaff() && callerCompany() == "heartwood" && resource.data.uid == request.auth.uid;
      allow list: if rcAdmin() && callerCompany() == "heartwood" && resource.data.companyId == "heartwood";
      allow list: if rcSync() && resource.data.status == "paid";
      allow list: if callerCompany() != "heartwood" && resource.data.companyId == callerCompany()
        && (resource.data.uid == request.auth.uid || (hasProfile() && profile().role == "admin"));
      allow create: if rcCreate(id) && (
        callerCompany() == "heartwood" || request.resource.data.companyId == callerCompany()
      );
      allow update: if (rcDecision() && docCompany(resource.data) == callerCompany()) || rcHubdoc();
      allow delete: if false;
    }
// END REIMBURSEMENT CLAIM RULES
// BEGIN HOURS EXPORT RULES
    // Heartwood still queues to accounts@heartwoodew.com only.
    // Another company queues to companies/{id}.accountsEmail, never Heartwood's mailbox.
    function hxSignedIn() { return request.auth != null; }
    function hxProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hxHasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function hxCaller() {
      return callerCompany();
    }
    function hxAdmin() {
      return hxSignedIn() && (
        request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2" || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
        || (hxHasProfile() && hxProfile().get("role", "") == "admin" && hxCaller() != "")
      );
    }
    function hxSync() { return hxSignedIn() && request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2"; }
    function hxAccounts() {
      return hxCaller() == "heartwood"
        ? "accounts@heartwoodew.com"
        : get(/databases/$(database)/documents/companies/$(hxCaller())).data.accountsEmail;
    }
    function hxShape(d, id) {
      return id.matches('^hx[a-z0-9]{16}$')
        && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.weekEnd is string && d.weekEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.fileName is string && d.fileName.matches('^[A-Za-z0-9_-]{1,80}[.]xlsx$')
        && d.storagePath == "hoursExports/" + id + "/" + d.fileName
        && d.people is int && d.people >= 0 && d.people <= 500
        && d.totalHours is number && d.totalHours >= 0 && d.totalHours <= 100000
        && d.status == "queued" && d.attempts == 0
        && d.createdBy == request.auth.uid
        && d.createdByName is string && d.createdByName.size() <= 80
        && d.createdAt == request.time;
    }
    function hxCreate(id) {
      let d = request.resource.data;
      return hxAdmin() && hxCaller() != "" && hxShape(d, id) && (
        (hxCaller() == "heartwood"
          && d.keys().hasOnly(["weekStart", "weekEnd", "to", "fileName", "storagePath", "people", "totalHours", "status", "attempts", "createdBy", "createdByName", "createdAt", "companyId", "companyName"])
          && d.companyId == "heartwood"
          && d.companyName == "Heartwood"
          && d.to == "accounts@heartwoodew.com")
        || (hxCaller() != "heartwood"
          && d.keys().hasOnly(["weekStart", "weekEnd", "to", "fileName", "storagePath", "people", "totalHours", "status", "attempts", "createdBy", "createdByName", "createdAt", "companyId", "companyName"])
          && d.companyId == hxCaller()
          && d.companyName is string && d.companyName.size() > 0 && d.companyName.size() <= 80
          && d.to == hxAccounts()
          && d.to != "accounts@heartwoodew.com"
          && exists(/databases/$(database)/documents/companies/$(hxCaller()))
          && get(/databases/$(database)/documents/companies/$(hxCaller())).data.isTest != true)
      );
    }
    function hxMark() {
      return hxSync()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "attempts", "updatedAt", "sentAt", "messageId", "error", "via"])
        && request.resource.data.status in ["sending", "sent", "failed"]
        && request.resource.data.attempts is int
        && request.resource.data.get("error", "") is string && request.resource.data.get("error", "").size() <= 300
        && request.resource.data.get("messageId", "") is string && request.resource.data.get("messageId", "").size() <= 100;
    }
    match /hoursExports/{id} {
      allow get: if (hxAdmin() && docCompany(resource.data) == hxCaller()) || hxSync();
      allow list: if hxAdmin() && resource.data.companyId == hxCaller();
      allow list: if hxSync();
      allow create: if hxCreate(id);
      allow update: if hxMark();
      allow delete: if false;
    }
// END HOURS EXPORT RULES

// BEGIN INBOX IMPORT RULES
    // inbox/{gmailMessageId} is written by the box (tools/sync_inbox.py, admin SDK, or the
    // same sync UID as hours export). The app only marks read and imported.
    // Admins and supervisors can read and mark. Operators cannot. No client deletes.
    function inSignedIn() { return request.auth != null; }
    function inSync() { return inSignedIn() && request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2"; }
    function inOffice() {
      return inSignedIn() && (
        request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"
        || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin"
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "supervisor"
          )
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("tenantId", "heartwood") == "heartwood"
        )
      );
    }
    function inMark() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(["read", "readAt", "imported", "importedJobId", "importedAt", "importedBy", "jobIds"])
        && (!changed.hasAny(["read"]) || request.resource.data.read is bool)
        && (!changed.hasAny(["readAt"]) || request.resource.data.readAt == request.time)
        && (!changed.hasAny(["imported"]) || request.resource.data.imported == true)
        && (!changed.hasAny(["importedJobId"]) || (
          request.resource.data.importedJobId is string
          && request.resource.data.importedJobId.size() > 0
          && request.resource.data.importedJobId.size() <= 128
          && request.resource.data.importedJobId.matches('^[A-Za-z0-9_-]+$')
        ))
        && (!changed.hasAny(["importedBy"]) || request.resource.data.importedBy == request.auth.uid)
        && (!changed.hasAny(["importedAt"]) || request.resource.data.importedAt == request.time)
        && (!changed.hasAny(["jobIds"]) || (
          request.resource.data.jobIds is list && request.resource.data.jobIds.size() <= 20
        ))
        && (!changed.hasAny(["imported", "importedJobId", "importedBy", "importedAt"])
          || (changed.hasAll(["imported", "importedJobId", "importedBy", "importedAt"])));
    }
    match /inbox/{id} {
      allow read: if inOffice() || inSync();
      allow create: if inSync();
      allow update: if inSync() || (inOffice() && inMark());
      allow delete: if false;
    }
// END INBOX IMPORT RULES

// BEGIN JOB CHECK RULES
    // jobChecks/{id} is written by requestJobCheck with the Admin SDK.
    // Heartwood admins (Alex, Patrick) and Heartwood admin or supervisor
    // profiles can read. A missing companyId on the profile means heartwood.
    // Nobody can write from the client. Test and friend companies are not
    // heartwood, so their staff cannot read these rows.
    function jcSignedIn() { return request.auth != null; }
    function jcUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function jcCompanyId() {
      return jcUser().keys().hasAny(["companyId"]) && jcUser().companyId is string && jcUser().companyId.size() > 0
        ? jcUser().companyId
        : (jcUser().keys().hasAny(["tenantId"]) && jcUser().tenantId is string && jcUser().tenantId.size() > 0
          ? jcUser().tenantId
          : "heartwood");
    }
    function jcOffice() {
      return jcSignedIn() && (
        request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"
        || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (jcUser().get("role", "") == "admin" || jcUser().get("role", "") == "supervisor")
          && jcCompanyId() == "heartwood"
        )
      );
    }
    match /jobChecks/{id} {
      allow get: if jcOffice() && resource.data.companyId == "heartwood";
      allow list: if jcOffice() && resource.data.companyId == "heartwood";
      allow create, update, delete: if false;
    }
// END JOB CHECK RULES
  }
}
