rules_version = '2';
// EMULATOR MODEL ONLY. Do not deploy.
// The live Firestore rules are not in this repository. Deploying this file
// would replace jobs, quotes, photos-email and receipt rules.
// These rules cover only the checks this branch adds: tenant fields cannot be
// self-served, Xero queue items stay on the existing Heartwood finance UIDs,
// the INVITE block (also cloud/production/firestore.invites.rules), the
// CHAT block (also cloud/production/firestore.chat.rules), the FLEET block
// (cloud/production/firestore.fleet.rules), the SERVICING block
// (cloud/production/firestore.servicing.rules), the PRESTART block
// (cloud/production/firestore.prestart.rules), the SWMS SIGNATURE and
// RUN SHEET blocks (cloud/production/firestore.swms.rules and
// firestore.runsheets.rules), the TIMESHEET block
// (cloud/production/firestore.timesheet.rules), the LEAVE block
// (cloud/production/firestore.leave.rules), the REIMBURSEMENT block
// (cloud/production/firestore.reimbursements.rules), the HOURS EXPORT block
// (cloud/production/firestore.hours-export.rules), the INBOX IMPORT block
// (cloud/production/firestore.inbox.rules), and the INBOUND FORWARD block
// (cloud/production/firestore.inbound.rules). Paste those blocks into the live rules.
// Do not deploy this whole file.
// CallUp Base does not use xeroQueue. Heartwood's current app still does.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }


    function docData() { return request.resource.data; }
    function prevData() { return resource.data; }
    function textMax(v, n) {
      return v is string && v.size() <= n;
    }
    function textLen(v, lo, hi) {
      return v is string && v.size() >= lo && v.size() <= hi;
    }
    // Same catalogue as cloud/firestore.production.rules. Do not keep a second copy of the ids.
    function tradeIdOk(id) {
      return id is string && id in ["earthworks", "landscaping", "concreting", "fencing", "carpentry", "tiling", "plumbing", "electrical", "concrete-cutting", "cleaning", "property-maintenance", "pest-control", "skip-bins", "pools", "solar-aircon", "traffic-control", "civil-earthworks", "traffic-civil"];
    }
    function tradeSetOk(list, min, max) {
      return list is list && list.size() >= min && list.size() <= max && list.hasOnly(["earthworks", "landscaping", "concreting", "fencing", "carpentry", "tiling", "plumbing", "electrical", "concrete-cutting", "cleaning", "property-maintenance", "pest-control", "skip-bins", "pools", "solar-aircon", "traffic-control", "civil-earthworks", "traffic-civil"]);
    }
    function isAlex() { return signedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function isPatrick() { return signedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function isHeartwoodFinance() { return isAlex() || isPatrick(); }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return exists(userPath()); }
    function profile() { return get(userPath()).data; }
    function isAppAdmin() {
      return isAlex() || isPatrick() || (hasProfile() && profile().role == "admin" && callerCompany() == "heartwood");
    }

    // Platform owner is Alex's verified mailbox, plus either his bootstrap uid
    // or a custom claim platformOwner=true. A company admin cannot set this.
    function platformOwner() {
      return signedIn()
        && "email_verified" in request.auth.token
        && request.auth.token.email_verified == true
        && "email" in request.auth.token
        && request.auth.token.email == "alex@heartwoodew.com"
        && (("platformOwner" in request.auth.token && request.auth.token.platformOwner == true) || isAlex());
    }
    function docCompany(data) {
      return ("companyId" in data && data.companyId is string && data.companyId.size() > 0)
        ? data.companyId
        : (("tenantId" in data && data.tenantId is string && data.tenantId.size() > 0)
          ? data.tenantId
          : "heartwood");
    }
    // Paused: the trial has ended and the company is not paying, or the platform owner
    // set ownerPaused. One company lookup. Heartwood returns before the lookup.
    // A missing company document is not paused (legacy Heartwood data and tests).
    // ownerPaused is checked first so a test or paying company can still be held.
    // A missing ownerPaused field is not an owner pause. Billing writes use the Admin SDK.
    function companyRecordOpen(data) {
      return data.get("ownerPaused", false) != true
        && (data.get("isTest", false) == true || companyBillingOpen(data));
    }
    function companyBillingOpen(data) {
      let raw = data.get("billing", null);
      let status = raw is map ? raw.get("status", "") : "";
      let plan = data.get("plan", "");
      let trialEnd = data.get("trialEndsAt", null);
      let friendEnd = data.get("friendEndsAt", null);
      let trialOver = trialEnd is timestamp && !(trialEnd > request.time);
      let friendOver = friendEnd is timestamp && !(friendEnd > request.time);
      // Pause only when a trial or friend end is actually in the past. A missing end (older docs) stays open.
      return status == "active" || status == "trialing"
        || (plan == "paid" && status != "past_due" && status != "canceled")
        || (plan == "friend" && !friendOver)
        || (plan != "friend" && plan != "paid" && !trialOver && data.get("status", "active") == "active");
    }
    function companyNotPaused(companyId) {
      let path = /databases/$(database)/documents/companies/$(companyId);
      return !exists(path) || companyRecordOpen(get(path).data);
    }
    function companyOpen(companyId) {
      return companyId == "heartwood" || companyNotPaused(companyId);
    }
    function sessionPath() { return /databases/$(database)/documents/platformSessions/$(request.auth.uid); }
    function sessionCompany() {
      let id = platformOwner() && exists(sessionPath()) ? get(sessionPath()).data.get("companyId", "") : "";
      let path = /databases/$(database)/documents/companies/$(id);
      let row = id is string && id.size() > 1 && exists(path) ? get(path).data : null;
      return row != null && row.isTest == true && row.status == "active" ? id : "";
    }
    function callerCompany() {
      let session = sessionCompany();
      return session != "" ? session
        : (isAlex() || isPatrick())
        ? "heartwood"
        : (hasProfile() && "companyId" in profile() && profile().companyId is string && profile().companyId.size() > 0
          ? profile().companyId
          : (hasProfile() && "tenantId" in profile() && profile().tenantId is string && profile().tenantId.size() > 0
            ? profile().tenantId
            : (hasProfile() ? "heartwood" : "")));
    }
    function companyIdOk(id) {
      return textLen(id, 2, 40) && id.matches('^[a-z0-9][a-z0-9-]{0,39}$');
    }
    // Length only. A state list or postcode regex here pushes company edits over the 1000-expression cap.
    // The app checks the eight state codes and a 4-digit postcode before it writes.
    function addressPartsOk(data) {
      return !("addressParts" in data) || (
        data.addressParts.size() == 4
        && data.addressParts.street.size() > 0 && data.addressParts.street.size() <= 80
        && data.addressParts.suburb.size() > 0 && data.addressParts.suburb.size() <= 40
        && data.addressParts.state.size() == 3
        && data.addressParts.postcode.size() == 4);
    }
        function companyDetailText(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.legalName is string && data.legalName.size() >= 1 && data.legalName.size() <= 120
        && data.abn is string && data.abn.size() >= 1 && data.abn.size() <= 20
        && data.signoff is string && data.signoff.size() <= 80
        && data.logoUrl is string && data.logoUrl.size() <= 300
        && data.address is string && data.address.size() >= 1 && data.address.size() <= 160
        && data.phone is string && data.phone.size() <= 40
        && data.email is string && data.email.size() >= 6 && data.email.size() <= 120
        && data.accountsEmail is string && data.accountsEmail.size() >= 6 && data.accountsEmail.size() <= 120
        && data.hubdocAddress is string && data.hubdocAddress.size() <= 120
        && (data.hubdocAddress == "" || data.hubdocAddress.matches('^[a-z0-9._+-]+@app[.]hubdoc[.]com$'))
        && addressPartsOk(data);
    }
    function companyBillingLocked(data) {
      return data.billing is map
        && data.billing.keys().hasOnly(["provider", "status", "stripeCustomerId", "stripeSubscriptionId"])
        && data.billing.provider == null
        && data.billing.status == "not-configured"
        && data.billing.stripeCustomerId == null
        && data.billing.stripeSubscriptionId == null;
    }
    function oneTradeId(id) {
      return tradeIdOk(id);
    }
    function tradeFieldOk(data) {
      return !("trade" in data) || oneTradeId(data.trade);
    }
    function tradesListOk(list) {
      return tradeSetOk(list, 1, 18);
    }
    function companyTradesEdit(companyId) {
      let next = docData();
      let prev = prevData();
      return next.diff(prev).affectedKeys().hasOnly(["trades"])
        && referralFieldsSame()
        && signedIn()
        && companyId == callerCompany()
        && (isAlex() || isPatrick() || (hasProfile() && (profile().role == "admin" || profile().role == "manager")))
        && tradesListOk(next.trades);
    }
    // Referral code, referredBy and reward fields are written by Cloud Functions only.
    // A client cannot set them at create, and cannot add or change a referral after the company exists.
    function referralClientFieldsAbsent(data) {
      return !("referredBy" in data) && !("referralCode" in data) && !("referralReward" in data);
    }
    function referralFieldsSame() {
      let next = docData();
      let prev = prevData();
      return next.get("referredBy", null) == prev.get("referredBy", null)
        && next.get("referralCode", null) == prev.get("referralCode", null)
        && next.get("referralReward", null) == prev.get("referralReward", null);
    }
    function companyOwnerCreate(companyId) {
      let d = docData();
      return signedIn()
        && !isAlex() && !isPatrick()
        && !hasProfile()
        && companyIdOk(companyId)
        && companyId != "heartwood"
        && d.keys().hasOnly(["name", "legalName", "abn", "signoff", "logoUrl", "address", "addressParts", "phone", "email", "accountsEmail", "hubdocAddress", "ownerUid", "createdBy", "status", "plan", "origin", "isTest", "signedUpAt", "trialEndsAt", "staffCount", "jobCount", "lastActivityAt", "billing", "trade", "trades"])
        && companyDetailText(d) && tradeFieldOk(d) && (!("trades" in d) || tradesListOk(d.trades))
        && d.ownerUid == request.auth.uid
        && d.createdBy == request.auth.uid
        && d.status == "active"
        && d.plan == "trial"
        && d.isTest == false
        && d.origin == "signup"
        && d.signedUpAt == request.time
        && d.trialEndsAt > request.time + duration.value(13, 'd')
        && d.trialEndsAt < request.time + duration.value(15, 'd')
        && d.staffCount == 1
        && d.jobCount == 0
        && d.lastActivityAt == request.time
        && companyBillingLocked(d)
        && referralClientFieldsAbsent(d)
        && !d.keys().hasAny(["platformOwner", "finance"]);
    }
    function companyAdminEdit(companyId) {
      let next = docData();
      let prev = prevData();
      let diff = next.diff(prev).affectedKeys();
      return diff.hasOnly(["name", "legalName", "abn", "signoff", "logoUrl", "address", "addressParts", "phone", "email", "accountsEmail", "hubdocAddress"])
        && referralFieldsSame()
        && signedIn()
        && companyId == callerCompany()
        && (isAlex() || isPatrick() || (hasProfile() && profile().role == "admin"))
        && companyDetailText(next)
        && next.status == prev.status
        && next.plan == prev.plan
        && next.billing == prev.billing
        && next.ownerUid == prev.ownerUid
        && next.staffCount == prev.staffCount
        && next.jobCount == prev.jobCount
        && next.origin == prev.origin
        && next.get("isTest", false) == prev.get("isTest", false)
        && next.get("plan", "trial") == prev.get("plan", "trial")
        && next.get("friendEndsAt", null) == prev.get("friendEndsAt", null);
    }
    function testCompanyCreate(companyId) {
      let d = docData();
      return platformOwner()
        && companyIdOk(companyId)
        && companyId != "heartwood"
        && d.keys().hasOnly(["name", "legalName", "abn", "signoff", "logoUrl", "address", "addressParts", "phone", "email", "accountsEmail", "hubdocAddress", "ownerUid", "createdBy", "status", "plan", "origin", "isTest", "demoData", "signedUpAt", "trialEndsAt", "staffCount", "jobCount", "lastActivityAt", "billing", "trade", "trades"])
        && companyDetailText(d) && tradeFieldOk(d) && (!("trades" in d) || tradesListOk(d.trades))
        && d.isTest == true
        && d.plan == "trial"
        && d.origin == "test"
        && d.status == "active"
        && d.demoData is bool
        && d.ownerUid == request.auth.uid
        && d.createdBy == request.auth.uid
        && d.signedUpAt == request.time
        && d.trialEndsAt == null
        && d.lastActivityAt == request.time
        && companyBillingLocked(d)
        && referralClientFieldsAbsent(d)
        && (d.demoData == true ? (d.staffCount == 2 && d.jobCount == 2) : (d.staffCount == 0 && d.jobCount == 0));
    }
    function friendInvitePath(code) { return /databases/$(database)/documents/friendInvites/$(code); }
    function friendCompanyCreate(companyId) {
      let d = docData();
      return signedIn()
        && !isAlex() && !isPatrick()
        && !hasProfile()
        && companyIdOk(companyId)
        && companyId != "heartwood"
        && d.keys().hasOnly(["name", "legalName", "abn", "signoff", "logoUrl", "address", "addressParts", "phone", "email", "accountsEmail", "hubdocAddress", "ownerUid", "createdBy", "status", "plan", "origin", "isTest", "demoData", "friendInvite", "friendEndsAt", "signedUpAt", "trialEndsAt", "staffCount", "jobCount", "lastActivityAt", "billing", "trade", "trades"])
        && companyDetailText(d) && tradeFieldOk(d) && (!("trades" in d) || tradesListOk(d.trades))
        && d.plan == "friend"
        && d.isTest == false
        && d.demoData == false
        && d.origin == "friend"
        && d.status == "active"
        && d.friendInvite is string
        && d.friendInvite == d.friendInvite
        && exists(friendInvitePath(d.friendInvite))
        && get(friendInvitePath(d.friendInvite)).data.status == "pending"
        && existsAfter(friendInvitePath(d.friendInvite))
        && getAfter(friendInvitePath(d.friendInvite)).data.status == "used"
        && getAfter(friendInvitePath(d.friendInvite)).data.usedBy == request.auth.uid
        && getAfter(friendInvitePath(d.friendInvite)).data.companyId == companyId
        && d.ownerUid == request.auth.uid
        && d.friendEndsAt == null
        && d.trialEndsAt == null
        && d.signedUpAt == request.time
        && d.lastActivityAt == request.time
        && d.staffCount == 1
        && d.jobCount == 0
        && companyBillingLocked(d)
        && referralClientFieldsAbsent(d);
    }
    function ownerPlanEdit(companyId) {
      let next = docData();
      let prev = prevData();
      return next.diff(prev).affectedKeys().hasOnly(["plan", "friendEndsAt", "trialEndsAt"])
        && referralFieldsSame()
        && platformOwner()
        && prev.get("isTest", false) != true
        && next.get("isTest", false) == prev.get("isTest", false)
        && next.plan in ["friend", "trial", "paid"]
        && next.billing == prev.billing
        && next.status == prev.status
        && (next.friendEndsAt == null || next.friendEndsAt is timestamp)
        && (next.plan != "trial" || (
          next.trialEndsAt > request.time + duration.value(13, 'd')
          && next.trialEndsAt < request.time + duration.value(15, 'd')
        ));
    }
    function testArchive(companyId) {
      let next = docData();
      let prev = prevData();
      return next.diff(prev).affectedKeys().hasOnly(["status", "archivedAt"])
        && referralFieldsSame()
        && platformOwner()
        && prev.isTest == true
        && prev.status == "active"
        && next.status == "archived"
        && next.archivedAt == request.time
        && next.isTest == true
        && next.plan == prev.plan
        && next.billing == prev.billing;
    }
    function testDemoCounts(companyId) {
      let next = docData();
      let prev = prevData();
      return next.diff(prev).affectedKeys().hasOnly(["demoData", "staffCount", "jobCount", "lastActivityAt"])
        && referralFieldsSame()
        && platformOwner()
        && prev.isTest == true
        && prev.status == "active"
        && next.demoData == true
        && next.staffCount == 2
        && next.jobCount == 2
        && next.lastActivityAt == request.time;
    }
    function companyStatsBump(companyId) {
      let next = docData();
      let prev = prevData();
      return next.diff(prev).affectedKeys().hasOnly(["staffCount", "jobCount", "lastActivityAt"])
        && referralFieldsSame()
        && signedIn()
        && companyId == callerCompany()
        && hasProfile()
        && next.staffCount is int && next.jobCount is int
        && next.staffCount >= prev.staffCount && next.staffCount <= prev.staffCount + 1
        && next.jobCount >= prev.jobCount && next.jobCount <= prev.jobCount + 1
        && next.lastActivityAt == request.time;
    }
    function profileCompany() {
      let user = hasProfile() ? profile() : null;
      return user == null ? ""
        : (user.get("companyId", "") is string && user.get("companyId", "").size() > 0
          ? user.get("companyId", "")
          : (user.get("tenantId", "") is string && user.get("tenantId", "").size() > 0
            ? user.get("tenantId", "")
            : ""));
    }
    // Only the platform owner can set or clear an owner pause. Heartwood and the
    // caller's own company are refused. The pause record (who, when) stays on reactivate.
    function ownerPauseEdit(companyId) {
      let next = docData();
      let prev = prevData();
      let diff = next.diff(prev).affectedKeys();
      return diff.hasAny(["ownerPaused", "ownerPausedAt", "ownerPausedBy", "ownerReactivatedAt", "ownerReactivatedBy"])
        && referralFieldsSame()
        && platformOwner()
        && companyId != "heartwood"
        && companyId != profileCompany()
        && companyIdOk(companyId)
        && next.billing == prev.billing
        && next.plan == prev.plan
        && next.status == prev.status
        && next.get("isTest", false) == prev.get("isTest", false)
        && (
          (diff.hasOnly(["ownerPaused", "ownerPausedAt", "ownerPausedBy"])
            && next.ownerPaused == true
            && next.ownerPausedBy == request.auth.uid
            && next.ownerPausedAt == request.time)
          || (prev.get("ownerPaused", false) == true
            && diff.hasOnly(["ownerPaused", "ownerReactivatedAt", "ownerReactivatedBy"])
            && next.ownerPaused == false
            && next.ownerReactivatedBy == request.auth.uid
            && next.ownerReactivatedAt == request.time
            && next.get("ownerPausedBy", "") == prev.get("ownerPausedBy", "")
            && next.get("ownerPausedAt", null) == prev.get("ownerPausedAt", null))
        );
    }
    function ownerProfileCreate() {
      let d = docData();
      // jobTitle/jobTitleId: the signup screen labels the owner "Admin" under their first trade (PR 71).
      return d.keys().hasOnly(["name", "email", "role", "companyId", "tenantId", "jobTitle", "jobTitleId"])
        && d.role == "admin"
        && d.get("jobTitle", "Admin") == "Admin"
        && d.get("jobTitleId", "earthworks:admin").matches('^(earthworks|landscaping|concreting|fencing|carpentry|tiling|plumbing|electrical|concrete-cutting|cleaning|property-maintenance|pest-control|skip-bins|pools|solar-aircon|traffic-control|civil-earthworks):admin$')
        && companyIdOk(d.companyId)
        && d.companyId != "heartwood"
        && d.tenantId == d.companyId
        &&textLen(d.name, 1, 80)
        &&textMax(d.email, 120)
        && exists(/databases/$(database)/documents/companies/$(d.companyId))
        && get(/databases/$(database)/documents/companies/$(d.companyId)).data.ownerUid == request.auth.uid
        && !d.keys().hasAny(["platformOwner", "finance", "customerIds"]);
    }

    function same(key) {
      let next = docData();
      let prev = prevData();
      return (!(key in next) && !(key in prev))
        || ((key in next) && (key in prev) && next[key] == prev[key]);
    }
    function fieldSame(next, prev, key) {
      return (!(key in next) && !(key in prev))
        || ((key in next) && (key in prev) && next[key] == prev[key]);
    }
    match /users/{uid} {
      allow get: if signedIn() && (
        request.auth.uid == uid
        || platformOwner()
        || (callerCompany() != "" && docCompany(prevData()) == callerCompany()
          && (isAlex() || isPatrick() || (hasProfile() && (profile().role == "admin" || profile().role == "supervisor" || profile().role == "manager"))))
      );
      allow list: if platformOwner();
      allow list: if signedIn() && callerCompany() != ""
        && prevData().companyId == callerCompany()
        && (isAlex() || isPatrick() || (hasProfile() && (profile().role == "admin" || profile().role == "supervisor" || profile().role == "manager")));
      allow create: if signedIn() && request.auth.uid == uid && (
        (!docData().keys().hasAny(["tenantId", "role", "customerIds", "finance", "platformOwner", "companyId"]))
        || ownerProfileCreate()
      );
      allow create, update: if platformOwner()
        && uid.matches('^demo-[a-z0-9-]{1,80}$')
        && docData().keys().hasOnly(["name", "role", "companyId", "tenantId", "demo", "email"])
        && docData().demo == true
        && docData().role in ["operator", "supervisor"]
        && docData().companyId is string
        && docData().tenantId == docData().companyId
        && exists(/databases/$(database)/documents/companies/$(docData().companyId))
        && get(/databases/$(database)/documents/companies/$(docData().companyId)).data.isTest == true
        && !docData().keys().hasAny(["platformOwner", "finance", "isTest"]);
      allow update: if signedIn() && request.auth.uid == uid
        && same("tenantId") && same("role") && same("customerIds") && same("finance")
        && same("companyId") && same("platformOwner");
      allow delete: if false;
    }

    match /xeroQueue/{id} {
      allow read: if isHeartwoodFinance();
      allow create: if isHeartwoodFinance()
        && callerCompany() == "heartwood"
        && docData().status == "queued"
        && docData().by == request.auth.uid
        && (!("tenantId" in docData()) || docData().tenantId == "heartwood")
        && docData().get("isTest", false) != true;
      allow update, delete: if false;
    }

    match /tenants/{id} {
      allow get: if signedIn() && (id == callerCompany() || platformOwner());
      allow list: if platformOwner();
      allow write: if false;
    }

    // Reads are company-scoped. Writes stay closed in this emulator model:
    // the live jobs and receipts rules are not in this file. Do not deploy it.
    function demoJobWrite(id) {
      let d = docData();
      return platformOwner()
        && id.matches('^demo-[a-z0-9-]{1,80}$')
        && d.demo == true
        && d.companyId is string
        && d.tenantId == d.companyId
        && exists(/databases/$(database)/documents/companies/$(d.companyId))
        && get(/databases/$(database)/documents/companies/$(d.companyId)).data.isTest == true
        && d.keys().hasOnly(["client", "address", "type", "description", "date", "time", "status", "companyId", "tenantId", "demo", "assigned", "assignedNames"])
        &&textMax(d.client, 80)
        &&textMax(d.address, 160)
        &&textMax(d.description, 400)
        && !d.keys().hasAny(["invoiceAmount", "invoiceNo", "amountInc", "quoteAmount", "poAmount", "poAmountBasis", "poAmountSource"]);
    }
    // Job money (round 3, Q6): PO value and accepted-quote total, office only (see firestore.production.rules).
    // Read model only here: Heartwood finance, company admins and supervisors of the same company. Crew never.
    function jobMoneyReader(data) {
      return signedIn() && callerCompany() != "" && docCompany(data) == callerCompany()
        && companyOpen(docCompany(data))
        && (isAlex() || isPatrick() || (hasProfile() && (profile().role == "admin" || profile().role == "supervisor" || profile().role == "manager")));
    }
    match /jobMoney/{id} {
      allow get: if resource == null ? jobMoneyReader({"companyId": callerCompany()}) : jobMoneyReader(prevData());
      allow list: if jobMoneyReader(prevData()) && prevData().companyId == callerCompany();
      allow write: if false;
    }
    match /jobs/{id} {
      allow get: if signedIn() && callerCompany() != "" && docCompany(prevData()) == callerCompany() && companyOpen(docCompany(prevData()));
      allow list: if signedIn() && callerCompany() != "" && prevData().companyId == callerCompany() && companyOpen(prevData().companyId);
      allow write: if false;
      allow create, update: if demoJobWrite(id);
    }
    match /receipts/{id} {
      allow get: if signedIn() && callerCompany() != "" && docCompany(prevData()) == callerCompany() && companyOpen(docCompany(prevData()));
      allow list: if signedIn() && callerCompany() != "" && prevData().companyId == callerCompany() && companyOpen(prevData().companyId);
      allow write: if false;
    }

// BEGIN COMPANY RULES
    match /companies/{companyId} {
      allow get: if platformOwner() || (signedIn() && callerCompany() == companyId);
      allow list: if platformOwner();
      allow create: if companyOwnerCreate(companyId) || testCompanyCreate(companyId) || friendCompanyCreate(companyId);
      // Separate allows, and each one checks the changed keys before any profile read.
      // One combined condition crosses the 1000-expression cap.
      allow update: if companyTradesEdit(companyId);
      allow update: if ownerPlanEdit(companyId);
      allow update: if testArchive(companyId);
      allow update: if testDemoCounts(companyId);
      allow update: if companyAdminEdit(companyId);
      allow update: if companyStatsBump(companyId);
      allow update: if ownerPauseEdit(companyId);
      allow delete: if false;
    }
// END COMPANY RULES

// BEGIN AUTOFILL RULES
    // Emails this company has already sent a job to. Office only (admin, manager, supervisor,
    // plus Alex and Patrick at Heartwood). Crew cannot read it: it can name people on jobs
    // they are not assigned to. No price fields. No list, no delete.
    match /companies/{companyId}/autofill/{docId} {
      function autofillOffice(companyId) {
        return signedIn()
          && companyId == callerCompany()
          && companyOpen(companyId)
          && (
            (companyId == "heartwood" && (isAlex() || isPatrick()))
            || (hasProfile() && profile().get("role", "") in ["admin", "supervisor", "manager"])
          );
      }
      function autofillDocOk(companyId) {
        let d = docData();
        return d.keys().hasOnly(["companyId", "emails", "updatedAt", "updatedBy"])
          && d.companyId == companyId
          && d.emails is list
          && d.emails.size() <= 40
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
      }

      allow get: if docId == "recipients" && autofillOffice(companyId) && (resource == null || prevData().companyId == companyId);
      allow list: if false;
      allow create, update: if docId == "recipients" && autofillOffice(companyId) && autofillDocOk(companyId);
      allow delete: if false;
    }
// END AUTOFILL RULES

    // Deletion audit. Written by deleteCompanyAccount (Admin SDK). Kept outside the company
    // that was deleted. Clients cannot write or delete it.
    match /companyDeletions/{companyId} {
      allow read: if platformOwner();
      allow create, update, delete: if false;
    }

    // Referral lookup, reward state and audit. Cloud Functions use the Admin SDK.
    // Clients cannot read or write these, so a reward cannot be granted from the browser.
    match /referralCodes/{code} {
      allow read, write: if false;
    }
    match /referrals/{referredCompanyId} {
      allow read, write: if false;
    }
    match /referralAudits/{id} {
      allow read, write: if false;
    }
    match /referralLocks/{companyId} {
      allow read, write: if false;
    }

    match /platformSessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if platformOwner() && request.auth.uid == uid
        && docData().keys().hasOnly(["companyId"])
        && textMax(docData().companyId, 40)
        && (docData().companyId == ""
          || (exists(/databases/$(database)/documents/companies/$(docData().companyId))
            && get(/databases/$(database)/documents/companies/$(docData().companyId)).data.isTest == true
            && get(/databases/$(database)/documents/companies/$(docData().companyId)).data.status == "active"));
      allow delete: if false;
    }

    function friendCodeOk(code) { return code.matches('^[a-z0-9]{8}$'); }
    match /friendInvites/{code} {
      allow get: if platformOwner()
        || (signedIn() && prevData().status == "pending")
        || (signedIn() && prevData().usedBy == request.auth.uid);
      allow list: if platformOwner();
      allow create: if platformOwner()
        && friendCodeOk(code)
        && docData().keys().hasOnly(["status", "createdBy", "createdAt", "note"])
        && docData().status == "pending"
        && docData().createdBy == request.auth.uid
        && docData().createdAt == request.time
        && textMax(docData().note, 80);
      allow update: if (
          platformOwner()
          && prevData().status == "pending"
          && docData().status == "revoked"
          && docData().diff(prevData()).affectedKeys().hasOnly(["status", "revokedAt"])
          && docData().revokedAt == request.time
        ) || (
          signedIn()
          && prevData().status == "pending"
          && docData().status == "used"
          && docData().usedBy == request.auth.uid
          && docData().companyId is string
          && docData().usedAt == request.time
          && docData().diff(prevData()).affectedKeys().hasOnly(["status", "usedBy", "companyId", "usedAt"])
          && existsAfter(/databases/$(database)/documents/companies/$(docData().companyId))
          && getAfter(/databases/$(database)/documents/companies/$(docData().companyId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/companies/$(docData().companyId)).data.plan == "friend"
          && getAfter(/databases/$(database)/documents/companies/$(docData().companyId)).data.friendInvite == code
        );
      allow delete: if false;
    }

    match /testMailLog/{id} {
      allow read: if platformOwner();
      allow create: if platformOwner()
        && sessionCompany() != ""
        && docData().keys().hasOnly(["kind", "status", "companyId", "preview", "createdAt"])
        && docData().kind in ["hours", "hubdoc", "xero", "builder"]
        && docData().status == "preview"
        && docData().companyId == sessionCompany()
        && textMax(docData().preview, 2000)
        && docData().createdAt == request.time;
      allow update, delete: if false;
    }

// BEGIN INVITE RULES
    function inviteSignedIn() { return request.auth != null; }
    function inviteIsAlex() { return inviteSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function inviteIsPatrick() { return inviteSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function inviteUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function inviteHasProfile() { return inviteSignedIn() && exists(inviteUserPath()); }
    function inviteProfile() { return get(inviteUserPath()).data; }
    function inviteAdmin() {
      return inviteIsAlex() || inviteIsPatrick()
        || (inviteHasProfile() && "role" in inviteProfile()
          && (inviteProfile().role == "admin" || inviteProfile().role == "supervisor" || inviteProfile().role == "manager"));
    }
    function inviteCallerTenant() {
      return inviteIsAlex() || inviteIsPatrick()
        ? "heartwood"
        : (inviteHasProfile() && "companyId" in inviteProfile() && inviteProfile().companyId is string && inviteProfile().companyId.size() > 0
          ? inviteProfile().companyId
          : (inviteHasProfile() && "tenantId" in inviteProfile() && inviteProfile().tenantId is string && inviteProfile().tenantId.size() > 0
          ? inviteProfile().tenantId
          : (inviteHasProfile() ? "heartwood" : "")));
    }
    function inviteEmailOk(email) {
      return textLen(email, 6, 120)
        && email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
    }
    // Labourer, operator or supervisor: any invite admin (admin or supervisor). Admin: a profile-role admin of a CallUp
    // company, or a Heartwood admin (Alex, Patrick, or an accepted Heartwood admin grant in heartwoodAdmins/{uid}).
    function inviteFullAdmin() {
      return inviteCallerTenant() == "heartwood"
        ? (inviteIsAlex() || inviteIsPatrick()
          || (exists(/databases/$(database)/documents/heartwoodAdmins/$(request.auth.uid))
            && inviteHasProfile() && inviteProfile().get("role", "") == "admin"))
        : (inviteHasProfile() && "role" in inviteProfile() && inviteProfile().role == "admin");
    }
    function inviteRoleOk() {
      let next = docData();
      return next.role in ["labourer", "operator", "supervisor", "manager"]
        || (next.role == "admin" && inviteFullAdmin());
    }
    function inviteSame(key) {
      let next = docData();
      let prev = prevData();
      return (!(key in next) && !(key in prev))
        || ((key in next) && (key in prev) && next[key] == prev[key]);
    }
    function inviteBaseOk() {
      let next = docData();
      return textLen(next.name, 1, 80)
        && !next.name.matches('.*[\\n\\r\\t<>].*')
        && inviteEmailOk(next.email)
        && inviteRoleOk()
        && next.tenantId is string
        && next.tenantId == inviteCallerTenant()
        && next.tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && (!("companyId" in next) || next.companyId == next.tenantId)
        && next.token is string
        && next.token.matches('^[A-Za-z0-9_-]{43,128}$')
        && textLen(next.createdBy, 1, 128)
        && next.createdAt is timestamp
        && next.expiresAt is timestamp;
    }
    function inviteExpiryWindow() {
      let next = docData();
      return next.expiresAt > request.time + duration.value(6, 'd')
        && next.expiresAt < request.time + duration.value(8, 'd');
    }
    function inviteLockPath(email) { return /databases/$(database)/documents/inviteEmails/$(email); }
    function invitePath(inviteId) { return /databases/$(database)/documents/invites/$(inviteId); }
    function inviteLockFree(email) {
      return !exists(inviteLockPath(email))
        || get(inviteLockPath(email)).data.status != "pending";
    }
    function inviteLockAgrees(email, inviteId) {
      let next = docData();
      return existsAfter(inviteLockPath(email))
        && getAfter(inviteLockPath(email)).data.keys().hasOnly(["email", "status", "inviteId", "expiresAt", "role", "tenantId"])
        && getAfter(inviteLockPath(email)).data.email == email
        && getAfter(inviteLockPath(email)).data.inviteId == inviteId
        && getAfter(inviteLockPath(email)).data.role == next.role
        && getAfter(inviteLockPath(email)).data.tenantId == next.tenantId
        && getAfter(inviteLockPath(email)).data.status == next.status
        && getAfter(inviteLockPath(email)).data.expiresAt == next.expiresAt;
    }
    function inviteCreateOk(inviteId) {
      let next = docData();
      return inviteAdmin()
        && inviteBaseOk()
        && next.keys().hasOnly(["name", "email", "role", "jobTitle", "jobTitleId", "status", "createdBy", "createdAt", "expiresAt", "token", "tenantId", "companyId"])
        && next.status == "pending"
        && next.createdBy == request.auth.uid
        && next.createdAt == request.time
        && inviteExpiryWindow()
        && inviteLockFree(next.email)
        && inviteLockAgrees(next.email, inviteId);
    }
    function inviteCancelOk(inviteId) {
      let next = docData();
      let prev = prevData();
      return prev.status == "pending"
        && next.status == "cancelled"
        && next.cancelledBy == request.auth.uid
        && next.cancelledAt == request.time
        && inviteSame("name") && inviteSame("email") && inviteSame("role") && inviteSame("createdBy")
        && inviteSame("createdAt") && inviteSame("expiresAt") && inviteSame("token") && inviteSame("tenantId")
        && inviteSame("resentAt") && inviteSame("resentBy") && inviteSame("companyId")
        && inviteLockAgrees(next.email, inviteId);
    }
    function inviteResendOk(inviteId) {
      let next = docData();
      let prev = prevData();
      return prev.status == "pending"
        && next.status == "pending"
        && next.token != prev.token
        && next.resentBy == request.auth.uid
        && next.resentAt == request.time
        && inviteExpiryWindow()
        && inviteSame("name") && inviteSame("email") && inviteSame("role") && inviteSame("createdBy")
        && inviteSame("createdAt") && inviteSame("tenantId") && inviteSame("companyId")
        && inviteSame("cancelledAt") && inviteSame("cancelledBy")
        && inviteLockAgrees(next.email, inviteId);
    }
    function inviteUpdateOk(inviteId) {
      let next = docData();
      return inviteAdmin()
        && inviteBaseOk()
        && next.keys().hasOnly(["name", "email", "role", "jobTitle", "jobTitleId", "status", "createdBy", "createdAt", "expiresAt", "token", "tenantId", "companyId", "cancelledAt", "cancelledBy", "resentAt", "resentBy"])
        && (inviteCancelOk(inviteId) || inviteResendOk(inviteId));
    }

    match /invites/{inviteId} {
      // Supervisors never read an admin invite (it carries the sign-up token): their list asks for the three crew/supervisor roles.
      allow get, list: if inviteAdmin() && prevData().tenantId == inviteCallerTenant()
        && (prevData().role in ["labourer", "operator", "supervisor", "manager"] || inviteFullAdmin());
      allow create: if inviteCreateOk(inviteId);
      allow update: if inviteUpdateOk(inviteId);
      allow delete: if false;
    }

    function inviteLockEmailOk(email) {
      let next = docData();
      return inviteEmailOk(email)
        && next.email == email
        && inviteRoleOk()
        && next.tenantId == inviteCallerTenant()
        && textLen(next.inviteId, 1, 128)
        && next.expiresAt is timestamp
        && (next.status == "pending" || next.status == "cancelled")
        && next.keys().hasOnly(["email", "status", "inviteId", "expiresAt", "role", "tenantId"]);
    }
    function inviteLockPointsAtInvite(email) {
      let next = docData();
      return existsAfter(invitePath(next.inviteId))
        && getAfter(invitePath(next.inviteId)).data.email == email
        && getAfter(invitePath(next.inviteId)).data.role == next.role
        && getAfter(invitePath(next.inviteId)).data.tenantId == next.tenantId
        && getAfter(invitePath(next.inviteId)).data.status == next.status
        && getAfter(invitePath(next.inviteId)).data.expiresAt == next.expiresAt;
    }
    function inviteLockWriteOk(email) {
      return (
        !exists(inviteLockPath(email))
        && docData().status == "pending"
      ) || (
        exists(inviteLockPath(email))
        && get(inviteLockPath(email)).data.status == "pending"
        && get(inviteLockPath(email)).data.inviteId == docData().inviteId
        && (docData().status == "pending" || docData().status == "cancelled")
      ) || (
        exists(inviteLockPath(email))
        && get(inviteLockPath(email)).data.status != "pending"
        && docData().status == "pending"
      );
    }

    match /inviteEmails/{email} {
      allow get: if inviteAdmin();
      allow list: if false;
      allow create, update: if inviteAdmin()
        && inviteLockEmailOk(email)
        && inviteLockPointsAtInvite(email)
        && inviteLockWriteOk(email);
      allow delete: if false;
    }

    match /inviteMail/{id} {
      allow read, write: if false;
    }
    match /mail/{id} {
      allow read, write: if false;
    }
// END INVITE RULES

    // Password-reset rate limit. Written by adminSendPasswordReset only. The link is not stored.
    match /passwordResetRate/{uid} {
      allow read, write: if false;
    }
    // Job-email rate limit and send audit. Written by sendJobEmail only.
    match /jobEmailRate/{uid} {
      allow read, write: if false;
    }
    match /jobMail/{id} {
      allow read, write: if false;
    }

// BEGIN CHAT RULES
    function chatSignedIn() { return request.auth != null; }
    function chatIsAlex() { return chatSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function chatIsPatrick() { return chatSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function chatUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function chatHasProfile() { return chatSignedIn() && exists(chatUserPath()); }
    function chatProfile() { return get(chatUserPath()).data; }
    function chatExplicitTenant() {
      return chatHasProfile() && "tenantId" in chatProfile() && chatProfile().tenantId is string && chatProfile().tenantId.size() > 0;
    }
    function chatCallerTenant() {
      return chatExplicitTenant()
        ? chatProfile().tenantId
        : ((chatHasProfile() || chatIsAlex() || chatIsPatrick()) ? "heartwood" : "");
    }
    function chatMember(tenantId) {
      return chatSignedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && chatCallerTenant() == tenantId;
    }
    function chatJobPath(jobId) { return /databases/$(database)/documents/jobs/$(jobId); }
    function chatJob(jobId) { return get(chatJobPath(jobId)).data; }
    function chatJobTenant(jobId) {
      return "tenantId" in chatJob(jobId) && chatJob(jobId).tenantId is string && chatJob(jobId).tenantId.size() > 0
        ? chatJob(jobId).tenantId
        : "heartwood";
    }
    function chatAccountTenant() {
      return chatExplicitTenant() ? chatProfile().tenantId : "heartwood";
    }
    function chatAssigned(jobId) {
      return "assigned" in chatJob(jobId) && chatJob(jobId).assigned is list && request.auth.uid in chatJob(jobId).assigned;
    }
    function chatCustomerOk(jobId) {
      return !chatHasProfile()
        || !("customerIds" in chatProfile())
        || !(chatProfile().customerIds is list)
        || chatProfile().customerIds.size() == 0
        || ("client" in chatJob(jobId) && chatJob(jobId).client is string && chatJob(jobId).client in chatProfile().customerIds);
    }
    function chatAccountCanSee(tenantId, jobId) {
      return chatHasProfile()
        && chatAccountTenant() == tenantId
        && (("role" in chatProfile() && chatProfile().role == "admin") || chatAssigned(jobId))
        && chatCustomerOk(jobId);
    }
    function chatCanSeeJob(tenantId, jobId) {
      return chatSignedIn()
        && textLen(jobId, 1, 200)
        && chatJobTenant(jobId) == tenantId
        && ((tenantId == "heartwood" && (chatIsAlex() || chatIsPatrick())) || chatAccountCanSee(tenantId, jobId));
    }
    function chatThreadOk(threadId) {
      return threadId == "staff"
        || (textMax(threadId, 210) && threadId.matches('^job_[A-Za-z0-9_-]{1,200}$'));
    }
    function chatJobId(threadId) { return threadId[4:threadId.size()]; }
    function chatCanAccess(tenantId, threadId) {
      return chatThreadOk(threadId) && (
        threadId == "staff"
          ? chatMember(tenantId)
          : chatCanSeeJob(tenantId, chatJobId(threadId))
      );
    }
    function chatAdmin(tenantId) {
      return chatMember(tenantId) && (
        chatIsAlex() || chatIsPatrick() || (chatHasProfile() && "role" in chatProfile() && chatProfile().role == "admin")
      );
    }
    function chatHasPhoto() { return "photoPath" in docData(); }
    function chatPhotoPathOk(tenantId, threadId) {
      return threadId == "staff"
        ? docData().photoPath.matches('^tenants/' + tenantId + '/chat/staff/photos/c[A-Za-z0-9]{8,40}$')
        : docData().photoPath.matches('^tenants/' + tenantId + '/chat/jobs/' + chatJobId(threadId) + '/photos/c[A-Za-z0-9]{8,40}$');
    }
    function chatMessageOk(tenantId, threadId) {
      return docData().keys().hasOnly(["senderUid", "senderName", "text", "createdAt", "photoPath", "photoType"])
        && docData().senderUid == request.auth.uid
        && textLen(docData().senderName, 1, 80)
        && textMax(docData().text, 4000)
        && docData().createdAt == request.time
        && (docData().text.size() > 0 || chatHasPhoto())
        && (!chatHasPhoto() || (
          textLen(docData().photoPath, 1, 300)
          && docData().photoType is string
          && docData().photoType.matches('^image/(jpeg|png|webp|gif)$')
          && chatPhotoPathOk(tenantId, threadId)
        ))
        && (chatHasPhoto() || !("photoType" in docData()));
    }
    function chatHeadOk() {
      return docData().keys().hasOnly(["lastAt", "lastSenderUid", "lastSenderName", "preview"])
        && docData().lastSenderUid == request.auth.uid
        && docData().lastAt == request.time
        && textLen(docData().lastSenderName, 1, 80)
        && textMax(docData().preview, 140);
    }

    match /tenants/{tenantId}/chats/{threadId} {
      allow read: if chatCanAccess(tenantId, threadId);
      allow create, update: if chatCanAccess(tenantId, threadId) && chatHeadOk();
      allow delete: if false;
    }

    match /tenants/{tenantId}/chats/{threadId}/messages/{messageId} {
      allow read: if chatCanAccess(tenantId, threadId);
      allow create: if chatCanAccess(tenantId, threadId) && chatMessageOk(tenantId, threadId);
      allow update: if false;
      allow delete: if chatCanAccess(tenantId, threadId)
        && (prevData().senderUid == request.auth.uid || chatAdmin(tenantId));
    }

    match /tenants/{tenantId}/chatSeen/{uid}/threads/{threadId} {
      allow read: if chatSignedIn() && request.auth.uid == uid && chatCanAccess(tenantId, threadId);
      allow create, update: if chatSignedIn()
        && request.auth.uid == uid
        && chatCanAccess(tenantId, threadId)
        && docData().keys().hasOnly(["seenAt"])
        && docData().seenAt == request.time;
      allow delete: if false;
    }

    // Web push tokens. The owner writes their own. Nobody else can read them.
    function chatExplicitCompany() {
      return chatHasProfile() && "companyId" in chatProfile() && chatProfile().companyId is string && chatProfile().companyId.size() > 0;
    }
    function chatTokenCompany() {
      return chatExplicitCompany()
        ? chatProfile().companyId
        : (chatExplicitTenant()
          ? chatProfile().tenantId
          : ((chatHasProfile() || chatIsAlex() || chatIsPatrick()) ? "heartwood" : ""));
    }
    function chatCompanyIdOk(id) {
      return textLen(id, 2, 40) && id.matches('^[a-z0-9][a-z0-9-]{0,39}$');
    }
    function chatPushOriginOk() {
      return docData().origin in [
        "https://jobs.heartwoodew.com",
        "https://app.callupapp.com.au",
        "https://callupapp.web.app"
      ];
    }
    function chatTokenOk() {
      return docData().keys().hasOnly(["token", "companyId", "origin", "platform", "updatedAt"])
        && textLen(docData().token, 20, 4096)
        && chatCompanyIdOk(docData().companyId)
        && docData().companyId == chatTokenCompany()
        && chatPushOriginOk()
        && docData().platform == "web"
        && docData().updatedAt == request.time;
    }
    function chatPrefsOk() {
      return docData().keys().hasOnly(["muteChat", "muteDaily", "muteClockOnReminder"])
        && docData().muteChat is bool
        && docData().muteDaily is bool
        && (!("muteClockOnReminder" in docData()) || docData().muteClockOnReminder is bool);
    }
    match /users/{uid}/fcmTokens/{tokenId} {
      allow read: if chatSignedIn() && request.auth.uid == uid;
      allow create, update: if chatSignedIn()
        && request.auth.uid == uid
        && tokenId.matches('^[a-f0-9]{32}$')
        && chatTokenOk();
      allow delete: if chatSignedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/chatSettings/{docId} {
      function chatClockTargetPath() { return /databases/$(database)/documents/users/$(uid); }
      function chatClockTargetCompany() {
        let there = exists(chatClockTargetPath());
        let data = there ? get(chatClockTargetPath()).data : {};
        return !there ? ""
          : ("companyId" in data && data.companyId is string && data.companyId.size() > 0) ? data.companyId
          : (("tenantId" in data && data.tenantId is string && data.tenantId.size() > 0) ? data.tenantId : "heartwood");
      }
      // Admin of that company only. Cannot change muteChat or muteDaily.
      function chatClockAdmin() {
        let target = chatClockTargetCompany();
        let caller = chatTokenCompany();
        let adminRole = chatHasProfile() && chatProfile().get("role", "") == "admin";
        return chatSignedIn() && request.auth.uid != uid && target != "" && (
          (target == "heartwood" && (chatIsAlex() || chatIsPatrick() || (adminRole && caller == "heartwood")))
          || (target != "heartwood" && adminRole && caller == target)
        );
      }
      allow get: if docId == "prefs" && chatSignedIn() && (request.auth.uid == uid || chatClockAdmin());
      allow list: if false;
      allow create, update: if chatSignedIn()
        && request.auth.uid == uid
        && docId == "prefs"
        && chatPrefsOk();
      allow create: if docId == "prefs" && chatClockAdmin()
        && docData().keys().hasOnly(["muteClockOnReminder"])
        && docData().muteClockOnReminder is bool;
      allow update: if docId == "prefs" && chatClockAdmin()
        && docData().diff(prevData()).affectedKeys().hasOnly(["muteClockOnReminder"])
        && docData().muteClockOnReminder is bool;
      allow delete: if false;
    }
// END CHAT RULES

// BEGIN FLEET RULES
    function fleetSignedIn() { return request.auth != null; }
    function fleetIsAlex() { return fleetSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function fleetIsPatrick() { return fleetSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function fleetUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function fleetHasProfile() { return fleetSignedIn() && exists(fleetUserPath()); }
    function fleetProfile() { return get(fleetUserPath()).data; }
    function fleetExplicitTenant() {
      return fleetHasProfile() && "tenantId" in fleetProfile() && fleetProfile().tenantId is string && fleetProfile().tenantId.size() > 0;
    }
    function fleetCallerTenant() {
      return fleetExplicitTenant()
        ? fleetProfile().tenantId
        : ((fleetHasProfile() || fleetIsAlex() || fleetIsPatrick()) ? "heartwood" : "");
    }
    function fleetMember(tenantId) {
      return fleetSignedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && fleetCallerTenant() == tenantId;
    }
    function fleetAdmin(tenantId) {
      return fleetMember(tenantId) && (
        fleetIsAlex() || fleetIsPatrick() || (fleetHasProfile() && "role" in fleetProfile() && fleetProfile().role == "admin")
      );
    }
    function fleetDateOk(v) {
      return v is string && (v == "" || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function fleetAssetOk() {
      return docData().keys().hasOnly(["type", "name", "rego", "regoExpiry", "coiRequired", "coiExpiry", "notes", "prestartKind", "reading", "readingUnit", "readingAt", "readingBy", "readingByName", "updatedAt", "updatedBy"])
        && (docData().type == "vehicle" || docData().type == "trailer" || docData().type == "plant")
        && (!("prestartKind" in docData()) || docData().prestartKind == "skid-steer" || docData().prestartKind == "excavator" || docData().prestartKind == "tip-truck" || docData().prestartKind == "ute" || docData().prestartKind == "trailer" || docData().prestartKind == "other-plant")
        && textLen(docData().name, 1, 80)
        && textMax(docData().rego, 20)
        && fleetDateOk(docData().regoExpiry)
        && docData().coiRequired is bool
        && fleetDateOk(docData().coiExpiry)
        && textMax(docData().notes, 2000)
        && (!("reading" in docData()) || (docData().reading is int && docData().reading >= 0 && docData().reading <= 10000000))
        && (!("readingUnit" in docData()) || docData().readingUnit == "" || docData().readingUnit == "hours" || docData().readingUnit == "km")
        && docData().updatedBy == request.auth.uid
        && docData().updatedAt == request.time;
    }
    function fleetEditor(tenantId) {
      return fleetAdmin(tenantId)
        || (fleetMember(tenantId) && fleetHasProfile() && "role" in fleetProfile() && fleetProfile().role in ["supervisor", "manager"]);
    }
    function fleetPolicyOk() {
      return docData().keys().hasOnly(["type", "insurer", "policyNumber", "startDate", "expiry", "amount", "notes", "assetId", "updatedAt", "updatedBy"])
        && (docData().type == "workcover" || docData().type == "public-liability" || docData().type == "vehicle" || docData().type == "plant" || docData().type == "contract-works")
        && textLen(docData().insurer, 1, 120)
        && textMax(docData().policyNumber, 60)
        && fleetDateOk(docData().startDate)
        && fleetDateOk(docData().expiry)
        && textMax(docData().amount, 40)
        && textMax(docData().notes, 2000)
        && textMax(docData().assetId, 80)
        && docData().assetId.matches('^[A-Za-z0-9_-]*$')
        && docData().updatedBy == request.auth.uid
        && docData().updatedAt == request.time;
    }

    // Prestart readings: any member of the tenant may move a machine's reading UP (same unit), signed as themselves.
    // Nothing else on the machine can change this way. A lower reading stays on the prestart only.
    function fleetReadingOk(tenantId) {
      return fleetMember(tenantId)
        && docData().diff(prevData()).affectedKeys().hasOnly(["reading", "readingUnit", "readingAt", "readingBy", "readingByName"])
        && docData().reading is int
        && docData().reading > 0
        && docData().reading <= 10000000
        && (docData().readingUnit == "hours" || docData().readingUnit == "km")
        && (prevData().get("reading", 0) == 0
          || prevData().get("readingUnit", "") == ""
          || prevData().get("readingUnit", "") != docData().readingUnit
          || docData().reading > prevData().get("reading", 0))
        && docData().readingBy == request.auth.uid
        && textMax(docData().readingByName, 80)
        && docData().readingAt == request.time;
    }

    match /tenants/{tenantId}/fleet/{assetId} {
      allow read: if fleetMember(tenantId);
      allow create: if fleetEditor(tenantId) && fleetAssetOk();
      allow update: if (fleetEditor(tenantId) && fleetAssetOk()) || fleetReadingOk(tenantId);
      allow delete: if fleetAdmin(tenantId);
    }

    match /tenants/{tenantId}/policies/{policyId} {
      allow read: if fleetAdmin(tenantId);
      allow create, update: if fleetAdmin(tenantId) && fleetPolicyOk();
      allow delete: if fleetAdmin(tenantId);
    }
// END FLEET RULES

// BEGIN SERVICING RULES
    function svcSignedIn() { return request.auth != null; }
    function svcIsAlex() { return svcSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function svcIsPatrick() { return svcSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function svcUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function svcHasProfile() { return svcSignedIn() && exists(svcUserPath()); }
    function svcProfile() { return get(svcUserPath()).data; }
    function svcExplicitTenant() {
      return svcHasProfile() && "tenantId" in svcProfile() && svcProfile().tenantId is string && svcProfile().tenantId.size() > 0;
    }
    function svcCallerTenant() {
      return svcExplicitTenant()
        ? svcProfile().tenantId
        : ((svcHasProfile() || svcIsAlex() || svcIsPatrick()) ? "heartwood" : "");
    }
    function svcMember(tenantId) {
      return svcSignedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && svcCallerTenant() == tenantId;
    }
    function svcAdmin(tenantId) {
      return svcMember(tenantId) && (
        svcIsAlex() || svcIsPatrick() || (svcHasProfile() && "role" in svcProfile() && svcProfile().role == "admin")
      );
    }
    function svcWriter(tenantId) {
      return svcAdmin(tenantId)
        || (svcMember(tenantId) && svcHasProfile() && "role" in svcProfile() && svcProfile().role in ["supervisor", "manager"]);
    }
    function svcInt(v, max) {
      return v is int && v >= 0 && v <= max;
    }
    function svcUnit(v) {
      return v == "" || v == "hours" || v == "km";
    }
    function svcDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function svcRecordOk() {
      return docData().keys().hasOnly(["assetId", "doneOn", "reading", "readingUnit", "serviceType", "servicedBy", "notes", "updatedAt", "updatedBy"])
        && docData().assetId is string
        && docData().assetId.matches('^[A-Za-z0-9_-]{1,80}$')
        && svcDate(docData().doneOn)
        && svcInt(docData().reading, 10000000)
        && svcUnit(docData().readingUnit)
        && (docData().reading == 0 || docData().readingUnit == "hours" || docData().readingUnit == "km")
        && (docData().serviceType == "250hr" || docData().serviceType == "major" || docData().serviceType == "repair" || docData().serviceType == "other")
        && textMax(docData().servicedBy, 120)
        && textMax(docData().notes, 2000)
        && docData().updatedBy == request.auth.uid
        && docData().updatedAt == request.time;
    }
    function svcPlanOk() {
      return docData().keys().hasOnly(["everyDays", "everyReading", "readingUnit", "currentReading", "updatedAt", "updatedBy"])
        && svcInt(docData().everyDays, 3650)
        && svcInt(docData().everyReading, 1000000)
        && svcInt(docData().currentReading, 10000000)
        && svcUnit(docData().readingUnit)
        && (docData().everyReading == 0 || docData().readingUnit == "hours" || docData().readingUnit == "km")
        && docData().updatedBy == request.auth.uid
        && docData().updatedAt == request.time;
    }
    function svcCostOk() {
      return docData().keys().hasOnly(["amount", "updatedAt", "updatedBy"])
        && textLen(docData().amount, 1, 40)
        && docData().updatedBy == request.auth.uid
        && docData().updatedAt == request.time;
    }

    match /tenants/{tenantId}/servicing/{recordId} {
      allow read: if svcMember(tenantId);
      allow create, update: if svcWriter(tenantId) && svcRecordOk();
      allow delete: if svcWriter(tenantId);
    }

    match /tenants/{tenantId}/servicePlans/{assetId} {
      allow read: if svcMember(tenantId);
      allow create, update: if svcWriter(tenantId) && svcPlanOk();
      allow delete: if svcWriter(tenantId);
    }

    match /tenants/{tenantId}/serviceCosts/{recordId} {
      allow read: if svcWriter(tenantId);
      allow create, update: if svcWriter(tenantId) && svcCostOk();
      allow delete: if svcWriter(tenantId);
    }
// END SERVICING RULES

// BEGIN PRESTART RULES
    function psSignedIn() { return request.auth != null; }
    function psIsAlex() { return psSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function psIsPatrick() { return psSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function psUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function psHasProfile() { return psSignedIn() && exists(psUserPath()); }
    function psProfile() { return get(psUserPath()).data; }
    function psExplicitTenant() {
      return psHasProfile() && "tenantId" in psProfile() && psProfile().tenantId is string && psProfile().tenantId.size() > 0;
    }
    function psCallerTenant() {
      return psExplicitTenant()
        ? psProfile().tenantId
        : ((psHasProfile() || psIsAlex() || psIsPatrick()) ? "heartwood" : "");
    }
    function psMember(tenantId) {
      return psSignedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && psCallerTenant() == tenantId;
    }
    function psAdmin(tenantId) {
      return psMember(tenantId) && (
        psIsAlex() || psIsPatrick() || (psHasProfile() && "role" in psProfile() && psProfile().role == "admin")
      );
    }
    function psKindOk(kind) {
      return kind == "skid-steer" || kind == "excavator" || kind == "tip-truck"
        || kind == "ute" || kind == "trailer" || kind == "other-plant";
    }
    function psItem(item) {
      return item.keys().hasOnly(["id", "result", "comment", "critical"])
        && textLen(item.id, 1, 40)
        && (item.result == "pass" || item.result == "fail" || item.result == "na")
        && textMax(item.comment, 500)
        && (item.result != "fail" || item.comment.size() > 0)
        && item.critical is bool;
    }
    function psItems(items) {
      return items is list
        && items.size() >= 1
        && items.size() <= 16
        && psItem(items[0])
        && psItem(items[items.size() - 1]);
    }
    function psTpl(item) {
      return item.keys().hasOnly(["id", "label", "critical"])
        &&textLen(item.id, 1, 40)
        &&textLen(item.label, 1, 60)
        && item.critical is bool;
    }
    function psCreateOk() {
      return docData().keys().hasOnly(["assetId", "assetType", "assetName", "kind", "day", "reading", "readingUnit", "odometer", "items", "signerUid", "signerName", "signedAt", "defect", "doNotOperate", "resolved"])
        && docData().assetId is string
        && docData().assetId.matches('^[A-Za-z0-9_-]{1,80}$')
        && (docData().assetType == "vehicle" || docData().assetType == "trailer" || docData().assetType == "plant")
        && psKindOk(docData().kind)
        && textLen(docData().assetName, 1, 80)
        && docData().day is string
        && docData().day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && docData().reading is int
        && docData().reading >= 0
        && docData().reading <= 10000000
        && (docData().readingUnit == "" || docData().readingUnit == "hours" || docData().readingUnit == "km")
        && docData().odometer is int
        && docData().odometer >= 0
        && docData().odometer <= 10000000
        && psItems(docData().items)
        && docData().signerUid == request.auth.uid
        && textLen(docData().signerName, 2, 80)
        && docData().signedAt == request.time
        && docData().defect is bool
        && docData().doNotOperate is bool
        && docData().resolved == false;
    }
    function psSame(key) {
      return docData()[key] == prevData()[key];
    }
    function psResolveOk() {
      return prevData().defect == true
        && prevData().resolved == false
        && docData().resolved == true
        && docData().resolvedBy == request.auth.uid
        && textMax(docData().resolvedNote, 500)
        && docData().resolvedAt == request.time
        && psSame("assetId") && psSame("assetType") && psSame("assetName") && psSame("kind")
        && psSame("day") && psSame("reading") && psSame("readingUnit") && psSame("odometer")
        && psSame("items") && psSame("signerUid") && psSame("signerName")
        && psSame("signedAt") && psSame("defect") && psSame("doNotOperate");
    }
    function psTemplateOk() {
      return docData().keys().hasOnly(["items", "updatedAt", "updatedBy"])
        && docData().items is list
        && docData().items.size() >= 1
        && docData().items.size() <= 16
        && psTpl(docData().items[0])
        && psTpl(docData().items[docData().items.size() - 1])
        && docData().updatedBy == request.auth.uid
        && docData().updatedAt == request.time;
    }

    match /tenants/{tenantId}/prestarts/{id} {
      allow read: if psMember(tenantId);
      allow create: if psMember(tenantId) && psCreateOk();
      allow update: if psAdmin(tenantId) && psResolveOk();
      allow delete: if false;
    }

    match /tenants/{tenantId}/prestartTemplates/{assetType} {
      allow read: if psMember(tenantId);
      allow create, update: if psAdmin(tenantId)
        && psKindOk(assetType)
        && psTemplateOk();
      allow delete: if false;
    }
// END PRESTART RULES




// BEGIN SWMS SIGNATURE RULES
    function swmsSignedIn() { return request.auth != null; }
    function swmsIsAlex() { return swmsSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function swmsIsPatrick() { return swmsSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function swmsUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function swmsHasProfile() { return swmsSignedIn() && exists(swmsUserPath()); }
    function swmsProfile() { return get(swmsUserPath()).data; }
    function swmsIsAdmin() {
      return swmsIsAlex() || swmsIsPatrick()
        || (swmsHasProfile() && "role" in swmsProfile() && swmsProfile().role == "admin");
    }
    function swmsCanSign() {
      return swmsIsAlex() || swmsIsPatrick() || swmsHasProfile();
    }
    function swmsIdOk() {
      return docData().swmsId is string
        && docData().swmsId.matches('^(working-near-roads|mobile-plant|working-with-silica|hazardous-substances|electrical)$');
    }
    function swmsSigOk() {
      return textLen(docData().sig, 32, 90000)
        && docData().sig.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$');
    }
    function swmsCreateOk() {
      return swmsCanSign()
        && docData().keys().hasOnly(["uid", "name", "swmsId", "swmsTitle", "version", "jobId", "jobLabel", "sig", "signedAt", "signedAtMs", "expiresAtMs", "device", "companyId"])
        && (!("companyId" in docData()) || docData().companyId == callerCompany())
        && docData().uid == request.auth.uid
        && textLen(docData().name, 2, 80)
        && swmsIdOk()
        && textLen(docData().swmsTitle, 1, 80)
        && docData().version is string
        && docData().version.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && textMax(docData().jobId, 200)
        && textMax(docData().jobLabel, 160)
        && swmsSigOk()
        && docData().signedAt == request.time
        && docData().signedAtMs is int
        && docData().signedAtMs >= request.time.toMillis() - 300000
        && docData().signedAtMs <= request.time.toMillis() + 300000
        && docData().expiresAtMs is int
        && docData().expiresAtMs >= docData().signedAtMs + 364 * 24 * 60 * 60 * 1000
        && docData().expiresAtMs <= docData().signedAtMs + 367 * 24 * 60 * 60 * 1000
        && textMax(docData().device, 200);
    }

    match /swmsSignatures/{id} {
      allow get: if swmsSignedIn() && resource != null && docCompany(prevData()) == callerCompany()
        && (prevData().uid == request.auth.uid || swmsIsAdmin() && callerCompany() == docCompany(prevData()));
      allow list: if swmsSignedIn() && callerCompany() == "heartwood" && prevData().uid == request.auth.uid;
      allow list: if swmsSignedIn() && callerCompany() != "heartwood" && prevData().uid == request.auth.uid
        && prevData().companyId == callerCompany();
      allow list: if (swmsIsAlex() || swmsIsPatrick() || (swmsHasProfile() && swmsProfile().role == "admin" && callerCompany() == "heartwood"))
        && prevData().companyId == "heartwood";
      allow list: if callerCompany() != "heartwood" && swmsHasProfile() && swmsProfile().role == "admin"
        && prevData().companyId == callerCompany();
      allow create: if swmsCreateOk();
      allow update, delete: if false;
    }
// END SWMS SIGNATURE RULES

// BEGIN RUN SHEET RULES
    function routeSignedIn() { return request.auth != null; }
    function routeIsAlex() { return routeSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function routeIsPatrick() { return routeSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function routeUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function routeHasProfile() { return routeSignedIn() && exists(routeUserPath()); }
    function routeProfile() { return get(routeUserPath()).data; }
    function routeIsAdmin() {
      return routeIsAlex() || routeIsPatrick()
        || (routeHasProfile() && "role" in routeProfile() && routeProfile().role == "admin");
    }
    function routeSheetIdOk(id) {
      return id is string && id.matches('^[A-Za-z0-9]{1,128}_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function routeSheetWorker(id) { return id[0:id.size()-11]; }
    function routeSheetDate(id) { return id[id.size()-10:id.size()]; }
    // Run sheets belong to one company (12 Nov 2026): companyId on the sheet (missing = Heartwood). An admin reads and
    // writes only their own company's sheets, for a worker of their own company. The depot is the company's own address
    // (Heartwood: Chuwar from its settings / default), so it is checked for shape only.
    function routeWorkerCompany(sheetId) {
      let p = /databases/$(database)/documents/users/$(routeSheetWorker(sheetId));
      return exists(p) ? docCompany(get(p).data) : "heartwood";
    }
    function routeCanRead(sheetId) {
      return routeSignedIn() && routeSheetIdOk(sheetId)
        && (request.auth.uid == routeSheetWorker(sheetId)
          || (routeIsAdmin() && (resource == null || docCompany(prevData()) == callerCompany())));
    }
    function routeCanWrite(sheetId) {
      return routeIsAdmin() && routeSheetIdOk(sheetId)
        && docData().keys().hasOnly([
          "workerUid", "workerName", "date", "jobIds", "returnToDepot", "status", "depot",
          "method", "provider", "tweaked", "totalMinutes", "totalKm", "currentMinutes", "currentKm",
          "approvedBy", "approvedByName", "approvedAt", "companyId"
        ])
        && docData().companyId is string
        && docData().companyId == callerCompany()
        && (resource == null || docCompany(prevData()) == callerCompany())
        && routeWorkerCompany(sheetId) == callerCompany()
        && docData().approvedBy == request.auth.uid
        && docData().date == routeSheetDate(sheetId)
        && docData().date is string
        && docData().status == "approved"
        && textLen(docData().depot, 1, 200)
        && docData().returnToDepot is bool
        && docData().tweaked is bool
        && docData().jobIds is list
        && docData().jobIds.size() > 0
        && docData().jobIds.size() <= 40
        && textMax(docData().workerName, 80)
        && textLen(docData().approvedByName, 1, 80)
        && docData().approvedAt == request.time
        && docData().method in ["exact", "nearest-neighbour-2opt"]
        && docData().provider in ["osrm", "ors", "osrm-fallback"]
        && docData().totalMinutes is number
        && docData().totalMinutes >= 0
        && docData().totalKm is number
        && docData().totalKm >= 0
        && docData().currentMinutes is number
        && docData().currentMinutes >= 0
        && docData().currentKm is number
        && docData().currentKm >= 0;
    }

    match /runSheets/{sheetId} {
      allow read: if routeCanRead(sheetId);
      allow create, update: if routeCanWrite(sheetId);
      allow delete: if false;
    }
// END RUN SHEET RULES
// BEGIN TIMESHEET RULES
    function tsHeartwoodAdmin() {
      return isAlex() || isPatrick() || (
        hasProfile() && profile().role == "admin"
        && (!("tenantId" in profile()) || profile().tenantId == "heartwood")
      );
    }
    function tsMine(id) {
      return signedIn()
        && docData().uid == request.auth.uid
        && docData().weekStart is string
        && docData().weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == request.auth.uid + "_" + docData().weekStart;
    }
    function tsDocOk() {
      return docData().keys().hasOnly(["uid", "name", "weekStart", "weekEnd", "days", "entries", "totalHrs", "updatedAt", "updatedAtIso", "lastEntryId", "locationConsentAt", "sent", "sentAt", "sentBy", "approved"])
        && textLen(docData().name, 1, 80)
        && docData().weekEnd is string
        && docData().weekEnd >= docData().weekStart
        && docData().days is map
        && docData().days.size() <= 7
        && docData().totalHrs is number
        && docData().totalHrs >= 0
        && docData().totalHrs <= 400
        && docData().updatedAt == request.time
        && textMax(docData().updatedAtIso, 40);
    }
    function tsFix(m) {
      return m.keys().hasOnly(["at", "fix", "lat", "lng", "accuracy"])
        && m.at == request.time
        && ((m.fix == "no location" && m.keys().hasOnly(["at", "fix"]))
          || (m.fix == "gps" && m.lat is number && m.lat >= -90 && m.lat <= 90
            && m.lng is number && m.lng >= -180 && m.lng <= 180
            && m.accuracy is number && m.accuracy >= 0 && m.accuracy <= 100000));
    }
    function tsFixSame(b, a, k) {
      return a.source == "manual" ? !(k in a)
        : ((!(k in a) && !(k in b)) || ((k in a) && (k in b) && a[k] == b[k]) || ((k in a) && !(k in b) && tsFix(a[k])));
    }
    function tsEntryCore(e) {
      return e.keys().hasOnly(["id", "source", "status", "date", "start", "finish", "breakStart", "breakEnd", "note", "job", "clockOn", "clockOff", "breakOn", "breakOff", "enteredBy", "enteredByName", "enteredAt", "edits", "lastEditId", "machineChoice", "machineId", "machineName"])
        && e.id == docData().lastEntryId
        && e.id.matches('^[a-z0-9]{8,24}$')
        && (e.source == "clock" || e.source == "manual")
        && e.enteredBy == request.auth.uid
        &&textLen(e.enteredByName, 1, 80)
        && e.enteredAt is timestamp
        && e.edits is map
        &&textMax(e.note, 200)
        &&textMax(e.job, 200)
        && e.date is string && e.date.size() == 10
        &&textMax(e.start, 5)
        &&textMax(e.finish, 5)
        && ((e.source == "clock" && "clockOn" in e) || (e.source == "manual" && !e.keys().hasAny(["clockOn", "clockOff", "breakOn", "breakOff"])));
    }
    function tsEntryNew(e) {
      return tsEntryCore(e) && e.enteredAt == request.time && e.edits.size() == 0 && e.lastEditId == ""
        && tsFixSame({}, e, "clockOn") && tsFixSame({}, e, "clockOff") && tsFixSame({}, e, "breakOn") && tsFixSame({}, e, "breakOff");
    }
    // One diff, reused: each extra diff of the entries/edits maps counts against the 1000-expression limit.
    function tsEditOk(b, a) {
      let d = a.edits.diff(b.edits);
      return d.removedKeys().size() == 0
        && d.changedKeys().size() == 0
        && (d.addedKeys().size() == 0
          || (d.addedKeys().hasOnly([a.lastEditId])
            && a.edits[a.lastEditId].at == request.time
            && a.edits[a.lastEditId].by == request.auth.uid
            && a.edits[a.lastEditId].byName is string
            && a.edits[a.lastEditId].summary is string
            && a.edits[a.lastEditId].summary.size() > 0
            && a.edits[a.lastEditId].summary.size() <= 200));
    }
    // A machine pick is written once, all three fields together.
    function tsMachinePick(b, a) {
      return !("machineChoice" in b)
        && (((a.machineChoice == "none" || a.machineChoice == "skip") && a.machineId == "" &&textMax(a.machineName, 80))
          || (a.machineChoice == "asset" && a.machineId.matches('^[A-Za-z0-9_-]{1,80}$') &&textLen(a.machineName, 1, 80)));
    }
    // An existing shift: check only what changed. id, source, author, enteredAt and the clock-on stamp never change;
    // a recorded stamp or machine pick is never rewritten or removed; a new stamp is a valid fix taken now (clock shifts only).
    // A clock-time correction is separate: start and finish only, plus the edit audit and the original times.
    // Job, note, date and the GPS fix stay. The first original is kept. Re-validating the whole shift on every tap
    // pushed clock-off after a break past Firestore's 1000-expression limit (permission-denied, user test 11 Nov 2026).
    function tsHm(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function tsPad2(n) {
      return n < 10 ? "0" + string(n) : string(n);
    }
    function tsToday() {
      let t = request.time + duration.value(10, 'h');
      return string(t.year()) + "-" + tsPad2(t.month()) + "-" + tsPad2(t.day());
    }
    function tsNowHm() {
      let t = request.time + duration.value(10, 'h');
      return tsPad2(t.hours()) + ":" + tsPad2(t.minutes());
    }
    // Called only after the punch branch has already failed its key check, so a clock-off does not pay for it.
    function tsTimeOk(b, a) {
      let today = tsToday();
      let nowHm = tsNowHm();
      let openWeek = today >= prevData().weekStart && today <= prevData().weekEnd;
      let locked = prevData().get("sent", false) == true || prevData().get("approved", false) == true;
      return (a.finish == "" || a.finish > a.start)
        && (a.date < today || (a.date == today && a.start <= nowHm && (a.finish == "" || a.finish <= nowHm)))
        && (openWeek || !locked || isAlex() || isPatrick() || (hasProfile() && profile().role == "admin"))
        && (!("originalClockOn" in b) ? a.originalClockOn == b.start : a.originalClockOn == b.originalClockOn)
        && (b.finish == ""
          ? (!("originalClockOff" in a) && !("originalClockOff" in b))
          : (!("originalClockOff" in b) ? a.originalClockOff == b.finish : a.originalClockOff == b.originalClockOff));
    }
    function tsEntryNext(b, a) {
      let d = a.diff(b);
      let ch = d.affectedKeys();
      let added = d.addedKeys();
      return d.removedKeys().size() == 0 && (
        (ch.hasOnly(["status", "finish", "breakStart", "breakEnd", "clockOff", "breakOn", "breakOff", "enteredByName", "edits", "lastEditId", "machineChoice", "machineId", "machineName"])
          && !("start" in ch)
          && (!("finish" in ch) || ch.hasAny(["status", "clockOff", "breakOn", "breakOff"]))
          && !d.changedKeys().hasAny(["clockOff", "breakOn", "breakOff", "machineChoice", "machineId", "machineName"])
          && (!ch.hasAny(["clockOff", "breakOn", "breakOff"]) || (a.source == "clock"
            && (!("clockOff" in added) || tsFix(a.clockOff))
            && (!("breakOn" in added) || tsFix(a.breakOn))
            && (!("breakOff" in added) || tsFix(a.breakOff))))
          && (!ch.hasAny(["machineChoice", "machineId", "machineName"]) || tsMachinePick(b, a))
          && (!("finish" in ch) || (textMax(a.finish, 5)))
          && (!("enteredByName" in ch) || (textLen(a.enteredByName, 1, 80)))
          && (!ch.hasAny(["edits", "lastEditId"]) || (a.edits is map && tsEditOk(b, a))))
        || (ch.hasOnly(["start", "finish", "edits", "lastEditId", "originalClockOn", "originalClockOff"])
          && (a.start != b.start || a.finish != b.finish)
          && tsHm(a.start)
          && (a.finish == "" || tsHm(a.finish))
          && (b.finish != "" || a.finish == "")
          && a.edits is map
          && a.edits.size() == b.edits.size() + 1
          && tsEditOk(b, a)
          && tsTimeOk(b, a)));
    }
    function tsFleetReader(tenantId) {
      return signedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && (
          ((isAlex() || isPatrick()) && tenantId == "heartwood")
          || (hasProfile() && (
            ("tenantId" in profile() && profile().tenantId == tenantId)
            || (!("tenantId" in profile()) && tenantId == "heartwood")
          ))
        );
    }
    // Clock-off after a break and a machine pick used to hit Firestore's 1000-expression limit (permission-denied):
    // the entries map was diffed three times and compared whole. Diff once and look the shift up once.
    function tsOneEntry() {
      let after = docData().entries;
      let before = prevData().get("entries", {});
      let key = docData().lastEntryId;
      let d = after.diff(before);
      return after is map
        && after.size() <= 40
        && key is string
        && d.removedKeys().size() == 0
        && d.affectedKeys().size() == 1
        && d.affectedKeys().hasOnly([key])
        && (key in before ? tsEntryNext(before[key], after[key]) : tsEntryNew(after[key]));
    }
    function tsWorkerCreate(id) {
      return tsMine(id) && tsDocOk()
        && !("sent" in docData()) && !("sentAt" in docData()) && !("sentBy" in docData())
        && !("approved" in docData())
        && (!("locationConsentAt" in docData()) || docData().locationConsentAt == request.time)
        && (!("entries" in docData())
          || (docData().entries.size() == 1
            && docData().lastEntryId in docData().entries
            && tsEntryNew(docData().entries[docData().lastEntryId])));
    }
    function tsWorkerUpdate(id) {
      return tsMine(id) && tsDocOk()
        && docData().uid == prevData().uid
        && docData().weekStart == prevData().weekStart
        && same("sent") && same("sentAt") && same("sentBy") && same("approved")
        && (!("locationConsentAt" in prevData()) && !("locationConsentAt" in docData())
          || !("locationConsentAt" in prevData()) && docData().locationConsentAt == request.time
          || docData().get("locationConsentAt", null) == prevData().get("locationConsentAt", null))
        // Shift change first: comparing the whole entries map is only needed when no shift changed.
        && (tsOneEntry() || docData().get("entries", {}) == prevData().get("entries", {}));
    }
    function tsSentUpdate() {
      return tsHeartwoodAdmin()
        && docData().diff(prevData()).affectedKeys().hasOnly(["sent", "sentAt", "sentBy"])
        && docData().sent is bool
        && (docData().get("sentAt", null) == null || docData().sentAt is string)
        && (docData().get("sentBy", null) == null || docData().sentBy == request.auth.uid);
    }

    match /timesheets/{id} {
      allow get: if signedIn() && (
        (resource == null && id.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        || (tsHeartwoodAdmin() && resource != null && docCompany(prevData()) == "heartwood")
        || (resource != null && prevData().uid == request.auth.uid && docCompany(prevData()) == callerCompany())
        || (callerCompany() != "heartwood" && hasProfile() && profile().role == "admin" && resource != null && prevData().companyId == callerCompany())
      );
      allow list: if signedIn() && callerCompany() == "heartwood" && prevData().uid == request.auth.uid;
      allow list: if callerCompany() != "heartwood" && prevData().uid == request.auth.uid && prevData().companyId == callerCompany();
      allow list: if tsHeartwoodAdmin() && prevData().companyId == "heartwood";
      allow list: if callerCompany() != "heartwood" && hasProfile() && profile().role == "admin" && prevData().companyId == callerCompany();
      allow create: if tsWorkerCreate(id);
      allow update: if tsWorkerUpdate(id) || tsSentUpdate();
      allow delete: if false;
    }

    // Read-only mirror so clock-on can list machines and today's prestart.
    // Creates and edits stay with the compliance PR. allow write: if false does not veto those rules.
    match /tenants/{tenantId}/fleet/{assetId} {
      allow read: if tsFleetReader(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/prestarts/{id} {
      allow read: if tsFleetReader(tenantId);
      allow write: if false;
    }
// END TIMESHEET RULES

// BEGIN LEAVE RULES
    function lvSignedIn() { return request.auth != null; }
    function lvHeartwood() {
      return lvSignedIn() && (
        isAlex() || isPatrick() || (hasProfile() && callerCompany() == "heartwood")
      );
    }
    function lvDecider() {
      let known = lvSignedIn() && hasProfile();
      let user = known ? profile() : null;
      let company = lvSignedIn() ? callerCompany() : "";
      return lvSignedIn() && (
        (!known && (isAlex() || isPatrick()))
        || (company == "heartwood" && (isAlex() || isPatrick() || (known && (user.role == "admin" || user.role == "supervisor" || user.role == "manager"))))
        || (company != "heartwood" && known && (user.role == "admin" || user.role == "supervisor" || user.role == "manager"))
      );
    }
    function lvDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function lvHalf(v) {
      return v == "" || v == "am" || v == "pm";
    }
    function lvHalves() {
      let next = docData();
      return lvHalf(next.startHalf)
        && lvHalf(next.endHalf)
        && (
          (next.start == next.end
            && next.startHalf == next.endHalf)
          || (next.start < next.end
            && (next.startHalf == "" || next.startHalf == "pm")
            && (next.endHalf == "" || next.endHalf == "am"))
        );
    }
    function lvCertPath(uid, id) {
      let next = docData();
      return next.certificatePath == ""
        || next.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.pdf"
        || next.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.jpg"
        || next.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.png"
        || next.certificatePath == "leaveCertificates/" + uid + "/" + id + "/cert.webp";
    }
    function lvCreate(id) {
      let next = docData();
      return (lvHeartwood() || (callerCompany() != "heartwood" && callerCompany() != "" && hasProfile()))
        && id.matches('^lv[a-z0-9]{16}$')
        && next.keys().hasOnly(["uid", "name", "type", "start", "end", "startHalf", "endHalf", "reason", "certificatePath", "certificateName", "status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "createdAt", "updatedAt", "companyId"])
        && (!("companyId" in next) || next.companyId == callerCompany())
        && next.uid == request.auth.uid
        && textLen(next.name, 1, 80)
        && (next.type == "annual" || next.type == "sick" || next.type == "other")
        && lvDate(next.start)
        && lvDate(next.end)
        && next.end >= next.start
        && lvHalves()
        && textLen(next.reason, 1, 500)
        && lvCertPath(request.auth.uid, id)
        && textMax(next.certificateName, 120)
        && (next.certificatePath == ""
          ? next.certificateName == ""
          : next.certificateName.size() > 0)
        && next.status == "pending"
        && next.decisionNote == ""
        && next.decidedBy == ""
        && next.decidedByName == ""
        && next.decidedAt == null
        && next.createdAt == request.time
        && next.updatedAt == request.time;
    }
    function lvDecision() {
      let next = docData();
      let prev = prevData();
      return lvDecider()
        && prev.status == "pending"
        && next.diff(prev).affectedKeys().hasOnly(["status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "updatedAt"])
        && (next.status == "approved" || next.status == "declined")
        && textLen(next.decisionNote, 1, 500)
        && next.decidedBy == request.auth.uid
        && textLen(next.decidedByName, 1, 80)
        && next.decidedAt == request.time
        && next.updatedAt == request.time
        && fieldSame(next, prev, "uid") && fieldSame(next, prev, "name") && fieldSame(next, prev, "type") && fieldSame(next, prev, "start") && fieldSame(next, prev, "end")
        && fieldSame(next, prev, "startHalf") && fieldSame(next, prev, "endHalf") && fieldSame(next, prev, "reason")
        && fieldSame(next, prev, "certificatePath") && fieldSame(next, prev, "certificateName") && same("createdAt");
    }

    match /leaveRequests/{id} {
      allow get: if (lvHeartwood() && (resource == null && id.matches('^lv[a-z0-9]{16}$')
          || resource != null && docCompany(prevData()) == "heartwood" && (lvDecider() || prevData().uid == request.auth.uid)))
        || (callerCompany() != "heartwood" && resource != null && prevData().companyId == callerCompany()
          && (prevData().uid == request.auth.uid || (hasProfile() && (profile().role == "admin" || profile().role == "supervisor" || profile().role == "manager"))));
      allow list: if lvHeartwood() && prevData().uid == request.auth.uid;
      allow list: if lvHeartwood() && lvDecider() && prevData().companyId == "heartwood";
      allow list: if callerCompany() != "heartwood" && prevData().companyId == callerCompany()
        && (prevData().uid == request.auth.uid || (hasProfile() && (profile().role == "admin" || profile().role == "supervisor" || profile().role == "manager")));
      allow create: if lvCreate(id) && (lvHeartwood() && callerCompany() == "heartwood" || docData().companyId == callerCompany());
      allow update: if lvDecision() && docCompany(prevData()) == callerCompany();
      allow delete: if false;
    }
// END LEAVE RULES

// BEGIN REIMBURSEMENT CLAIM RULES
    function rcSignedIn() { return request.auth != null; }
    function rcStaff() {
      return rcSignedIn() && (
        isAlex() || isPatrick() || (
          hasProfile() && callerCompany() == "heartwood"
        ) || (
          callerCompany() != "heartwood" && callerCompany() != "" && hasProfile()
        )
      );
    }
    function rcAdmin() {
      return rcStaff() && (isAlex() || isPatrick() || (hasProfile() && (profile().role == "admin" || profile().role == "manager")));
    }
    function rcReceiptPath(uid, id) {
      let next = docData();
      return next.receiptPath == ""
        || next.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.pdf"
        || next.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.jpg"
        || next.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.png"
        || next.receiptPath == "reimbursements/" + uid + "/" + id + "/receipt.webp";
    }
    function rcCreate(id) {
      return rcStaff()
        && id.matches('^rc[a-z0-9]{16}$')
        && docData().keys().hasOnly(["uid", "name", "date", "amountCents", "supplier", "category", "notes", "paidWith", "jobId", "jobLabel", "receiptPath", "receiptName", "status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "paidAt", "createdAt", "updatedAt", "companyId"])
        && (!("companyId" in docData()) || docData().companyId == callerCompany())
        && docData().uid == request.auth.uid
        && textLen(docData().name, 1, 80)
        && docData().date is string
        && docData().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && docData().amountCents is int
        && docData().amountCents > 0
        && docData().amountCents <= 10000000
        && textLen(docData().supplier, 1, 120)
        && (docData().category == "fuel" || docData().category == "tip-fees" || docData().category == "parts" || docData().category == "tools" || docData().category == "consumables" || docData().category == "other")
        && textMax(docData().notes, 1000)
        && (docData().paidWith == "personal-card" || docData().paidWith == "cash")
        && docData().jobId is string
        && docData().jobId.matches('^[A-Za-z0-9_-]{0,80}$')
        && textMax(docData().jobLabel, 160)
        && rcReceiptPath(request.auth.uid, id)
        && textMax(docData().receiptName, 120)
        && (docData().receiptPath == ""
          ? docData().receiptName == ""
          : docData().receiptName.size() > 0)
        && docData().status == "submitted"
        && docData().decisionNote == ""
        && docData().decidedBy == ""
        && docData().decidedByName == ""
        && docData().decidedAt == null
        && docData().paidAt == null
        && docData().createdAt == request.time
        && docData().updatedAt == request.time;
    }
    function rcStep() {
      let next = docData();
      let prev = prevData();
      return (prev.status == "submitted" && (next.status == "approved" || next.status == "declined" || next.status == "paid"))
        || (prev.status == "approved" && (next.status == "paid" || next.status == "declined"));
    }
    function rcDecision() {
      return rcAdmin()
        && rcStep()
        && docData().diff(prevData()).affectedKeys().hasOnly(["status", "decisionNote", "decidedBy", "decidedByName", "decidedAt", "paidAt", "updatedAt", "hubdocStatus"])
        && (!docData().diff(prevData()).affectedKeys().hasAny(["hubdocStatus"])
          || (docData().status == "paid"
            && docData().hubdocStatus == (prevData().receiptPath == "" ? "no-receipt" : "queued")))
        && textMax(docData().decisionNote, 500)
        && docData().decidedBy == request.auth.uid
        && textLen(docData().decidedByName, 1, 80)
        && docData().decidedAt == request.time
        && docData().updatedAt == request.time
        && (docData().status == "paid"
          ? docData().paidAt == request.time
          : docData().paidAt == null);
    }

    // Hubdoc filer: the box sync account (tools/hubdoc_filer.py) reads paid claims and records only the Hubdoc
    // send state. It cannot change the claim itself, and only on claims that are already paid.
    function rcSync() { return rcSignedIn() && request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2"; }
    function rcHubdoc() {
      let next = docData();
      let prev = prevData();
      return rcSync()
        && prev.status == "paid"
        && next.diff(prev).affectedKeys().hasOnly(["hubdocStatus", "hubdocAttempts", "hubdocUpdatedAt", "hubdocSentAt", "hubdocMessageId", "hubdocVia", "hubdocError"])
        && next.hubdocStatus in ["sending", "sent", "failed", "no-receipt"]
        && next.get("hubdocAttempts", 0) is int
        && next.get("hubdocError", "") is string
        && next.get("hubdocError", "").size() <= 300
        && next.get("hubdocMessageId", "") is string
        && next.get("hubdocMessageId", "").size() <= 100;
    }

    match /reimbursementClaims/{id} {
      allow get: if (rcSync() && resource != null && prevData().status == "paid")
        || (rcStaff() && callerCompany() == "heartwood" && (
          (resource == null && id.matches('^rc[a-z0-9]{16}$'))
          || (resource != null && docCompany(prevData()) == "heartwood" && (rcAdmin() || prevData().uid == request.auth.uid))
        ))
        || (callerCompany() != "heartwood" && resource != null && prevData().companyId == callerCompany()
          && (prevData().uid == request.auth.uid || (hasProfile() && (profile().role == "admin" || profile().role == "manager"))));
      allow list: if rcStaff() && callerCompany() == "heartwood" && prevData().uid == request.auth.uid;
      allow list: if rcAdmin() && callerCompany() == "heartwood" && prevData().companyId == "heartwood";
      allow list: if rcSync() && prevData().status == "paid";
      allow list: if callerCompany() != "heartwood" && prevData().companyId == callerCompany()
        && (prevData().uid == request.auth.uid || (hasProfile() && (profile().role == "admin" || profile().role == "manager")));
      allow create: if rcCreate(id) && (
        callerCompany() == "heartwood" || docData().companyId == callerCompany()
      );
      allow update: if (rcDecision() && docCompany(prevData()) == callerCompany()) || rcHubdoc();
      allow delete: if false;
    }
// END REIMBURSEMENT CLAIM RULES
// BEGIN HOURS EXPORT RULES
    // Heartwood still queues to accounts@heartwoodew.com only.
    // Another company queues to companies/{id}.accountsEmail, never Heartwood's mailbox.
    function hxSignedIn() { return request.auth != null; }
    function hxProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hxHasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function hxCaller() {
      return callerCompany();
    }
    function hxAdmin() {
      return hxSignedIn() && (
        request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2" || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
        || (hxHasProfile() && hxProfile().get("role", "") == "admin" && hxCaller() != "")
      );
    }
    function hxSync() { return hxSignedIn() && request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2"; }
    function hxAccounts() {
      return hxCaller() == "heartwood"
        ? "accounts@heartwoodew.com"
        : get(/databases/$(database)/documents/companies/$(hxCaller())).data.accountsEmail;
    }
    function hxShape(d, id) {
      return id.matches('^hx[a-z0-9]{16}$')
        && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.weekEnd is string && d.weekEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.fileName is string && d.fileName.matches('^[A-Za-z0-9_-]{1,80}[.]xlsx$')
        && d.storagePath == "hoursExports/" + id + "/" + d.fileName
        && d.people is int && d.people >= 0 && d.people <= 500
        && d.totalHours is number && d.totalHours >= 0 && d.totalHours <= 100000
        && d.status == "queued" && d.attempts == 0
        && d.createdBy == request.auth.uid
        &&textMax(d.createdByName, 80)
        && d.createdAt == request.time;
    }
    function hxCreate(id) {
      let d = docData();
      return hxAdmin() && hxCaller() != "" && hxShape(d, id) && (
        (hxCaller() == "heartwood"
          && d.keys().hasOnly(["weekStart", "weekEnd", "to", "fileName", "storagePath", "people", "totalHours", "status", "attempts", "createdBy", "createdByName", "createdAt", "companyId", "companyName"])
          && d.companyId == "heartwood"
          && d.companyName == "Heartwood"
          && d.to == "accounts@heartwoodew.com")
        || (hxCaller() != "heartwood"
          && d.keys().hasOnly(["weekStart", "weekEnd", "to", "fileName", "storagePath", "people", "totalHours", "status", "attempts", "createdBy", "createdByName", "createdAt", "companyId", "companyName"])
          && d.companyId == hxCaller()
          &&textLen(d.companyName, 1, 80)
          && d.to == hxAccounts()
          && d.to != "accounts@heartwoodew.com"
          && exists(/databases/$(database)/documents/companies/$(hxCaller()))
          && get(/databases/$(database)/documents/companies/$(hxCaller())).data.isTest != true)
      );
    }
    function hxMark() {
      return hxSync()
        && docData().diff(prevData()).affectedKeys().hasOnly(["status", "attempts", "updatedAt", "sentAt", "messageId", "error", "via"])
        && docData().status in ["sending", "sent", "failed"]
        && docData().attempts is int
        &&textMax(docData().get("error", ""), 300)
        &&textMax(docData().get("messageId", ""), 100);
    }
    match /hoursExports/{id} {
      allow get: if (hxAdmin() && docCompany(prevData()) == hxCaller()) || hxSync();
      allow list: if hxAdmin() && prevData().companyId == hxCaller();
      allow list: if hxSync();
      allow create: if hxCreate(id);
      allow update: if hxMark();
      allow delete: if false;
    }
// END HOURS EXPORT RULES

// BEGIN INBOX IMPORT RULES
    // inbox/{gmailMessageId} is written by the box (tools/sync_inbox.py, admin SDK, or the
    // same sync UID as hours export). The app only marks read and imported.
    // Admins and supervisors can read and mark. Operators cannot. No client deletes.
    function inSignedIn() { return request.auth != null; }
    function inSync() { return inSignedIn() && request.auth.uid == "38SU5waAy4f9UI9N6JTqDMaYpQg2"; }
    function inOffice() {
      return inSignedIn() && (
        request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"
        || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin"
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "supervisor"
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "manager"
          )
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("tenantId", "heartwood") == "heartwood"
        )
      );
    }
    function inMark() {
      let changed = docData().diff(prevData()).affectedKeys();
      return changed.hasOnly(["read", "readAt", "imported", "importedJobId", "importedAt", "importedBy", "jobIds"])
        && (!changed.hasAny(["read"]) || docData().read is bool)
        && (!changed.hasAny(["readAt"]) || docData().readAt == request.time)
        && (!changed.hasAny(["imported"]) || docData().imported == true)
        && (!changed.hasAny(["importedJobId"]) || (
          textLen(docData().importedJobId, 1, 128)
          && docData().importedJobId.matches('^[A-Za-z0-9_-]+$')
        ))
        && (!changed.hasAny(["importedBy"]) || docData().importedBy == request.auth.uid)
        && (!changed.hasAny(["importedAt"]) || docData().importedAt == request.time)
        && (!changed.hasAny(["jobIds"]) || (
          docData().jobIds is list && docData().jobIds.size() <= 20
        ))
        && (!changed.hasAny(["imported", "importedJobId", "importedBy", "importedAt"])
          || (changed.hasAll(["imported", "importedJobId", "importedBy", "importedAt"])));
    }
    match /inbox/{id} {
      allow read: if inOffice() || inSync();
      allow create: if inSync();
      allow update: if inSync() || (inOffice() && inMark());
      allow delete: if false;
    }
// END INBOX IMPORT RULES

// BEGIN LIVE LOCATION RULES
    // One live doc per person (latest position only). Heartwood: liveLocations/{uid}.
    // Every other company: companies/{id}/liveLocations/{uid}. The same clock-off and
    // last-known rules apply to every company. Written while that person's timesheet
    // shift is clocked on (open or on a break). Clock off keeps the doc: the same person
    // sets clockedOn false and clockedOffAt, and does not have to delete it.
    // A position already shared cannot be replaced with location off, so a lapsed update stays.
    // Admin and manager of the same company read every doc, including a clocked-off last position.
    // A supervisor reads clocked-on docs only, for the Staff roster. Operator and labourer do not.
    // The crew map stays manager and admin. No other company does.
    // Heartwood: status "paused" blocks locations (llPaused). Other companies use companyNotPaused,
    // the same trial and billing pause as the rest of the app. No company document means not paused.
    match /liveLocations/{id} {
      function llMap() {
        return isAlex()
          || (isPatrick() && callerCompany() == "heartwood")
          || (hasProfile() && (profile().get("role", "") == "admin" || profile().get("role", "") == "manager"));
      }
      function llLiveRead() {
        return prevData().clockedOn == true || llMap();
      }
      function llKeepsFix() {
        return prevData().sharing != "gps" || docData().sharing == "gps";
      }
      function llClockOff(id) {
        let d = docData();
        return prevData().clockedOn == true
          && d.clockedOn == false
          && d.clockedOffAt == request.time
          && d.uid == id
          && d.uid == request.auth.uid
          && same("uid") && same("name") && same("companyId") && same("sharing")
          && same("lat") && same("lng") && same("accuracy")
          && same("updatedAt") && same("weekStart") && same("entryId")
          && (
            (d.sharing == "gps" && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "lat", "lng", "accuracy", "updatedAt", "weekStart", "entryId", "clockedOffAt"]))
            || (d.sharing == "off" && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "updatedAt", "weekStart", "entryId", "clockedOffAt"]))
          );
      }
      function llRole() {
        return hasProfile() ? profile().get("role", "") : "";
      }
      function llPaused(id) {
        let path = /databases/$(database)/documents/companies/$(id);
        return exists(path) && get(path).data.get("status", "") == "paused";
      }
      function llOffice() {
        return signedIn() && callerCompany() != "" && (
          isAlex()
          || (isPatrick() && callerCompany() == "heartwood")
          || (hasProfile() && (llRole() == "admin" || llRole() == "manager" || llRole() == "supervisor"))
        );
      }
      function llGps(d) {
        return d.sharing == "gps"
          && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "lat", "lng", "accuracy", "updatedAt", "weekStart", "entryId"])
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100000;
      }
      function llOff(d) {
        return d.sharing == "off"
          && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "updatedAt", "weekStart", "entryId"]);
      }
      function llOpenEntry(sheet) {
        let entry = sheet.entries[docData().entryId];
        return sheet.uid == request.auth.uid
          && docCompany(sheet) == docData().companyId
          && entry.source == "clock"
          && (entry.status == "open" || entry.status == "break");
      }
      function llClocked() {
        let path = /databases/$(database)/documents/timesheets/$(request.auth.uid + "_" + docData().weekStart);
        return exists(path) && llOpenEntry(get(path).data);
      }
      function llBody(d, id) {
        return d.uid == id
          && d.uid == request.auth.uid
          &&textLen(d.name, 1, 80)
          && d.clockedOn == true
          && d.updatedAt == request.time
          && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.entryId is string && d.entryId.matches('^[a-z0-9]{8,24}$')
          && (llGps(d) || llOff(d))
          && llClocked();
      }

      allow get: if llOffice() && !llPaused("heartwood") && callerCompany() == "heartwood" && docCompany(prevData()) == "heartwood" && llLiveRead();
      allow list: if llOffice() && !llPaused("heartwood") && callerCompany() == "heartwood" && prevData().companyId == "heartwood" && llLiveRead();
      allow create: if callerCompany() == "heartwood" && docData().companyId == "heartwood" && !llPaused("heartwood") && llBody(docData(), id);
      allow update: if callerCompany() == "heartwood" && docData().companyId == "heartwood" && !llPaused("heartwood") && ((llBody(docData(), id) && llKeepsFix()) || llClockOff(id));
      allow delete: if signedIn() && request.auth.uid == id && callerCompany() == "heartwood" && docCompany(prevData()) == "heartwood" && !llPaused("heartwood");
    }
    match /companies/{c}/liveLocations/{id} {
      function llMap() {
        return isAlex()
          || (isPatrick() && callerCompany() == "heartwood")
          || (hasProfile() && (profile().get("role", "") == "admin" || profile().get("role", "") == "manager"));
      }
      function llLiveRead() {
        return prevData().clockedOn == true || llMap();
      }
      function llKeepsFix() {
        return prevData().sharing != "gps" || docData().sharing == "gps";
      }
      function llClockOff(id) {
        let d = docData();
        return prevData().clockedOn == true
          && d.clockedOn == false
          && d.clockedOffAt == request.time
          && d.uid == id
          && d.uid == request.auth.uid
          && same("uid") && same("name") && same("companyId") && same("sharing")
          && same("lat") && same("lng") && same("accuracy")
          && same("updatedAt") && same("weekStart") && same("entryId")
          && (
            (d.sharing == "gps" && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "lat", "lng", "accuracy", "updatedAt", "weekStart", "entryId", "clockedOffAt"]))
            || (d.sharing == "off" && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "updatedAt", "weekStart", "entryId", "clockedOffAt"]))
          );
      }
      function llRole() {
        return hasProfile() ? profile().get("role", "") : "";
      }
      function llOffice() {
        return signedIn() && callerCompany() != "" && (
          isAlex()
          || (isPatrick() && callerCompany() == "heartwood")
          || (hasProfile() && (llRole() == "admin" || llRole() == "manager" || llRole() == "supervisor"))
        );
      }
      function llGps(d) {
        return d.sharing == "gps"
          && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "lat", "lng", "accuracy", "updatedAt", "weekStart", "entryId"])
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100000;
      }
      function llOff(d) {
        return d.sharing == "off"
          && d.keys().hasOnly(["uid", "name", "companyId", "clockedOn", "sharing", "updatedAt", "weekStart", "entryId"]);
      }
      function llOpenEntry(sheet) {
        let entry = sheet.entries[docData().entryId];
        return sheet.uid == request.auth.uid
          && docCompany(sheet) == docData().companyId
          && entry.source == "clock"
          && (entry.status == "open" || entry.status == "break");
      }
      function llClocked() {
        let path = /databases/$(database)/documents/timesheets/$(request.auth.uid + "_" + docData().weekStart);
        return exists(path) && llOpenEntry(get(path).data);
      }
      function llBody(d, id) {
        return d.uid == id
          && d.uid == request.auth.uid
          &&textLen(d.name, 1, 80)
          && d.clockedOn == true
          && d.updatedAt == request.time
          && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.entryId is string && d.entryId.matches('^[a-z0-9]{8,24}$')
          && (llGps(d) || llOff(d))
          && llClocked();
      }

      allow get: if llOffice() && c != "heartwood" && callerCompany() == c && docCompany(prevData()) == c && companyNotPaused(c) && llLiveRead();
      allow list: if llOffice() && c != "heartwood" && callerCompany() == c && prevData().companyId == c && companyNotPaused(c) && llLiveRead();
      allow create: if c != "heartwood" && callerCompany() == c && docData().companyId == c && companyNotPaused(c) && llBody(docData(), id);
      allow update: if c != "heartwood" && callerCompany() == c && docData().companyId == c && companyNotPaused(c) && ((llBody(docData(), id) && llKeepsFix()) || llClockOff(id));
      allow delete: if signedIn() && request.auth.uid == id && c != "heartwood" && callerCompany() == c && docCompany(prevData()) == c && companyNotPaused(c);
    }
// END LIVE LOCATION RULES

// BEGIN DAILY JOB RULES
    match /dailyJobDigest/{id} {
      allow read, write: if false;
    }
// END DAILY JOB RULES

// BEGIN PRESTART NOTICE RULES
    // Written by the prestart assignment function. The person reads their own
    // company only. Clients cannot write. The document has no prices.
    match /users/{uid}/prestartNotices/{noticeId} {
      allow read: if signedIn() && request.auth.uid == uid && prevData().companyId == callerCompany();
      allow create, update, delete: if false;
    }
// END PRESTART NOTICE RULES

// BEGIN LOCATION REMIND RULES
    // Written by remindLocationSharing. The person reads their own company only.
    // sentAtMs is the 30-minute rate limit. Clients cannot write.
    match /users/{uid}/locationNotices/{noticeId} {
      allow read: if signedIn() && request.auth.uid == uid && prevData().companyId == callerCompany();
      allow create, update, delete: if false;
    }
// END LOCATION REMIND RULES

// BEGIN QUOTE WRITE RULES
    // Same quote create/update as cloud/firestore.production.rules: one profile read,
    // so a verified email does not blow the 1000-expression limit. Crew cannot write.
    function quoteFieldsOk(d) {
      return d.get("extraItems", []) is list && d.get("extraItems", []).size() <= 40
        && d.get("priceOverrides", {}) is map && d.get("priceOverrides", {}).size() <= 20
        && (d.get("addressPlace", null) == null || (d.addressPlace is map
          && d.addressPlace.keys().hasOnly(["formattedAddress", "lat", "lng", "placeId", "source"])
          && d.addressPlace.lat is number && d.addressPlace.lng is number));
    }
    function quoteActor() {
      let user = /databases/$(database)/documents/users/$(request.auth.uid);
      let has = signedIn() && exists(user);
      let data = has ? get(user).data : null;
      let role = data != null ? data.get("role", "") : "";
      let companyId = data != null ? data.get("companyId", "") : "";
      let tenantId = data != null ? data.get("tenantId", "") : "";
      let bootstrap = signedIn() && request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "38SU5waAy4f9UI9N6JTqDMaYpQg2", "R7t41e54Ykcdk9WPdVZnDd697iI2"];
      let company = bootstrap ? "heartwood"
        : (companyId is string && companyId.size() > 0 ? companyId
          : (tenantId is string && tenantId.size() > 0 ? tenantId : (has ? "heartwood" : "")));
      let grant = /databases/$(database)/documents/heartwoodAdmins/$(request.auth.uid);
      let granted = !bootstrap && has && exists(grant) && get(grant).data.get("role", "") == "admin" && role == "admin" && company == "heartwood";
      return { "listed": bootstrap || granted, "role": role, "company": company, "ok": signedIn() };
    }
    function quoteCompanyOf(data) {
      let id = data.get("companyId", "");
      let tenant = data.get("tenantId", "");
      return (id is string && id.size() > 0) ? id : ((tenant is string && tenant.size() > 0) ? tenant : "heartwood");
    }
    function quoteOffice(actor, company) {
      return actor.ok && company is string && (
        (actor.listed && company == "heartwood")
        || (actor.company == company && company == "heartwood" && actor.role in ["manager", "supervisor"])
        || (actor.company == company && company != "heartwood" && company != "" && actor.role in ["admin", "manager", "supervisor"] && companyNotPaused(company))
      );
    }
    function quotePricesOk(actor, next, before) {
      return actor.listed || actor.role == "admin" || actor.role == "manager" || next.get("priceOverrides", {}) == before;
    }
    function quoteCreateOk() {
      let actor = quoteActor();
      let data = docData();
      let company = quoteCompanyOf(data);
      return quoteFieldsOk(data) && quoteOffice(actor, company) && quotePricesOk(actor, data, {});
    }
    function quoteUpdateOk() {
      let actor = quoteActor();
      let next = docData();
      let company = quoteCompanyOf(prevData());
      return prevData().get("quoteStatus", "") != "Accepted"
        && quoteFieldsOk(next)
        && quoteOffice(actor, company)
        && quoteCompanyOf(next) == company
        && quotePricesOk(actor, next, prevData().get("priceOverrides", {}));
    }
    match /quotes/{id} {
      allow get: if quoteOffice(quoteActor(), quoteCompanyOf(prevData()));
      allow list: if prevData().companyId is string && quoteOffice(quoteActor(), prevData().companyId);
      allow create: if quoteCreateOk();
      allow update: if quoteUpdateOk();
      allow delete: if false;
    }
// END QUOTE WRITE RULES

// BEGIN STAFF PERFORMANCE RULES
    // One profile read per helper. Heartwood returns before the company lookup.
    // performanceSettings is managers and admins only (weights and the crew-only ranking switch).
    // take5Settings is the on/off flag every staff member of that company can read, so field crew
    // know to prompt, without being able to read weights or money.
    // take5s: any staff member creates their own; supervisors and above list the company.
    function perfListed() {
      return request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "38SU5waAy4f9UI9N6JTqDMaYpQg2", "R7t41e54Ykcdk9WPdVZnDd697iI2"];
    }
    function perfCompanyOf(p) {
      return p.get("companyId", "") is string && p.get("companyId", "") != ""
        ? p.get("companyId", "")
        : p.get("tenantId", "heartwood");
    }
    function perfRole(companyId) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      let missing = !exists(path);
      let p = missing ? {} : get(path).data;
      let c = perfCompanyOf(p);
      let same = (companyId == "heartwood" && (perfListed() || (!missing && c == "heartwood")))
        || (companyId != "heartwood" && !missing && c == companyId && companyNotPaused(companyId));
      return signedIn() && companyId is string && companyId.size() >= 2 && same ? (perfListed() ? "admin" : p.get("role", "")) : "";
    }
    match /performanceSettings/{companyId} {
      function perfWeightsOk(w) {
        return w is map
          && w.keys().hasOnly(["hours", "money", "jobs", "prestart", "take5", "incidents", "sick", "annual"])
          && w.hours is number && w.hours >= 0 && w.hours <= 10
          && w.money is number && w.money >= 0 && w.money <= 10
          && w.jobs is number && w.jobs >= 0 && w.jobs <= 10
          && w.prestart is number && w.prestart >= 0 && w.prestart <= 10
          && w.take5 is number && w.take5 >= 0 && w.take5 <= 10
          && w.incidents is number && w.incidents >= 0 && w.incidents <= 10
          && w.sick is number && w.sick >= 0 && w.sick <= 10
          && w.annual is number && w.annual >= 0 && w.annual <= 10;
      }
      function perfBody(companyId) {
        let d = docData();
        return d.keys().hasOnly(["companyId", "excludeLeaders", "weights", "updatedAt", "updatedBy"])
          && d.companyId == companyId
          && d.excludeLeaders is bool
          && perfWeightsOk(d.weights)
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
      }
      function perfDefaultWeights() {
        let w = docData().weights;
        return w.hours == 1 && w.money == 1 && w.jobs == 1 && w.prestart == 1 && w.take5 == 1
          && w.incidents == 1 && w.sick == 1 && w.annual == 0;
      }
      function perfCanRead(companyId) {
        let role = perfRole(companyId);
        return role == "admin" || role == "manager";
      }

      allow get: if perfCanRead(companyId);
      allow list: if false;
      allow create, update: if perfRole(companyId) == "admin" && perfBody(companyId);
      allow create: if perfRole(companyId) == "manager" && perfBody(companyId) && perfDefaultWeights();
      allow update: if perfRole(companyId) == "manager"
        && docData().diff(prevData()).affectedKeys().hasOnly(["excludeLeaders", "updatedAt", "updatedBy"])
        && docData().excludeLeaders is bool
        && docData().companyId == prevData().companyId
        && docData().weights == prevData().weights
        && docData().updatedBy == request.auth.uid
        && docData().updatedAt == request.time;
      allow delete: if false;
    }
    match /take5Settings/{companyId} {
      function take5Actor(companyId) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let missing = !exists(path);
        let p = missing ? {} : get(path).data;
        let c = perfCompanyOf(p);
        return signedIn() && companyId is string && companyId.size() >= 2 && (
          (companyId == "heartwood" && (perfListed() || (!missing && c == "heartwood")))
          || (companyId != "heartwood" && !missing && c == companyId && companyNotPaused(companyId))
        );
      }

      allow get: if take5Actor(companyId);
      allow list: if false;
      allow create, update: if perfRole(companyId) == "admin"
        && docData().keys().hasOnly(["companyId", "enabled", "updatedAt", "updatedBy"])
        && docData().companyId == companyId
        && docData().enabled is bool
        && docData().updatedBy == request.auth.uid
        && docData().updatedAt == request.time;
      allow delete: if false;
    }
    match /take5s/{id} {
      function take5Actor(companyId) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let missing = !exists(path);
        let p = missing ? {} : get(path).data;
        let c = perfCompanyOf(p);
        return signedIn() && companyId is string && companyId.size() >= 2 && (
          (companyId == "heartwood" && (perfListed() || (!missing && c == "heartwood")))
          || (companyId != "heartwood" && !missing && c == companyId && companyNotPaused(companyId))
        );
      }
      function take5Office(companyId) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let missing = !exists(path);
        let p = missing ? {} : get(path).data;
        let role = p.get("role", "");
        let c = perfCompanyOf(p);
        let leader = perfListed() || role in ["supervisor", "manager", "admin"];
        return signedIn() && companyId is string && leader && (
          (companyId == "heartwood" && (perfListed() || (!missing && c == "heartwood")))
          || (companyId != "heartwood" && !missing && c == companyId && companyNotPaused(companyId))
        );
      }
      function take5IdOk(id) { return id.matches('^t5[a-z0-9]{16}$'); }
      function take5MayGetMissing(id) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let missing = !exists(path);
        let p = missing ? {} : get(path).data;
        let c = perfCompanyOf(p);
        let open = c == "heartwood" || (!missing && companyNotPaused(c));
        return take5IdOk(id) && signedIn() && open && (perfListed() || !missing);
      }
      function take5Body(id) {
        let d = docData();
        return take5IdOk(id)
          && d.keys().hasOnly(["companyId", "uid", "name", "jobId", "jobNo", "day", "note", "steps", "photoPath", "createdAt"])
          && d.companyId is string
          && d.uid == request.auth.uid
          &&textLen(d.name, 2, 80)
          &&textLen(d.jobId, 1, 80)
          &&textMax(d.jobNo, 40)
          && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          &&textLen(d.note, 1, 500)
          && d.steps is map
          && d.steps.keys().hasOnly(["stop", "look", "assess", "control", "proceed"])
          && d.steps.stop == true && d.steps.look == true && d.steps.assess == true
          && d.steps.control == true && d.steps.proceed == true
          &&textMax(d.photoPath, 200)
          && (d.photoPath == "" || d.photoPath == "take5Photos/" + d.companyId + "/" + d.uid + "_" + id + ".jpg")
          && d.createdAt == request.time;
      }

      allow get: if resource == null && take5MayGetMissing(id);
      allow get: if resource != null && prevData().uid == request.auth.uid && take5Actor(prevData().companyId);
      allow get: if resource != null && take5Office(prevData().companyId);
      allow list: if prevData().uid == request.auth.uid && take5Actor(prevData().companyId);
      allow list: if take5Office(prevData().companyId);
      allow create: if take5Actor(docData().companyId) && take5Body(id);
      allow update, delete: if false;
    }
    // Managers need company timesheets and incidents to build the ranking. Crew and supervisors stay on their own.
    match /timesheets/{id} {
      allow get: if perfRole(docCompany(prevData())) == "manager";
      allow list: if prevData().companyId is string && perfRole(prevData().companyId) == "manager";
    }
    match /incidents/{iid} {
      allow get: if perfRole(docCompany(prevData())) == "manager";
      allow list: if prevData().companyId is string && perfRole(prevData().companyId) == "manager";
    }
// END STAFF PERFORMANCE RULES


    // One profile read and one job read, shared by job files and job requirements.
    // Office is admin, manager or supervisor, including Heartwood. Crew is an assigned operator or labourer.
    // company == "heartwood" || companyNotPaused(company). actor.role in ["admin", "manager", "supervisor"]
    // or actor.role in ["operator", "labourer"].
    function jobFileActor() {
      let bootstrap = signedIn() && request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "R7t41e54Ykcdk9WPdVZnDd697iI2"];
      let user = /databases/$(database)/documents/users/$(request.auth.uid);
      let has = signedIn() && !bootstrap && exists(user);
      let data = has ? get(user).data : null;
      let role = data != null ? data.get("role", "") : "";
      let actorCompany = data != null ? data.get("companyId", "") : "";
      let actorTenant = data != null ? data.get("tenantId", "") : "";
      let company = bootstrap ? "heartwood"
        : (actorCompany is string && actorCompany.size() > 0 ? actorCompany
          : (actorTenant is string && actorTenant.size() > 0 ? actorTenant : (has ? "heartwood" : "")));
      return { "role": role, "company": company, "ok": signedIn() && (bootstrap || has) };
    }
    function jobAccessGate(jobId) {
      let actor = jobFileActor();
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      let companyId = job.get("companyId", "");
      let tenantId = job.get("tenantId", "");
      let company = (companyId is string && companyId.size() > 0) ? companyId
        : ((tenantId is string && tenantId.size() > 0) ? tenantId : "heartwood");
      let assignedList = job.get("assigned", []);
      let assigned = assignedList is list && request.auth.uid in assignedList;
      let open = company == "heartwood" || companyNotPaused(company);
      let same = actor.ok && actor.company == company && open;
      let office = same && (
        actor.role in ["admin", "manager", "supervisor"]
        || (company == "heartwood" && request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "R7t41e54Ykcdk9WPdVZnDd697iI2"])
      );
      let crew = same && assigned && actor.role in ["operator", "labourer"];
      return { "office": office, "crew": crew, "company": company };
    }

// BEGIN JOB DOCUMENT RULES
    // Job files (plans, quotes, invoices, drawings). Metadata only; the bytes live in Storage.
    // One profile read (none for Alex or Patrick) and one job read. companyNotPaused runs once,
    // and never for Heartwood, so a verified email stays under the 1000-expression limit.
    // Office is admin, manager and supervisor (same people who read quotes). Crew is operator
    // or labourer, and only when they are on the job's assigned list. Office-only files are
    // hidden from crew. A paused company cannot read or write. A missing company is not paused.
    match /jobs/{jobId}/documents/{docId} {
      function documentShape(d, jobId, docId) {
        return docId.matches('^d[A-Za-z0-9]{8,40}$')
          && d.keys().hasOnly(["companyId", "tenantId", "jobId", "name", "fileName", "contentType", "size", "visibility", "storagePath", "uploaderUid", "uploaderName", "createdAt", "updatedAt"])
          && d.companyId is string && d.tenantId == d.companyId && d.jobId == jobId
          &&textLen(d.name, 1, 160)
          &&textLen(d.fileName, 1, 200)
          &&textLen(d.contentType, 1, 160)
          && d.size is number && d.size > 0 && d.size <= 25 * 1024 * 1024
          && d.visibility in ["crew", "office"]
          && d.storagePath == "tenants/" + d.companyId + "/jobs/" + jobId + "/documents/" + docId
          && d.uploaderUid == request.auth.uid
          &&textLen(d.uploaderName, 1, 80)
          && d.createdAt == request.time
          && d.updatedAt == request.time;
      }
      function documentCreate(jobId, docId) {
        let gate = jobAccessGate(jobId);
        let d = docData();
        return gate.office && d.companyId == gate.company && documentShape(d, jobId, docId);
      }
      function documentOffice(jobId) {
        return jobAccessGate(jobId).office;
      }
      function documentCrew(jobId) {
        let gate = jobAccessGate(jobId);
        return gate.crew && prevData().visibility == "crew";
      }
      function documentRename(jobId) {
        let gate = jobAccessGate(jobId);
        let next = docData();
        let prev = prevData();
        return gate.office
          && prev.get("companyId", "") == gate.company
          && next.diff(prev).affectedKeys().hasOnly(["name", "updatedAt"])
          &&textLen(next.name, 1, 160)
          && next.updatedAt == request.time;
      }
      function documentRemove(jobId) {
        let gate = jobAccessGate(jobId);
        return gate.office && prevData().get("companyId", "") == gate.company;
      }

      allow get: if documentOffice(jobId);
      allow list: if documentOffice(jobId);
      allow get: if documentCrew(jobId);
      allow list: if documentCrew(jobId);
      allow create: if documentCreate(jobId, docId);
      allow update: if documentRename(jobId);
      allow delete: if documentRemove(jobId);
    }
// END JOB DOCUMENT RULES

// BEGIN JOB REQUIREMENT RULES
    // Job requirements. Office (admin, manager, supervisor, including Heartwood
    // supervisors) can create, edit and delete items and the current meta.
    // They still cannot write the job document. Assigned operator or labourer
    // can tick or untick only. Unassigned crew cannot read. A paused company
    // cannot read or write. No money fields. One profile read and one job read.
    match /companies/{companyId}/requirementTemplates/{templateId} {
      function templateOffice() {
        let actor = jobFileActor();
        let open = companyId == "heartwood" || companyNotPaused(companyId);
        return templateId in ["coral-homes", "heartwood-default"] && actor.ok && actor.company == companyId && open && (
          actor.role in ["admin", "manager", "supervisor"]
          || (companyId == "heartwood" && request.auth.uid in ["1JKLsoxkQNfkphBBO0vDz2ziEyj2", "R7t41e54Ykcdk9WPdVZnDd697iI2"])
        );
      }
      function templateShape(d) {
        return d.keys().hasOnly(["companyId", "templateId", "builder", "title", "items", "updatedAt", "updatedBy"])
          && !d.keys().hasAny(["poAmount", "poAmountBasis", "poAmountSource", "quoteAmount", "invoiceAmount", "xeroCheck", "price", "rate", "rates", "tipFee", "tipFees", "amount", "cost", "totalEx", "gst", "totalInc"])
          && d.companyId == companyId
          && d.templateId == templateId
          && templateId in ["coral-homes", "heartwood-default"]
          &&textMax(d.builder, 80)
          &&textMax(d.title, 80)
          && d.items is list && d.items.size() <= 80
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
      }

      allow get, list: if templateOffice();
      allow create, update: if templateOffice() && templateShape(docData());
      allow delete: if templateOffice() && prevData().get("companyId", "") == companyId;
    }

    match /jobs/{jobId}/requirementItems/{itemId} {
      function itemShape(d) {
        return itemId.matches('^r[A-Za-z0-9]{6,40}$')
          && d.keys().hasOnly(["companyId", "section", "text", "source", "sort", "done", "doneBy", "doneAt", "createdAt", "updatedAt", "updatedBy"])
          && !d.keys().hasAny(["poAmount", "poAmountBasis", "poAmountSource", "quoteAmount", "invoiceAmount", "xeroCheck", "price", "rate", "rates", "tipFee", "tipFees", "amount", "cost", "totalEx", "gst", "totalInc"])
          &&textLen(d.companyId, 1, 40)
          && d.section in ["shared", "earthworks", "setup", "spoil", "clean", "close"]
          &&textLen(d.text, 1, 500)
          && d.source in ["template", "custom", "email"]
          && d.sort is number && d.sort >= 0 && d.sort <= 9999
          && d.done is bool
          &&textMax(d.doneBy, 128)
          && (d.doneAt == null || d.doneAt is timestamp)
          && d.createdAt is timestamp
          && d.updatedAt is timestamp
          &&textLen(d.updatedBy, 1, 128);
      }
      function itemSee(jobId) {
        let gate = jobAccessGate(jobId);
        return gate.office || gate.crew;
      }
      function itemCreate(jobId) {
        let gate = jobAccessGate(jobId);
        let d = docData();
        return gate.office && itemShape(d) && d.companyId == gate.company
          && d.createdAt == request.time && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
      }
      function itemUpdate(jobId) {
        let gate = jobAccessGate(jobId);
        let next = docData();
        let prev = prevData();
        let changed = next.diff(prev).affectedKeys();
        let shape = itemShape(next);
        let sameCompany = prev.get("companyId", "") == gate.company && next.companyId == prev.companyId;
        let office = gate.office && shape && sameCompany
          && next.createdAt == prev.createdAt
          && next.updatedAt == request.time
          && next.updatedBy == request.auth.uid;
        let tick = gate.crew && shape && sameCompany
          && changed.hasOnly(["done", "doneBy", "doneAt", "updatedBy"])
          && next.updatedBy == request.auth.uid
          && ((next.done == true && next.doneBy == request.auth.uid && next.doneAt == request.time)
            || (next.done == false && next.doneBy == "" && next.doneAt == null));
        return office || tick;
      }
      function itemRemove(jobId) {
        let gate = jobAccessGate(jobId);
        return gate.office && prevData().get("companyId", "") == gate.company;
      }

      allow get, list: if itemSee(jobId);
      allow create: if itemCreate(jobId);
      allow update: if itemUpdate(jobId);
      allow delete: if itemRemove(jobId);
    }

    match /jobs/{jobId}/requirementMeta/{metaId} {
      function metaShape(d) {
        return metaId == "current"
          && d.keys().hasOnly(["templateId", "builder", "storey", "cleanStage", "notes", "updatedAt", "updatedBy"])
          && !d.keys().hasAny(["poAmount", "poAmountBasis", "poAmountSource", "quoteAmount", "invoiceAmount", "xeroCheck", "price", "rate", "rates", "tipFee", "tipFees", "amount", "cost", "totalEx", "gst", "totalInc"])
          &&textMax(d.templateId, 40) && d.templateId.matches('^[a-z0-9-]*$')
          &&textMax(d.builder, 80)
          && d.storey in ["single", "two", ""]
          && d.cleanStage in ["", "first", "second-lowset", "second-highset", "third", "final"]
          &&textMax(d.notes, 2000)
          && d.updatedAt == request.time
          && d.updatedBy == request.auth.uid;
      }
      function metaSee(jobId) {
        let gate = jobAccessGate(jobId);
        return gate.office || gate.crew;
      }
      function metaWrite(jobId) {
        let gate = jobAccessGate(jobId);
        return gate.office && metaShape(docData());
      }

      allow get, list: if metaSee(jobId);
      allow create, update: if metaWrite(jobId);
      allow delete: if jobAccessGate(jobId).office && metaId == "current";
    }
// END JOB REQUIREMENT RULES

// BEGIN INBOUND FORWARD RULES
    // Per-company forwarded mail and job drafts. Written by inboundEmailWebhook
    // (Admin SDK). Office of that company (admin, manager, supervisor) can read.
    // Crew cannot. Another company cannot. The route index is not listable.
    // No price fields on a draft. Paste into the live rules. Do not deploy this file.
    function inboundCompanyOf(p) {
      return p.get("companyId", "") is string && p.get("companyId", "") != ""
        ? p.get("companyId", "")
        : (p.get("tenantId", "") is string && p.get("tenantId", "") != "" ? p.get("tenantId", "") : "heartwood");
    }
    function inboundBootstrap(companyId) {
      return companyId == "heartwood" && signedIn() && (
        request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"
        || request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"
      );
    }
    function inboundProfileOffice(companyId) {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return p.get("role", "") in ["admin", "manager", "supervisor"] && inboundCompanyOf(p) == companyId;
    }
    function inboundProfileMinter(companyId) {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return p.get("role", "") in ["admin", "manager"] && inboundCompanyOf(p) == companyId;
    }
    function inboundOffice(companyId) {
      return inboundBootstrap(companyId) || (signedIn() && inboundProfileOffice(companyId));
    }
    function inboundMinter(companyId) {
      return inboundBootstrap(companyId) || (signedIn() && inboundProfileMinter(companyId));
    }
    function inboundMoneyFree(data) {
      return !data.keys().hasAny(["poAmount", "poAmountBasis", "poAmountSource", "quoteAmount", "poLookupCandidates", "invoiceAmount", "xeroCheck", "amountInc", "totalEx", "gst", "totalInc", "priceOverrides", "lines"]);
    }
    function inboundLocalOk(companyId, localPart) {
      return companyId is string
        && companyId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && localPart is string
        && localPart.matches("^" + companyId + "-[a-z0-9]{8}$");
    }

    match /companies/{companyId}/inbound/{docId} {
      allow get: if docId == "config" && inboundOffice(companyId)
        && (resource == null || prevData().companyId == companyId);
      allow list: if false;
      allow create: if docId == "config" && inboundMinter(companyId)
        && docData().keys().hasOnly(["companyId", "address", "localPart", "domain", "createdBy", "createdAt"])
        && docData().companyId == companyId
        && inboundLocalOk(companyId, docData().localPart)
        && docData().domain == "inbound.callupapp.com.au"
        && docData().address == docData().localPart + "@inbound.callupapp.com.au"
        && docData().createdBy == request.auth.uid
        && docData().createdAt == request.time;
      allow update, delete: if false;
    }
    match /companies/{companyId}/inboundMail/{messageId} {
      allow get: if inboundOffice(companyId) && prevData().companyId == companyId;
      allow list: if inboundOffice(companyId) && prevData().companyId == companyId;
      allow update: if resource != null
        && inboundOffice(companyId)
        && prevData().companyId == companyId
        && prevData().kind == "verification"
        && docData().diff(prevData()).affectedKeys().hasOnly(["dismissed", "dismissedAt"])
        && docData().dismissed == true
        && docData().dismissedAt == request.time;
      allow create, delete: if false;
    }
    match /companies/{companyId}/jobDrafts/{draftId} {
      function draftTextOk(d) {
        return textMax(d.client, 120)
          &&textMax(d.address, 200)
          &&textMax(d.notes, 800)
          &&textMax(d.description, 800)
          &&textMax(d.po, 40)
          &&textMax(d.type, 40)
          && (!("date" in d) || d.date == "" || d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && (!("supervisorName" in d) || (textMax(d.supervisorName, 80)))
          && (!("supervisorEmail" in d) || (textMax(d.supervisorEmail, 120)))
          && (!("supervisorPhone" in d) || (textMax(d.supervisorPhone, 40)));
      }
      allow get: if inboundOffice(companyId) && prevData().companyId == companyId;
      allow list: if inboundOffice(companyId) && prevData().companyId == companyId;
      allow update: if resource != null
        && inboundOffice(companyId)
        && prevData().companyId == companyId
        && docData().companyId == companyId
        && prevData().status == "pending"
        && prevData().source == "inbound-forward"
        && docData().messageId == prevData().messageId
        && inboundMoneyFree(docData())
        && (
          (docData().status == "pending"
            && docData().diff(prevData()).affectedKeys().hasOnly(["client", "address", "lot", "street", "suburb", "type", "typeLabel", "costCode", "date", "po", "description", "notes", "supervisorName", "supervisorEmail", "supervisorPhone", "updatedAt"])
            && draftTextOk(docData()))
          || (docData().status == "approved"
            && docData().diff(prevData()).affectedKeys().hasOnly(["client", "address", "lot", "street", "suburb", "type", "typeLabel", "costCode", "date", "po", "description", "notes", "supervisorName", "supervisorEmail", "supervisorPhone", "updatedAt", "status", "jobId", "approvedBy", "approvedAt"])
            && draftTextOk(docData())
            && docData().get("jobId", "") is string
            && docData().get("jobId", "").matches('^fwd[A-Za-z0-9]{8,40}$')
            && docData().approvedBy == request.auth.uid
            && docData().approvedAt == request.time)
          || (docData().status == "discarded"
            && docData().diff(prevData()).affectedKeys().hasOnly(["status", "discardedBy", "discardedAt"])
            && docData().discardedBy == request.auth.uid
            && docData().discardedAt == request.time)
        );
      allow create, delete: if false;
    }
    match /inboundRoutes/{localPart} {
      allow read: if false;
      allow create: if signedIn()
        && inboundMinter(docData().companyId)
        && docData().keys().hasOnly(["companyId", "address", "createdBy", "createdAt"])
        && inboundLocalOk(docData().companyId, localPart)
        && docData().address == localPart + "@inbound.callupapp.com.au"
        && docData().createdBy == request.auth.uid
        && docData().createdAt == request.time;
      allow update, delete: if false;
    }
    match /inboundSeen/{id} {
      allow read, write: if false;
    }
// END INBOUND FORWARD RULES
  }
}
