rules_version = '2';
// EMULATOR MODEL ONLY. Do not deploy.
// The live Firestore rules are not in this repository. Deploying this file
// would replace jobs, quotes, photos-email and receipt rules.
// These rules cover only the checks this branch adds: tenant fields cannot be
// self-served, Xero queue items stay on the existing Heartwood finance UIDs,
// and the CHAT block below (also cloud/production/firestore.chat.rules) is the
// piece to merge into the live rules. Do not deploy this whole file.
// CallUp Base does not use xeroQueue. Heartwood's current app still does.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAlex() { return signedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function isPatrick() { return signedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function isHeartwoodFinance() { return isAlex() || isPatrick(); }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return exists(userPath()); }
    function profile() { return get(userPath()).data; }
    function isAppAdmin() {
      return isAlex() || isPatrick() || (hasProfile() && profile().role == "admin");
    }

    function same(key) {
      return (!(key in request.resource.data) && !(key in resource.data))
        || ((key in request.resource.data) && (key in resource.data) && request.resource.data[key] == resource.data[key]);
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAppAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(["tenantId", "role", "customerIds", "finance"]);
      allow update: if signedIn() && request.auth.uid == uid
        && same("tenantId") && same("role") && same("customerIds") && same("finance");
      allow delete: if false;
    }

    match /xeroQueue/{id} {
      allow read: if isHeartwoodFinance();
      allow create: if isHeartwoodFinance()
        && request.resource.data.status == "queued"
        && request.resource.data.by == request.auth.uid
        && (!("tenantId" in request.resource.data) || request.resource.data.tenantId == "heartwood");
      allow update, delete: if false;
    }

    match /tenants/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /jobs/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /receipts/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

// BEGIN CHAT RULES
    function chatSignedIn() { return request.auth != null; }
    function chatIsAlex() { return chatSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function chatIsPatrick() { return chatSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function chatUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function chatHasProfile() { return chatSignedIn() && exists(chatUserPath()); }
    function chatProfile() { return get(chatUserPath()).data; }
    function chatExplicitTenant() {
      return chatHasProfile() && "tenantId" in chatProfile() && chatProfile().tenantId is string && chatProfile().tenantId.size() > 0;
    }
    function chatCallerTenant() {
      return chatExplicitTenant()
        ? chatProfile().tenantId
        : ((chatHasProfile() || chatIsAlex() || chatIsPatrick()) ? "heartwood" : "");
    }
    function chatMember(tenantId) {
      return chatSignedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && chatCallerTenant() == tenantId;
    }
    function chatJobPath(jobId) { return /databases/$(database)/documents/jobs/$(jobId); }
    function chatJob(jobId) { return get(chatJobPath(jobId)).data; }
    function chatJobTenant(jobId) {
      return "tenantId" in chatJob(jobId) && chatJob(jobId).tenantId is string && chatJob(jobId).tenantId.size() > 0
        ? chatJob(jobId).tenantId
        : "heartwood";
    }
    function chatAccountTenant() {
      return chatExplicitTenant() ? chatProfile().tenantId : "heartwood";
    }
    function chatAssigned(jobId) {
      return "assigned" in chatJob(jobId) && chatJob(jobId).assigned is list && request.auth.uid in chatJob(jobId).assigned;
    }
    function chatCustomerOk(jobId) {
      return !chatHasProfile()
        || !("customerIds" in chatProfile())
        || !(chatProfile().customerIds is list)
        || chatProfile().customerIds.size() == 0
        || ("client" in chatJob(jobId) && chatJob(jobId).client is string && chatJob(jobId).client in chatProfile().customerIds);
    }
    function chatAccountCanSee(tenantId, jobId) {
      return chatHasProfile()
        && chatAccountTenant() == tenantId
        && (("role" in chatProfile() && chatProfile().role == "admin") || chatAssigned(jobId))
        && chatCustomerOk(jobId);
    }
    function chatCanSeeJob(tenantId, jobId) {
      return chatSignedIn()
        && jobId is string
        && jobId.size() > 0
        && jobId.size() <= 200
        && chatJobTenant(jobId) == tenantId
        && ((tenantId == "heartwood" && (chatIsAlex() || chatIsPatrick())) || chatAccountCanSee(tenantId, jobId));
    }
    function chatThreadOk(threadId) {
      return threadId == "staff"
        || (threadId is string && threadId.size() <= 210 && threadId.matches('^job_[A-Za-z0-9_-]{1,200}$'));
    }
    function chatJobId(threadId) { return threadId[4:threadId.size()]; }
    function chatCanAccess(tenantId, threadId) {
      return chatThreadOk(threadId) && (
        threadId == "staff"
          ? chatMember(tenantId)
          : chatCanSeeJob(tenantId, chatJobId(threadId))
      );
    }
    function chatAdmin(tenantId) {
      return chatMember(tenantId) && (
        chatIsAlex() || chatIsPatrick() || (chatHasProfile() && "role" in chatProfile() && chatProfile().role == "admin")
      );
    }
    function chatHasPhoto() { return "photoPath" in request.resource.data; }
    function chatPhotoPathOk(tenantId, threadId) {
      return threadId == "staff"
        ? request.resource.data.photoPath.matches('^tenants/' + tenantId + '/chat/staff/photos/c[A-Za-z0-9]{8,40}$')
        : request.resource.data.photoPath.matches('^tenants/' + tenantId + '/chat/jobs/' + chatJobId(threadId) + '/photos/c[A-Za-z0-9]{8,40}$');
    }
    function chatMessageOk(tenantId, threadId) {
      return request.resource.data.keys().hasOnly(["senderUid", "senderName", "text", "createdAt", "photoPath", "photoType"])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.createdAt == request.time
        && (request.resource.data.text.size() > 0 || chatHasPhoto())
        && (!chatHasPhoto() || (
          request.resource.data.photoPath is string
          && request.resource.data.photoPath.size() > 0
          && request.resource.data.photoPath.size() <= 300
          && request.resource.data.photoType is string
          && request.resource.data.photoType.matches('^image/(jpeg|png|webp|gif)$')
          && chatPhotoPathOk(tenantId, threadId)
        ))
        && (chatHasPhoto() || !("photoType" in request.resource.data));
    }
    function chatHeadOk() {
      return request.resource.data.keys().hasOnly(["lastAt", "lastSenderUid", "lastSenderName", "preview"])
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastSenderName is string
        && request.resource.data.lastSenderName.size() > 0
        && request.resource.data.lastSenderName.size() <= 80
        && request.resource.data.preview is string
        && request.resource.data.preview.size() <= 140;
    }

    match /tenants/{tenantId}/chats/{threadId} {
      allow read: if chatCanAccess(tenantId, threadId);
      allow create, update: if chatCanAccess(tenantId, threadId) && chatHeadOk();
      allow delete: if false;
    }

    match /tenants/{tenantId}/chats/{threadId}/messages/{messageId} {
      allow read: if chatCanAccess(tenantId, threadId);
      allow create: if chatCanAccess(tenantId, threadId) && chatMessageOk(tenantId, threadId);
      allow update: if false;
      allow delete: if chatCanAccess(tenantId, threadId)
        && (resource.data.senderUid == request.auth.uid || chatAdmin(tenantId));
    }

    match /tenants/{tenantId}/chatSeen/{uid}/threads/{threadId} {
      allow read: if chatSignedIn() && request.auth.uid == uid && chatCanAccess(tenantId, threadId);
      allow create, update: if chatSignedIn()
        && request.auth.uid == uid
        && chatCanAccess(tenantId, threadId)
        && request.resource.data.keys().hasOnly(["seenAt"])
        && request.resource.data.seenAt == request.time;
      allow delete: if false;
    }
// END CHAT RULES
// BEGIN TIMESHEET RULES
    function tsHeartwoodAdmin() {
      return isAlex() || isPatrick() || (
        hasProfile() && profile().role == "admin"
        && (!("tenantId" in profile()) || profile().tenantId == "heartwood")
      );
    }
    function tsMine(id) {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.weekStart is string
        && request.resource.data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == request.auth.uid + "_" + request.resource.data.weekStart;
    }
    function tsDocOk() {
      return request.resource.data.keys().hasOnly(["uid", "name", "weekStart", "weekEnd", "days", "entries", "totalHrs", "updatedAt", "updatedAtIso", "lastEntryId", "locationConsentAt", "sent", "sentAt", "sentBy"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.weekEnd is string
        && request.resource.data.weekEnd >= request.resource.data.weekStart
        && request.resource.data.days is map
        && request.resource.data.days.size() <= 7
        && request.resource.data.totalHrs is number
        && request.resource.data.totalHrs >= 0
        && request.resource.data.totalHrs <= 400
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedAtIso is string
        && request.resource.data.updatedAtIso.size() <= 40;
    }
    function tsFix(m) {
      return m.keys().hasOnly(["at", "fix", "lat", "lng", "accuracy"])
        && m.at == request.time
        && ((m.fix == "no location" && m.keys().hasOnly(["at", "fix"]))
          || (m.fix == "gps" && m.lat is number && m.lat >= -90 && m.lat <= 90
            && m.lng is number && m.lng >= -180 && m.lng <= 180
            && m.accuracy is number && m.accuracy >= 0 && m.accuracy <= 100000));
    }
    function tsFixSame(b, a, k) {
      return a.source == "manual" ? !(k in a)
        : ((!(k in a) && !(k in b)) || ((k in a) && (k in b) && a[k] == b[k]) || ((k in a) && !(k in b) && tsFix(a[k])));
    }
    function tsEntryCore(e) {
      return e.keys().hasOnly(["id", "source", "status", "date", "start", "finish", "breakStart", "breakEnd", "note", "job", "clockOn", "clockOff", "breakOn", "breakOff", "enteredBy", "enteredByName", "enteredAt", "edits", "lastEditId", "machineChoice", "machineId", "machineName"])
        && e.id == request.resource.data.lastEntryId
        && e.id.matches('^[a-z0-9]{8,24}$')
        && (e.source == "clock" || e.source == "manual")
        && e.enteredBy == request.auth.uid
        && e.enteredByName is string && e.enteredByName.size() > 0 && e.enteredByName.size() <= 80
        && e.enteredAt is timestamp
        && e.edits is map
        && e.note is string && e.note.size() <= 200
        && e.job is string && e.job.size() <= 200
        && e.date is string && e.date.size() == 10
        && e.start is string && e.start.size() <= 5
        && e.finish is string && e.finish.size() <= 5
        && ((e.source == "clock" && "clockOn" in e) || (e.source == "manual" && !e.keys().hasAny(["clockOn", "clockOff", "breakOn", "breakOff"])));
    }
    function tsEntryNew(e) {
      return tsEntryCore(e) && e.enteredAt == request.time && e.edits.size() == 0 && e.lastEditId == ""
        && tsFixSame({}, e, "clockOn") && tsFixSame({}, e, "clockOff") && tsFixSame({}, e, "breakOn") && tsFixSame({}, e, "breakOff");
    }
    function tsEditOk(b, a) {
      return a.edits.diff(b.edits).removedKeys().size() == 0
        && a.edits.diff(b.edits).changedKeys().size() == 0
        && (a.edits.diff(b.edits).addedKeys().size() == 0
          || (a.edits.diff(b.edits).addedKeys().hasOnly([a.lastEditId])
            && a.edits[a.lastEditId].at == request.time
            && a.edits[a.lastEditId].by == request.auth.uid
            && a.edits[a.lastEditId].byName is string
            && a.edits[a.lastEditId].summary is string
            && a.edits[a.lastEditId].summary.size() > 0
            && a.edits[a.lastEditId].summary.size() <= 200));
    }
    function tsMachineLock(b, a) {
      return (!("machineChoice" in a) && !("machineChoice" in b))
        || ("machineChoice" in b && a.machineChoice == b.machineChoice && a.get("machineId", "") == b.get("machineId", "") && a.get("machineName", "") == b.get("machineName", ""))
        || (!("machineChoice" in b) && (
          ((a.machineChoice == "none" || a.machineChoice == "skip") && a.machineId == "" && a.machineName is string && a.machineName.size() <= 80)
          || (a.machineChoice == "asset" && a.machineId.matches('^[A-Za-z0-9_-]{1,80}$') && a.machineName is string && a.machineName.size() > 0 && a.machineName.size() <= 80)
        ));
    }
    function tsEntryNext(b, a) {
      return tsEntryCore(a) && a.source == b.source && a.enteredBy == b.enteredBy && a.enteredAt == b.enteredAt && a.id == b.id
        && tsFixSame(b, a, "clockOn") && tsFixSame(b, a, "clockOff") && tsFixSame(b, a, "breakOn") && tsFixSame(b, a, "breakOff")
        && tsMachineLock(b, a)
        && tsEditOk(b, a);
    }
    function tsFleetReader(tenantId) {
      return signedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && (
          ((isAlex() || isPatrick()) && tenantId == "heartwood")
          || (hasProfile() && (
            ("tenantId" in profile() && profile().tenantId == tenantId)
            || (!("tenantId" in profile()) && tenantId == "heartwood")
          ))
        );
    }
    function tsOneEntry() {
      return request.resource.data.entries is map
        && request.resource.data.entries.size() <= 40
        && request.resource.data.lastEntryId is string
        && request.resource.data.entries.diff(resource.data.get("entries", {})).removedKeys().size() == 0
        && request.resource.data.entries.diff(resource.data.get("entries", {})).affectedKeys().size() == 1
        && request.resource.data.entries.diff(resource.data.get("entries", {})).affectedKeys().hasOnly([request.resource.data.lastEntryId])
        && (
          (request.resource.data.lastEntryId in resource.data.get("entries", {})
            && tsEntryNext(resource.data.entries[request.resource.data.lastEntryId], request.resource.data.entries[request.resource.data.lastEntryId]))
          || (!(request.resource.data.lastEntryId in resource.data.get("entries", {}))
            && tsEntryNew(request.resource.data.entries[request.resource.data.lastEntryId]))
        );
    }
    function tsWorkerCreate(id) {
      return tsMine(id) && tsDocOk()
        && !("sent" in request.resource.data) && !("sentAt" in request.resource.data) && !("sentBy" in request.resource.data)
        && (!("locationConsentAt" in request.resource.data) || request.resource.data.locationConsentAt == request.time)
        && (!("entries" in request.resource.data)
          || (request.resource.data.entries.size() == 1
            && request.resource.data.lastEntryId in request.resource.data.entries
            && tsEntryNew(request.resource.data.entries[request.resource.data.lastEntryId])));
    }
    function tsWorkerUpdate(id) {
      return tsMine(id) && tsDocOk()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.weekStart == resource.data.weekStart
        && same("sent") && same("sentAt") && same("sentBy")
        && (!("locationConsentAt" in resource.data) && !("locationConsentAt" in request.resource.data)
          || !("locationConsentAt" in resource.data) && request.resource.data.locationConsentAt == request.time
          || request.resource.data.get("locationConsentAt", null) == resource.data.get("locationConsentAt", null))
        && (request.resource.data.get("entries", {}) == resource.data.get("entries", {}) || tsOneEntry());
    }
    function tsSentUpdate() {
      return tsHeartwoodAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sent", "sentAt", "sentBy"])
        && request.resource.data.sent is bool
        && (request.resource.data.get("sentAt", null) == null || request.resource.data.sentAt is string)
        && (request.resource.data.get("sentBy", null) == null || request.resource.data.sentBy == request.auth.uid);
    }

    match /timesheets/{id} {
      allow read: if signedIn() && (
        tsHeartwoodAdmin()
        || (resource == null && id.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        || (resource != null && resource.data.uid == request.auth.uid)
      );
      allow create: if tsWorkerCreate(id);
      allow update: if tsWorkerUpdate(id) || tsSentUpdate();
      allow delete: if false;
    }

    // Read-only mirror so clock-on can list machines and today's prestart.
    // Creates and edits stay with the compliance PR. allow write: if false does not veto those rules.
    match /tenants/{tenantId}/fleet/{assetId} {
      allow read: if tsFleetReader(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/prestarts/{id} {
      allow read: if tsFleetReader(tenantId);
      allow write: if false;
    }
// END TIMESHEET RULES
  }
}
