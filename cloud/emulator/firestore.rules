rules_version = '2';
// EMULATOR MODEL ONLY. Do not deploy.
// The live Firestore rules are not in this repository. Deploying this file
// would replace jobs, quotes, photos-email and receipt rules.
// These rules cover only the checks this branch adds: tenant fields cannot be
// self-served, Xero queue items stay on the existing Heartwood finance UIDs,
// the INVITE block (also cloud/production/firestore.invites.rules), the
// CHAT block (also cloud/production/firestore.chat.rules), the FLEET block
// (cloud/production/firestore.fleet.rules), the SERVICING block
// (cloud/production/firestore.servicing.rules), the PRESTART block
// (cloud/production/firestore.prestart.rules), the SWMS SIGNATURE and
// RUN SHEET blocks (cloud/production/firestore.swms.rules and
// firestore.runsheets.rules), the TIMESHEET block
// (cloud/production/firestore.timesheet.rules), the LEAVE block
// (cloud/production/firestore.leave.rules), the REIMBURSEMENT block
// (cloud/production/firestore.reimbursements.rules), the HOURS EXPORT block
// (cloud/production/firestore.hours-export.rules), the INBOX IMPORT block
// (cloud/production/firestore.inbox.rules), and the JOB CHECK block
// (cloud/production/firestore.job-checks.rules). Paste those blocks into the live rules.
// Do not deploy this whole file.
// CallUp Base does not use xeroQueue. Heartwood's current app still does.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAlex() { return signedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function isPatrick() { return signedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function isHeartwoodFinance() { return isAlex() || isPatrick(); }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return exists(userPath()); }
    function profile() { return get(userPath()).data; }
    function isAppAdmin() {
      return isAlex() || isPatrick() || (hasProfile() && profile().role == "admin" && callerCompany() == "heartwood");
    }

    // Platform owner is Alex's verified mailbox, plus either his bootstrap uid
    // or a custom claim platformOwner=true. A company admin cannot set this.
    function platformOwner() {
      return signedIn()
        && "email_verified" in request.auth.token
        && request.auth.token.email_verified == true
        && "email" in request.auth.token
        && request.auth.token.email == "alex@heartwoodew.com"
        && (("platformOwner" in request.auth.token && request.auth.token.platformOwner == true) || isAlex());
    }
    function docCompany(data) {
      return ("companyId" in data && data.companyId is string && data.companyId.size() > 0)
        ? data.companyId
        : (("tenantId" in data && data.tenantId is string && data.tenantId.size() > 0)
          ? data.tenantId
          : "heartwood");
    }
    function sessionPath() { return /databases/$(database)/documents/platformSessions/$(request.auth.uid); }
    function sessionCompany() {
      let id = platformOwner() && exists(sessionPath()) ? get(sessionPath()).data.get("companyId", "") : "";
      return id is string && id.size() > 1
        && exists(/databases/$(database)/documents/companies/$(id))
        && get(/databases/$(database)/documents/companies/$(id)).data.isTest == true
        && get(/databases/$(database)/documents/companies/$(id)).data.status == "active"
        ? id : "";
    }
    function callerCompany() {
      let session = sessionCompany();
      return session != "" ? session
        : (isAlex() || isPatrick())
        ? "heartwood"
        : (hasProfile() && "companyId" in profile() && profile().companyId is string && profile().companyId.size() > 0
          ? profile().companyId
          : (hasProfile() && "tenantId" in profile() && profile().tenantId is string && profile().tenantId.size() > 0
            ? profile().tenantId
            : (hasProfile() ? "heartwood" : "")));
    }
    function companyIdOk(id) {
      return id is string && id.size() >= 2 && id.size() <= 40 && id.matches('^[a-z0-9][a-z0-9-]{0,39}$');
    }
    function companyDetailText(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.legalName is string && data.legalName.size() > 0 && data.legalName.size() <= 120
        && data.abn is string && data.abn.size() > 0 && data.abn.size() <= 20
        && data.signoff is string && data.signoff.size() <= 80
        && data.logoUrl is string && data.logoUrl.size() <= 300
        && data.address is string && data.address.size() > 0 && data.address.size() <= 160
        && data.phone is string && data.phone.size() <= 40
        && data.email is string && data.email.size() >= 6 && data.email.size() <= 120
        && data.accountsEmail is string && data.accountsEmail.size() >= 6 && data.accountsEmail.size() <= 120
        && data.hubdocAddress is string && data.hubdocAddress.size() <= 120
        && (data.hubdocAddress == "" || data.hubdocAddress.matches('^[a-z0-9._+-]+@app[.]hubdoc[.]com$'));
    }
    function companyBillingLocked(data) {
      return data.billing is map
        && data.billing.keys().hasOnly(["provider", "status", "stripeCustomerId", "stripeSubscriptionId"])
        && data.billing.provider == null
        && data.billing.status == "not-configured"
        && data.billing.stripeCustomerId == null
        && data.billing.stripeSubscriptionId == null;
    }
    function companyOwnerCreate(companyId) {
      let d = request.resource.data;
      return signedIn()
        && !isAlex() && !isPatrick()
        && !hasProfile()
        && companyIdOk(companyId)
        && companyId != "heartwood"
        && d.keys().hasOnly(["name", "legalName", "abn", "signoff", "logoUrl", "address", "phone", "email", "accountsEmail", "hubdocAddress", "ownerUid", "createdBy", "status", "plan", "origin", "isTest", "signedUpAt", "trialEndsAt", "staffCount", "jobCount", "lastActivityAt", "billing"])
        && companyDetailText(d)
        && d.ownerUid == request.auth.uid
        && d.createdBy == request.auth.uid
        && d.status == "active"
        && d.plan == "trial"
        && d.isTest == false
        && d.origin == "signup"
        && d.signedUpAt == request.time
        && d.trialEndsAt > request.time + duration.value(13, 'd')
        && d.trialEndsAt < request.time + duration.value(15, 'd')
        && d.staffCount == 1
        && d.jobCount == 0
        && d.lastActivityAt == request.time
        && companyBillingLocked(d)
        && !d.keys().hasAny(["platformOwner", "finance"]);
    }
    function companyAdminEdit(companyId) {
      let next = request.resource.data;
      let diff = next.diff(resource.data).affectedKeys();
      return signedIn()
        && companyId == callerCompany()
        && (isAlex() || isPatrick() || (hasProfile() && profile().role == "admin"))
        && diff.hasOnly(["name", "legalName", "abn", "signoff", "logoUrl", "address", "phone", "email", "accountsEmail", "hubdocAddress"])
        && companyDetailText(next)
        && next.status == resource.data.status
        && next.plan == resource.data.plan
        && next.billing == resource.data.billing
        && next.ownerUid == resource.data.ownerUid
        && next.staffCount == resource.data.staffCount
        && next.jobCount == resource.data.jobCount
        && next.origin == resource.data.origin
        && next.get("isTest", false) == resource.data.get("isTest", false)
        && next.get("plan", "trial") == resource.data.get("plan", "trial")
        && next.get("friendEndsAt", null) == resource.data.get("friendEndsAt", null);
    }
    function testCompanyCreate(companyId) {
      let d = request.resource.data;
      return platformOwner()
        && companyIdOk(companyId)
        && companyId != "heartwood"
        && d.keys().hasOnly(["name", "legalName", "abn", "signoff", "logoUrl", "address", "phone", "email", "accountsEmail", "hubdocAddress", "ownerUid", "createdBy", "status", "plan", "origin", "isTest", "demoData", "signedUpAt", "trialEndsAt", "staffCount", "jobCount", "lastActivityAt", "billing"])
        && companyDetailText(d)
        && d.isTest == true
        && d.plan == "trial"
        && d.origin == "test"
        && d.status == "active"
        && d.demoData is bool
        && d.ownerUid == request.auth.uid
        && d.createdBy == request.auth.uid
        && d.signedUpAt == request.time
        && d.trialEndsAt == null
        && d.lastActivityAt == request.time
        && companyBillingLocked(d)
        && (d.demoData == true ? (d.staffCount == 2 && d.jobCount == 2) : (d.staffCount == 0 && d.jobCount == 0));
    }
    function friendInvitePath(code) { return /databases/$(database)/documents/friendInvites/$(code); }
    function friendCompanyCreate(companyId) {
      let d = request.resource.data;
      return signedIn()
        && !isAlex() && !isPatrick()
        && !hasProfile()
        && companyIdOk(companyId)
        && companyId != "heartwood"
        && d.keys().hasOnly(["name", "legalName", "abn", "signoff", "logoUrl", "address", "phone", "email", "accountsEmail", "hubdocAddress", "ownerUid", "createdBy", "status", "plan", "origin", "isTest", "demoData", "friendInvite", "friendEndsAt", "signedUpAt", "trialEndsAt", "staffCount", "jobCount", "lastActivityAt", "billing"])
        && companyDetailText(d)
        && d.plan == "friend"
        && d.isTest == false
        && d.demoData == false
        && d.origin == "friend"
        && d.status == "active"
        && d.friendInvite is string
        && d.friendInvite == d.friendInvite
        && exists(friendInvitePath(d.friendInvite))
        && get(friendInvitePath(d.friendInvite)).data.status == "pending"
        && existsAfter(friendInvitePath(d.friendInvite))
        && getAfter(friendInvitePath(d.friendInvite)).data.status == "used"
        && getAfter(friendInvitePath(d.friendInvite)).data.usedBy == request.auth.uid
        && getAfter(friendInvitePath(d.friendInvite)).data.companyId == companyId
        && d.ownerUid == request.auth.uid
        && d.friendEndsAt == null
        && d.trialEndsAt == null
        && d.signedUpAt == request.time
        && d.lastActivityAt == request.time
        && d.staffCount == 1
        && d.jobCount == 0
        && companyBillingLocked(d);
    }
    function ownerPlanEdit(companyId) {
      let next = request.resource.data;
      return platformOwner()
        && resource.data.get("isTest", false) != true
        && next.get("isTest", false) == resource.data.get("isTest", false)
        && next.diff(resource.data).affectedKeys().hasOnly(["plan", "friendEndsAt", "trialEndsAt"])
        && next.plan in ["friend", "trial", "paid"]
        && next.billing == resource.data.billing
        && next.status == resource.data.status
        && (next.friendEndsAt == null || next.friendEndsAt is timestamp)
        && (next.plan != "trial" || (
          next.trialEndsAt > request.time + duration.value(13, 'd')
          && next.trialEndsAt < request.time + duration.value(15, 'd')
        ));
    }
    function testArchive(companyId) {
      let next = request.resource.data;
      return platformOwner()
        && resource.data.isTest == true
        && resource.data.status == "active"
        && next.diff(resource.data).affectedKeys().hasOnly(["status", "archivedAt"])
        && next.status == "archived"
        && next.archivedAt == request.time
        && next.isTest == true
        && next.plan == resource.data.plan
        && next.billing == resource.data.billing;
    }
    function testDemoCounts(companyId) {
      let next = request.resource.data;
      return platformOwner()
        && resource.data.isTest == true
        && resource.data.status == "active"
        && next.diff(resource.data).affectedKeys().hasOnly(["demoData", "staffCount", "jobCount", "lastActivityAt"])
        && next.demoData == true
        && next.staffCount == 2
        && next.jobCount == 2
        && next.lastActivityAt == request.time;
    }
    function companyStatsBump(companyId) {
      let next = request.resource.data;
      return signedIn()
        && companyId == callerCompany()
        && hasProfile()
        && next.diff(resource.data).affectedKeys().hasOnly(["staffCount", "jobCount", "lastActivityAt"])
        && next.staffCount is int && next.jobCount is int
        && next.staffCount >= resource.data.staffCount && next.staffCount <= resource.data.staffCount + 1
        && next.jobCount >= resource.data.jobCount && next.jobCount <= resource.data.jobCount + 1
        && next.lastActivityAt == request.time;
    }
    function ownerProfileCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(["name", "email", "role", "companyId", "tenantId"])
        && d.role == "admin"
        && companyIdOk(d.companyId)
        && d.companyId != "heartwood"
        && d.tenantId == d.companyId
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.email is string && d.email.size() <= 120
        && exists(/databases/$(database)/documents/companies/$(d.companyId))
        && get(/databases/$(database)/documents/companies/$(d.companyId)).data.ownerUid == request.auth.uid
        && !d.keys().hasAny(["platformOwner", "finance", "customerIds"]);
    }

    function same(key) {
      return (!(key in request.resource.data) && !(key in resource.data))
        || ((key in request.resource.data) && (key in resource.data) && request.resource.data[key] == resource.data[key]);
    }
    match /users/{uid} {
      allow get: if signedIn() && (
        request.auth.uid == uid
        || platformOwner()
        || (callerCompany() != "" && docCompany(resource.data) == callerCompany()
          && (isAlex() || isPatrick() || (hasProfile() && (profile().role == "admin" || profile().role == "supervisor"))))
      );
      allow list: if platformOwner();
      allow list: if signedIn() && callerCompany() != ""
        && resource.data.companyId == callerCompany()
        && (isAlex() || isPatrick() || (hasProfile() && (profile().role == "admin" || profile().role == "supervisor")));
      allow create: if signedIn() && request.auth.uid == uid && (
        (!request.resource.data.keys().hasAny(["tenantId", "role", "customerIds", "finance", "platformOwner", "companyId"]))
        || ownerProfileCreate()
      );
      allow create, update: if platformOwner()
        && uid.matches('^demo-[a-z0-9-]{1,80}$')
        && request.resource.data.keys().hasOnly(["name", "role", "companyId", "tenantId", "demo", "email"])
        && request.resource.data.demo == true
        && request.resource.data.role in ["operator", "supervisor"]
        && request.resource.data.companyId is string
        && request.resource.data.tenantId == request.resource.data.companyId
        && exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
        && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.isTest == true
        && !request.resource.data.keys().hasAny(["platformOwner", "finance", "isTest"]);
      allow update: if signedIn() && request.auth.uid == uid
        && same("tenantId") && same("role") && same("customerIds") && same("finance")
        && same("companyId") && same("platformOwner");
      allow delete: if false;
    }

    match /xeroQueue/{id} {
      allow read: if isHeartwoodFinance();
      allow create: if isHeartwoodFinance()
        && callerCompany() == "heartwood"
        && request.resource.data.status == "queued"
        && request.resource.data.by == request.auth.uid
        && (!("tenantId" in request.resource.data) || request.resource.data.tenantId == "heartwood")
        && request.resource.data.get("isTest", false) != true;
      allow update, delete: if false;
    }

    match /tenants/{id} {
      allow get: if signedIn() && (id == callerCompany() || platformOwner());
      allow list: if platformOwner();
      allow write: if false;
    }

    // Reads are company-scoped. Writes stay closed in this emulator model:
    // the live jobs and receipts rules are not in this file. Do not deploy it.
    function demoJobWrite(id) {
      let d = request.resource.data;
      return platformOwner()
        && id.matches('^demo-[a-z0-9-]{1,80}$')
        && d.demo == true
        && d.companyId is string
        && d.tenantId == d.companyId
        && exists(/databases/$(database)/documents/companies/$(d.companyId))
        && get(/databases/$(database)/documents/companies/$(d.companyId)).data.isTest == true
        && d.keys().hasOnly(["client", "address", "type", "description", "date", "time", "status", "companyId", "tenantId", "demo", "assigned", "assignedNames"])
        && d.client is string && d.client.size() <= 80
        && d.address is string && d.address.size() <= 160
        && d.description is string && d.description.size() <= 400
        && !d.keys().hasAny(["invoiceAmount", "invoiceNo", "amountInc", "quoteAmount"]);
    }
    match /jobs/{id} {
      allow get: if signedIn() && callerCompany() != "" && docCompany(resource.data) == callerCompany();
      allow list: if signedIn() && callerCompany() != "" && resource.data.companyId == callerCompany();
      allow write: if false;
      allow create, update: if demoJobWrite(id);
    }
    match /receipts/{id} {
      allow get: if signedIn() && callerCompany() != "" && docCompany(resource.data) == callerCompany();
      allow list: if signedIn() && callerCompany() != "" && resource.data.companyId == callerCompany();
      allow write: if false;
    }

// BEGIN COMPANY RULES
    match /companies/{companyId} {
      allow get: if platformOwner() || (signedIn() && callerCompany() == companyId);
      allow list: if platformOwner();
      allow create: if companyOwnerCreate(companyId) || testCompanyCreate(companyId) || friendCompanyCreate(companyId);
      allow update: if ownerPlanEdit(companyId) || testArchive(companyId) || testDemoCounts(companyId) || companyAdminEdit(companyId) || companyStatsBump(companyId);
      allow delete: if false;
    }
// END COMPANY RULES

    match /platformSessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if platformOwner() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["companyId"])
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() <= 40
        && (request.resource.data.companyId == ""
          || (exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
            && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.isTest == true
            && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.status == "active"));
      allow delete: if false;
    }

    function friendCodeOk(code) { return code.matches('^[a-z0-9]{8}$'); }
    match /friendInvites/{code} {
      allow get: if platformOwner()
        || (signedIn() && resource.data.status == "pending")
        || (signedIn() && resource.data.usedBy == request.auth.uid);
      allow list: if platformOwner();
      allow create: if platformOwner()
        && friendCodeOk(code)
        && request.resource.data.keys().hasOnly(["status", "createdBy", "createdAt", "note"])
        && request.resource.data.status == "pending"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 80;
      allow update: if (
          platformOwner()
          && resource.data.status == "pending"
          && request.resource.data.status == "revoked"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "revokedAt"])
          && request.resource.data.revokedAt == request.time
        ) || (
          signedIn()
          && resource.data.status == "pending"
          && request.resource.data.status == "used"
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.companyId is string
          && request.resource.data.usedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "usedBy", "companyId", "usedAt"])
          && existsAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
          && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.plan == "friend"
          && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.friendInvite == code
        );
      allow delete: if false;
    }

    match /testMailLog/{id} {
      allow read: if platformOwner();
      allow create: if platformOwner()
        && sessionCompany() != ""
        && request.resource.data.keys().hasOnly(["kind", "status", "companyId", "preview", "createdAt"])
        && request.resource.data.kind in ["hours", "hubdoc", "xero", "builder"]
        && request.resource.data.status == "preview"
        && request.resource.data.companyId == sessionCompany()
        && request.resource.data.preview is string
        && request.resource.data.preview.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

// BEGIN INVITE RULES
    function inviteSignedIn() { return request.auth != null; }
    function inviteIsAlex() { return inviteSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function inviteIsPatrick() { return inviteSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function inviteUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function inviteHasProfile() { return inviteSignedIn() && exists(inviteUserPath()); }
    function inviteProfile() { return get(inviteUserPath()).data; }
    function inviteAdmin() {
      return inviteIsAlex() || inviteIsPatrick()
        || (inviteHasProfile() && "role" in inviteProfile()
          && (inviteProfile().role == "admin" || inviteProfile().role == "supervisor"));
    }
    function inviteCallerTenant() {
      return inviteIsAlex() || inviteIsPatrick()
        ? "heartwood"
        : (inviteHasProfile() && "companyId" in inviteProfile() && inviteProfile().companyId is string && inviteProfile().companyId.size() > 0
          ? inviteProfile().companyId
          : (inviteHasProfile() && "tenantId" in inviteProfile() && inviteProfile().tenantId is string && inviteProfile().tenantId.size() > 0
          ? inviteProfile().tenantId
          : (inviteHasProfile() ? "heartwood" : "")));
    }
    function inviteEmailOk(email) {
      return email is string
        && email.size() >= 6
        && email.size() <= 120
        && email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
    }
    function inviteRoleOk() {
      return request.resource.data.role == "operator" || request.resource.data.role == "supervisor";
    }
    function inviteSame(key) {
      return (!(key in request.resource.data) && !(key in resource.data))
        || ((key in request.resource.data) && (key in resource.data) && request.resource.data[key] == resource.data[key]);
    }
    function inviteBaseOk() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && !request.resource.data.name.matches('.*[\\n\\r\\t<>].*')
        && inviteEmailOk(request.resource.data.email)
        && inviteRoleOk()
        && request.resource.data.tenantId is string
        && request.resource.data.tenantId == inviteCallerTenant()
        && request.resource.data.tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && (!("companyId" in request.resource.data) || request.resource.data.companyId == request.resource.data.tenantId)
        && request.resource.data.token is string
        && request.resource.data.token.matches('^[A-Za-z0-9_-]{43,128}$')
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() > 0
        && request.resource.data.createdBy.size() <= 128
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp;
    }
    function inviteExpiryWindow() {
      return request.resource.data.expiresAt > request.time + duration.value(6, 'd')
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
    }
    function inviteLockPath(email) { return /databases/$(database)/documents/inviteEmails/$(email); }
    function invitePath(inviteId) { return /databases/$(database)/documents/invites/$(inviteId); }
    function inviteLockFree(email) {
      return !exists(inviteLockPath(email))
        || get(inviteLockPath(email)).data.status != "pending";
    }
    function inviteLockAgrees(email, inviteId) {
      return existsAfter(inviteLockPath(email))
        && getAfter(inviteLockPath(email)).data.keys().hasOnly(["email", "status", "inviteId", "expiresAt", "role", "tenantId"])
        && getAfter(inviteLockPath(email)).data.email == email
        && getAfter(inviteLockPath(email)).data.inviteId == inviteId
        && getAfter(inviteLockPath(email)).data.role == request.resource.data.role
        && getAfter(inviteLockPath(email)).data.tenantId == request.resource.data.tenantId
        && getAfter(inviteLockPath(email)).data.status == request.resource.data.status
        && getAfter(inviteLockPath(email)).data.expiresAt == request.resource.data.expiresAt;
    }
    function inviteCreateOk(inviteId) {
      return inviteAdmin()
        && inviteBaseOk()
        && request.resource.data.keys().hasOnly(["name", "email", "role", "status", "createdBy", "createdAt", "expiresAt", "token", "tenantId", "companyId"])
        && request.resource.data.status == "pending"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && inviteExpiryWindow()
        && inviteLockFree(request.resource.data.email)
        && inviteLockAgrees(request.resource.data.email, inviteId);
    }
    function inviteCancelOk(inviteId) {
      return resource.data.status == "pending"
        && request.resource.data.status == "cancelled"
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelledAt == request.time
        && inviteSame("name") && inviteSame("email") && inviteSame("role") && inviteSame("createdBy")
        && inviteSame("createdAt") && inviteSame("expiresAt") && inviteSame("token") && inviteSame("tenantId")
        && inviteSame("resentAt") && inviteSame("resentBy") && inviteSame("companyId")
        && inviteLockAgrees(request.resource.data.email, inviteId);
    }
    function inviteResendOk(inviteId) {
      return resource.data.status == "pending"
        && request.resource.data.status == "pending"
        && request.resource.data.token != resource.data.token
        && request.resource.data.resentBy == request.auth.uid
        && request.resource.data.resentAt == request.time
        && inviteExpiryWindow()
        && inviteSame("name") && inviteSame("email") && inviteSame("role") && inviteSame("createdBy")
        && inviteSame("createdAt") && inviteSame("tenantId") && inviteSame("companyId")
        && inviteSame("cancelledAt") && inviteSame("cancelledBy")
        && inviteLockAgrees(request.resource.data.email, inviteId);
    }
    function inviteUpdateOk(inviteId) {
      return inviteAdmin()
        && inviteBaseOk()
        && request.resource.data.keys().hasOnly(["name", "email", "role", "status", "createdBy", "createdAt", "expiresAt", "token", "tenantId", "companyId", "cancelledAt", "cancelledBy", "resentAt", "resentBy"])
        && (inviteCancelOk(inviteId) || inviteResendOk(inviteId));
    }

    match /invites/{inviteId} {
      allow get, list: if inviteAdmin() && resource.data.tenantId == inviteCallerTenant();
      allow create: if inviteCreateOk(inviteId);
      allow update: if inviteUpdateOk(inviteId);
      allow delete: if false;
    }

    function inviteLockEmailOk(email) {
      return inviteEmailOk(email)
        && request.resource.data.email == email
        && inviteRoleOk()
        && request.resource.data.tenantId == inviteCallerTenant()
        && request.resource.data.inviteId is string
        && request.resource.data.inviteId.size() > 0
        && request.resource.data.inviteId.size() <= 128
        && request.resource.data.expiresAt is timestamp
        && (request.resource.data.status == "pending" || request.resource.data.status == "cancelled")
        && request.resource.data.keys().hasOnly(["email", "status", "inviteId", "expiresAt", "role", "tenantId"]);
    }
    function inviteLockPointsAtInvite(email) {
      return existsAfter(invitePath(request.resource.data.inviteId))
        && getAfter(invitePath(request.resource.data.inviteId)).data.email == email
        && getAfter(invitePath(request.resource.data.inviteId)).data.role == request.resource.data.role
        && getAfter(invitePath(request.resource.data.inviteId)).data.tenantId == request.resource.data.tenantId
        && getAfter(invitePath(request.resource.data.inviteId)).data.status == request.resource.data.status
        && getAfter(invitePath(request.resource.data.inviteId)).data.expiresAt == request.resource.data.expiresAt;
    }
    function inviteLockWriteOk(email) {
      return (
        !exists(inviteLockPath(email))
        && request.resource.data.status == "pending"
      ) || (
        exists(inviteLockPath(email))
        && get(inviteLockPath(email)).data.status == "pending"
        && get(inviteLockPath(email)).data.inviteId == request.resource.data.inviteId
        && (request.resource.data.status == "pending" || request.resource.data.status == "cancelled")
      ) || (
        exists(inviteLockPath(email))
        && get(inviteLockPath(email)).data.status != "pending"
        && request.resource.data.status == "pending"
      );
    }

    match /inviteEmails/{email} {
      allow get: if inviteAdmin();
      allow list: if false;
      allow create, update: if inviteAdmin()
        && inviteLockEmailOk(email)
        && inviteLockPointsAtInvite(email)
        && inviteLockWriteOk(email);
      allow delete: if false;
    }

    match /inviteMail/{id} {
      allow read, write: if false;
    }
    match /mail/{id} {
      allow read, write: if false;
    }
// END INVITE RULES

// BEGIN CHAT RULES
    function chatSignedIn() { return request.auth != null; }
    function chatIsAlex() { return chatSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function chatIsPatrick() { return chatSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function chatUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function chatHasProfile() { return chatSignedIn() && exists(chatUserPath()); }
    function chatProfile() { return get(chatUserPath()).data; }
    function chatExplicitTenant() {
      return chatHasProfile() && "tenantId" in chatProfile() && chatProfile().tenantId is string && chatProfile().tenantId.size() > 0;
    }
    function chatCallerTenant() {
      return chatExplicitTenant()
        ? chatProfile().tenantId
        : ((chatHasProfile() || chatIsAlex() || chatIsPatrick()) ? "heartwood" : "");
    }
    function chatMember(tenantId) {
      return chatSignedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && chatCallerTenant() == tenantId;
    }
    function chatJobPath(jobId) { return /databases/$(database)/documents/jobs/$(jobId); }
    function chatJob(jobId) { return get(chatJobPath(jobId)).data; }
    function chatJobTenant(jobId) {
      return "tenantId" in chatJob(jobId) && chatJob(jobId).tenantId is string && chatJob(jobId).tenantId.size() > 0
        ? chatJob(jobId).tenantId
        : "heartwood";
    }
    function chatAccountTenant() {
      return chatExplicitTenant() ? chatProfile().tenantId : "heartwood";
    }
    function chatAssigned(jobId) {
      return "assigned" in chatJob(jobId) && chatJob(jobId).assigned is list && request.auth.uid in chatJob(jobId).assigned;
    }
    function chatCustomerOk(jobId) {
      return !chatHasProfile()
        || !("customerIds" in chatProfile())
        || !(chatProfile().customerIds is list)
        || chatProfile().customerIds.size() == 0
        || ("client" in chatJob(jobId) && chatJob(jobId).client is string && chatJob(jobId).client in chatProfile().customerIds);
    }
    function chatAccountCanSee(tenantId, jobId) {
      return chatHasProfile()
        && chatAccountTenant() == tenantId
        && (("role" in chatProfile() && chatProfile().role == "admin") || chatAssigned(jobId))
        && chatCustomerOk(jobId);
    }
    function chatCanSeeJob(tenantId, jobId) {
      return chatSignedIn()
        && jobId is string
        && jobId.size() > 0
        && jobId.size() <= 200
        && chatJobTenant(jobId) == tenantId
        && ((tenantId == "heartwood" && (chatIsAlex() || chatIsPatrick())) || chatAccountCanSee(tenantId, jobId));
    }
    function chatThreadOk(threadId) {
      return threadId == "staff"
        || (threadId is string && threadId.size() <= 210 && threadId.matches('^job_[A-Za-z0-9_-]{1,200}$'));
    }
    function chatJobId(threadId) { return threadId[4:threadId.size()]; }
    function chatCanAccess(tenantId, threadId) {
      return chatThreadOk(threadId) && (
        threadId == "staff"
          ? chatMember(tenantId)
          : chatCanSeeJob(tenantId, chatJobId(threadId))
      );
    }
    function chatAdmin(tenantId) {
      return chatMember(tenantId) && (
        chatIsAlex() || chatIsPatrick() || (chatHasProfile() && "role" in chatProfile() && chatProfile().role == "admin")
      );
    }
    function chatHasPhoto() { return "photoPath" in request.resource.data; }
    function chatPhotoPathOk(tenantId, threadId) {
      return threadId == "staff"
        ? request.resource.data.photoPath.matches('^tenants/' + tenantId + '/chat/staff/photos/c[A-Za-z0-9]{8,40}$')
        : request.resource.data.photoPath.matches('^tenants/' + tenantId + '/chat/jobs/' + chatJobId(threadId) + '/photos/c[A-Za-z0-9]{8,40}$');
    }
    function chatMessageOk(tenantId, threadId) {
      return request.resource.data.keys().hasOnly(["senderUid", "senderName", "text", "createdAt", "photoPath", "photoType"])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.createdAt == request.time
        && (request.resource.data.text.size() > 0 || chatHasPhoto())
        && (!chatHasPhoto() || (
          request.resource.data.photoPath is string
          && request.resource.data.photoPath.size() > 0
          && request.resource.data.photoPath.size() <= 300
          && request.resource.data.photoType is string
          && request.resource.data.photoType.matches('^image/(jpeg|png|webp|gif)$')
          && chatPhotoPathOk(tenantId, threadId)
        ))
        && (chatHasPhoto() || !("photoType" in request.resource.data));
    }
    function chatHeadOk() {
      return request.resource.data.keys().hasOnly(["lastAt", "lastSenderUid", "lastSenderName", "preview"])
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastSenderName is string
        && request.resource.data.lastSenderName.size() > 0
        && request.resource.data.lastSenderName.size() <= 80
        && request.resource.data.preview is string
        && request.resource.data.preview.size() <= 140;
    }

    match /tenants/{tenantId}/chats/{threadId} {
      allow read: if chatCanAccess(tenantId, threadId);
      allow create, update: if chatCanAccess(tenantId, threadId) && chatHeadOk();
      allow delete: if false;
    }

    match /tenants/{tenantId}/chats/{threadId}/messages/{messageId} {
      allow read: if chatCanAccess(tenantId, threadId);
      allow create: if chatCanAccess(tenantId, threadId) && chatMessageOk(tenantId, threadId);
      allow update: if false;
      allow delete: if chatCanAccess(tenantId, threadId)
        && (resource.data.senderUid == request.auth.uid || chatAdmin(tenantId));
    }

    match /tenants/{tenantId}/chatSeen/{uid}/threads/{threadId} {
      allow read: if chatSignedIn() && request.auth.uid == uid && chatCanAccess(tenantId, threadId);
      allow create, update: if chatSignedIn()
        && request.auth.uid == uid
        && chatCanAccess(tenantId, threadId)
        && request.resource.data.keys().hasOnly(["seenAt"])
        && request.resource.data.seenAt == request.time;
      allow delete: if false;
    }
// END CHAT RULES

// BEGIN FLEET RULES
    function fleetSignedIn() { return request.auth != null; }
    function fleetIsAlex() { return fleetSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function fleetIsPatrick() { return fleetSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function fleetUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function fleetHasProfile() { return fleetSignedIn() && exists(fleetUserPath()); }
    function fleetProfile() { return get(fleetUserPath()).data; }
    function fleetExplicitTenant() {
      return fleetHasProfile() && "tenantId" in fleetProfile() && fleetProfile().tenantId is string && fleetProfile().tenantId.size() > 0;
    }
    function fleetCallerTenant() {
      return fleetExplicitTenant()
        ? fleetProfile().tenantId
        : ((fleetHasProfile() || fleetIsAlex() || fleetIsPatrick()) ? "heartwood" : "");
    }
    function fleetMember(tenantId) {
      return fleetSignedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && fleetCallerTenant() == tenantId;
    }
    function fleetAdmin(tenantId) {
      return fleetMember(tenantId) && (
        fleetIsAlex() || fleetIsPatrick() || (fleetHasProfile() && "role" in fleetProfile() && fleetProfile().role == "admin")
      );
    }
    function fleetDateOk(v) {
      return v is string && (v == "" || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function fleetAssetOk() {
      return request.resource.data.keys().hasOnly(["type", "name", "rego", "regoExpiry", "coiRequired", "coiExpiry", "notes", "prestartKind", "reading", "readingUnit", "readingAt", "readingBy", "readingByName", "updatedAt", "updatedBy"])
        && (request.resource.data.type == "vehicle" || request.resource.data.type == "trailer" || request.resource.data.type == "plant")
        && (!("prestartKind" in request.resource.data) || request.resource.data.prestartKind == "skid-steer" || request.resource.data.prestartKind == "excavator" || request.resource.data.prestartKind == "tip-truck" || request.resource.data.prestartKind == "ute" || request.resource.data.prestartKind == "trailer" || request.resource.data.prestartKind == "other-plant")
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.rego is string
        && request.resource.data.rego.size() <= 20
        && fleetDateOk(request.resource.data.regoExpiry)
        && request.resource.data.coiRequired is bool
        && fleetDateOk(request.resource.data.coiExpiry)
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && (!("reading" in request.resource.data) || (request.resource.data.reading is int && request.resource.data.reading >= 0 && request.resource.data.reading <= 10000000))
        && (!("readingUnit" in request.resource.data) || request.resource.data.readingUnit == "" || request.resource.data.readingUnit == "hours" || request.resource.data.readingUnit == "km")
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }
    function fleetEditor(tenantId) {
      return fleetAdmin(tenantId)
        || (fleetMember(tenantId) && fleetHasProfile() && "role" in fleetProfile() && fleetProfile().role == "supervisor");
    }
    function fleetPolicyOk() {
      return request.resource.data.keys().hasOnly(["type", "insurer", "policyNumber", "startDate", "expiry", "amount", "notes", "assetId", "updatedAt", "updatedBy"])
        && (request.resource.data.type == "workcover" || request.resource.data.type == "public-liability" || request.resource.data.type == "vehicle" || request.resource.data.type == "plant" || request.resource.data.type == "contract-works")
        && request.resource.data.insurer is string
        && request.resource.data.insurer.size() > 0
        && request.resource.data.insurer.size() <= 120
        && request.resource.data.policyNumber is string
        && request.resource.data.policyNumber.size() <= 60
        && fleetDateOk(request.resource.data.startDate)
        && fleetDateOk(request.resource.data.expiry)
        && request.resource.data.amount is string
        && request.resource.data.amount.size() <= 40
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.assetId is string
        && request.resource.data.assetId.size() <= 80
        && request.resource.data.assetId.matches('^[A-Za-z0-9_-]*$')
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Prestart readings: any member of the tenant may move a machine's reading UP (same unit), signed as themselves.
    // Nothing else on the machine can change this way. A lower reading stays on the prestart only.
    function fleetReadingOk(tenantId) {
      return fleetMember(tenantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reading", "readingUnit", "readingAt", "readingBy", "readingByName"])
        && request.resource.data.reading is int
        && request.resource.data.reading > 0
        && request.resource.data.reading <= 10000000
        && (request.resource.data.readingUnit == "hours" || request.resource.data.readingUnit == "km")
        && (resource.data.get("reading", 0) == 0
          || resource.data.get("readingUnit", "") == ""
          || resource.data.get("readingUnit", "") != request.resource.data.readingUnit
          || request.resource.data.reading > resource.data.get("reading", 0))
        && request.resource.data.readingBy == request.auth.uid
        && request.resource.data.readingByName is string
        && request.resource.data.readingByName.size() <= 80
        && request.resource.data.readingAt == request.time;
    }

    match /tenants/{tenantId}/fleet/{assetId} {
      allow read: if fleetMember(tenantId);
      allow create: if fleetEditor(tenantId) && fleetAssetOk();
      allow update: if (fleetEditor(tenantId) && fleetAssetOk()) || fleetReadingOk(tenantId);
      allow delete: if fleetAdmin(tenantId);
    }

    match /tenants/{tenantId}/policies/{policyId} {
      allow read: if fleetAdmin(tenantId);
      allow create, update: if fleetAdmin(tenantId) && fleetPolicyOk();
      allow delete: if fleetAdmin(tenantId);
    }
// END FLEET RULES

// BEGIN SERVICING RULES
    function svcSignedIn() { return request.auth != null; }
    function svcIsAlex() { return svcSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function svcIsPatrick() { return svcSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function svcUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function svcHasProfile() { return svcSignedIn() && exists(svcUserPath()); }
    function svcProfile() { return get(svcUserPath()).data; }
    function svcExplicitTenant() {
      return svcHasProfile() && "tenantId" in svcProfile() && svcProfile().tenantId is string && svcProfile().tenantId.size() > 0;
    }
    function svcCallerTenant() {
      return svcExplicitTenant()
        ? svcProfile().tenantId
        : ((svcHasProfile() || svcIsAlex() || svcIsPatrick()) ? "heartwood" : "");
    }
    function svcMember(tenantId) {
      return svcSignedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && svcCallerTenant() == tenantId;
    }
    function svcAdmin(tenantId) {
      return svcMember(tenantId) && (
        svcIsAlex() || svcIsPatrick() || (svcHasProfile() && "role" in svcProfile() && svcProfile().role == "admin")
      );
    }
    function svcWriter(tenantId) {
      return svcAdmin(tenantId)
        || (svcMember(tenantId) && svcHasProfile() && "role" in svcProfile() && svcProfile().role == "supervisor");
    }
    function svcInt(v, max) {
      return v is int && v >= 0 && v <= max;
    }
    function svcUnit(v) {
      return v == "" || v == "hours" || v == "km";
    }
    function svcDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function svcRecordOk() {
      return request.resource.data.keys().hasOnly(["assetId", "doneOn", "reading", "readingUnit", "serviceType", "servicedBy", "notes", "updatedAt", "updatedBy"])
        && request.resource.data.assetId is string
        && request.resource.data.assetId.matches('^[A-Za-z0-9_-]{1,80}$')
        && svcDate(request.resource.data.doneOn)
        && svcInt(request.resource.data.reading, 10000000)
        && svcUnit(request.resource.data.readingUnit)
        && (request.resource.data.reading == 0 || request.resource.data.readingUnit == "hours" || request.resource.data.readingUnit == "km")
        && (request.resource.data.serviceType == "250hr" || request.resource.data.serviceType == "major" || request.resource.data.serviceType == "repair" || request.resource.data.serviceType == "other")
        && request.resource.data.servicedBy is string
        && request.resource.data.servicedBy.size() <= 120
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }
    function svcPlanOk() {
      return request.resource.data.keys().hasOnly(["everyDays", "everyReading", "readingUnit", "currentReading", "updatedAt", "updatedBy"])
        && svcInt(request.resource.data.everyDays, 3650)
        && svcInt(request.resource.data.everyReading, 1000000)
        && svcInt(request.resource.data.currentReading, 10000000)
        && svcUnit(request.resource.data.readingUnit)
        && (request.resource.data.everyReading == 0 || request.resource.data.readingUnit == "hours" || request.resource.data.readingUnit == "km")
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }
    function svcCostOk() {
      return request.resource.data.keys().hasOnly(["amount", "updatedAt", "updatedBy"])
        && request.resource.data.amount is string
        && request.resource.data.amount.size() > 0
        && request.resource.data.amount.size() <= 40
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    match /tenants/{tenantId}/servicing/{recordId} {
      allow read: if svcMember(tenantId);
      allow create, update: if svcWriter(tenantId) && svcRecordOk();
      allow delete: if svcWriter(tenantId);
    }

    match /tenants/{tenantId}/servicePlans/{assetId} {
      allow read: if svcMember(tenantId);
      allow create, update: if svcWriter(tenantId) && svcPlanOk();
      allow delete: if svcWriter(tenantId);
    }

    match /tenants/{tenantId}/serviceCosts/{recordId} {
      allow read: if svcWriter(tenantId);
      allow create, update: if svcWriter(tenantId) && svcCostOk();
      allow delete: if svcWriter(tenantId);
    }
// END SERVICING RULES

// BEGIN PRESTART RULES
    function psSignedIn() { return request.auth != null; }
    function psIsAlex() { return psSignedIn() && request.auth.uid == "1JKLsoxkQNfkphBBO0vDz2ziEyj2"; }
    function psIsPatrick() { return psSignedIn() && request.auth.uid == "R7t41e54Ykcdk9WPdVZnDd697iI2"; }
    function psUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function psHasProfile() { return psSignedIn() && exists(psUserPath()); }
    function psProfile() { return get(psUserPath()).data; }
    function psExplicitTenant() {
      return psHasProfile() && "tenantId" in psProfile() && psProfile().tenantId is string && psProfile().tenantId.size() > 0;
    }
    function psCallerTenant() {
      return psExplicitTenant()
        ? psProfile().tenantId
        : ((psHasProfile() || psIsAlex() || psIsPatrick()) ? "heartwood" : "");
    }
    function psMember(tenantId) {
      return psSignedIn()
        && tenantId is string
        && tenantId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
        && psCallerTenant() == tenantId;
    }
    function psAdmin(tenantId) {
      return psMember(tenantId) && (
        psIsAlex() || psIsPatrick() || (psHasProfile() && "role" in psProfile() && psProfile().role == "admin")
      );
    }
    function psKindOk(kind) {
      return kind == "skid-steer" || kind == "excavator" || kind == "tip-truck"
        || kind == "ute" || kind == "trailer" || kind == "other-plant";
    }
    function psItem(item) {
      return item.keys().hasOnly(["id", "result", "comment", "critical"])
        && item.id is string
        && item.id.size() > 0
        && item.id.size() <= 40
        && (item.result == "pass" || item.result == "fail" || item.result == "na")
        && item.comment is string
        && item.comment.size() <= 500
        && (item.result != "fail" || item.comment.size() > 0)
        && item.critical is bool;
    }
    function psItems(items) {
      return items is list
        && items.size() >= 1
        && items.size() <= 16
        && psItem(items[0])
        && psItem(items[items.size() - 1]);
    }
    function psTpl(item) {
      return item.keys().hasOnly(["id", "label", "critical"])
        && item.id is string && item.id.size() > 0 && item.id.size() <= 40
        && item.label is string && item.label.size() > 0 && item.label.size() <= 60
        && item.critical is bool;
    }
    function psCreateOk() {
      return request.resource.data.keys().hasOnly(["assetId", "assetType", "assetName", "kind", "day", "reading", "readingUnit", "odometer", "items", "signerUid", "signerName", "signedAt", "defect", "doNotOperate", "resolved"])
        && request.resource.data.assetId is string
        && request.resource.data.assetId.matches('^[A-Za-z0-9_-]{1,80}$')
        && (request.resource.data.assetType == "vehicle" || request.resource.data.assetType == "trailer" || request.resource.data.assetType == "plant")
        && psKindOk(request.resource.data.kind)
        && request.resource.data.assetName is string
        && request.resource.data.assetName.size() > 0
        && request.resource.data.assetName.size() <= 80
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.reading is int
        && request.resource.data.reading >= 0
        && request.resource.data.reading <= 10000000
        && (request.resource.data.readingUnit == "" || request.resource.data.readingUnit == "hours" || request.resource.data.readingUnit == "km")
        && request.resource.data.odometer is int
        && request.resource.data.odometer >= 0
        && request.resource.data.odometer <= 10000000
        && psItems(request.resource.data.items)
        && request.resource.data.signerUid == request.auth.uid
        && request.resource.data.signerName is string
        && request.resource.data.signerName.size() >= 2
        && request.resource.data.signerName.size() <= 80
        && request.resource.data.signedAt == request.time
        && request.resource.data.defect is bool
        && request.resource.data.doNotOperate is bool
        && request.resource.data.resolved == false;
    }
    function psSame(key) {
      return request.resource.data[key] == resource.data[key];
    }
    function psResolveOk() {
      return resource.data.defect == true
        && resource.data.resolved == false
        && request.resource.data.resolved == true
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedNote is string
        && request.resource.data.resolvedNote.size() <= 500
        && request.resource.data.resolvedAt == request.time
        && psSame("assetId") && psSame("assetType") && psSame("assetName") && psSame("kind")
        && psSame("day") && psSame("reading") && psSame("readingUnit") && psSame("odometer")
        && psSame("items") && psSame("signerUid") && psSame("signerName")
