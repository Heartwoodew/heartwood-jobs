{
  "hosting": {
    "site": "callupapp",
    "public": "hosting-dist",
    "cleanUrls": false,
    "trailingSlash": true,
    "headers": [
      { "source": "**/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/app/" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(js|css|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
