{
  "hosting": {
    "site": "callup-site",
    "public": "public",
    "cleanUrls": false,
    "trailingSlash": true,
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
    ]
  }
}
